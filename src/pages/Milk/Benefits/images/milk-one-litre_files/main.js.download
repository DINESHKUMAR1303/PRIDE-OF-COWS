  // ===============================start faq section=======================
  $(document).on("click", ".faqsList__category, .faq-question", function () {
    $(".faqsList__category, .faq-question")
      .not($(this))
      .removeClass("active")
      .siblings(".faqsList__detail, .faq-answer")
      .slideUp();
    $(this).toggleClass("active").siblings(".faqsList__detail, .faq-answer").slideToggle();
  });
   // ===============================end faq section=======================
window.addEventListener("DOMContentLoaded", function () {
  $("#hamMenu input:checkbox").prop("checked", false);
  // mobile menu
  $("#hamMenu input").change(function () {
    if ($(this).is(":checked")) {
      $(".header").addClass("open");
    } else {
      $("#hamMenu").removeClass("over-profile-card");
      $(".header").removeClass("open");
    }
  });

  $(".header .overlay.mobile").click(function () {
    $("#hamMenu input").prop("checked", false);
    $(".header").removeClass("open");
  });

  $(".register__overlay, .cart__overlay, .nav_overlay").click(function () {
    $(".header, .register, .cart").removeClass("open");
  });
  // !mobile menu

  //================== menu dropdown
  $("nav li.dropdown > a").on("click", function (e) {
    e.preventDefault();
    $("li.dropdown").not($(this).parent()).removeClass("open");
    $(this).parent().toggleClass("open");
    if ($(this).parent().hasClass("open")) {
      $(".menuOverlay").addClass("active");
    } else {
      $(".menuOverlay").removeClass("active");
    }
  });

  // Keep menu open on hover inside the dropdown
  $("nav li.dropdown > a").on("mouseleave", function () {
    $(this).removeClass("open");
    $(".menuOverlay").removeClass("active");
  });

  // Close menu on click outside
  $("body").on("click", function (event) {
    if (
      !$(event.target).closest("li.dropdown").length &&
      !$(event.target).is("li.dropdown")
    ) {
      $("li.dropdown").removeClass("open");
      $(".menuOverlay").removeClass("active");
    }
  });

  $(".navsubmenuwithImage li").hover(function () {
    let cls = $(this).data("cls");
    $(this)
      .closest(".navsubmenuwithImage")
      .find(".navsubmenuimg")
      .removeClass("active");
    $(this)
      .closest(".navsubmenuwithImage")
      .find(".navsubmenuimg." + cls)
      .addClass("active");
  });
  //================== !menu dropdown

  //================== home care tabs
  $(".careManifesto__tabs h2").each(function () {
    $(this).on("click", function () {
      let tabContentId = $(this).data("id");
      $(".careManifesto__tabs h2").removeClass("active");
      $(".careManifesto__you").removeClass("active");
      $("#" + tabContentId).addClass("active");
      $(this).addClass("active");
    });
  });
  //================= !home care tabs

  /*==================Hero-slider=====================*/
  if ($(".hero__slider").length > 0) {
    $(".hero__slider").slick({
      slidesToShow: 1,
      arrows: true,
      autoplay: true,
      autoplaySpeed: 7000,
      pauseOnHover: false,
      pauseOnFocus: false,
      prevArrow: $(".hero .prev"),
      nextArrow: $(".hero .next"),
      responsive: [
        {
          breakpoint: 600,
          settings: {
            slidesToShow: 1,
          },
        },
      ],
    });

    let $slider = $(".hero__slider");
    let $progressBar = $(".hero .sliderProgress__bar");

    $($slider).on(
      "beforeChange",
      function (event, slick, currentSlide, nextSlide) {
        let calc = (nextSlide / (slick.slideCount - 1)) * 100;

        $progressBar.css("width", calc + "%");
      }
    );
  }
  /*=================!Hero-slider=====================*/

  /*==================ForWellbeing-slider=====================*/
