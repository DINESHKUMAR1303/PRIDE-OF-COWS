  // on scroll fixed header {
  var lastScrollTop = 0;
  function scrolledHeader() {
    var st = $(this).scrollTop();
    st >= 105
      ? $("body, body header, #appBanner").addClass("scrolled")
      : $("body, body header, #appBanner").removeClass("scrolled");

    lastScrollTop = st;
  }

  $(window).on("load", function () {
    scroll();
    // scrollAppearAnimation();
  });
  // scrollAppearAnimation();

  var scroll = function () {
    scrolledHeader();
    scrollAppearAnimation();
  };
  var waiting = false,
    endScrollHandle;
  $(window).scroll(function () {
    if (waiting) {
      return;
    }
    waiting = true;

    clearTimeout(endScrollHandle);

    scroll();

    setTimeout(function () {
      waiting = false;
    }, 80);

    endScrollHandle = setTimeout(function () {
      scroll();
    }, 180);
  });
  // !on scroll fixed header

  var windowHeight = $(window).height();
  function scrollAppearAnimation() {
    $(".showDivLeft, .showDivRight, .showDiv").each(function () {
      if ($(this).parent().hasClass("cookiesPolicy")) {
      } else {
        var scrollTop = $(window).scrollTop(),
          elementOffset = $(this).offset().top,
          distance = elementOffset - scrollTop;
        if (distance < windowHeight) {
          $(this).addClass("add_showDiv");
        } else {
          $(this).removeClass("add_showDiv");
        }
      }
    });
  }

  // ==================Form-focus-handle
  $(".inputGroup input")
    .bind("blur", function () {
      if ($(this).val() == "") {
        $(this).parent().find("label").removeClass("focused");
      }
    })
    .bind("focus", function () {
      $(this).parent().find("label").addClass("focused");
    });
  // =================!Form-focus-handle

  /*==================Accordion====================*/
  // $('.faqsList__item:eq(0) .faqsList__category')
  //   .addClass('active')
  //   .siblings('.faqsList__detail')
  //   .slideDown();
  /*==================!Accordion===================*/
  $("[disabled]").on("click", function (e) {
    e.preventDefault();
  });
});

