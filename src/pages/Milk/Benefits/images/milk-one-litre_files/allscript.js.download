                  window.location.href = url + "calenderorder?order=0";
                }
                else{
                  var offlinecartDatas=localStorage.getItem('offlinecart');
                  let mergeLocalCartData = JSON.parse(localStorage.getItem("userdata"));
                  mergeLocalCartToServer(mergeLocalCartData);  // for sync local cart
                  setTimeout(() => {
                  if(!offlinecartDatas){
                    // start code redirect params
                      if (redirectParam) {
                          window.location.href = url + redirectParam; 
                      } else {
                        window.location.href = url + "ordersubscription";
                        $("#detect_Location_Popup").addClass("show-topmodal");
                      }
                    // end code redirect params
                    return;
                  }else{
                    getOfflineproducts();
                  }
                    window.location.reload();
                  }, 4000);
                }
              }, 1000);
            } else if (response.status == 3) {
              register__step1.classList.add("hidden");
              $('.register').removeClass('open');
              $("#overlay").fadeIn();
              register__step3.classList.add("hidden");
              $("#userid").val(response.UserID);
              $("#otp").val(response.Otp);
              $("#mobile").val(response.MobileNo);
              if (localStorage.getItem('currCity') !== null) {
              var settings = {
                url: baseurl + "register",
                method: "POST",
                headers: {
                        "Content-Type": "application/json",
                },
                data: JSON.stringify({
                        UserId: response.data.UserID,
                        Pincode: localStorage.currPin,
                        City: localStorage.currCity,
                }),
            };       
             $.ajax(settings).done(function (response) {
              $("#overlay").fadeOut();
              if(response.status==1){
                localStorage["userdata"] = JSON.stringify(response.data);
                let mergeLocalCartData = JSON.parse(localStorage.getItem("userdata"));
                mergeLocalCartToServer(mergeLocalCartData);
                setTimeout(() => {
                  window.location.href = url + "ordersubscription";
                }, 3000);  // for sync local cart
              } 
             });
            }
              setTimeout(() => {
                $("#overlay").fadeOut();
                window.location.href = url + "ordersubscription";
            }, 6000);
            }
          })
          .fail(function () {
            register__step1.classList.remove("hidden");
            register__step2.classList.add("hidden");
            register__step3.classList.add("hidden");
            Swal.fire({
              position: "top-end",
              icon: "error",
              title: "Something Went Wrong",
              showConfirmButton: false,
              timer: 2500,
            });
          });
      }
    } else {
      Swal.fire({
        position: "top-end",
        icon: "error",
        title: "Can't proceed as you didn't agree to the terms!",
        showConfirmButton: false,
        timer: 2500,
      });
    }
  } 


//script2
function showRegister(event) {
  gaEvent({
      'event': 'user_profile',
      'current_page': window.location.href  
    });
    localStorage.removeItem('currPin');
    localStorage.removeItem('currCity');

  if (localStorage.getItem("userdata") !== null) {
    var userdata = localStorage["userdata"]
      ? JSON.parse(localStorage["userdata"])
      : {};
    if (
      userdata.pincode === "" ||
      userdata.FirstName === null ||
      userdata.LastName === null ||
      userdata.FirstName === "" ||
      userdata.LastName === ""
    ) { 
      if( userdata.pincode!=='' && userdata.pincode!== null  && String(userdata.pincode).trim().length !== 0 ){
        event?.preventDefault();
        var register__step1 = document.querySelector(".register__step1");
        var register__step2 = document.querySelector(".register__step2");
        // var register__step3 = document.querySelector(".register__step3");    // for address popup
        register.classList.add("open");
        register__step1.classList.add("hidden");
        register__step2.classList.add("hidden");
        // register__step3.classList.remove("hidden");      // for address popup
        
        // start address popup
          window.location.href = url + "profile";
          if ($('.register').hasClass('open')) {
              // $("#addressPopup").show();
              $('.register').hide();
              $('.register').removeClass('open');
            }
        // end address popup

        var pincodeInput = document.querySelector(".reg3pincode");
        if(userdata.pincode == 0 && userdata.pincode < 6 && userdata.pincode == null ) {
          pincodeInput.removeAttribute('readonly'); 
        }
        if(userdata.pincode !== null) {
          $('.reg3pincode').val(userdata.pincode);
          checkpincodereregister(userdata.pincode);
        }
        if(userdata.FirstName != null) {
          $('.reg3fname').val(userdata.FirstName);
        }
        if(userdata.LastName != null) {
          $('.reg3lname').val(userdata.LastName);
        }
        if(userdata.flat_plot_no != null) {
          $('.reg3flatn').val(userdata.flat_plot_no);
        }
        if(userdata.building_name != null) {
          $('.reg3regadd1').val(userdata.building_name);
        }
        if(userdata.street_road != null) {
          $('.reg3regadd2').val(userdata.street_road);
        }
        if(userdata.Email != null) {
          $('.reg3email').val(userdata.Email);
        }
        if(userdata.landmark != null) {
          $('.reg3reglocality').val(userdata.landmark);
        }
      }else{
        togglelocation();
        return;
      }
      $("#reg3pincode").prop("disabled", true);
    } else {
      window.location.href = url + "profile";
    }
  }
  setTimeout(function () {
    event?.preventDefault();
    register.classList.add("open");
  }, 400);
  document.addEventListener("keydown", function (event) {
    if (event?.key === "Escape" || event?.key === "Esc") {
      closeModalFunction();
    }
  });
}
//script3
//  subscripName();
function subscripName() {
  var userdata = localStorage["userdata"]
    ? JSON.parse(localStorage["userdata"])
    : {};
  if (userdata) {
    FirstName = userdata.FirstName;
    LastName = userdata.LastName;
    MobileNo = userdata.MobileNo;
    var newHTML = FirstName + " " + LastName;
    if (FirstName == '' || FirstName == null) {
      newHTML = "Guest";
    }
    $("#subscripid").text(newHTML);
    $("#webusernumber").text(MobileNo);
  }
}

