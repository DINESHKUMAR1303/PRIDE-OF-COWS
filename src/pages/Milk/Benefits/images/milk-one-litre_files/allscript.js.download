function pauseSubscriptionUpdate() {
  var userdata = localStorage.getItem("userdata", userdata);
  const data = JSON.parse(userdata);
  var token = data.token;

  let errorMsg = "";
  let startDate = $("#pauseStartDate").val();
  let endDate = $("#pauseEndDate").val();
  
  if(!startDate){
    errorMsg = "Please select date first"
  }
  
  if(errorMsg){
    Swal.fire({
      position: "top-end",
      icon: "error",
      title: errorMsg,
      showConfirmButton: false,
      timer: 2500,
    });
    return;
  }

  var settings = {
    url: baseurl + "pause-subscription",
    method: "POST",
    headers: {
      "Content-Type": "application/json",
      Authorization: "Bearer " + token,
    },
    data: JSON.stringify({
      subscriptionId: localStorage.getItem("subId"),
      startDate: startDate,
      ...(endDate ? { endDate } : {}) 
    }),
  };

  $.ajax(settings).done(function (response) {
    $("#subscription").removeClass("active");
    $("#alertBoxPopup").addClass("active");
    $("#alertBoxPopup h3").text(response.message);
    $("#alertBoxPopup img").attr("src", "../images/success.gif");
    setTimeout(()=> {
        $("#alertBoxPopup").removeClass("active");
        if (response.status == 1) {
          setTimeout(()=> {
          window.location.href = url + "mysubscription";
          }, 100)
        } else {
          console.log(response.message);
        }
      }, 2000)
  });
}
// end pause subscription

// start cancel subscription

function showCancelSubscriptionModal(){
  $("#cancel-subscription-modal").addClass("active");
}

function cancelSubscription() {
  try {
  var userdata = localStorage.getItem("userdata", userdata);
  const data = JSON.parse(userdata);
  var token = data.token;

  let errorMsg = "";
  let cancelDate = $("#cancelStartDate").val();

  if(!cancelDate){
    errorMsg = "Please select date first"
  }
  
  if(errorMsg){
    Swal.fire({
      position: "top-end",
      icon: "error",
      title: errorMsg,
      showConfirmButton: false,
      timer: 2500,
    });
    return;
  }

  var settings = {
    url: baseUrl + "cancel-subscription",
    method: "POST",
    headers: {
      "Content-Type": "application/json",
      Authorization: "Bearer " + token,
    },
    data: JSON.stringify({
      subscriptionId: localStorage.getItem("subId"),
      subscriptionStart : cancelDate
    }),
  };

  $.ajax(settings).done(function (response) {
    $("#cancel-subscription-modal").removeClass("active");
    $("#alertBoxPopup").addClass("active");
    $("#alertBoxPopup h3").text(response.message);
    $("#alertBoxPopup img").attr("src", "../images/success.gif");
    setTimeout(()=> {
      $("#alertBoxPopup").removeClass("active");
      if (response.status == 1) {
        gaEvent({
          "event": "cancelled_subscription", 
          "custId": userdata?.UserID,
          "subscriptionPlan" : localStorage.getItem("subscriptionData").scheduleType,
          "subscriptionId": localStorage.getItem("subId"),
          "subscriptionStart" : cancelDate
        });
        window.location.href = url + "ordersubscription";
      } else {
        Swal.fire({
          position: "top-end",
          icon: "error",
          title: response.message,
          showConfirmButton: false,
          timer: 2500,
        });
      }
    }, 2000)
  });
} catch (error) {
  Swal.fire({
    position: "top-end",
    icon: "error",
    title: "Something went wrong.",
    showConfirmButton: false,
    timer: 2500,
  });
}
}
// end cancel subscription

