// start utm source campaining function
function submitCampaignDetails(campaignEvents, product_id = '') {
   try {
        var userdata = localStorage.getItem("userdata", userdata);
        var data = JSON.parse(userdata);
        var userID = data?.UserID ?? '';

        if(!sessionStorage.getItem("utm_source") && !sessionStorage.getItem("lastparam_ghee")){
        // if(!sessionStorage.getItem("utm_source")){
            const params = new URLSearchParams(window.location.search);
            const utm_source_params = params.get('utm_source') || 'other';
            sessionStorage.setItem("utm_source", utm_source_params);

            const pathParts = window.location.pathname.split('/').filter(Boolean); 
            // const lastParam = pathParts[pathParts.length - 1];
            // let updatedLastParam = lastParam === 'ghee' ? 'ghee' : 'other-cat';
            let updatedLastParam = pathParts.includes('ghee') ? 'ghee' : 'other-cat';
            sessionStorage.setItem("lastparam_ghee", updatedLastParam);
        }

        const utm_source = sessionStorage.getItem("utm_source");
        const newlastParam = sessionStorage.getItem("lastparam_ghee");
        var settings = {
        url: baseUrl + "customerdetailsofcampaign",
        method: "POST",
        data: {
          user_id: userID,
          product_id: product_id,
          order_detail_id: campaignEvents,
          source: utm_source, 
          offer_detail: utm_source !== 'utm_source' && newlastParam !== 'ghee' ? 'other-cat' : 'cat-ghee',
          // offer_detail: utm_source === 'other' ? '' : 'cat-ghee',
        },
      };
      $.ajax(settings).done(function (response) {
        // console.log(response);
      });
    } catch (error) {
    console.error("Error in submitCampaignDetails:", error);
  }
}
  // end utm source campaining function

  
function formatDateUpdate(apiDate) {
    const [year, month, day] = apiDate.split("-");
    return `${day}/${month}/${year}`;
}
function formatDateToYMD(date) {
    const [day, month, year] = date.split("/");
    const formattedDay = day.padStart(2, '0');
    const formattedMonth = month.padStart(2, '0');
    return `${year}-${formattedMonth}-${formattedDay}`;
}

