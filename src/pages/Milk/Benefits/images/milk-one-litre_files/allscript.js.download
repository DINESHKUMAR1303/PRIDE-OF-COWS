function walletoffers() {
  var userdata = localStorage.getItem("userdata");
  const data = JSON.parse(userdata);
  $.ajax({
    url: baseUrl + "wallet-promo-offers",
    method: "post",
    headers: {
      Authorization: "Bearer " + data.token,
      "Content-Type": "application/json"
    },
    data: JSON.stringify({
      city: data.city_id,
    })
  }).done(function (resp) {
    $.each(resp, function (key, value) {
      let minimumCartValue = value.minimum_cart_value;
      $("#offers_image_item").append(` <div class="col-6 col-xs-12 my-10"> <a href="${url}wallet?promo_id=${value.id}&minimum_cart_value=${minimumCartValue}"><img src="https://prideofcows.in/prideofcows/storage/upload/${value.thumbnail_image}" alt="${value.promocode_name}"></a> </div>`);
    });
  });
}
function promocodeforoffer() {
  var data = (localStorage["userdata"]) ? JSON.parse(localStorage["userdata"]) : {};
  if(data){
  $('.offermenu_item').css('display','contents');
  var token = data.token;
  var UserId = data.UserID;
  var ProductID = localStorage.getItem("pid", ProductID);
  var settings = {
    url: baseUrl + "allactiveoffers",
    method: "POST",
    timeout: 0,
    headers: {
      Authorization: "Bearer " + token,
      "Content-Type": "application/json",
    },
    data: JSON.stringify({
      custid: UserId,
    }),
  };
  $.ajax(settings).done(function (response) {
    var gheeOffer = '';
    if (response.status == 1) {
      $.each(response.data, function (key, value) {
        // if(value.type!="wallet"){
          var onclick='';
          var href='#';
          var img = value.image;
          if (value.type == 999) {
            onclick = `onclick="availofferlink(999,'Pride of Cows Website');"`;
            var href=`/orders/offer.php`;
          }
          if (value.type == 'product' && !isNaN(value.navigation)) {
            onclick = `onclick="getproductDetail(${value.navigation}, '${value.slug}', '${value.category_slug}');"`;
          }
          if (value.code == 'churn') {
            onclick = `onclick="getproductDetailChurn(${value.navigation}, '${value.slug}','churn');"`;
          }
          if(value.type=='wallet'){
            href=`${url}wallet?promocode=${value.code}`;
          }
          if(value.id == 11) {
            gheeOffer = ` <div class="col-6 col-xs-12 my-10"> <a href="#"><img src="${img}" alt="${value.code}" ${onclick}></a> </div>`
          } else {
            $("#offers_image_item").append(` <div class="col-6 col-xs-12 my-10"> <a href="${href}"><img src="${img}" alt="${value.code}" ${onclick}></a> </div>`);
          }
        // }
      });
      // walletoffers();
      setTimeout(() => {
        $("#offers_image_item").append(gheeOffer);
      }, 2000);
    }
  });
}else{
  promocodeofflineoffer()
}
}
