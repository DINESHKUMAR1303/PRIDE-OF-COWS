  } else {
    var arr = $('.prodcounts').map((i, e) => e.value).get();
  }
  const totalPriceOfAllProducts = await fetchcartdata(arr);
  var walletBalance = localStorage.getItem("balance");

  var userdata = localStorage.getItem("userdata");
  const data = JSON.parse(userdata);
  const cust_type = data.customer_type;



  // display:none property will be add
  $('.pro_to_checkout').html(`
  ${cust_type == "prepaid" && walletBalance < totalPriceOfAllProducts ? `
  <span class="info webchkt" onclick="adjustOrderInstruction()" id="infoIcon" style="display:none"> <img src="${url}../images/info.svg" alt="pencil icon"></span> 
  <button class="btn-checkout chkt adj-btn webchkt" onclick="adjustOrderModal()" style="display:none;">Adjust</button>` : ''}
  <button class="btn-checkout chkt webchkt" onclick="window.location.href='../customer/checkout'">Checkout</button>

`);

