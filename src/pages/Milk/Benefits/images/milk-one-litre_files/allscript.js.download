function getAllSubscriptions() {
  var userdata = localStorage.getItem("userdata", userdata);
  // start code for existing userpincode
  if(userdata){
    var userdata = localStorage.getItem("userdata");
    var newuserdata = userdata ? JSON.parse(userdata) : null;
    if (newuserdata) {
      var userPin = localStorage.getItem("userPincode");
      var asd= newuserdata.default_address_id
      localStorage.setItem("selectedAddressId",asd)
      var pinn = newuserdata.pincode; 
      if (!userPin) {
        localStorage.setItem("userPincode", pinn);
      }
    }
  }
// end code for existing userpincode
  const poc_addresid = localStorage.getItem("selectedAddressId");
  const data = JSON.parse(userdata);
  var token = data.token;
  var settings = {
    url: baseurl + "get-subscription",
    method: "POST",
    headers: {
      "Content-Type": "application/json",
      Authorization: "Bearer " + token,
    },
    data: JSON.stringify({
      addressId: poc_addresid
    })
  };

  $.ajax(settings).done(function (response) {
    $("#preloader").show();
    if (response.status == 1) {
    if (response) {
      $("#preloader").css("display", "none");
      if (response.data && response.data.length > 0) {
      localStorage.setItem("allSubscriptionDetails", JSON.stringify(response.data));
      $.each(response.data?.reverse(), function (key, value) {
        if (value.status == 0) {
          var statusCol = "skyBlue";
        } else {
          var statusCol = "d-flex red";
        }
        // console.log(value);
        var fromDt = new Date(value.from_date);
        fromDt = formatDate(fromDt);

        var toDt = new Date(value.to_date);
        toDt = formatDate(toDt);
        if( $("#onlysubscription").length){
          $("#onlysubscription").append(`
                    <div class="pOrders__box">
                    <div class="pOrders__top d-flex justify-space-between">
                        <h4>Manage Subscription</h4>
                        <h4>Order no.:${value.order_id}</h4>
                    </div>
                     <div class="pOrders__middle">
                    <div class="d-flex pOrders__middle__bottom align-end justify-space-between">
                        <div class="d-flex pOrders__middle__bottom__imgs sn_m_left">
                            <div class="sub-productImage">
                                <img src=${value.product.productImage} alt="product image">
                            </div>
                            <div class="sub-productDetails">
                                <p>${value.product.product_name}</p>
                                <p style="text-transform: capitalize;">${value.scheduleType} Delivery</p>
                            </div>
                        </div>
                        <div class="cta d-flex">
                          ${  value.status === "active" ? `<a class="d-flex" onClick="getAllSubscription(${value.subscription_id})">
                            <svg class="transition" width="27" height="13" viewBox="0 0 27 13" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M21.098 12L26 6.5M26 6.5L21.098 0.999999M26 6.5L1 6.5" stroke="#808080" stroke-linecap="square" stroke-linejoin="round"></path>
                            </svg>
                          </a>` : 
                            "<div class='cancel' >Cancelled</div>"
                        }
                        </div>
                    </div>
                </div>
          </div>`);
        }
      });
      if(typeof populateSubscriptionDate === "function"){
        populateSubscriptionDate();
      }
      } else {
      $("#onlysubscription").html(`
        <div class="emptyOrderScreen mt-25">
             <div class="text-center">
             <div class="empty_order_img_container">
             <img src="../images/cartbagempty.png" alt="Empty Cart" loading="lazy" class="emptyOrderImg"/>
             </div>
             <p class="fw-bold mt-10">No Active Subscription Found!</p>
             <p>Set it up now for seamless deliveries and never miss your favorite POC products again!</p>
             <a class="btn" href="${weburl}shop/all">Explore more products</a>
             </div>
         </div>
        `)
        $('.pagination__orders').hide();
        $('.profile__right, .pOrders').css('margin-bottom', 'unset');
      }
    }
    }
  });
}
// end subscription details 

// start manage subscription
function manageSubscription() {
  let sub_data = JSON.parse(localStorage.getItem("subscriptionData"));
  let sub_prod_image = sub_data.product?.productImage ? sub_data.product?.productImage : '../images/product-img-not-found.jpg';
  let totalPrice = sub_data.product.price
  if (sub_data.scheduleType === "custom") {
    $("#quantityCompo").hide()
    totalPrice = sub_data.totalPrice;
  }
  localStorage.setItem("totalPrice", totalPrice)
  localStorage.setItem("totalPriceItem", totalPrice)
  localStorage.setItem("price", sub_data.product.price)
  $("#manageSubscription").addClass("active");
  $("#productName").text(sub_data.product.product_name);
  $("#sub_prod_img").attr("src", sub_prod_image);
  $("#productPrice").text(sub_data.product.price);
  $("#itemQuantity").val(sub_data.qty.trim() || 1);
  // $("#total_product_amount").text(`₹${sub_data.totalPrice}`);
  $("#total_product_amount").text(`₹0`);
  $("#walletBalance").text(localStorage.getItem("balance"));
  
  gaEvent({
    "event": "edit_subscription", 
    "custId": localStorage.getItem("userdata")?.UserID,
    "subs_id" : localStorage.getItem("subId"),
    "delivery_plan" : sub_data.scheduleType,
    "date" : moment(new Date()).format('DD MMM YYYY')
    })
}

function manageSubscriptionUpdate(){
  try {
    const sub_data = JSON.parse(localStorage.getItem("subscriptionData"));
    let userData = JSON.parse(localStorage.getItem("userdata") || null)
    const poc_addresid = localStorage.getItem("selectedAddressId");
    if(!userData?.token){
      showRegister();
      return;
    }
    let errorMsg = "";
   
    const deliveryPlan = $(".btnPlanType.btn.active").attr("data-plan");
    const productId = localStorage.getItem("pid");
    const subscriptionId = localStorage.getItem("subId")
    const quantity = $("#itemQuantity").val();
    const subscriptionType = deliveryPlan
    let startDate = $("#startDate").val();
    let tempDate = new Date(startDate);
    
    if(quantity < 1){
      errorMsg = "Please add minimum 1 quantity"
    } 
    
    let subscriptionFrequency = Array(7).fill(quantity).join(",");
    if(subscriptionType === "alternate"){
      subscriptionFrequency = `alternate,${quantity}`;
      startDate = $("#alternateStartDate").val();
    }else if(subscriptionType === "custom"){
      startDate = $("#customStartDate").val();
      subscriptionFrequency = JSON.parse(localStorage.getItem("customDays"));
      subscriptionFrequency.push(subscriptionFrequency.shift());
      subscriptionFrequency = subscriptionFrequency.join(",");
    }
    
    if(!startDate){
      errorMsg = "Please select a start date"
    } 
    
    tempDate.setDate(tempDate.getDate() + 15);
    if(new Date(startDate) > tempDate ){
      errorMsg = "Start Date must be within 15 days from today"
    }
    if(errorMsg){
      Swal.fire({
        position: "top-end",
        icon: "error",
        title: errorMsg,
        showConfirmButton: false,
        timer: 2500,
      });
      return;
    }
    var settings = {
    url: baseurl + "manage-subscription",
      method: "POST",
      headers: {
        "Content-Type": "application/json",
        ...(userData?.token ? { Authorization: "Bearer " + userData?.token } : {}),
      },
      data: JSON.stringify({
        subscriptionType: subscriptionType,
        subscriptionFrequency,
        productId : parseInt(productId),
        subscriptionStart : startDate,
        subscriptionId,
        current_balance: localStorage.getItem("balance") ?? "0",
        addressId: poc_addresid
      }),
    };
    $.ajax(settings).done(function (resp) {
      localStorage.setItem("subId",resp.subs_id)
      gaEvent({
        "event": "manage_subscription", 
        "custId": userData?.UserID,
        "sub_data": sub_data,
        "updated_sub_data" : {
          subs_id : resp.subs_id,
          subscriptionType: subscriptionType,
          subscriptionFrequency,
          productId : productId,
          subscriptionStart : startDate,
          subscriptionId,
          current_balance: localStorage.getItem("balance") ?? "0"
        }
      });
      window.location.href = url + "mysubscription";
    }); 
} catch (error) {
  Swal.fire({
    position: "top-end",
    icon: "error",
    title: "Something went wrong please try again leter",
    showConfirmButton: false,
    timer: 2500,
  });
}
}

// end manage subscription

