function checkpincodereregister(value) {
  var userdata = localStorage.getItem("userdata", userdata);
  var data = JSON.parse(userdata);
  const isSubscriptionalbleProduct = !!localStorage.getItem("isSubscriptionalbleProduct");
  $("#state_name").val("");
  $("#city_name").val("");
  $("#state_id").val("");
  $("#city_id").val("");
  var valueString = value.toString();
  var validateMobNum = /^\d*(?:\.\d{1,2})?$/;
  if (validateMobNum.test(value) && valueString.length == 6 && data !== null) {
    var token = data.token;
    var settings = {
      url: baseurl + "allstatecity",
      method: "POST",
      timeout: 0,
      headers: {
        "Content-Type": "application/json",
        Authorization: "Bearer " + token,
      },
      data: JSON.stringify({
        pincode: value,
      }),
    };

    $.ajax(settings).done(function (response) {
      console.log(response);
      if (response) {
        if (response) {
          if (response.status == 0) {
            Swal.fire({
              position: "top-end",
              icon: "error",
              title: "Not a valid pincode",
              showConfirmButton: false,
              timer: 2500,
            });
            $("#pincode").val("");
            $("#reg3pincode").val("");
            return false;
          } else if(response.status == 2 && isSubscriptionalbleProduct){
            Swal.fire({
              position: "top-end",
              icon: "error",
              title: "This Product is not available at you area",
              showConfirmButton: false,
              timer: 2500,
            });
            $("#pincode").val("");
            $("#reg3pincode").val("");
          } 
          else {
            $("#reg3state_name").val(response.state_name);
            $("#reg3city_name").val(response.cityname);
            $("#reg3state_id").val(response.sid);
            $("#reg3city_id").val(response.cid);
            checkaddressinput();
          }
        }
      }
    });
  }
}

