function checkpincoderegisterold(value) {
  var userdata = localStorage.getItem("userdata", userdata);
  var data = JSON.parse(userdata);

  var validateMobNum = /^\d*(?:\.\d{1,2})?$/;
  if (validateMobNum.test(value) && value.length == 6 && data !== null) {
    var token = data.token;

    var settings = {
      url: baseurl + "loginpostal",
      method: "POST",
      timeout: 0,
      headers: {
        "Content-Type": "application/json",
        Authorization: "Bearer " + token,
        //"Cookie": "_csrf=195f3790df5ab56b2bc1388c9ec0a5655652c472e84360afe2bbbd47f0a7b22ca%3A2%3A%7Bi%3A0%3Bs%3A5%3A%22_csrf%22%3Bi%3A1%3Bs%3A32%3A%225l5f-f5jLrreSDJVoyNrsvfl2Gt2_oCb%22%3B%7D; advanced-api=f7ie9bmfgjutco2nf699v4pp1b"
      },
      data: JSON.stringify({
        subscrippostal: value,
      }),
    };

    $.ajax(settings).done(function (response) {
      // console.log(response);

      if (response) {
        var values = response;
        if (values) {
          $("#city_id_id").show();
          $("#address_city_id1_id").hide();
          stateid(values.sid, values.city_id, values.city_id1);
          $("#dropdownid").val(values.sid);
          $("#dropdownid1").val(values.sid);
          $("#address_city_id1").val(values.city_id);
        }
      }
    });
  }
}
function checkpincoderegister(value,st=0) {
  var userdata = localStorage.getItem("userdata", userdata);
  var data = JSON.parse(userdata);
  $("#state_name").val("");
  $("#city_name").val("");
  $("#state_id").val("");
  $("#city_id").val("");

  var validateMobNum = /^\d*(?:\.\d{1,2})?$/;
  if (validateMobNum.test(value) && value.length == 6 && data !== null) {
    var token = data.token;
    var settings = {
      url: baseurl + "allstatecity",
      method: "POST",
      timeout: 0,
      headers: {
        "Content-Type": "application/json",
        Authorization: "Bearer " + token,
      },
      data: JSON.stringify({
        pincode: value,
      }),
    };

    $.ajax(settings).done(function (response) {
      // console.log(response);
      if (response) {
        if (response) {
          if (response.status == 0) {
            if(st===0){
              Swal.fire({
                position: "top-end",
                icon: "error",
                title: "Not a valid pincode",
                showConfirmButton: false,
                timer: 2500,
              });
            }
            $("#pincode").val("");
            return false;
          } else {
            $("#state_name").val(response.state_name);
            $("#city_name").val(response.cityname);
            $("#state_id").val(response.sid);
            $("#city_id").val(response.cid);
            $(".statelab").addClass("focused");
            $(".citylab").addClass("focused");
          }
        }
      }
    });
  }
}


