        if (value && value.date && value.status !== undefined) {
          $("#raisedticket").append(`
          <div class="addAddress__box d-flex justify-space-between bg-white">
          <div class="addAddress__top w-100 d-flex justify-space-between mb-0">
            <div class="addAddress__top__left d-flex">
