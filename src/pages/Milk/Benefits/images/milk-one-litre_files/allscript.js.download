}
function renderStars({ rating, containerId, totalReviews, element }) {
  let starContainer = document.getElementById(containerId);
  try {
    const featureFlags = JSON.parse(localStorage.getItem('featureFlags'));
    const isFeatureEnabled = featureFlags ? typeof featureFlags?.product_rating === "boolean" && featureFlags?.product_rating : false;
    if (element) {
      starContainer = element;
    }
    if (!isFeatureEnabled || !rating || rating <= 3) {
      $(starContainer).remove();
      return;
    }
    starContainer.style.display = "block";

    for (let i = 1; i <= 5; i++) {
      const star = document.createElement('span');
      star.classList.add('star');
      star.innerHTML = '&#9733;';

      if (i <= Math.floor(rating)) {
        star.classList.add('filled');
      } else if (i === Math.floor(rating) + 1 && rating % 1 !== 0) {
        star.classList.add('half-filled');
        star.style.position = "relative";
        let halfStar = document.createElement("span");
        halfStar.innerHTML = "&#9733;";
        halfStar.style.position = "absolute";
        halfStar.style.color = "#917415";
        halfStar.style.width = `${(rating % 1).toFixed(2) * 100}%`;
        halfStar.style.overflow = "hidden";
        halfStar.style.left = "0";
        star.appendChild(halfStar);
      }

      starContainer.appendChild(star);
    }
    starContainer.innerHTML += `<span>${rating} ${totalReviews ? "(" + formatNumber(totalReviews) + ")" : ""}</span>`;
  } catch (e) {
    $(starContainer).remove();
  }
}

function formatNumber(n) {
  if (n >= 1e3) return Math.floor(n / 1e2) / 10 + 'k';
  return n.toString();
}

function addSessionData({city_id}){
  $.ajax({
    url: weburl+'site/set-token',
    method: 'POST',
    data: { city_id : city_id },
    success: function (response) {
      console.log("cityId stored in session:", response);
    },
    error: function (err) {
      console.error("cityId setting token:", err);
    }
  });
}

/* ========================accoridon js start============================ */
  // Loop through each accordion group
  $('.accordion-group').each(function () {
    const group = $(this);
    const openCount = group.data('open'); // "1", "2", or "all"
    const headers = group.find('.accordion-header');

    // Open N accordions on load
    function openAccordions(count) {
      let total = count === 'all' ? headers.length : parseInt(count, 10);
      headers.slice(0, total).each(function () {
        const content = $(this).next('.accordion-content');
        content.addClass('active');
        $(this).find('.arrow-toggle').addClass('rotate');
        $(this).find('h4, p').css('font-weight', '700');
      });
    }

    if (openCount !== undefined) {
      openAccordions(openCount);
    }

    // Handle toggling individually within group
    headers.on('click', function () {
      const content = $(this).next('.accordion-content');
      const isActive = content.hasClass('active');

      if (isActive) {
        content.removeClass('active');
        $(this).find('.arrow-toggle').removeClass('rotate');
        $(this).find('h4, p').css('font-weight', 'normal');
      } else {
        content.addClass('active');
        $(this).find('.arrow-toggle').addClass('rotate');
        $(this).find('h4, p').css('font-weight', '700');
      }
    });
  });
  /* ========================accordion js end============================ */

