function updateaddressbook() {
  var userdata = localStorage.getItem("userdata", userdata);
  var addressid = localStorage.getItem("addressid", addressid);
  const value = JSON.parse(userdata);
  var token = value.token;
  var Id = value.Id;
  var UserID = value.UserID;

  var name = $("#fullname").val();
  var mobile_number = $("#pnumber").val();
  var alter_mobile_number = $("#apnumber").val();
  var addres_line1 = $("#address").val();
  var address_line2 = $("#locality").val();
  var landmark = $("#landmark").val();
  var pincode = $("#address_pincode_edit").val();
  var state = $("#state_edit").val();
  var city = $("#address_city_id_edit").val();
  var address_line2 = $("#locality").val();
  var addresstype = $('input[name="addressType"]:checked').val();
  var statusAs = 0;
  if (localStorage.addressChecked) {
    var statusAs = localStorage.addressChecked;
  }

  var settings = {
    url: baseurl + "addressupdate",
    method: "POST",
    timeout: 0,
    headers: {
      "Content-Type": "application/json",
      Authorization: "Bearer " + token,
      //   "Cookie": "_csrf=5da2070f0ac7c3a947403e67e79f4f98898c3de96b800382e5807ad75a683890a%3A2%3A%7Bi%3A0%3Bs%3A5%3A%22_csrf%22%3Bi%3A1%3Bs%3A32%3A%22VAX_BhROmb6s_WyGuk5OA7coukZIW8-U%22%3B%7D; advanced-api=inpdo4016i0d60c3adb7cjcsk8"
    },
    data: JSON.stringify({
      Id: addressid,
      Name: name,
      MobileNumber: mobile_number,
      AlterMobile: alter_mobile_number,
      Address1: addres_line1,
      Address2: address_line2,
      Landmark: landmark,
      Pincode: pincode,
      State: state,
      City: city,
      AddressType: addresstype,
      AddressStatus: statusAs,
      UserId: UserID,
    }),
  };

  $.ajax(settings).done(function (response) {
    localStorage.removeItem("addressChecked");

    if (response.status == 1) {
      Swal.fire({
        title: "success",
        text: response.message,
        icon: "success",
        closeOnConfirm: true,
      }).then(function () {
        window.location.href = url + "addressbook";
      });
    } else {
      Swal.fire({
        title: "error",
        text: response.message,
        icon: "error",
        closeOnConfirm: true,
      }).then(function () {
        window.location.href = url + "addressbook";
      });
    }
  });
}

