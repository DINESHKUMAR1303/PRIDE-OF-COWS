function updateCalOrderCheckout(ProdID, date, oldQty, productPrice, isGhost, productName) {
  newQtyEdit = parseInt($('#newQtyInput').val());
  qtyprod = newQtyEdit - oldQty;
  editAllProdPrice = qtyprod * productPrice;

  var userdata = localStorage.getItem("userdata", userdata);
  const data = JSON.parse(userdata);
  var token = data.token;
  if(isGhost){
      manageGhostOrder({action : 'editGhostOrder', productName : productName, oldDate : date})
  }
  else if (data.customer_type === 'Postpaid') {
    updatedQuantity = parseInt($('#newQtyInput').val());
    if (updatedQuantity !== parseInt(oldQty)) {
        var settings = {
          url: baseurl + "updateorder",
          method: "POST",
          timeout: 0,
          headers: {
            Authorization: "Bearer " + token,
            "Content-Type": "application/json",
          },
          data: JSON.stringify({
            Date: date,
            id: ProdID,
            Quantity: updatedQuantity,
            custid: data.UserID,
          }),
        };
  
        $.ajax(settings).done(function (response) {
          localStorage.removeItem("ddate");
          localStorage.removeItem("update");
          localStorage.removeItem("rid");
          if (response.status == 1) {
            Swal.fire({
              title: "success",
              text: response.message,
              icon: "success",
              closeOnConfirm: true,
            }).then(function () {
              window.location.href = url + "calenderorder";
            });
          } else {
            Swal.fire({
              title: "error",
              text: response.message,
              icon: "error",
              closeOnConfirm: true,
            }).then(function () {
              window.location.href = url + "calenderorder";
            });
          }
        });

    } else {
      Swal.fire({
        title: "error",
        text: "Quantity remains unchanged. Order not updated.",
        icon: "error",
        closeOnConfirm: true,
      });
    }
  } else {
    var settings = {
      "url": baseurl + "getwallet",
      "method": "POST",
      "timeout": 0,
      "headers": {
        "Authorization": "Bearer " + token,
        "Content-Type": "application/json",
      },
    };
    $.ajax(settings).done(function (response) {
      $.each(response.data, function (key, value) {
        var currentWalletBlc = response.data.balance;
        if (currentWalletBlc >= editAllProdPrice) {
          var userdata = localStorage["userdata"] ? JSON.parse(localStorage["userdata"]) : {};
          if (userdata) {
            updatedQuantity = parseInt($('#newQtyInput').val());
            var token = userdata.token;
            if (updatedQuantity !== parseInt(oldQty)) {
              var settings = {
                url: baseurl + "updateorder",
                method: "POST",
                timeout: 0,
                headers: {
                  Authorization: "Bearer " + token,
                  "Content-Type": "application/json",
                },
                data: JSON.stringify({
                  Date: date,
                  id: ProdID,
                  Quantity: updatedQuantity,
                  custid: userdata.UserID,
                }),
              };

              $.ajax(settings).done(function (response) {
                localStorage.removeItem("ddate");
                localStorage.removeItem("update");
                localStorage.removeItem("rid");
                if (response.status == 1) {
                  Swal.fire({
                    title: "success",
                    text: response.message,
                    icon: "success",
                    closeOnConfirm: true,
                  }).then(function () {
                    window.location.href = url + "calenderorder";
                  });
                } else {
                  Swal.fire({
                    title: "error",
                    text: response.message,
                    icon: "error",
                    closeOnConfirm: true,
                  }).then(function () {
                    window.location.href = url + "calenderorder";
                  });
                }
              });
            }
            else {
              Swal.fire({
                title: "error",
                text: "Quantity remains unchanged. Order not updated.",
                icon: "error",
                closeOnConfirm: true,
              });
            }
          }
        } else if (newQtyEdit < oldQty) {
          // console.log("oldQty"+  +oldQty);
          var userdata = localStorage["userdata"] ? JSON.parse(localStorage["userdata"]) : {};
          if (userdata) {
            updatedQuantity = parseInt($('#newQtyInput').val());
            var token = userdata.token;
            if (updatedQuantity !== parseInt(oldQty)) {
              var settings = {
                url: baseurl + "updateorder",
                method: "POST",
                timeout: 0,
                headers: {
                  Authorization: "Bearer " + token,
                  "Content-Type": "application/json",
                },
                data: JSON.stringify({
                  Date: date,
                  id: ProdID,
                  Quantity: updatedQuantity,
                  custid: userdata.UserID,
                }),
              };

              $.ajax(settings).done(function (response) {
                localStorage.removeItem("ddate");
                localStorage.removeItem("update");
                localStorage.removeItem("rid");
                if (response.status == 1) {
                  Swal.fire({
                    title: "success",
                    text: response.message,
                    icon: "success",
                  }).then(function () {
                    window.location.href = url + "calenderorder";
                  });
                } else {
                  Swal.fire({
                    title: "error",
                    text: response.message,
                    icon: "error",
                    closeOnConfirm: true,
                  }).then(function () {
                    window.location.href = url + "calenderorder";
                  });
                }
              });
            }
            else {
              Swal.fire({
                title: "error",
                text: "Quantity remains unchanged. Order not updated.",
                icon: "error",
                closeOnConfirm: true,
              });
            }
          }
        } else {
          Swal.fire({
            title: "error",
            text: "Not enough balance",
            icon: "error",
            closeOnConfirm: true,
          });

        }
      });
    });
  }

}

