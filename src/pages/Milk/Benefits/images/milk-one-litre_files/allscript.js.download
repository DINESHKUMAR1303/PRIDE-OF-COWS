 }
 function validateNumber(value) {
  value = value.replace(/\s+/g, '');
  value = value.replace(/[^0-9\W]/g, '');

  if (value.length > 0 && value[0] === '0') {
      value = value.substring(1); // Remove the leading 0
  }
  const validPattern = /^[1-9]\d{9}[\W]{0,2}$/;

  const specialCharIndex = value.search(/[\W]/);
  if (specialCharIndex !== -1) {
      value = value.substring(0, specialCharIndex + 2);
  } else if (value.length > 10) {
      value = value.substring(0, 10); // Restrict to 10 digits
  }

  const inputField = document.getElementById('regpnumber');
  inputField.value = value;
}

// comma saperated ammount
function formatAmount(amount, locale = 'en-IN') {
  return amount.toLocaleString(locale);
}

// commas separated indian rs 
document.addEventListener("DOMContentLoaded", function () {
  function formatAmounts() {
    document.querySelectorAll('.indRs').forEach(el => {
      // Keep digits and decimal point, remove everything else
      const rawValue = el.textContent.replace(/[^\d.]/g, ''); 

      if (rawValue === '0') {
        el.textContent = "0"; // Keep 0 as it is
      } else if (!isNaN(rawValue) && rawValue.trim() !== '') {
        // Format the number with ₹ and commas
        el.textContent = "₹ " + Number(rawValue).toLocaleString('en-IN');
      }
    });
  }

  // Reformat if any content changes (handles dynamic updates)
  // const observer = new MutationObserver(formatAmounts);
  // observer.observe(document.body, { childList: true, subtree: true, characterData: true });

});
function btnSubscribe(ele) {
  if($(".deliveryPlan--once").is(":visible")){
    $(".deliveryPlan--once").hide();
    $(".new_buynew").removeClass("active");
    localStorage.setItem('currVlaue', 1);
    $("#itemQuantity").val(1)
    $(".prodQntSet").text('1');
  }
  if (!window.originalParent) {
    window.originalParent = $("#quntityContainerData").parent();
  }
  if ($("#quntityContainerData").parent()[0] !== $(".subscribeQuntity")[0]) {
    $(".subscribeQuntity").append($("#quntityContainerData"));
    $("#itemQuantity").val(1)
  } else {
    $(window.originalParent).append($("#quntityContainerData"));
    // checkCartStatusAndBindHandler();
  }
  $("#quntityContainerDataParent").toggleClass("hide");

  $(".productInner__left.js-top").css("transform", "translateY(0px)")
  var userdata = localStorage.getItem("userdata");
  $(ele).toggleClass("active");
  $(".footer .go-top").toggleClass("up-lift");
  $("#subscribe-section").toggle(); 
  if(!$(".qntyOfPlans").is(":visible")){
    $(".qntyOfPlans").show();
  }else if($(".btnPlanType.btn.active").attr("data-plan") === "custom"){
    $(".qntyOfPlans").hide();
  }
  gaEvent({
    "event": "subscribe_btn_toggle", 
    "custId": userdata?.UserID,
    "product_id" : localStorage.getItem("pid"),
    "product_name" : localStorage.getItem("name"),
  });
}

function handleSubscription(){
  try {
    Swal.fire({
      html: `<div class="d-flex" > <img src="${weburl}/images/circular-loader.gif" alt="Loading..." style="width:15%; margin : auto" loading="lazy" /> </div>`,
       background: 'transparent',
      allowOutsideClick: false,
      allowEscapeKey: false,
      showConfirmButton: false
  });
    $(".subscribeNow").prop("disabled", true);
    let userData = JSON.parse(localStorage.getItem("userdata") || null)
    if(!userData?.token){
      showRegister();
      return;
    }
    let errorMsg = "";
   
    const deliveryPlan = $(".btnPlanType.btn.active").attr("data-plan");
    const productId = localStorage.getItem("pid");
    const quantity = $("#itemQuantity").val();
    const subscriptionType = deliveryPlan
    let startDate = $("#startDate").val();
    let tempDate = new Date(startDate);
    
    if(quantity < 1){
      errorMsg = "Please add minimum 1 quantity"
    } 
    
    let subscriptionFrequency = Array(7).fill(quantity).join(",");
    if(subscriptionType === "alternate"){
      subscriptionFrequency = `alternate,${quantity}`
      startDate = $("#alternateStartDate").val();
    }else if(subscriptionType === "custom"){
      startDate = $("#customStartDate").val();
      subscriptionFrequency = JSON.parse(localStorage.getItem("customDays"));
      subscriptionFrequency.push(subscriptionFrequency.shift());
      subscriptionFrequency = subscriptionFrequency.join(",");
    }
    if(!errorMsg && !startDate){
      errorMsg = "Please select a start date"
    } 
    tempDate.setDate(tempDate.getDate() + 15);
    if(!errorMsg && new Date(startDate) > tempDate ){
      errorMsg = "Start Date must be within 15 days from today"
    }else if(!errorMsg && subscriptionType === "custom" && !/^(?!0+$)[0-9]+$/.test(subscriptionFrequency.replaceAll(",", ""))){
      errorMsg = "Please select at least one day of the week"
    }else if(!errorMsg && !(userData?.pincode && userData?.FirstName && userData?.flat_plot_no && userData?.building_name)){
      errorMsg = "Please fill in your address details"
      $("#add-address-btn")
    }
    if(errorMsg){
      Swal.fire({
        position: "top-end",
        icon: "error",
        title: errorMsg,
        showConfirmButton: false,
        timer: 2500,
      });
      $(".subscribeNow").prop("disabled", false);
      return;
    }
    const poc_addresid = localStorage.getItem("selectedAddressId");
    var settings = {
      url: baseurl + "create-subscription",
      method: "POST",
      headers: {
        "Content-Type": "application/json",
        ...(userData?.token ? { Authorization: "Bearer " + userData?.token } : {}),
      },
      data: JSON.stringify({
        subscriptionType: subscriptionType,
        subscriptionFrequency,
        productId : parseInt(productId),
        subscriptionStart : startDate,
        current_balance: localStorage.getItem("balance") ?? "0",
        billingAddressId: poc_addresid,
        deliveryAddressId : poc_addresid,
        addressId: poc_addresid
      }),
    };
    $.ajax(settings).done(function (resp) {
      if (resp.status == 1) {
        $("#subscription-modal").addClass("show-topmodal");
        $("#modal-start-date").text(`Start Date : ${document.querySelector(".startDate-input").innerHTML}`);
      } else {
          Swal.fire({
            position: "top-end",
            icon: "error",
            title: resp.message,
            showConfirmButton: false,
            timer: 2500,
          });
      }
      Swal.close();
      $(".subscribeNow").prop("disabled", false);
        gaEvent({
        "event": "subscription_done", 
        "custId": userData?.UserID,
        "product_id" : localStorage.getItem("pid"),
        "product_name" : localStorage.getItem("name"),
        "price" : localStorage.getItem("price"),
        "start_date": startDate,
        "currency": "INR",
        "totalPrice": Number(localStorage.getItem("totalPriceItem")),
        "delivery_plan": subscriptionType,
        "subscriptionFrequency" : subscriptionFrequency,
        "quantity_per_day": quantity,
      });
    }).fail(()=>{
      Swal.fire({
          position: "top-end",
          icon: "error",
          title: "Something went wrong please try again leter",
          showConfirmButton: false,
          timer: 2500,
      });
  }).always(()=>$(".subscribeNow").prop("disabled", false)); 
  
} catch (error) {
  Swal.fire({
    position: "top-end",
    icon: "error",
    title: "Something went wrong please try again leter",
    showConfirmButton: false,
    timer: 2500,
  });
  $(".subscribeNow").prop("disabled", false);
}
}

function handleAddAddress(event, isSubscriptionalbleProduct){
  if(isSubscriptionalbleProduct){
    localStorage.setItem("isSubscriptionalbleProduct", true);
  }
  const user_data = localStorage["userdata"] ? JSON.parse(localStorage["userdata"]) : {};
  if(!user_data["token"]){
          showRegister(event)
          return;
      }
      if(user_data.pincode == null || user_data.FirstName == null || user_data.flat_plot_no == null || user_data.building_name == null || user_data.pincode == '' || user_data.FirstName == '' || user_data.flat_plot_no == '' || user_data.building_name == ''){
          var register = document.querySelector(".register");
          var register__step1 = document.querySelector(".register__step1");
          var register__step2 = document.querySelector(".register__step2");
          var register__step3 = document.querySelector(".register__step3");
          register.classList.add("open");
          register__step1.classList.add("hidden");
          register__step2.classList.add("hidden");
          register__step3.classList.remove("hidden");
          var pincodeInput = document.querySelector(".reg3pincode");
          if(user_data.pincode == 0 && user_data.pincode < 6 && user_data.pincode == null ) {
          pincodeInput.removeAttribute('readonly'); 
          }
          if(user_data.pincode !== null) {
          $('.reg3pincode').val(user_data.pincode);
          checkpincodereregister(user_data.pincode);
          }
          if(user_data.FirstName != null) {
          $('.reg3fname').val(user_data.FirstName);
          }
          if(user_data.LastName != null) {
          $('.reg3lname').val(user_data.LastName);
          }
          if(user_data.flat_plot_no != null) {
          $('.reg3flatn').val(user_data.flat_plot_no);
          }
          if(user_data.building_name != null) {
          $('.reg3regadd1').val(user_data.building_name);
          }
          if(user_data.street_road != null) {
          $('.reg3regadd2').val(user_data.street_road);
          }
          if(user_data.Email != null) {
          $('.reg3email').val(user_data.Email);
          }
          if(user_data.landmark != null) {
          $('.reg3reglocality').val(user_data.landmark);
          } 
      }
          
}

function findIndex(arr, num) {
  let index = arr.indexOf(num);
  if (index === -1) {
    let nearestGreater = arr.reduce((a, b) => new Date(a).getTime() > new Date(b).getTime() ? a : b);
    return nearestGreater;
    }
    return index;
}

const getNearestWalletAmount = (amount, walletAmounts = DEFAULT_WALLET_AMOUNTS) => {
  const sortedAmounts = [...walletAmounts].sort((a, b) => a - b);  

  for (let i = 0; i < sortedAmounts.length; i++) { 
    if (amount <= sortedAmounts[i]) {
      return sortedAmounts[i];
    }
  }

  return amount; 
};

