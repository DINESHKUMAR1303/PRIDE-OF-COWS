        closeOnConfirm: true,
      });
    }
  }
}
var totalPriceOfAllProducts = 0;
function addProductsCal(ProdID, date, prodImg, prodName, prodPrice, prodUnit) {

  var viewportWidth = $(window).width();
  if (viewportWidth <= 768) {
    if ($('#quantityMob_' + ProdID).length > 0) {
      return;
    }

    // MOBILE container append
    $('.addprd_left').append(`
      <div class="explore-added-products-container pidcal${ProdID} prod_items_count">
        <div class="explore-added-products-flex-container make-flex gap-10">
          <div class="img-holder-added-product">
            <img src="${prodImg}" alt="${prodName}">
          </div>
          <div class="content-added-explore">
            <p class="content-added-heading">${prodName}</p>
            <div class="quantity-flex-container-explore make-flex">
              <p>${prodUnit}</p>
              <p class="add-amountt second">₹${prodPrice}</p>
            </div>
            <div class="flex-increment-decrement power-controller-quantity make-flex align-center gap-10">
              <p class="decrementMob decrease" data-id="${ProdID}" data-date="${date}" style="cursor:pointer;">-</p>
              <p class="number-of" id="quantityMob_${ProdID}">1</p>
              <p class="power-increment incrementMob increase" data-id="${ProdID}" data-date="${date}" style="cursor:pointer;">+</p>
            </div>
          </div>
        </div>
      </div>
    `);

  } else {
    if ($('#quantity_' + ProdID).length > 0) {
      return;
    }

    // WEB container append
    $('.addprd_right').append(`
      <div class="explore-added-products-container mobilecalendar pidcal${ProdID} prod_item_add_count">
        <div class="explore-added-products-flex-container make-flex gap-10">
          <div class="img-holder-added-product">
            <img src="${prodImg}" alt="${prodName}">
          </div>
          <div class="content-added-explore">
            <p class="content-added-heading">${prodName}</p>
            <div class="quantity-flex-container-explore make-flex">
              <p>${prodUnit}</p>
              <p class="add-amountt first">₹${prodPrice}</p>
            </div>
            <div class="flex-increment-decrement power-controller-quantity make-flex align-center gap-10">
              <p class="decrementWeb decrease" data-id="${ProdID}" data-date="${date}" style="cursor:pointer;">-</p>
              <p class="number-of" id="quantity_${ProdID}">1</p>
              <p class="power-increment increase incrementWeb" data-id="${ProdID}" data-date="${date}">+</p>
            </div>
          </div>
        </div>
      </div>
    `);
  }

  // Only add 1 to cart when first adding the product
  addToCartProduct(ProdID, date, 1);
  $(".no-orders-flex-conatiner").hide();
  showUpdateOrderBtn();
  // INCREMENT WEB - Only increment by 1
  $(document).off("click", `.incrementWeb[data-id='${ProdID}']`).on("click", `.incrementWeb[data-id='${ProdID}']`, function () {
    let $qty = $(`#quantity_${ProdID}`);
    let currentQty = parseInt($qty.text());
    let newQty = currentQty + 1;
    $(this).addClass("pointernone");
    $qty.text(newQty);
    // addToCartProduct(ProdID, date, newQty, 'increment');
    updateCartQuantity(ProdID,newQty);
    updateCartCount();
    showUpdateOrderBtn();
  });

  // DECREMENT WEB - Only decrement by 1
  $(document).off("click", `.decrementWeb[data-id='${ProdID}']`).on("click", `.decrementWeb[data-id='${ProdID}']`, function () {
    let $qty = $(`#quantity_${ProdID}`);
    let currentQty = parseInt($qty.text());
    let newQty = currentQty - 1;

    if (newQty <= 0) {
      $(`.pidcal${ProdID}`).remove();
      addToCartProduct(ProdID, date, newQty, 'remove');
    } else {
      $qty.text(newQty);
      $(this).addClass("pointernone");
      updateCartQuantity(ProdID,newQty);
    }
    updateCartCount();
    showUpdateOrderBtn();
  });

  // INCREMENT MOB - Only increment by 1
  $(document).off("click", `.incrementMob[data-id='${ProdID}']`).on("click", `.incrementMob[data-id='${ProdID}']`, function () {
    let $qty = $(`#quantityMob_${ProdID}`);
    let currentQty = parseInt($qty.text());
    let newQty = currentQty + 1;
    $qty.text(newQty);

    // $(this).addClass("pointernone");
    addToCartProduct(ProdID, date, 1, 'increment');
    updateCartCount();
    showUpdateOrderBtn();
  });

  // DECREMENT MOB - Only decrement by 1
  $(document).off("click", `.decrementMob[data-id='${ProdID}']`).on("click", `.decrementMob[data-id='${ProdID}']`, function () {
    let $qty = $(`#quantityMob_${ProdID}`);
    let currentQty = parseInt($qty.text());
    let newQty = currentQty - 1;

    if (newQty <= 0) {
      $(`.pidcal${ProdID}`).remove();
      addToCartProduct(ProdID, date, 0, 'remove');
    } else {
      $qty.text(newQty);
      // $(this).addClass("pointernone");
      addToCartProduct(ProdID, date, -1, 'decrement');
    }
    updateCartCount();
    showUpdateOrderBtn();
  });

  let $cartImage = $(".cart_image");
  $("#notifier").css("display", "");
  let $newImage = $(`<img class="cart__imgg" id="imgID${ProdID}" src="${prodImg}" alt="cart new image">`);
  $cartImage.append($newImage);
  $newImage.css({ transform: "translateY(-40px)", opacity: 0 })
    .animate({ opacity: 1 }, 300, function () {
      $(this).css("transform", "translateY(0)");
    });

  updateImageVisibility();
  updateCartCount();
}
function updateCartCount() {
  let cartItem = $(".prod_items_count").length;
  $(".cart_item").html(`${cartItem} ITEM${cartItem > 1 ? "S" : ""} <br>Added`);
}
function updateImageVisibility() {
  let $cartImage = $(".cart_image");
  let images = $cartImage.children();
  if (window.innerWidth <= 768) {
    if (images.length === 0) {
      $("#notifier").hide();
    } else {
      $("#notifier").show(); 
    }
  }
  images.each(function (index) {
      if (index < images.length - 3) {
          $(this).css({
              width: "18px",
              opacity: "0",
              transition: "all 0.3s ease",
          });
      } else {
          $(this).css({
              width: "50px",
              opacity: "1",
              transition: "all 0.3s ease",
          });
      }
  });
}

function removeCartItem(ProdID) {
  $(`#imgID${ProdID}`).remove();
  updateCartCount();
  updateImageVisibility();
}
{/* <div>
<button class="btn-ok addToCartBtn" id="addBtn_${ProdID}" onclick="addToCartProd(${ProdID},'${date}','${prodImg}','${prodName}',${prodPrice})" style="padding: 8px 20px; background-color: #2C3E50; color: white; border: none; border-radius: 15px; cursor: pointer;">Add</button>
</div>
<div>
<button class="btn-ok addToCartBtn" id="addBtnMob_${ProdID}" onclick="addToCartProd(${ProdID},'${date}','${prodImg}','${prodName}',${prodPrice})" style="padding: 8px 20px; background-color: #2C3E50; color: white; border: none; border-radius: 15px; cursor: pointer;">Add</button>
</div>
*/}
$(document).on('click', '.couponPopUp__close', function () {
  let container = $(this).closest('.prod-container')
  let pid = container.attr("class").split(" ")[1].match(/\d+/g)
  let prod_id = null;
  let classList = container.attr("class").split(" ");
  classList.forEach(cls => {
    let match = cls.match(/^pidcal(\d+)$/);
    if (match) {
      prod_id = match[1];
    }
  });
  let imagEle = $(`#imgID${pid}`)
  if (prod_id) {
    getCartIdByProductId(prod_id)
      .then(cartID => {
        removeFromCart(cartID);
      })
      .catch(error => {
        console.error("Failed to remove cart item:", error);
      });
  };
  if(imagEle.is(":first-child")){
    imagEle.next().removeAttr("style");
  }
  imagEle.remove();
  container.remove();
  var arr = $('.prodcounts').map((i, e) => e.value).get();
  var arrmob = $('.prodcountsmob').map((i, e) => e.value).get();
  Checkdivisions();
  if (arr.length === 0) {
    $('.webchkt').hide();
  }
  if (arrmob.length === 0) {
    $('.mobchkt').hide();
  }
  let productID=Number(pid)
  removeCartItem(productID)
});

async function Checkdivisions() {
  if ($(window).width() < 768) {
    var arr = $('.prodcountsmob').map((i, e) => e.value).get();
  } else {
    var arr = $('.prodcounts').map((i, e) => e.value).get();
  }
  const totalPriceOfAllProducts = await fetchcartdata(arr);
  var walletBalance = localStorage.getItem("balance");

  var userdata = localStorage.getItem("userdata");
  const data = JSON.parse(userdata);
  const cust_type = data.customer_type;

  // display:none property will be add
  $('.pro_to_checkout').html(`
${cust_type == "prepaid" && walletBalance < totalPriceOfAllProducts ? `
<span class="info webchkt" onclick="adjustOrderInstruction()" id="infoIcon" style="display:none"> <img src="${url}../images/info.svg" alt="pencil icon"></span> 
<button class="btn-checkout chkt adj-btn webchkt" onclick="adjustOrderModal()" style="display:none;">Adjust</button>` : ''}
<button class="btn-checkout chkt webchkt" onclick="window.location.href='../customer/checkout'">Checkout</button>

`);

  $('.pro_to_checkout_mob').html(`
${cust_type == "prepaid" && walletBalance < totalPriceOfAllProducts ? `
<span class="infoo mobchkt" onclick="adjustOrderInstruction()" id="infoIcon" style="display:none"> <img src="${url}../images/info.svg" alt="pencil icon"></span>
<button class="btn-checkout chkt adj-btn mobchkt" onclick="adjustOrderModal()" style="display:none;">Adjust</button>` : ''}
<button class="btn-checkout chkt mobchkt" onclick="showCart()" >Checkout</button>

`);
}

async function incrementWeb(quantityId) {
  var quantityInput = $('#' + quantityId);
  var currentValue = parseInt(quantityInput.val());
  var newValue = currentValue + 1;
  quantityInput.val(newValue).trigger('change');
  var productId = Number(quantityId.split("_")[1]);
  updateCartQuantity(productId, newValue);
}
async function decrementWeb(quantityId) {
  var quantityInput = $('#' + quantityId);
  var currentValue = parseInt(quantityInput.val());
  if (currentValue > 1) {
    var newValue = currentValue - 1;
    quantityInput.val(newValue).trigger('change');
    var productId = Number(quantityId.split("_")[1]);
    updateCartQuantity(productId, newValue);
  }
}
async function incrementMob(quantityId) {
  var quantityInput = $('#' + quantityId);
  var currentValue = parseInt(quantityInput.val());
  var newValue = currentValue + 1;
  quantityInput.val(newValue).trigger('change');
  var productId = Number(quantityId.split("_")[1]);
  updateCartQuantity(productId, newValue);
}
async function decrementMob(quantityId) {
  var quantityInput = $('#' + quantityId);
  var currentValue = parseInt(quantityInput.val());
  if (currentValue > 1) {
     var newValue = currentValue - 1;
    quantityInput.val(newValue).trigger('change');
    var productId = Number(quantityId.split("_")[1]);
    updateCartQuantity(productId, newValue);
  }
}
