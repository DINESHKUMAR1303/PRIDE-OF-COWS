          } else {
            Swal.fire({
              position: "top-end",
              icon: "error",
              title: response.message,
              showConfirmButton: false,
              timer: 2500,
            });
          }
        })
        .fail(function () {
          Swal.fire({
            position: "top-end",
            icon: "error",
            title: "Something Went Wrong",
            showConfirmButton: false,
            timer: 2500,
          });
        });
