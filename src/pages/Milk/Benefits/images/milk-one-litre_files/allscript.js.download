function saveUpdateProfile() {
  $('#submitProfileDetails').hide();
  $('#cancelProfileDetails').hide();
  $('.black-overlay').show();
  $("#fname1").prop("readonly", true);
  $("#email1").prop("readonly", true);
  $("#lname1").prop("readonly", true);
  $("#gender1").prop("readonly", true);
  $("#dob").prop("readonly", true);
  var userdata = localStorage.getItem('userdata', userdata);
  var addressid = localStorage.getItem('addressid', addressid);
  const value = JSON.parse(userdata);
  var token = value.token;
  var Id = value.Id;
  var UserID = value.UserID;
  var dob = value.dob;
  var gender = value.gender;

  //window.location.href = url + "";

  var firstname = $("#fname1").val();
  var lastname = $("#lname1").val();
  var mobile_number = $("#pnumber1").val();
  var emailid = $("#email1").val();
  var dob = $("#dob").val();
  var gender = $("#gender1").val();

  if (firstname === "") {
    Swal.fire({
      position: "top-end",
      icon: "error",
      title: "Please fill firstname",
      showConfirmButton: false,
      timer: 2500,
    });
    return false;
  }
  if (lastname === "") {
    Swal.fire({
      position: "top-end",
      icon: "error",
      title: "Please fill lastname",
      showConfirmButton: false,
      timer: 2500,
    });
    return false;
  }
  if (email === "") {
    Swal.fire({
      position: "top-end",
      icon: "error",
      title: "Please fill email",
      showConfirmButton: false,
      timer: 2500,
    });
    return false;
  }
  var emailVal = $("#email1").val();
  var pattern = /^\b[A-Z0-9._%-]+@[A-Z0-9.-]+\.[A-Z]{2,4}\b$/i;

  if (!pattern.test(emailVal)) {
    Swal.fire({
      position: "top-end",
      icon: "error",
      title: "Please enter a valid email(xyz@gmail.com)",
      showConfirmButton: false,
      timer: 2500,
    });
    return false;
  }

  var settings = {
    url: baseurl + "profileupdate",
    method: "POST",
    timeout: 0,
    headers: {
      "Content-Type": "application/json",
      Authorization: "Bearer " + token,
    },
    data: JSON.stringify({
      FirstName: firstname,
      LastName: lastname,
      Email: emailid,
      cust_id: UserID,
      dob: dob,
      gender: gender,
    }),
  };

  $.ajax(settings).done(function (response) {
    $(".black-overlay").hide();
    // console.log(response);
    if (response.status == 1) {
      // Disable editing for fields which should be edited only on "Edit Profile"
      // setTimeout(function () {
      //   $("#subscripid").text(response.data.FirstName + " " + response.data.LastName);
      // }, 100);
      // start address popup
      const payloadNew  = { ...value, FirstName: firstname, LastName: lastname, Email: emailid, dob: dob};
      localStorage.setItem("userdata", JSON.stringify(payloadNew));
      var settingRegister = {
        url: baseurl + "register",
        method: "POST",
        headers: {
              "Content-Type": "application/json",
        },
        data: JSON.stringify(payloadNew)
      }
      $.ajax(settingRegister).done(function (response) { 
          return false;
      })
      // end address popup

      Swal.fire({
        title: "success",
        text: response.message,
        icon: "success",
        closeOnConfirm: true,
      });
       location.reload();
    } else {
      Swal.fire({
        title: "error",
        text: response.message,
        icon: "error",
        closeOnConfirm: true,
      });
    }
  });
}
function updateorder(values) {
  var userdata = localStorage["userdata"]
    ? JSON.parse(localStorage["userdata"])
    : {};

  if (userdata) {
    var token = userdata.token;
    if (values && parseInt(values.qty) !== parseInt(values.oqty || 0)) {
      // Use moment.js to format the date to YYYY-MM-DD
      let formattedDate = values.date;
      if (values.date) {
        // Try to parse with moment.js (handles "13 Oct, 2025", "13 Oct", etc.)
        let m = moment(values.date, ["DD MMM, YYYY", "DD MMM YYYY", "DD MMM"], true);
        if (m.isValid()) {
          // If year is missing, use current year
          if (!/(\d{4})$/.test(values.date)) {
        m.year(new Date().getFullYear());
          }
          formattedDate = m.format("YYYY-MM-DD");
        }
      }

      var settings = {
        url: baseurl + "updateorder",
        method: "POST",
        timeout: 0,
        headers: {
          Authorization: "Bearer " + token,
          "Content-Type": "application/json",
        },
        data: JSON.stringify({
          Date: formattedDate,
          id: values.pid,
          Quantity: values.qty,
          custid: userdata.UserID,
          addressId: poc_addressID,            
          orderDispatchId: values.dispatchid, 
        }),
      };
      $.ajax(settings).done(function (response) {
        if (response.status == 1) { 
          Swal.fire({
            icon: "success",
            title: response.message,
            showConfirmButton: false,
            timer: 3500,
          });
          location.reload();
        } else {
          Swal.fire({
            text: response.message,
          }).then(function () {
            window.location.href = url + "calenderorder";
          });
        }
      });
    }
  }
}
function padTo2Digits(num) {
  return num.toString().padStart(2, '0');
}

function formatDate(date) {
  return [
    padTo2Digits(date.getDate()),
    padTo2Digits(date.getMonth() + 1),
    date.getFullYear(),
  ].join('-');
}

var newUpdatedQty;
var newQtyEdit;

function editCalOrder(ProdID, date, oldQty, isGhost, productName) {
  var userdata = localStorage.getItem('userdata');
  const data = JSON.parse(userdata);
  var token = data.token;
  var UserID = data.UserID;
  var city = data.city_id;
  var customer_type = data.customer_type;

  var settings = {
    "url": baseurl + "productlist",
    "method": "POST",
    "timeout": 0,
    "headers": {
      "Authorization": "Bearer " + token,
      "Content-Type": "application/json",
    },
    "data": JSON.stringify({
      "City": city,
      "UserID": UserID,
      "IsSubscribe": 0,
      "pre_launch": 2
    }),
  };

  $.ajax(settings).done(function (response) {
    var product = response.data.find(product => product.id === ProdID);
    if (product) {
      var productPrice = product.price;
      $.ajax(settings).done(function (response) {

        $(".calEditOrder").html(`
            <div class="swal2-container swal2-center swal2-backdrop-show">
                <div aria-labelledby="swal2-title" aria-describedby="swal2-html-container" class="smallpop swal2-popup swal2-modal swal2-overflow swal2-show" tabindex="-1" role="dialog" aria-live="assertive" aria-modal="true">
                  <div class="couponPopUp__close">
                    <svg width="30" height="30" viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <circle cx="11" cy="11" r="10" fill="#2C3E50" stroke="#2C3E50"></circle>
                        <path d="M14.3327 14.3332L7.66602 7.6665M14.3327 7.6665L7.66602 14.3332" stroke="#ffffff" stroke-linecap="round"></path>
                    </svg>
                  </div>       
                    <img class="swal2-image" style="display: none;">
                    <h2 class="swal2-title" id="swal2-title" style="display: block;">Are you sure want to update the order ?</h2>
                    <div class="number" style="display: flex; justify-content: center; margin-top: 10px;">
                        <span class="minus" style="cursor:pointer; border: 1px solid #aaa; border-radius: 4px; padding-left: 10px;padding-right: 10px; background-color: #eee; margin-right:10px;padding-top:4px">-</span>
                        <input type="text" id="newQtyInput" value="${oldQty}" style="width: 50px; text-align: center; font-size: 26px; border:1px solid #ddd; border-radius:4px; display: inline-block; vertical-align: middle;" readonly>
                        <span class="plus" style="cursor:pointer; border: 1px solid #aaa; border-radius: 4px;  padding-left: 10px;padding-right: 10px; padding-top:4px; background-color: #eee;margin-left:10px">+</span>
                    </div>
                    <div class="btn-container" style="margin-top: 20px; display: flex; justify-content: center;">
                    <button class="btn-ok" onclick="updateCalOrder(${ProdID},'${date}',${oldQty},${productPrice})" style="margin-right: 10px; padding: 10px 20px; background-color: #2C3E50; color: white; border: none; border-radius: 4px; cursor: pointer;">Update Order</button>

                    </div>
                </div>
            </div>`);

            
        $(document).on('click', '.couponPopUp__close', function () {
          $(this).closest('.swal2-container').remove();
          var arr = $('.prodcounts').map((i, e) => e.value).get();
          var arrmob = $('.prodcountsmob').map((i, e) => e.value).get();

          if (arr.length === 0) {
            $('.webchkt').hide();
          }
          if (arrmob.length === 0) {
            $('.mobchkt').hide();
          }

        });

        $(document).ready(function () {
          $('.minus').click(function () {
            var $input = $(this).parent().find('input');
            var count = parseInt($input.val()) - 1;
            count = count < 1 ? 1 : count;
            $input.val(count);
            newUpdatedQty = count;
            $input.change();
            toggleButtons(oldQty);
            return false;
          });

          $('.plus').click(function () {
            var $input = $(this).parent().find('input');
            $input.val(parseInt($input.val()) + 1);
            newUpdatedQty = parseInt($input.val());
            $input.change();
            toggleButtons(oldQty);
            return false;
          });
        });
      })
      //  added display:none property to adjust button
      function toggleButtons(oldQty) {
        var newquantity = newUpdatedQty - oldQty;
        var walletBalance = localStorage.getItem("balance");
        var totalAmount = newquantity * productPrice;
        if (newUpdatedQty > oldQty && customer_type == 'prepaid' && walletBalance < totalAmount) {
          $(".btn-container").html(`
                  <button class="btn-ok" onclick="updateCalOrderCheckout(${ProdID},'${date}',${oldQty},${productPrice})" style="margin-right: 10px; padding: 10px 20px; background-color: #2C3E50; color: white; border: none; border-radius: 4px; cursor: pointer;">Update Order</button>
                  <button class="btn-ok" onclick="calEditOrderAdjustModal(${ProdID},${productPrice},${oldQty},'${date}')" style="margin-right: 10px; padding: 10px 20px; background-color: #2C3E50; color: white; border: none; border-radius: 4px; cursor: pointer;">Adjust Order</button> 
              `);
        } else {
          $(".btn-container").html(`
                  <button class="btn-ok" onclick="updateCalOrderCheckout(${ProdID},'${date}',${oldQty},${productPrice}, ${isGhost},  '${productName}')" style="margin-right: 10px; padding: 10px 20px; background-color: #2C3E50; color: white; border: none; border-radius: 4px; cursor: pointer;">Update</button>
              `);
        }
      }
    } else {
      //  console.log('Product not found');
    }
  });
}


