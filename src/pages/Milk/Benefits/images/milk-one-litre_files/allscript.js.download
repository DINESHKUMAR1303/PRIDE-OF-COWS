function getproductDetailChurn(pid, slug) {
  localStorage.churnstatus = 1;
  localStorage.setItem("pid", pid);
  var userdata = localStorage["userdata"] ? JSON.parse(localStorage["userdata"]) : 0;
  //userdata);
  if (userdata == 0) {
    $("#showmodal").click();
  } else {
    window.location.href = weburl + slug;
  }
}
function checkchurn() {
  localStorage.removeItem("crurncount");
  if (localStorage.churnstatus == 1) {
    localStorage.removeItem("cart");
    localStorage.removeItem("offercart");
    localStorage.removeItem("churnstatus");
    localStorage.crurncount = 1;
    $('.samew[data-plan="once"]').hide();
    $('.qntyOfPlans').hide();
    $('.deliveryPlan--daily .col-6:nth-of-type(2)').hide();
    $('.deliveryPlan--alternate .col-6:nth-of-type(2)').hide();
    $('.deliveryPlan--daily .col-6:nth-of-type(1)').removeClass('col-6').addClass('col-12');
    $('.deliveryPlan--alternate .col-6:nth-of-type(1)').removeClass('col-6').addClass('col-12');
  }
}
function convertToDMY(dateString, days) {
  const date = new Date(dateString);
  date.setDate(date.getDate() + days); // Add days
  const day = date.getDate();
  const month = date.getMonth() + 1;
  const year = date.getFullYear();
  const formattedDate = `${day}/${month}/${year}`;
  return formattedDate;
}
function checkuserlocaladdress() {
  var userdata = (localStorage["userdata"]) ? JSON.parse(localStorage["userdata"]) : {};
  if (userdata) {
    var token = userdata.token;
    var UserID = userdata.UserID;

    var settings = {
      "url": baseurl + "userlocaladdress",
      "method": "POST",
      "timeout": 0,
      "headers": {
        "Content-Type": "application/json",
        "Authorization": "Bearer " + token,
      },
      "data": JSON.stringify({
        "Customer_ID": UserID,
      }),
    };
    $.ajax(settings).done(function (response) {
      if (response.status == 1) {
        if (userdata.flat_plot_no != response.data.flat_plot_no && response.data.flat_plot_no != '') {
          userdata.flat_plot_no = response.data.flat_plot_no;
        }
        if (userdata.building_name != response.data.building_name && response.data.building_name != '') {
          userdata.building_name = response.data.building_name;
        }
        if (userdata.street_road != response.data.street_road && response.data.street_road != '') {
          userdata.street_road = response.data.street_road;
        }
        if (userdata.landmark != response.data.landmark && response.data.landmark != '') {
          userdata.landmark = response.data.landmark;
        }
        if (userdata.pincode != response.data.pincode && response.data.pincode != '') {
          userdata.pincode = response.data.pincode;
        }
        if (userdata.city_id != response.data.city && response.data.city != '') {
          userdata.city_id = response.data.city;
        }
        localStorage.setItem("userdata", JSON.stringify(userdata));
        // viewAddress();
      }   
    });
  }
}

