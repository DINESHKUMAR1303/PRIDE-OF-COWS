                                              <a onclick="addnewdata(${value.id})" ><img src="${url}../images/pencil.svg" alt="pencil icon"></a>
  
                                              <a onclick="deletedata(${value.id})" ><img class="addDelete" data-id="405" src="${url}../images/delete.svg" alt="delete icon"></a>
                                          </div>
