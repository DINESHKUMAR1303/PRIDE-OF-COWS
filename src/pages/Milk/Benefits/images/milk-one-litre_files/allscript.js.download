function deletedata(ids) {
  //window.location.href = url + "addressbook";
  var userdata = localStorage.getItem("userdata", userdata);
  var data = JSON.parse(userdata);
  var token = data.token;
  // var Id = data.Id;
  var UserId = data.UserId;
  //var addressid = localStorage.setItem('addressid', data);
  var settings = {
    url: baseurl + "addressdelete",
    method: "POST",
    timeout: 0,
    headers: {
      "Content-Type": "application/json",
      Authorization: "Bearer " + token,
