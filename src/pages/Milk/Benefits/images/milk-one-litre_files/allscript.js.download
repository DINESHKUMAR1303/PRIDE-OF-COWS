function profilePage() {
  $(".black-overlay").show();
  var userdata = localStorage["userdata"]
    ? JSON.parse(localStorage["userdata"])
    : {};
  if (userdata) {
    token = userdata.token;
    UserID = userdata.UserID;
    // dob = userdate.dob;
    // gender = userdata.gender;
  }
  var settings = {
    url: baseurl + "profile",
    method: "POST",
    timeout: 0,
    headers: {
      "Content-Type": "application/json",
      Authorization: "Bearer " + token,
    },
    data: JSON.stringify({
      UserID: UserID,
    }),
  };

  $.ajax(settings).done(function (response) {
    $(".black-overlay").hide();
    $("#fname1").val(response.data.FirstName);
    $("#lname1").val(response.data.LastName);
    $("#pnumber1").val(response.data.MobileNo);
    $("#email1").val(response.data.Email);
    $("#dob").val(response.data.dob);
    if (response.data.gender !== null && response.data.gender !== "") {
      $("#gender1").val(response.data.gender.toLowerCase());
    }else{
       $("#gender1").val(userdata.gender.toLowerCase());
    }
    // Set the my profile Name in the left side Menu
    const { FirstName, LastName } = response.data;
    const fullName = `${FirstName?.trim() || ''} ${LastName?.trim() || ''}`.trim();
    $("#subscripid").text(fullName || "Guest");
    localStorage.setItem("profileResp", response.data.max_address_limit)

    // console.log(response);
  });
}

