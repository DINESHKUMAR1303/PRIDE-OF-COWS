// Handle click event on the footer for sending analytics
$("footer .footer__title, footer .footer__link").on("click", function (elem) {
  const clickedElemText = $(this).find("a").text();
  gaEvent({ "event": "nav_footer", "category": clickedElemText, "current_page": window.location.href });
});

//handle click event on social media instagram app for sending analytics
$(".footer__social a[href='https://www.instagram.com/prideofcowsindia/']").on("click", function (event) {
  // event.preventDefault();

  const clickedElemText = $(this).text();
  gaEvent({
    "event": "connect_instagram",
    "category": "instagram",
    "platform": "Instagram"
  });
});
var countdownInterval;
function startCountdown() {
  var smsLink = document.getElementById("resendSmsLink");
  smsLink.style.pointerEvents = "none";
  smsLink.style.color = "gray";

  var callLink = document.getElementById("resendcall");
  callLink.style.pointerEvents = "none";
  callLink.style.color = "gray";

  var countdownTimer = document.getElementById("countdownTimer");
  countdownTimer.style.color = "#ff0000ab";

  var timeLeft = 30;
  countdownTimer.innerHTML = "You can resend the OTP in " + timeLeft + " seconds.";

  // Clear any previous interval if it's running
  if (countdownInterval) {
    clearInterval(countdownInterval);
  }

  countdownInterval = setInterval(function () {
    timeLeft--;
    countdownTimer.innerHTML = "You can resend the OTP in " + timeLeft + " seconds.";

    if (timeLeft <= 0) {
      clearInterval(countdownInterval);  // Stop the countdown when time runs out
      smsLink.style.pointerEvents = "auto";
      smsLink.style.color = "#193b61";
      callLink.style.pointerEvents = "auto";
      callLink.style.color = "#193b61";
      countdownTimer.innerHTML = "";
    }
  }, 1000);
}
function stopCountdown() {
  clearInterval(countdownInterval);
  console.log("Countdown stopped manually");
}
function goNext(form) {
  var mobile = $("#regpnumber").val();
  var previousPage = window.location.href;
  localStorage.setItem('previousPage', previousPage);
  // start code of finding redirect URL Params
  const redirectParam = new URLSearchParams(window.location.search).get('redirect');
  // end code of finding redirect URL Params
  const isValidMobile = /^[0-9]{10}(\+\*)?$/.test(mobile);

  if (!isValidMobile) {
    $('#changeNumberLink').show();
    Swal.fire({
      position: "top-end",
      icon: "error",
      title: "please fill the mobile number",
      showConfirmButton: false,
      timer: 1500,
    });
    return;
  }

  if ($("input.checkbox_check").is(":checked")) {
    var otpVerified = $("#otpVerified").val();
