function checkoutaddressbookCitywise() {
  var userdata = localStorage.getItem("userdata", userdata);
  const data = JSON.parse(userdata);
  var firstname = (data.FirstName)===null?'':data.FirstName;
  var lastname = (data.LastName)===null?'':data.LastName;
  var fullname = firstname + " " + lastname;
  var landmark = (data.landmark)===null?'':data.landmark;
  var pincode = (data.pincode)===null?'':data.pincode;
  var buildingName = (data.building_name)===null?'':data.building_name;
  var flatNo = (data.flat_plot_no)===null?'':data.flat_plot_no;
  var roadName = (data.street_road)===null?'':data.street_road;
  var city = (data.City)===null?'':data.City;

  $('.fname').html(fullname);
  $('.buildingdetail').html(flatNo + ' ' + buildingName + ' ' + landmark + ' ' + roadName);
  $('.citydetail').html(pincode + ' ' + city);

}
function goHome() {
  const bannerClosed = localStorage.getItem('DwnBannerClosed');
  localStorage.clear();
  localStorage.setItem('DwnBannerClosed', bannerClosed);
  localStorage.removeItem("cart");
  localStorage.removeItem("offlinecart");
  gaEvent({ "event": "logout" });

  var settings = {
    url: url +"logout-session",
    method: "POST",
    timeout: 0,
    headers: {
      "Content-Type": "application/json",
    },
    data: JSON.stringify({}),
    success: function(response) {
      if (response.status === 'success') {
        console.log("Session cleared successfully");
      } 
    },
  };

  $.ajax(settings);

  setTimeout(function () {
    window.location.href = weburl; 
  }, 1500);
}
