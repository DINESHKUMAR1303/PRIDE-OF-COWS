function setCustomerDetails() {
  var userdata = localStorage.getItem('userdata');
  var data = JSON.parse(userdata);
  if (userdata) {
    var UserID = data.UserID;
  } else {
    var UserID = '';
  }
  var settings = {
    "url": url + "addcustomerdetails",
    "method": "POST",
    headers: {
      'Content-Type': 'application/x-www-form-urlencoded'
    },
    data: {
      'customer_id': UserID
    }
  };
  $.ajax(settings).done(function (response) {
    let resp = JSON.parse(response);
    if(!isNaN(resp.loyaltyPoints)) {
      $("#loyalty-points").removeAttr('style');
      $("#numpoints").html(resp.loyaltyPoints);
    } else {
      $("#loyalty-points").attr('style', 'display:none');
    }
  });
}
function checklogin() {
  var userdata = localStorage["userdata"]
    ? JSON.parse(localStorage["userdata"])
    : 0;
    var pathSegments = window.location.pathname.split('/');
    var lastSegment = pathSegments.pop();
  if (userdata == 0 && lastSegment !== 'offers') {
    // start code if user not login then redirect on that login page
      const searchParams = new URLSearchParams(window.location.search);
      const encodedRedirect = searchParams.get('redirect');

      if (encodedRedirect) {
        const decodedRedirect = decodeURIComponent(encodedRedirect); 
        const lastSegment = decodedRedirect.split('/').filter(Boolean).pop();
      }
      window.location.href = url + `index?login=false&redirect=${lastSegment}`;
    // end code if user not login then redirect on that login page
  }
  setCustomerDetails();
}

function hg(pid, orderDate, type, maxQty, paidproductStatus, isGhost, productName,dispatchid,sub_id) {
  $(".swal2sh")
    .html(`
    <div class="swal2-container swal2-center swal2-backdrop-show" >
        <div aria-labelledby="swal2-title" aria-describedby="swal2-html-container" class="smallpop swal2-popup swal2-modal swal2-overflow swal2-show top-swal-cal cal-width calendar_order" tabindex="-1" role="dialog" aria-live="assertive" aria-modal="true" style="display: grid;"><button type="button" class="swal2-close" aria-label="Close this dialog" style="display: none;">×</button>
            <ul class="swal2-progress-steps" style="display: none;"></ul>
            <div class="swal2-icon" style="display: none;"></div><img class="swal2-image" style="display: none;">
            <h2 class="swal2-title" id="swal2-title" style="display: block;">You will be rescheduling the selected product for the selected date?</h2>
            <div class="swal2-html-container inner-container-swal2" id="swal2-html-container" style="display: block;"><input type="date" id="new_delivery_date" name="new_delivery_date"></div>
            <input class="swal2-input" style="display: none;"><input type="file" class="swal2-file" style="display: none;">
            <div class="swal2-range" style="display: none;"><input type="range"><output></output></div><select class="swal2-select" style="display: none;"></select>
            <div class="swal2-radio" style="display: none;"></div><label for="swal2-checkbox" class="swal2-checkbox" style="display: none;"><input type="checkbox"><span class="swal2-label"></span></label><textarea class="swal2-textarea" style="display: none;"></textarea>
            <div class="swal2-validation-message" id="swal2-validation-message" style="display: none;"></div>
          ${paidproductStatus !== 1 ? `
            <div class="swal2-html-container inner-container-swal2" id="swal2-html-container2" style="display: block;">
              <ul class="d-flex align-center justify-center">
                <li>Quantity:</li>
                <li><button id='decrement'>-</button></li>
                <li><span id='newqty'>${maxQty}</span><input type='hidden' id='maxQty' value='${maxQty}'/></li>
                <li><button id='increment'>+</button></li>
              </ul>
              <div style='clear: both;'></div>
            </div>` : ''}
            <div class="swal2-actions" style="display: flex;">
              <button type="button" onclick="rescldate(${pid},'${orderDate}','${type}', ${maxQty}, ${paidproductStatus}, ${isGhost}, '${productName}', ${dispatchid}, ${sub_id})" class="ok swal2-confirm swal2-styled" aria-label="">OK</button>
              <button type="button" class="can swal2-cancel swal2-styled" aria-label="" style="display: inline-block;">Cancel</button>
            </div>
            <div class="swal2-footer" style="display: none;"></div>
            <div class="swal2-timer-progress-bar-container">
                <div class="swal2-timer-progress-bar" style="display: none;"></div>
            </div>
        </div>
    </div>`
    );
  $('.swal2-cancel').click(function () {
    $('.swal2-container').remove();
  });

  $(function () {
    var dtToday = new Date();
    dtToday.setDate(dtToday.getDate() + 2);

    var month = dtToday.getMonth() + 1;
    var day = dtToday.getDate();
    var year = dtToday.getFullYear();
    if (month < 10)
      month = '0' + month.toString();
    if (day < 10)
      day = '0' + day.toString();

    var minDate = year + '-' + month + '-' + day;

    $('#new_delivery_date').attr('min', minDate);
  });

    // ✅ Increment–Decrement
  $(document).off("click", "#increment").on("click", "#increment", function () {
    let qty = parseInt($("#newqty").text(), 10);
    if (qty < maxQty) {
      $("#newqty").text(qty);
    }
  });

  $(document).off("click", "#decrement").on("click", "#decrement", function () {
    let qty = parseInt($("#newqty").text(), 10);
    if (qty > 1) {
      $("#newqty").text(qty);
    }
  });

}

function addToCart1(
  ProductID,
  price,
  name,
  diffDays,
  totalPrice,
  totalPriceItem,
  main_img,
  currVlaue,
  delivery_date,
  minimum_quantity,
  taxpr
) {
  // console.log("ProductID===========data to be add in cart===>", ProductID);
  // console.log("price===========data to be add in cart===>", price);
  // console.log("name===========data to be add in cart===>", name);
  // console.log("diffDays===========data to be add in cart===>", diffDays);
  // console.log("totalPrice===========data to be add in cart===>", totalPrice);
  // console.log(
  //   "totalPriceItem===========data to be add in cart===>",
  //   totalPriceItem
  // );
  // console.log("currVlaue===========data to be add in cart===>", currVlaue);
  diffDays = Number(diffDays);
  currVlaue = Number(currVlaue);
  var result_quantity = diffDays * 0;
  var rewardprice = 0;
  localStorage.setItem("rewardprice", rewardprice);
  // localStorage.setItem('result_quantity',result_quantity);
  var quantity = $("#itemQuantity").val();
  var deliveryPlan = $(".deliveryPlan__btns .active").attr("data-plan");
  diffDays = Number(diffDays);
  currVlaue = Number(currVlaue);
  var result_quantity = diffDays * currVlaue;
  localStorage.setItem("result_quantity", result_quantity);
  localStorage.setItem("reward", "[]");
  var quantity = minimum_quantity;
  var deliveryPlan = "once";
  var startDate = delivery_date;
  var endDate = delivery_date;

  // console.log("deliveryPlan=", endDate);
  // console.log("deliveryPlan=", startDate);

  // console.log(
  //   "ProductID==>",
  //   ProductID,
  //   "quantity==>",
  //   quantity,
  //   "startDate==>",
  //   startDate
  // );
  if (ProductID && quantity && startDate) {
    var Productcart = localStorage.getItem("reward", Productcart);
    // console.log("Productcart===", Productcart);
    if (Productcart === "null" || Productcart === 0) {
      var myArray = {};
      // console.log("cart========>", Productcart);
      const myData = {
        ProductId: ProductID,
        Quantity: quantity,
        Price: price,
        DeliveryPlan: deliveryPlan,
        StartDate: startDate,
        EndDate: endDate,
        RepeatMonthly: 1,
        Name: name,
        diffDays: diffDays,
        totalPrice: totalPrice,
        totalPriceItem: totalPriceItem,
        main_img: main_img,
        currVlaue: currVlaue,
        taxprice: taxpr,
      };
      myArray.push(myData);
      localStorage.setItem("reward", JSON.stringify(myArray));
    } else {
      // console.log("Productcart===else");
      const myData = {
        ProductId: ProductID,
        Quantity: quantity,
        Price: price,
        DeliveryPlan: deliveryPlan,
        StartDate: startDate,
        EndDate: endDate,
        RepeatMonthly: 1,
        Name: name,
        diffDays: diffDays,
        totalPrice: totalPrice,
        totalPriceItem: totalPriceItem,
        main_img: main_img,
        currVlaue: currVlaue,
        taxprice: taxpr,
      };
      var data = JSON.parse(Productcart);
      var data = $.grep(data, function (e) {
        return e.ProductId != ProductID;
      });
      data.push(myData);
      // console.log("data->>", data);
      localStorage.setItem("reward", JSON.stringify(data));
    }
  } else {
    Swal.fire({
      position: "top-end",
      icon: "error",
      title: "Please Select the Data",
      showConfirmButton: false,
      timer: 2500,
    });
  }
  showRewardCart();
}


function rescldate(pid, orderDate, type, maxQty,paidproductStatus=0, isGhost, productName, dispatchid,sub_id) {
  var qty;
  if (paidproductStatus === 1) {
    qty = maxQty;
  } else {
      qty = parseInt($('#newqty').html()); 
  }

  if(isNaN(qty)) {
    Swal.fire({
      position: "center",
      icon: "error",
      title: "Please enter a numeric value",
      showConfirmButton: false,
      timer: 2500,
    });
    return;
  }
  if(qty > maxQty) {
    Swal.fire({
      position: "center",
      icon: "error",
      title: "Please enter a value less than or equal to " + maxQty,
      showConfirmButton: false,
      timer: 2500,
    });
    return;
  }
  if(qty < 1) {
    Swal.fire({
      position: "center",
      icon: "error",
      title: "Please enter a value greater than 0",
      showConfirmButton: false,
      timer: 2500,
    });
    return;
  }
  var resDate = $("#new_delivery_date").val();
  
  if (resDate === orderDate) {
    Swal.fire({
      position: "top-end",
      icon: "error",
      title: "You cannot reschedule on the same day.",
      showConfirmButton: false,
      timer: 2500,
    });
    return;
  }
  var currentTime = new Date();
  var year = currentTime.getFullYear();
  var month = currentTime.getMonth() + 1;
  var day = currentTime.getDate();
  if (month < 10) {
    month = '0' + month;
  }
  if (day < 10) {
    day = '0' + day;
  }
  var currentDate = year + '-' + month + '-' + day;

  if (resDate > orderDate || resDate > currentDate) {
    var userdata = localStorage["userdata"] ? JSON.parse(localStorage["userdata"]) : {};
    if (userdata) {
      var userIDs = userdata.UserID;
      var token = userdata.token;
      var rurl = type == 'offerreschedule' ? "offerresheduleorder" : "resheduleorder";
      if (isGhost) {
        manageGhostOrder({ action: 'resheduleGhostOrder', productName, oldDate: orderDate, sub_id });
      } else {
        var settings = {
          url: baseurl + rurl,
          method: "POST",
          timeout: 0,
          headers: {
            "Content-Type": "application/json",
            Authorization: "Bearer " + token
          },
          data: JSON.stringify({
            Date: orderDate,
            nDate: resDate,
            id: pid,
            cust_id: userIDs,
            qty: qty,
            orderDispatchId:dispatchid,
            addressId:poc_addressID,
            sub_id:sub_id
          }),
        };
        
        $.ajax(settings).done(function (response) {
          if (response.status == 1) {
            localStorage.removeItem("ddate");
            localStorage.removeItem("update");
            localStorage.removeItem("rid");
            Swal.fire({
              title: "success",
              text: "Your order rescheduled successfully",
              icon: "success",
              closeOnConfirm: true,
            }).then(function () {
              window.location.href = url + "calenderorder";
            });
          }
          else {
            localStorage.removeItem("ddate");
            localStorage.removeItem("update");
            localStorage.removeItem("rid");
            localStorage.removeItem("rstatus");
  
            Swal.fire({
              // title: "success",
              // text: "Your order rescheduled successfully",
              // icon: "success",
              // closeOnConfirm: true,
              title: "Error",
              text: response.message,
              icon: "error",
              closeOnConfirm: true,
            }).then(function () {
              window.location.href = url + 'calenderorder';
            });
          }
        });
      }
    }
  } else if (resDate < orderDate || resDate <= orderDate) {
    Swal.fire({
      position: "top-end",
      icon: "error",
      title: "Your date must be greater than the currentdate ",
      showConfirmButton: false,
      timer: 2500,
    });
  }
}

