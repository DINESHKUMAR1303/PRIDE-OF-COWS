function deleteorder(pid, date, isGhost, productName, dispatchid,sub_id) {
  var userdata = localStorage["userdata"]
    ? JSON.parse(localStorage["userdata"])
    : {};
  if (userdata) {
    var token = userdata.token;
    // Format date -> 02 Feb, 2025
    let formattedDate = new Date(date).toLocaleDateString("en-GB", {
      day: "2-digit",
      month: "short",
      year: "numeric"
    });

    Swal.fire({
      html: `
        <div class="swal-cancelorder-box">
          <img src="../frontend/web/images/cancel-order-popup-img.png" class="swal-cancelorder-img" />
          <h2 class="swal-cancelorder-title">Cancel Order</h2>
          <p class="swal-cancelorder-text">Are you sure you want to cancel the delivery on</p>
          <p class="swal-cancelorder-date">${formattedDate}</p>
        </div>
      `,
      showConfirmButton: true,
      showDenyButton: true,
      confirmButtonText: "Cancel Order",
      denyButtonText: "Don't Cancel",
      customClass: {
        popup: "swal-cancelorder-popup",
        confirmButton: "swal-cancelorder-confirmbtn",
        denyButton: "swal-cancelorder-denybtn",
        actions: "swal-cancelorder-actions"
      },
      buttonsStyling: false
    }).then((result) => {
      if (result.isConfirmed) {
        if(isGhost){
          manageGhostOrder({action : "cancelGhostOrder", productName, oldDate : date,sub_id})
        }else{
          var settings = {
            url: baseurl + "deleteorder",
            method: "POST",
            timeout: 0,
            headers: {
              Authorization: "Bearer " + token,
              "Content-Type": "application/json",
            },
            data: JSON.stringify({
              Date: date,
              id: pid,
              userId: userdata.UserID,
              orderDispatchId:dispatchid,
              addressId:poc_addressID,
              sub_id:sub_id
            }),
          };

          $.ajax(settings).done(function (response) {
            localStorage.removeItem("ddate");
            localStorage.removeItem("update");
            localStorage.removeItem("rid");
          });
        }

        Swal.fire("Cancelled Successfully!", "", "success");
        window.location.href = url + "calenderorder";
      }
    });
  }
}
function signupform() { 
 
var userdata = localStorage["userdata"]
        ? JSON.parse(localStorage["userdata"])
        : {};
if (userdata) { 
        var pincode = $("#pincode").val();
        var city = $("#city_id").val();
        var firstname = $("#fname").val();
        var lastname = $("#lname").val();
        var gender = $("#gender").val();
        var email = $("#email").val();
        var tower = $("#regadd1").val();
        var house = $("#flatn").val();
        var address = $("#regadd1").val();
        var roadname = $("#regadd2").val();
        var landmark = $("#reglocality").val();
        var refrealCode = $("#refered_code").val();

    if (firstname === "") {
      Swal.fire({
        position: "top-end",
        icon: "error",
        title: "Please fill firstname",
        showConfirmButton: false,
        timer: 2500,
      });
      return false;
    }
    if (lastname === "") {
      Swal.fire({
        position: "top-end",
        icon: "error",
        title: "Please fill lastname",
        showConfirmButton: false,
        timer: 2500,
      });
      return false;
    }
    if (email === "") {
      Swal.fire({
        position: "top-end",
        icon: "error",
        title: "Please fill email",
        showConfirmButton: false,
        timer: 2500,
      });
      return false;
    }
    var emailVal = $("#email").val();
    var pattern = /^\b[A-Z0-9._%-]+@[A-Z0-9.-]+\.[A-Z]{2,4}\b$/i;

        if (!pattern.test(emailVal)) {
                Swal.fire({
                        position: "top-end",
                        icon: "error",
                        title: "Please enter a valid email(xyz@gmail.com)",
                        showConfirmButton: false,
                        timer: 2500,
                });
                return false;
        }
        if (pincode === "") {
                Swal.fire({
                        position: "top-end",
                        icon: "error",
                        title: "Please fill pincode",
                        showConfirmButton: false,
                        timer: 2500,
                });
                return false;
        }
        if (city === "") {
                Swal.fire({
                        position: "top-end",
                        icon: "error",
                        title: "Please fill city",
                        showConfirmButton: false,
                        timer: 2500,
                });
                return false;
        }
        if (roadname === "") {
          Swal.fire({
            position: "top-end",
            icon: "error",
            title: "Please fill road name",
            showConfirmButton: false,
            timer: 2500,
          });
          return false;
        }
        if (house === "") {
          Swal.fire({
            position: "top-end",
            icon: "error",
            title: "Please fill flat no",
            showConfirmButton: false,
            timer: 2500,
          });
          return false;
        }
        if (address === "") {
          Swal.fire({
            position: "top-end",
            icon: "error",
            title: "Please fill building",
            showConfirmButton: false,
            timer: 2500,
          });
          return false;
        }
      
        var settings = {
                url: baseurl + "register",
                method: "POST",
                headers: {
                        "Content-Type": "application/json",
                },
                data: JSON.stringify({
                        FirstName: firstname,
                        LastName: lastname,
                        Gender: gender,
                        Email: email,
                        Tower: tower,
                        Flatno: house,
                        Address: address,
                        Landmark: landmark,
                        UserId: userdata.UserID,
                        Pincode: pincode,
                        City: city,
                        Referral: refrealCode,
                }),
        };
        var userdatas = localStorage.getItem("userdata", userdatas);
        var datalayer = JSON.parse(userdatas);
        try {
                window.dataLayer = window.dataLayer || [];
                dataLayer.push({
                        event: "register_successfull",
                        first_name: firstname,
                        last_name: lastname,
                        mobile: datalayer.MobileNo,
                        email: email,
                });
        } catch (err) {

    }
    // console.log("====>register", window.dataLayer, firstname, lastname);
    $('#registerotp').attr('disabled', 'disabled');
    $.ajax(settings).done(function (response) {
      $('#registerotp').removeAttr('disabled');
      if (response.status == 1) {
        Swal.fire({
          position: "top-end",
          icon: "success",
          title: "Registered Successfully",
          showConfirmButton: false,
          timer: 2500,
        });
        localStorage["userdata"] = JSON.stringify(response.data);
        if (parseInt(loginpageindex) === 0) {
          setTimeout(() => {
            window.location.href = url + "wallet?walletoffer=1";
          }, 1000);
        } else {
          availoffer();
        }
      } else {
        Swal.fire({
          position: "top-end",
          icon: "error",
          title: "Something went wrong.",
          showConfirmButton: false,
          timer: 2500,
        });
      }
    });
  }
}

async function reregister() {
  const userdata = localStorage.getItem("userdata")
    ? JSON.parse(localStorage.getItem("userdata"))
    : {};
  if (!userdata) return;

  // Helper: Clear all previous error styles/messages
  function clearErrors() {
    $(".poc_form-input").removeClass("input-error");
    $(".field-error-msg, .error-message").remove();
  }

  // Helper: Show specific error on field
  function showError(fieldId, message) {
    const $field = $(`#${fieldId}`);
    $field.addClass("input-error");
    if ($field.next(".error-message").length === 0) {
      $field.after(`<div class="error-message">${message}</div>`);
    }
  }

  // Clear all existing errors before validating again
  clearErrors();

  // Get values
  const firstname = $("#reg3fname").val().trim();
  const lastname = $("#reg3lname").val().trim();
  const gender = $("#reg3gender").val();
  const phoneNo = $("#reg3mobile").val().trim();
  const email = $("#reg3email").val().trim();
  const flatno = $("#reg3flatn").val().trim();
  const building = $("#reg3regadd1").val().trim();
  const roadname = $("#reg3regadd2").val().trim();
  const landmark = $("#reg3reglocality").val().trim();
  const state = $("#reg3state_name").val();
  const city = $("#reg3city_id").val();
  const pincode = $("#reg3pincode").val().trim();
  let addressType = $('input[name="poc_addressType"]:checked').val();
  if (addressType === "other") {
    addressType = $("#poc_otherInput").val().trim();
  }
  addressType = addressType;
  // const addressType = $('input[name="poc_addressType"]:checked').val();
  const deliveryInstruction = userdata.delivery_instruction_type || "";

  let isValid = true;

  if (firstname === "") {
    showError("reg3fname", "Please enter first name");
    isValid = false;
  }

  if (lastname === "") {
    showError("reg3lname", "Please enter last name");
    isValid = false;
  }
  
  if (phoneNo === "") {
    showError("reg3mobile", "Please enter mobile number");
    isValid = false;
  } else if (!/^[0-9]{10}$/.test(phoneNo)) {
    showError("reg3mobile", "Please enter a valid mobile number (exactly 10 digits, numbers only)");
    isValid = false;
  }
  const inst= localStorage.getItem("instructionsVisible")
  if(inst == true){
    if (!deliveryInstruction) {
      Swal.fire({
        position: "top-end",
        icon: "error",
        title: "Please select a delivery instruction",
        showConfirmButton: false,
        timer: 2500
      });
      return false;
    }
  }
  if (email === "") {
    isValid = true;
  } else {
    const emailPattern = /^\b[A-Z0-9._%-]+@[A-Z0-9.-]+\.[A-Z]{2,}\b$/i;
    if (!emailPattern.test(email)) {
      showError("reg3email", "Please enter a valid email (e.g. xyz@gmail.com)");
      isValid = false;
    }
  }

  if (flatno === "") {
    showError("reg3flatn", "Please enter flat number");
    isValid = false;
  }

  if (building === "") {
    showError("reg3regadd1", "Please enter building name");
    isValid = false;
  }
  const selectedGender = $("input[name='gender']:checked").val();
  if (!selectedGender) {
    // Show error after the gender-buttons container
    if ($(".gender-buttons").next(".error-message").length === 0) {
      $(".gender-buttons").after('<div class="error-message" style="color:red;font-size:12px;">Please select Gender</div>');
    }
    isValid = false;
  } else {
    $(".gender-buttons").next(".error-message").remove();
    $("#reg3gender").val(selectedGender);
  }

  if (roadname === "") {
    showError("reg3regadd2", "Please enter Street/Area name");
    isValid = false;
  }

  if (pincode === "") {
    showError("reg3pincode", "Please enter pincode");
    isValid = false;
  } else if (pincode.length < 6) {
    showError("reg3pincode", "Pincode must be 6 digits");
    isValid = false;
  }

  if (city === "") {
    showError("reg3city_name", "Please select a city");
    isValid = false;
  }

  if (landmark === "") {
    showError("reg3reglocality", "Please enter landmark");
    isValid = false;
  }
  if (addressType === "") {
    showError("poc_otherInput", "Please enter address type");
    isValid = false;
  }


  if (!isValid) return;
  // Validate pincode via API
  // const pincodeCheck = await $.ajax({
  //   url: baseurl + "allstatecity",
  //   method: "POST",
  //   headers: {
  //     "Content-Type": "application/json",
  //   },
  //   data: JSON.stringify({ pincode }),
  // });

  // if (pincodeCheck?.status == 0) {
  //   showError("reg3pincode", "Not a valid pincode");
  //   $("#reg3pincode").val("");
  //   return;
  // }

  $(".poc_save-address-btn").prop("disabled", true)             // Disable the button
    .css({
      background: "#eee",
      opacity: 0.6,
      cursor: "not-allowed",
      color: "#999",
    });

  const location = await getLocationAsync();
  var latt = location.latitude;
  var long = location.longitude;

  localStorage.setItem("lat", latt)
  localStorage.setItem("lng", long)
  // const mobileNo = userdata.MobileNo;

  // Prepare registration data
  const payload = {
    FirstName: firstname,
    LastName: lastname,
    Gender: gender,
    Email: email,
    Tower: building,
    Flatno: flatno,
    Address: building,
    Roadname: roadname,
    Landmark: landmark,
    UserId: userdata.UserID,
    Pincode: pincode,
    City: city,
    AddressType: addressType,
    State_name: state,
    Latitude: localStorage.getItem("lat"),
    Longitude: localStorage.getItem("lng"),
    mobile_number: phoneNo,
    delivery_option: deliveryInstruction,
  };

  console.log(payload,"payload")
  // return false;

  // DataLayer push
  try {
    const datalayer = JSON.parse(localStorage.getItem("userdata"));
    window.dataLayer = window.dataLayer || [];
    dataLayer.push({
      event: "register_successfull",
      first_name: firstname,
      last_name: lastname,
      mobile: datalayer.MobileNo,
      email: email,
    });
  } catch (e) {}

  // $("#registerotp").attr("disabled", true);
  
  const token = userdata.token;
  // Final Register API Call
  $.ajax({
    url: baseurl + "register",
    method: "POST",
    headers: {
      Authorization: "Bearer " + token,
      "Content-Type": "application/json",
    },
    data: JSON.stringify(payload),
  }).done(function (response) {
    $("#registerotp").removeAttr("disabled");

    if (response.status == 1) {
      // Merge response.data into existing userdata, but keep token unchanged
      const existingUserdata = localStorage["userdata"] ? JSON.parse(localStorage["userdata"]) : {};
      const mergedUserdata = {
        ...existingUserdata,
        ...response.data,
        token: existingUserdata.token,
        customer_type: existingUserdata.customer_type
      };
      localStorage["userdata"] = JSON.stringify(mergedUserdata);

      const userdetails = localStorage.getItem("userdata");
      const user_data = userdetails ? JSON.parse(userdetails) : {};
      var getPin = user_data.pincode;
      localStorage.setItem("userPincode", getPin);
      if (
        Object.keys(user_data).length !== 0 &&
        user_data.city_id !== null &&
        parseInt(user_data.city_id) !== 0 &&
        parseInt(response.data.city_id) !== 0
      ) {
        var city_id = user_data.city_id;
        localStorage.removeItem("offercart");
        const poc_addresid = localStorage.getItem("selectedAddressId");

        const token = user_data.token;
        $.ajax({
          url: baseurl + "productlist",
          method: "POST",
          headers: {
            Authorization: "Bearer " + token,
            "Content-Type": "application/json",
          },
          data: JSON.stringify({
            IsSubscribe: 0,
            pre_launch: 2,
            addressId: poc_addresid,
            City: city_id
          }),
        }).done(function (response) {
          if (response.status == 1 && response.data) {
            const availableProducts = response.data;
            const cartprod = JSON.parse(localStorage.cart || "[]");

            if (cartprod) {
              updateCartWithProducts(cartprod, availableProducts).then(
                (updatedCart) => {
                  localStorage.setItem("cart", JSON.stringify(updatedCart));
                  if (Array.isArray(updatedCart) && updatedCart.length !== 0) {
                    setTimeout(() => {
                      const path = window.location.pathname;
                      const lastSegment = path.split("/").filter(Boolean).pop();
                      if (lastSegment === "checkout") {
                        location.reload();
                      }
                    }, 3000);
                  }
                }
              );
            }
          } else {
            localStorage.removeItem("cart");
          }
        });

        $("#overlay").fadeIn();
        setTimeout(() => {
          productdetails("all");
          $("#overlay").fadeOut();
        }, 6000);
      } else {
        window.location.reload();
      }
      $("#addressPopup").hide();
    } else {
      Swal.fire({
        position: "top-end",
        icon: "error",
        title: "Something went wrong.",
        showConfirmButton: false,
        timer: 2500,
      });
    }
  });
}

// Get actual latitude and longitude using browser geolocation
  function getLocationAsync() {
    return new Promise((resolve) => {
      if (navigator.geolocation) {
        navigator.geolocation.getCurrentPosition(
          (position) => {
            resolve({
              latitude: position.coords.latitude,
              longitude: position.coords.longitude,
            });
          },
          async () => {
          // fallback → IP-based location
          try {
            let res = await fetch("https://ipapi.co/json/");
            let data = await res.json();
            resolve({
              latitude: data.latitude,
              longitude: data.longitude,
            });
          } catch (e) {
            resolve(null);
          }
        }
        );
      } else {
       resolve(null);
      }
    });
  }

  function updateCartWithProducts(cartprod, availableProducts) {
    return new Promise((resolve) => {
        setTimeout(() => {
            const availableProductIds = new Set(availableProducts.map(p => p.id));
            const updatedCart = cartprod
            .filter(product => {
              const isAvailable = availableProductIds.has(parseInt(product.ProductId));
              if (!isAvailable) {
                  cartItemDelete(product.ProductId,1);
              }
              return isAvailable;
             })
                .map(product => {
                    const matchedProduct = availableProducts.find(p => p.id === parseInt(product.ProductId));
                    return matchedProduct ? { ...product, ...matchedProduct } : product;
                });
            resolve(updatedCart);
        }, 1000);
    });
}

