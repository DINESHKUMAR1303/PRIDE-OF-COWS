          <div class="col-4">  <div class="addAddress__username">${value.token}</div> </div>
          <div class="col-3"> <div class="addAddress__username">${value.product}</div> </div>
          <div class="col-3"> <div class="addAddress__line">${value.status}</div> </div>
          <div class="col-2"> 
          <div class="checkout__cart__viewOffers text-blue pointer" onclick="RaisedTicketModalOpen('${value.cust_id}', '${value.token}');"><b>View Details</b></div>
          </div>
          </div>           
          </div>
          <div class="addAddress__bottom w-100"></div>
        </div>
        <div class="couponPopUp">
          <div class="overlay couponPopUp__overlay"></div>
          <div class="couponPopUp__inner">
            <div class="couponPopUp__inner__box goldenborder" style="border: 1px solid;">
              <div class="couponPopUp__header d-flex justify-space-between">
                <h4></h4>
                <div class="couponPopUp__close pointer" onclick="RaisedTicketModalClose()">
                  <svg width="22" height="22" viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <circle cx="11" cy="11" r="10" fill="#F2F2F2" stroke="#919191"></circle>
                    <path d="M14.3327 14.3332L7.66602 7.6665M14.3327 7.6665L7.66602 14.3332" stroke="#919191" stroke-linecap="round"></path>
                  </svg>
                </div>
              </div>
              <div class="couponPopUp__body customScroll">
                <h4 class="couponPopUp__availableText">Request Details</h4>
                <div id="ticketDetails"></div>
              </div>
            </div>
          </div>
        </div>
        
                `);
        } else {
          console.error("Date or status is undefined for value:", value);
        }
      });
    }
  });
}

function RaisedTicketModalOpen(UserID, token_no) {
  $("#ticketDetails").html("");

  var couponPopUp = document.querySelector(".couponPopUp");
  couponPopUp.classList.add("open");
  // console.log("Opening details modal");

  var userdata = localStorage.getItem("userdata", userdata);
  const data = JSON.parse(userdata);
  var city = data.city;
  var isSubscribe = 0;
  var token = data.token;
  var UserID = data.UserID;

  var settings = {
    url: baseurl + "myrequest-details",
    method: "POST",
    timeout: 0,
    headers: {
      "Content-Type": "application/json",
      Authorization: "Bearer " + token,
    },

    data: JSON.stringify({
      cust_id: UserID,
      token_no: token_no,
    }),
  };

  $.ajax(settings)
    .done(function (response) {

      if (
        response &&
        response.data.date &&
        response.data.status !== undefined
      ) {
        const replyMessages = response.data.reply;
        let replyMessage = '';
        $.each(replyMessages, function (index, reply) {
          replyMessage += `
              ${reply.message};
          `;
        });
        const replyDates = response.data.reply;
        let replyDate = '';
        $.each(replyDates, function (index, reply) {
          replyDate += `
            ${reply.date};
        `;
        });
        // const replyDate = response.data.reply[0].date;
        // const replyMessage = response.data.reply[0].message;
        $("#ticketDetails").append(`
        <div class="addAddress__box  d-flex justify-space-between bg-white">
          <div class="addAddress__top w-100 d-flex justify-space-between">
            <div class="addAddress__top__left d-flex">
              <div class="addAddress__top__left">
                <h4>Ticket ID: ${response.data.token}</h4>
                <h5>${response.data.date}</h5>
              </div>
            </div>                 
          </div>
          <div class="addAddress__body">
          <div class="row">
             <div class="col-3">
             <div class="addAddress__username">Product Name:</div>
             </div>
             <div class="col-7">
             <div class="addAddress__line">Message: </div>
             </div>
             <div class="col-2">
             <div class="addAddress__line">Status:</div> 
             </div>
          </div>
            <div class="row">
            <div class="col-3">
            <div class="addAddress__username">${response.data.product}</div>
            </div>
            <div class="col-7">
            <div class="addAddress__line"> ${response.data.message}</div>
            </div>
            <div class="col-2">
            <div class="addAddress__line">${response.data.status}</div> 
            </div>
        </div>
          <div class="addAddress__line"><h3>Replies:-</h3></div>
          <div class="addAddress__line">Message: ${replyMessage}</div>
          <div class="addAddress__line">Date: ${replyDate}</div>
          <div class="addAddress__line">Replied By: Customer Executive</div> 
     
        </div>
                                                                             
          </div>
          <div class="addAddress__bottom w-100"></div>
        </div>
      `);
      } else {
        console.error("Date or status is undefined for value:", response);
      }
    })
}

function RaisedTicketModalClose() {
  var couponPopUp = document.querySelector(".couponPopUp");
  couponPopUp.classList.remove("open");
  // console.log("Closing details modal");
}
function beginCheckout() {
  var Cart = localStorage.getItem('cart', Cart);
  var data = JSON.parse(Cart);
  var items = [];
  var totalItemPrice = 0;
  if (data) {
    try {
      for (var i in data) {
        totalItemPrice += data[i]['totalPriceItem'];
        var qty = parseInt(data[i]['totalPrice']) / parseInt(data[i]['Price']);
        items.push({
          item_id: data[i]['ProductId'],
          item_name: data[i]['Name'],
          item_brand: "Pride Of Cows",
          item_category: data[i]['category_prod'],
          item_variant: data[i]['unit_prod'],
          quantity: qty,
          price: Number(data[i]['Price'])
        });
      }
      var jsonEvent = {
        event: "begin_checkout",
        ecommerce: {
          items: items,
          currency: "INR",
          value: Number(totalItemPrice)
        }
      };
      gaEvent(jsonEvent);
    } catch (err) {

    }
  }
}
