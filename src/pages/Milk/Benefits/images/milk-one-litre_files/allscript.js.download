});

function offerdetailstab(type, id, redirect) {
  var userdata = localStorage.getItem("userdata", userdata);
  const data = JSON.parse(userdata);
  var city = data.city_id;
  var token = data.token;
  var UserID = data.UserID;
  if (type == "product") {
    getproductDetail(id);
  } else if (type == "wallet") {
    window.location.href = url + "wallet?walletoffer=" + redirect;
  } else if (type == "999") {
    var settings = {
      url: baseUrl + "customofferdetail",
      method: "POST",
      headers: {
        "Content-Type": "application/json",
        Authorization: "Bearer " + token,
      },
      beforeSend: function () {
        $("#overlay").fadeIn();
      },
      data: JSON.stringify({
        custid: UserID,
        id: 1,
        city: city,
      }),
    };
    $.ajax(settings).done(function (response) {
      if (response) {
        availofferlink(response.min_payment);
      }
    });
  }
}

