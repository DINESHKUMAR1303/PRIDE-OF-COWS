    if (otpVerified == "") {
      event.preventDefault();
      var frm = $(".login-form");
      var data = frm.serialize();
      var settings = {
        url: baseUrl + "login",
        method: "POST",
        timeout: 0,
        headers: {
          "Content-Type": "application/json",
          'Access-Control-Allow-Origin': '*'
        },
        data: JSON.stringify({
          MobileNo: mobile,
          Source: "Desktop",
          Type: "login",
        }),
      };

      $.ajax(settings)
        .done(function (response) {
          stopCountdown();
          // start campaign login
          var cartdataLogin = localStorage.getItem("offlinecart") || "[]";
          var cartdataNewLogin = JSON.parse(cartdataLogin);
          var productQtyStringLogin = cartdataNewLogin
          .map(function (item) {
          return item.ProductId + ':' + item.Quantity;
          })
          .join(',');
          submitCampaignDetails(CAMPAIGN_EVENTS.CATEGORY_Login, productQtyStringLogin);
          // end campaign login
          if (response.status == 0) {
            gaEvent({
              'event': 'otp_request',
              'previous_page': previousPage
            });
            if (response.new) {
              var settings = {
                url: baseUrl + "login",
                method: "POST",
                timeout: 0,
                headers: {
                  "Content-Type": "application/json",
                },
                data: JSON.stringify({
                  MobileNo: mobile,
                  Source: "Desktop",
                  Type: "signup",
                }),
              };

              $.ajax(settings).done(function (resp) {
                stopCountdown();
                if (resp.status == 1) {
                  startCountdown();

                  verifyOtpBtn.style.pointerEvents = "auto";
                  verifyOtpBtn.style.opacity = 1;
                  $('#changeNumberLink').show();
                  localStorage.loginval = 1;
                  gaEvent({
                    'event': 'sign_up',
                    'mobile': mobile
                  });
                  // start campaign registraion
                  submitCampaignDetails(CAMPAIGN_EVENTS.CATEGORY_Registration);
                  // end campaign registration
                }
                // new user loged show verify OTP div
                otpDiv.classList.remove("hidden");
                sentOtpBtn.textContent = "verify otp";
                verifyOtpBtn.textContent = "Verify OTP";
                $("#otpVerified").val("0");
              });
            } else {
              // too many attempts error
               Swal.fire({
                position: "top-end",
                icon: "error",
                title: response.message,
                showConfirmButton: false,
                timer: 3500,
              });
              verifyOtpBtn.style.pointerEvents = "auto";
              verifyOtpBtn.style.opacity = 1;
              $("#regpnumber").removeAttr("disabled");
            }
          } else if (response.status == 1) {
            startCountdown();

            verifyOtpBtn.style.pointerEvents = "auto";
            verifyOtpBtn.style.opacity = 1;
            $('#changeNumberLink').show();
            otpDiv.classList.remove("hidden");
            // form.innerHTML = "verify otp";
            gaEvent({
              'event': 'otp_request',
              'previous_page': previousPage
            });
            $("#verifyotp").val("Verify OTP");

            $("#otpVerified").val("1");
