function calEditOrderAdjustModal(ProdID, productPrice, oldQty, date) {

  newQty = parseInt($('#newQtyInput').val());
  if (newQty >= oldQty) {
    updatedQty = newQty - oldQty;
    totalProductsPrice = updatedQty * productPrice;
    var userdata = localStorage.getItem("userdata", userdata);
    const udata = JSON.parse(userdata);
    confirmMessage = '';
    var token = udata.token;
    var UserID = udata.UserID;

    var settings = {
      url: baseurl + "getlastcancelledorderdetails",
      method: "POST",
      timeout: 0,
      headers: {
        "Content-Type": "application/json",
        Authorization: "Bearer " + token,
      },
      data: JSON.stringify({
        cust_id: UserID,
        "amount": totalProductsPrice,
        "orderdate": date
      }),
    };

    $.ajax(settings).done(function (response) {
      statusAdjustOrder = response.status;
      if (statusAdjustOrder != 0) {
        confirmMessage = response.confirm;
        $(".calEditOrderAdjustModal").html(`
        <div class="swal2-container swal2-center swal2-backdrop-show">
        <div aria-labelledby="swal2-title" aria-describedby="swal2-html-container" class="infomodal smallpop swal2-popup swal2-modal swal2-overflow swal2-show" tabindex="-1" role="dialog" aria-live="assertive" aria-modal="true">
          <div class="couponPopUp__close" onclick="adjustEditorderModalClose()">
              <svg width="30" height="30" viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg">
                <circle cx="11" cy="11" r="10" fill="#2C3E50" stroke="#2C3E50"></circle>
                <path d="M14.3327 14.3332L7.66602 7.6665M14.3327 7.6665L7.66602 14.3332" stroke="#ffffff" stroke-linecap="round"></path>
              </svg>
          </div>
          <p> Are you sure want to cancel the order for adjustment ?</p>
          <p> ${confirmMessage}</p>
  
          <div style="margin-top: 20px; display: flex; justify-content: center;">
          <button class="btn-ok" onclick="editAdjustOrder(${ProdID},'${date}',${oldQty},${totalProductsPrice})" style="margin-right: 10px; padding: 10px 20px; background-color: #2C3E50; color: white; border: none; border-radius: 4px; cursor: pointer;">OK</button>
      </div>  
  
        </div>
      </div>
        `);
      } else {
        Swal.fire({
          icon: "error",
          title: "No items found to adjust order.",
          showConfirmButton: false,
          timer: 3500,
        }).then(() => {
          setTimeout(() => {
            location.reload();
          }, 1000);
        });
      }
    });
  } else {
    alert("Qty must be greater than ");
  }
}
function editAdjustOrder(ProdID, date, oldQty, totalProductsPrice) {

  var userdata = localStorage.getItem("userdata", userdata);
  const data = JSON.parse(userdata);
  var token = data.token;
  var UserID = data.UserID;

  var settings = {
    url: baseurl + "getlastcancelledorderdetails",
    method: "POST",
    timeout: 0,
    headers: {
      "Content-Type": "application/json",
      Authorization: "Bearer " + token,
    },
    data: JSON.stringify({
      cust_id: UserID,
      "amount": totalProductsPrice,
      "cancelstatus": 1,
      "orderdate": date
    }),
  };

  $.ajax(settings).done(function (response) {

    if (response.status == 1) {
      updateCalOrder(ProdID, date, oldQty);

      setTimeout(() => {
        location.reload();
      }, 2500);
      Swal.fire({
        icon: "success",
        title: response.message,
        timer: 2500,
      }).then(() => {
        window.location.href = url + "calenderorder";
      });
    } else {
      Swal.fire({
        icon: "error",
        title: response.message,
        showConfirmButton: false,
        timer: 1500,
      }).then(() => {
        setTimeout(() => {
          location.reload();
        }, 1000);
      });
    }
  });

}
