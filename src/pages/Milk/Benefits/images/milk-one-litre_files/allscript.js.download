function setaddress(addId) {
  localStorage.addId = addId;

  Swal.fire({
    title: "Address Selected",
    text: "Address Selected",
    icon: "success",
    closeOnConfirm: true,
  });
}

function packagemasterone() {
  var cartdata1 = localStorage.getItem("cart");
  // console.log("cartdata1===>", cartdata1);
  if (!cartdata1) {
    return false;
  }
  var cartdata = JSON.parse(cartdata1);
  var userdata = localStorage.getItem("userdata");
  const data = JSON.parse(userdata);
  var token = data.token;
  var custId = data.UserID;
  var city = data.city;
  // console.log("cartdata===>", cartdata);
  if (!cartdata) {
    return false;
  }
  $.each(cartdata, function (i, it) {
    // console.log("CartItem===>", it);
    city = userdata.city;
    totalamount = 0;
    var totalamount = it.totalPrice;
    var newstrtdate = new Date(it.StartDate);
    var newenddate = it.EndDate;
    var cartitem =
      it.ProductId +
      ":" +
      it.Price +
      ":" +
      it.Quantity +
      ":" +
      newenddate +
      "|";

    if (it.DeliveryPlan == "daily") {
      var planNane = "everyday";
    } else {
      var planNane = it.DeliveryPlan;
    }
    var settings = {
      url: baseurl + "packagemasters",
      method: "POST",
      timeout: 0,
      headers: {
        "Content-Type": "application/json",
        Authorization: "Bearer " + token,
      },
      data: JSON.stringify({
        custId: custId,
        CartItems: cartitem,
        City: city,
        Source: "Desktop",
        TotalAmount: totalamount,
        TotalPay: "0",
        maxDate: newenddate,
        minDate: newstrtdate,
        subscriptionType: planNane,
        rewardId: localStorage.getItem("reward_id"),
        addressId: poc_addressID,
      }),
    };
    $.ajax(settings).done(function (response) {
      if (response.status == 1) {
        cartItemDelete(it.ProductId);
        if (window.location.origin === 'https://prideofcows.com') {
          window.location.href = "https://prideofcows.com/poc/customer/calenderorder";
        } else {
          window.location.href = url + "calenderorder";
        }
      }
    });
  });
}

function cartpricevalues(data) {
