async function addToCartProd(ProductID, startDate, prodImg, prodName, prodPrice, totalPrice) {

  jQuery(`#productId_${ProductID}`).addClass('prodclass-dyn');
  jQuery(`#productId_${ProductID}`).addClass('prodcounts');
  jQuery(`#productIdMob_${ProductID}`).addClass('prodclass-dyn-web');
  jQuery(`#productIdMob_${ProductID}`).addClass('prodcountsmob');

  var parts = startDate.split('-');
  var reformattedStartDate = parts[2] + '/' + parts[1] + '/' + parts[0];
  let quantity;
  if ($(window).width() < 768) {
    quantity = parseInt($('#quantityMob_' + ProductID).val());
  } else {
    quantity = parseInt($('#quantity_' + ProductID).val());
  }
  var totalPrice = quantity * prodPrice;


  if (ProductID && quantity && startDate) {
    $('.swal2-container').remove();
    var Productcart = localStorage.getItem("cart", Productcart);

    const userData = JSON.parse(localStorage.getItem('userdata'));
    const poc_addresid = localStorage.getItem("selectedAddressId");
    cityName = userData.city;
    var settings = {
      url: baseurl + "productdetail",
      method: "POST",
      timeout: 0,
      headers: {
        Authorization: "Bearer " + token,
        "Content-Type": "application/json",
      },
      data: JSON.stringify({
        "ProductID": ProductID,
        "city": cityName,
        "addressId": poc_addresid
      }),
    };
    $.ajax(settings).done(function (response) {
      let ratingInfo = response.data.ratingInfo;
      unitProd = response.data.product_unit;
      categoryProd = response.data.catagory;
      taxPrice = response.data.taxamount;
      deliveryPlan = "once";
      diff_days = 1;

      launchDate = response.data.launch_date || '';
      if (launchDate && launchDate.trim() !== '') {
        var date1 = reformattedStartDate.split("/");
        var newstrtdate = date1[2] + "-" + setDateZero(date1[1]) + "-" + setDateZero(date1[0]);
        var launchDateParts = launchDate.split("-");
        var formattedLaunchDate = launchDateParts[0] + "-" + launchDateParts[1] + "-" + launchDateParts[2];
        var reverseFormatedLaunch = launchDateParts[2] + "-" + launchDateParts[1] + "-" + launchDateParts[0];
        var startDateParsed = Date.parse(newstrtdate);
        var launchDateParsed = Date.parse(formattedLaunchDate);
        if (launchDateParsed > startDateParsed) {
          Swal.fire({
            text: 'Sorry this product will be available from ' + reverseFormatedLaunch,
            closeOnConfirm: true,
          })
          $('.pidcal' + ProductID).remove();
          $('.chkt').remove();
          return false;
        }
      }

      if (Productcart === null) {
        var myArray = [];
        const myData = {
          ProductId: ProductID,
          Quantity: quantity,
          Price: prodPrice,
          DeliveryPlan: deliveryPlan,
          StartDate: reformattedStartDate,
          EndDate: reformattedStartDate,
          RepeatMonthly: 0,
          Name: prodName,
          diffDays: diff_days,
          totalPrice: prodPrice,
          totalPriceItem: totalPrice,
          main_img: prodImg,
          currVlaue: quantity,
          taxprice: taxPrice,
          category_prod: categoryProd,
          unit_prod: unitProd,
          priceBeforeDiscount: response.data.priceBeforeDiscount,
          ratingInfo : ratingInfo
        };
        myArray.push(myData);
        localStorage.setItem("cart", JSON.stringify(myArray));
      } else {
        const myData = {
          ProductId: ProductID,
          Quantity: quantity,
          Price: prodPrice,
          DeliveryPlan: deliveryPlan,
          StartDate: reformattedStartDate,
          EndDate: reformattedStartDate,
          RepeatMonthly: 0,
          Name: prodName,
          diffDays: diff_days,
          totalPrice: prodPrice,
          totalPriceItem: totalPrice,
          main_img: prodImg,
          currVlaue: quantity,
          taxprice: taxPrice,
          category_prod: categoryProd,
          unit_prod: unitProd,
          ratingInfo : ratingInfo,
          priceBeforeDiscount: response.data.priceBeforeDiscount

        };
        var data = JSON.parse(Productcart);
        var data = $.grep(data, function (e) {
          return e.ProductId != ProductID;
        });
        data.push(myData);
        localStorage.setItem("cart", JSON.stringify(data));
      }

    });


  } else {
    Swal.fire({
      position: "top-end",
      icon: "error",
      title: "Please fill all the fields",
      showConfirmButton: false,
      timer: 2500,
    });
  }

  Offerproduct(startDate, startDate, "once");

  var totalQty = parseInt(totalPrice) / parseInt(prodPrice);
  try {
    var jsonEvent = {
      event: "add_to_cart",
      ecommerce: {
        items: [{
          item_id: ProductID,
          item_name: prodName,
          item_brand: "Pride Of Cows",
          item_category: categoryProd,
          item_variant: unit_prod,
          quantity: totalQty,
          price: Number(prodPrice),
        }],
        quantity_per_day: quantity,
        start_date: reformattedStartDate,
        end_date: reformattedStartDate,
        currency: "INR",
        value: Number(totalPrice),
        delivery_plan: deliveryPlan,
        booking_days: 1
      }
    };
    gaEvent(jsonEvent);
  } catch (er) {

  }
  setTimeout(() => {
    checkcartforprepaid();
  }, 1000);

}


function adjustOrderInstruction() {

  $(".adjustinstruction").html(`
  <div class="swal2-container swal2-center swal2-backdrop-show">
  <div aria-labelledby="swal2-title" aria-describedby="swal2-html-container" class="infomodal smallpop swal2-popup swal2-modal swal2-overflow swal2-show" tabindex="-1" role="dialog" aria-live="assertive" aria-modal="true">
  <div class="couponPopUp__close" onclick="adjustinstModalClose()">
      <svg width="30" height="30" viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg">
        <circle cx="11" cy="11" r="10" fill="#2C3E50" stroke="#2C3E50"></circle>
        <path d="M14.3327 14.3332L7.66602 7.6665M14.3327 7.6665L7.66602 14.3332" stroke="#ffffff" stroke-linecap="round"></path>
      </svg>
  </div>
     <p>
     If you want to adjust your order, please note that from the last possible date, your existing order will be canceled. The adjusted order will then be placed accordingly, and any remaining amount will be refunded to your wallet.
     </p>
  </div>
</div>
  `);
}
function adjustinstModalClose() {
  $(".adjustinstruction").html('');

}
function fetchcartdata(arr) {

  var Productcart = JSON.parse(localStorage.getItem("cart"));

  // console.log(Productcart);


  var secondArrayInt = arr.map(Number); // Convert elements of arr to integers

  // Filter common elements based on ProductId
  var commonElements = Productcart.filter(item => secondArrayInt.includes(item.ProductId));

  // console.log(commonElements);

  var totalAmount = commonElements.reduce((total, item) => total + (item.Quantity * item.Price), 0);

  // console.log(totalAmount);

  return totalAmount;



}
async function adjustOrderModal(typ = 0) {
  if (typ == 0) {
    var arr = $('.prodcounts').map((i, e) => e.value).get();
  } else {
    var arr = $('.prodcountsmob').map((i, e) => e.value).get();
  }
  const totalPriceOfAllProducts = await fetchcartdata(arr);
  var userdata = localStorage.getItem("userdata", userdata);
  const udata = JSON.parse(userdata);
  confirmMessage = '';
  var token = udata.token;
  var UserID = udata.UserID;

  var settings = {
    url: baseurl + "getlastcancelledorderdetails",
    method: "POST",
    timeout: 0,
    headers: {
      "Content-Type": "application/json",
      Authorization: "Bearer " + token,
    },
    'beforeSend': () => {
      try {
        $('#ok-adjust-btn').attr('disabled', 'disabled');
      } catch (err) {
        console.log(err);
      }
    },
    data: JSON.stringify({
      cust_id: UserID,
      "amount": totalPriceOfAllProducts,
    }),
  };

  $.ajax(settings).done(function (response) {
    statusAdjustOrder = response.status;
    if (statusAdjustOrder != 0) {
      confirmMessage = response.confirm;
      $(".adjustOrderModal").html(`
      <div class="swal2-container swal2-center swal2-backdrop-show">
      <div aria-labelledby="swal2-title" aria-describedby="swal2-html-container" class="infomodal smallpop swal2-popup swal2-modal swal2-overflow swal2-show" tabindex="-1" role="dialog" aria-live="assertive" aria-modal="true">
         <div class="couponPopUp__close" onclick="adjustorderModalClose()">
             <svg width="30" height="30" viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg">
               <circle cx="11" cy="11" r="10" fill="#2C3E50" stroke="#2C3E50"></circle>
               <path d="M14.3327 14.3332L7.66602 7.6665M14.3327 7.6665L7.66602 14.3332" stroke="#ffffff" stroke-linecap="round"></path>
             </svg>
         </div>
         <p> Are you sure want to cancel the order for adjustment ?</p>
         <p> ${confirmMessage}</p>
 
         <div style="margin-top: 20px; display: flex; justify-content: center;">
         <button class="btn-ok" id="ok-adjust-btn" onclick="adjustOrder(${totalPriceOfAllProducts})" style="margin-right: 10px; padding: 10px 20px; background-color: #2C3E50; color: white; border: none; border-radius: 4px; cursor: pointer;">OK</button>
     </div>  
 
      </div>
    </div>
      `);
    } else {
      Swal.fire({
        icon: "error",
        title: "No items found to adjust order.",
        showConfirmButton: false,
        timer: 3500,
      }).then(() => {
        setTimeout(() => {
          location.reload();
        }, 1000);
      });
    }
  });
}
function adjustorderModalClose() {
  $(".adjustOrderModal").html('');
}

function adjustOrder(totalPriceOfAllProducts) {

  var valuesArray = [];
  var valuesArrayWeb = [];

  $('.prodclass-dyn').each(function () {
    var value = $(this).val();
    valuesArray.push(value);
  });
  $('.prodclass-dyn-web').each(function () {
    var value = $(this).val();
    valuesArrayWeb.push(value);
  });

  if (valuesArrayWeb.length == 0) {
    Swal.fire({
      icon: "error",
      title: "No items found to adjust order.",
      showConfirmButton: false,
      timer: 2500,
    }).then(() => {
      setTimeout(() => {
        location.reload();
      }, 1000);
    });
    return;
  }
  if (valuesArray.length == 0) {
    Swal.fire({
      icon: "error",
      title: "No items found to adjust order.",
      showConfirmButton: false,
      timer: 2500,
    }).then(() => {
      setTimeout(() => {
        location.reload();
      }, 1000);
    });
    return;
  }
  var Productcart = localStorage.getItem("cart");
  Productcart = Productcart ? JSON.parse(Productcart) : [];
  ProductcartUpdated = Productcart.filter(function (item) {
    return valuesArray.includes(item.ProductId.toString());
  });

  localStorage.setItem("cart", JSON.stringify(ProductcartUpdated));

  var userdata = localStorage.getItem("userdata", userdata);
  const data = JSON.parse(userdata);
  var token = data.token;
  var UserID = data.UserID;

  var settings = {
    url: baseurl + "getlastcancelledorderdetails",
    method: "POST",
    timeout: 0,
    headers: {
      "Content-Type": "application/json",
      Authorization: "Bearer " + token,
    },
    data: JSON.stringify({
      cust_id: UserID,
      "amount": totalPriceOfAllProducts,
      "cancelstatus": 1
    }),
  };

  $.ajax(settings).done(function (response) {
    if (response.status == 1) {
      var settings = {
        url: baseUrl + "getwallet",
        method: "POST",
        headers: {
          Authorization: "Bearer " + token,
          "Content-Type": "application/json",
        },
      };
      $.ajax(settings).done(function (response) {
        if (response.status == 1) {
          localStorage.balance = response.data.balance;
          setTimeout(() => {
            ordersubmitone();
          }, 1000);
        }
      });
    } else {
      Swal.fire({
        icon: "error",
        title: response.message,
        showConfirmButton: false,
        timer: 2500,
      }).then(() => {
        setTimeout(() => {
          location.reload();
        }, 1000);
      });
    }
  });
}

function orderandsubscript() {
  var userdata = localStorage.getItem("userdata", userdata);
  const poc_addressId = localStorage.getItem("selectedAddressId");
  const data = JSON.parse(userdata);
  var token = data.token;
  var UserID = data.UserID;

  var settings = {
    url: baseurl + "orderandsubscription",
    method: "POST",
    timeout: 0,
    headers: {
      "Content-Type": "application/json",
      Authorization: "Bearer " + token,
    },
    data: JSON.stringify({
      cust_id: UserID,
      addressId: poc_addressId,
    }),
  };

  $.ajax(settings).done(function (response) {
    $("#preloader").show();
    if (response) {
      $("#preloader").css("display", "none");
      if (response.data && response.data.length > 0) {
      $.each(response.data, function (key, value) {
        if (value.status == 0) {
          var statusCol = "skyBlue";
        } else {
          var statusCol = "d-flex red";
        }
        // console.log(value);
        var fromDt = new Date(value.from_date);
        fromDt = formatDate(fromDt);

        var toDt = new Date(value.to_date);
        toDt = formatDate(toDt);
        $("#orderandsubsc").append(`
                  <div class="pOrders__box">
                  <div class="pOrders__top d-flex justify-space-between">
                      <ul class="d-flex withBullet">
                          <li class="d-flex">
                              <img src="https://prideofcows.in/poc/img/icons/calendar.svg" alt="calendar">Start Date:${fromDt} <span></span>
                          </li>
                          <li class="d-flex" >
                              <img src="https://prideofcows.in/poc/img/icons/calendar.svg" alt="calendar">End Date:${toDt} <span></span>
                          </li>
                      </ul>
                      <ul class="d-flex">
                          <li class="d-flex pr-0">
                              Order no.:POC${value.order_detail_id}${value.product_id} <span></span>
                          </li>
                      </ul>
                  </div>
                  <div class="pOrders__middle">
                      <ul>
                          <li class="d-flex pOrders__middle__top">
                              Total:${value.total_amount} <span></span>
                          </li>
                      </ul>
                      <div class="d-flex pOrders__middle__bottom align-end justify-space-between">
                          <div class="d-flex pOrders__middle__bottom__imgs sn_m_left" >${value.product_name}
                          </div>
                          <div class="cta d-flex">
                          ${value.offer_status != 1 ? `
                              <a class="d-flex" onclick="ordsubscreordproductDetail(${value.product_id},'${fromDt}','${toDt}',${value.total_amount},'${value.product_name}','${value.order_detail_id}','${value.package_name}','${value.quantity}','${value.product_price}', '${value.product_frequency}')"> reorder
                                <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <path d="M15 1.66675L17.5 4.16675L15 6.66675" stroke="#193B61" stroke-linecap="round" stroke-linejoin="round"></path>
                                    <path d="M5 18.3335L2.5 15.8335L5 13.3335" stroke="#193B61" stroke-linecap="round" stroke-linejoin="round"></path>
                                    <path d="M17.5 4.16675H8.33333C6.78624 4.16675 5.30251 4.78133 4.20854 5.87529C3.11458 6.96925 2.5 8.45299 2.5 10.0001" stroke="#193B61" stroke-linecap="round" stroke-linejoin="round"></path>
                                    <path d="M2.5 15.8333H11.6667C13.2138 15.8333 14.6975 15.2188 15.7915 14.1248C16.8854 13.0308 17.5 11.5471 17.5 10" stroke="#193B61" stroke-linecap="round" stroke-linejoin="round"></path>
                                </svg>
                              </a>
                                 ` : ''}
                          </div>
                      </div>
                  </div>

                  <div class="pOrders__bottom d-flex justify-space-between">
                      <ul class="d-flex withBullet">
                          <li class="d-flex ${statusCol}">${value.statusText}</li>
                          <li class="d-flex">
                              <img src="https://prideofcows.in/poc/img/icons/calendar.svg" alt="calendar">Next delivery on: <span></span>
                          </li>
                      </ul>
                  </div>
        </div>`);
      });
    } else {
      $("#orderandsubsc").html(`
        <div class="emptyOrderScreen mt-25">
             <div class="text-center">
             <div class="empty_order_img_container">
             <img src="../images/cartbagempty.png" alt="Empty Cart" loading="lazy" class="emptyOrderImg"/>
             </div>
             <p class="fw-bold mt-10">No Order Found!</p>
               <p>Start shopping and experience premium dairy at home.</p>
               <a class="btn" href="${weburl}shop/all">Explore more products</a>
             </div>
         </div>
        `)
        $('.pagination__orders').hide();
        $('.profile__right, .pOrders').css('margin-bottom', 'unset');
     }
    }
  });
}


