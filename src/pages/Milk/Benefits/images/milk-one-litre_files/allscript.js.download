function ordsubscreordproductDetail(pid, fromDt, toDt, total_amount, product_name, order_detail_id, package_name, quantity, product_price, product_frequency) {
  var productDetails = {
    'product_id': pid,
    'from_date': fromDt,
    'to_date': toDt,
    'total_amount': total_amount,
    'product_name': product_name,
    'order_detail_id': order_detail_id,
    'package_name': package_name,
    'quantity': quantity,
    'product_price': product_price,
    'product_frequency': product_frequency
  };
  localStorage.setItem("pid", pid);
  localStorage.setItem('reorderdetails', JSON.stringify(productDetails));
  var userdata = localStorage.getItem("userdata", userdata);
  const poc_addresid = localStorage.getItem("selectedAddressId");
  const value = JSON.parse(userdata);
  var token = value.token;
  var cityid = value.city_id;
  var settings = {
    url: baseurl + "productdetail",
    method: "POST",
    timeout: 0,
    headers: {
      "Content-Type": "application/json",
      Authorization: "Bearer " + token,
    },
    data: JSON.stringify({
      City: cityid,
      ProductID: pid,
      addressId: poc_addresid
    }),
  };
  $.ajax(settings).done(function (response) {
    if (response.status == 1) {
      window.location.href = weburl + response.data.slug;
    } else {
      window.location.href = url + "productdetail";
    }
  });
}

function citywiseallproduct() {
  var userdata = localStorage.getItem("userdata", userdata);
  var pid = localStorage.getItem("pid", pid);
  value = userdata ? JSON.parse(userdata) : {};
if (Object.keys(value).length !== 0) {
  var token = value.token;
  var UserID = value.UserID;
  var cityid = value.city_id;

  var settings = {
    url: baseurl + "citywiseproductlist",
    method: "POST",
    timeout: 0,
    headers: {
      "Content-Type": "application/json",
      Authorization: "Bearer " + token,
    },
    data: JSON.stringify({
      City: cityid,
      UserId: UserID,
      productId: pid,
      pre_launch: 2
    }),
  };

  $.ajax(settings).done(function (response) {
    // console.log(response);
    if (localStorage.getItem("userdata") !== null) {
      var userdata = localStorage["userdata"]
        ? JSON.parse(localStorage["userdata"])
        : {};
      if (
        userdata.pincode === "" &&
        (userdata.city_id === 0 ||
          userdata.FirstName === null ||
          userdata.LastName === null ||
          userdata.city_id === "")
      ) {
        event.preventDefault();
        register.classList.add("open");
        register__step1.classList.add("hidden");
        register__step2.classList.remove("hidden");
        register__step3.classList.add("hidden");
      }
    }
    setTimeout(function () {
      event.preventDefault();
      register.classList.add("open");
    }, 1500);
  });
}
}

