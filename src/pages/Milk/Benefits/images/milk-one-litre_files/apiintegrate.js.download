function handleInvitesCoupons() {
    var userdata = localStorage.getItem("userdata", userdata);
    var data = JSON.parse(userdata);
    var token = data.token;
    var settings = {
      url: baseUrl + "show-invites-and-coupons",
      method: "POST",
      headers: {
        Authorization: "Bearer " + token,
        "Content-Type": "application/json",
      },
    };

    $.ajax(settings).done(function (response) {
      if (response.status === 1) {
        // start -- add prev / current count of invites 
        const prevInviteCount = parseInt(localStorage.getItem("prevInviteCount")) || 0;
        const currentInviteCount = response.allInvites.length;
        // end -- add prev / current count of invites 
        localStorage.setItem("showinvitesres", JSON.stringify(response));
        window.inviteModalContent = response.inviteModalContent || {};
        const today = new Date().toISOString().split("T")[0];
        const lastInviteShown = localStorage.getItem("invitePopupShown");
        const lastCouponShown = localStorage.getItem("couponPopupShown");
        const showInviteToday = lastInviteShown !== today;
        const showCouponToday = lastCouponShown !== today;
        const shouldShowInvitePopup = showInviteToday && response.allInvites?.length > 0;
        const shouldShowCouponPopup = showCouponToday && !shouldShowInvitePopup && response.allCoupons?.length > 0;

        if (response.allInvites.length === 1) {
          const info = response.allInvites[0];
          window.singleInviteInfo = info;

          var userdata = localStorage.getItem("userdata", userdata);
          var data = JSON.parse(userdata);
          if (data) {
              $.ajax({
              method: 'post',
              url: baseurl + 'is-eligible-for-refer-and-earn',
              headers: {
                  Authorization: "Bearer " + data.token,
              },
              data: {},
              success: function (resp) {
                if(resp.status === 0){
                  if(!localStorage.getItem("amount")) {
                  $("#invitedsec, #walletReferearn").html(`
                    <div class="urinvitedbox d-flex justify-spc-bet align-center mb-20">
                      <div class="left-sec d-flex align-center">
                        <dotlottie-player
                          src="${lottieurl}images/referafriend.lottie"
                          background="transparent"
                          speed="1"
                          style="width: 70px; height: 50px; margin: 0 auto;"
                          autoplay>
                        </dotlottie-player>
                        <p class="text-blue fs-16 mt-0 fwb pl5">You're Invited!</p>
                      </div>
                      <div class="right-sec">
                        <button type="button" class="btn btn-transparent vwbtn text-blue mt-0" onClick="walletAmountSet(${info.login_id}, ${referNearnWalletAmount})">Apply</button>
                      </div>
                    </div>
                  `);
                  }
                }
              }
            })
          }
          if (showInviteToday) {
            showSingleInvitePopup();
            localStorage.setItem("invitePopupShown", today);
          }
        } else if (response.allInvites.length > 1) {

            $("#invitedsec, #walletReferearn").html(`
              <div class="urinvitedbox d-flex justify-spc-bet align-center mb-20">
                <div class="left-sec d-flex align-center">
                  <dotlottie-player
                    src="${lottieurl}images/referafriend.lottie"
                    background="transparent"
                    speed="1"
                    style="width: 70px; height: 50px; margin: 0 auto;"
                    loop autoplay>
                  </dotlottie-player>
                  <p class="text-blue fs-16 mt-0 fwb pl5">You're Invited!</p>
                </div>
                <div class="right-sec">
                  <button type="button" class="btn btn-transparent vwbtn text-blue mt-0" onClick="showMultiInvitePops()">View</button>
                </div>
              </div>
            `);
          // add if invites added in one day
          if (showInviteToday || currentInviteCount > prevInviteCount) {
            localStorage.setItem("invitePopupShown", today);
            const refrelinvites = response.allInvites;
              Swal.fire({
                html: `
                  <div class="custom-swal-header hmpgpop mb-10" id="adtest">
                    <div class="avatar-group">
                      <dotlottie-player
                          src="${lottieurl}images/referafriend.lottie"
                          background="transparent"
                          class="friendlottie"
                          speed="1"
                          loop autoplay>
                      </dotlottie-player>
                    </div>
                    <h2 class="swal-title text-blue">${window.inviteModalContent.title || "You're Invited!"}</h2>
                    <p class="swal-subtitle swal-text-container mb-10 text-black fs-16">
                      ${window.inviteModalContent.description || "Multiple friends have invited you. Select one to accept the invite and unlock your referral reward of ₹500."}
                    </p>
                  </div>
                  <div class="min-height" id="inviteList">
                  ${refrelinvites
                      .map((info, index) => {
                        return `
                          <div class="invotersec d-flex justify-spc-bet align-center mb-10">
                            <div class="text-left">
                              <p class="text-blue fs-14"> ${info.name}</p>
                              <p class="text-grey fs-14 mt-5 text-left">${info.login_id}</p>
                            </div>
                              ${info.login_id === localStorage.getItem("acceptedReferId") ? `<button class="btn btn-success mt-0 acceptedBtn text-gold textCam">Accepted</button>` : `<a type="button" class="btn btn-transparent text-blue mt-0 textCam" href="javascript:void(0)" onclick="handleInviteAccept(${info.login_id})">Accept</a>` }
                          </div>
                        `;
                      })
                      .join("")}
                  </div>
                  <p class="text-gold mt-10 fs-14" style="text-align:left; color:#AE8A49">
                    ${window.inviteModalContent.info || "After accepting the invite, you need complete a transaction of ₹2,000 or more to get your reward."}
                  </p>
                `,
                confirmButtonText: "Close",
                customClass: {
                  popup: "yourinvitedpopup",
                  confirmButton: "custom-accept-btn",
                },
              });
              // add latest current invites
              localStorage.setItem("prevInviteCount", currentInviteCount);
          }
        }

        // Handle Coupon Popups
        if ( shouldShowCouponPopup && response.allCoupons.length === 1) {
            const coupn = response.allCoupons[0];
            var cupncontent = response.couponModalContent

              Swal.fire({
              html: `
              <dotlottie-player
                src="${lottieurl}images/Coupon.lottie"
                background="transparent"
                speed="1"
                class="couponLottie"
                loop autoplay>
              </dotlottie-player>
              <h2 class="swal-title text-blue mt-10">${cupncontent.title}</h2>
                <p class="swal-text text-black mt-0">${coupn.invited_name} Accepted your invite.</p>
                <p class="swal-text text-black second-text">${coupn.description}</p>
                <p class="swal-text text-black fs-12 mb-0" style="color:#AE8A49"> ${cupncontent.info}</p>
              `,
              confirmButtonText: "Redeem Now",
              confirmButtonColor: "#ffffff",
              customClass: {
              popup: "custom-swal-popup",
              title: "swal-title text-blue",
              htmlContainer: "swal-text-container mt-0 mb-0",
              image: "swal-image",
              confirmButton: "swal-button",
            },
          }).then((result) => {
            if (result.isConfirmed) {
            const tempAnchor = document.createElement('a');
            tempAnchor.setAttribute('data-id', coupn.coupon_id);
            redeemreward(tempAnchor);
            }
          });
          localStorage.setItem("couponPopupShown", today);
        } else if ( shouldShowCouponPopup && response.allCoupons.length > 1) {
          const couponHtml = response.allCoupons
          
            .map(
              (cpn) => `
            <div class="invotersec d-flex justify-spc-bet align-center mb-10">
                <div class="text-left">
                    <p class="text-blue fs-14 text-left">${cpn.invited_name}</p>
                    <p class="text-grey fs-14 mt-5 text-left">${cpn.description}</p>
                </div>
                    <a type="button" class="btn btn-transparent text-gold mt-0 redmbtn" href="javascript:void(0)"
                    data-id="${cpn.coupon_id}"  
                    onclick="redeemreward(this);">Redeem Now</a>
            </div>`
            )
            .join("");

          Swal.fire({
            html: `
              <div class="custom-swal-header mulfriendpop mb-10" id="adtest">
                <div class="avatar-group">
                  <dotlottie-player
                    src="${lottieurl}images/Coupon.lottie"
                    background="transparent"
                    speed="1"
                    class="couponLottie"
                    loop autoplay>
                  </dotlottie-player>
                </div>
                <h2 class="swal-title text-blue">Your Friend Joined!</h2>
                <p class="swal-subtitle swal-text-container mb-10 text-black fs-16">
                  Multiple friends accepted your referral invite
                </p>
                <div class="swal-text text-black second-text fs-16 mb-10">Redeem your ₹500 referral reward for each!</div>
              </div>
              <div class="min-height">
                ${couponHtml}
              </div>
              <p class="text-gold mt-10 fs-14 text-left" style="color:#AE8A49;text-align:left">₹500 referral bonus will be instantly credited to your wallet.</p>
            `,
            confirmButtonText: "Close",
            customClass: {
              popup: "swal-friend-joined-popup",
              confirmButton: "custom-accept-btn",
            },
          });
          localStorage.setItem("couponPopupShown", today);
        }
      }
    });
  }

//  Show Single Invite Popup
  function showSingleInvitePopup() {
    const info = window.singleInviteInfo;
    if (!info) return;

  Swal.fire({
      html: `
        <div class="custom-swal-header choosewhopop mb-10" id="adtest">
          <div class="avatar-group">
            <dotlottie-player
                src="${lottieurl}images/referafriend.lottie"
