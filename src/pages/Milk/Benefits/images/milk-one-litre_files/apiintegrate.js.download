      //                           <div class="d-flex titleAmount">
      //                             <a href="#" class="checkoutProductName">
      //                             <h4 class="checkout__cart__title checkout__cart__text__color">${it.Name}</h4>
      //                             </a>
      //                             <div class="checkout__cart__price indRs checkout__cart__text__color">₹${it.Price} ${it.priceBeforeDiscount === null || it.priceBeforeDiscount === undefined || it.priceBeforeDiscount === 'null' ? '' : `<span class="price_bef_disc">₹${it.priceBeforeDiscount}</span>`}</div>
      //                           </div>
      //                           ${it.DeliveryPlan === 'once' ? "" : `<div class="checkout__cart__deliveryPlan d-flex"><div>Start Date: </div><div><span>${newStart}</span></div></div>
      //                           <div class="checkout__cart__deliveryPlan d-flex"><div>End Date: </div><div><span>${newEnd}</span></div></div>`}
      //                           <div class="checkout__cart__deliveryPlan d-flex checkout__cart__text__color"><div>${it.DeliveryPlan === 'once' ? 'Expected delivery' : 'Delivery plan'}: </div><div><span>${it.StartDate}</span></div></div>
      //                           <div class="checkout__cart__quantityPriceRow d-flex cart__deliveryPlan"><div class="checkout__cart__text__color">Qty: </div><div class="checkout__cart__quantity"><span>${result_quantity}</span></div></div>
      //                           <div class="checkout__cart__quantityPriceRow d-flex"><div class="fw-bold">Total Amount: </div><div class="checkout__cart__totalQuantityPrice indRs"><span class="fw-bold">₹ ${it.totalPriceItem}</span> </div></div>
      //                       </div>
      //                   </div>
      //               </div>`);
      loadCartItems();
      // localStorage.removeItem("cart");
      //     $('.showcheckoutSubtotal').html('₹'+total1-taxes);
      localStorage.totalval = tot;
      localStorage.subamount = tot - taxes;
      // $(".showcheckoutTax").html("₹ " + taxes);
      if(localStorage.promocode_for =='refferal'){ 
        $(".showcheckoutoffersDiscount").html("₹ 0");
        $(".showcheckoutRewardDiscount").html("-₹"+localStorage.discount_value );
      }
    });
    // $(".showcheckoutTotal").html(localStorage.totalval);

    if (localStorage.offeredprice) {
	    $(".showcheckoutTotal").html(parseInt(localStorage.totalval)-parseInt(localStorage.offeredprice));
      $(".showcheckoutoffersDiscount").html("-₹" +localStorage.discount_value); // added discount_value instead of offeredprice
      $(".showcheckoutTotal").html(
         (parseInt(localStorage.discount_value)+parseInt(localStorage.price))*parseInt(localStorage.result_quantity) - localStorage.offeredprice*localStorage.result_quantity
      );

      // start for paneer offer hide ghee offer
      // if (localStorage.promocode_name === "GHEE50") {
      //     $(".showcheckoutSubtotal").html("₹ " + ((parseInt(localStorage.totalval)) * parseInt(localStorage.result_quantity)));
      // } else {
      //     $(".showcheckoutSubtotal").html("₹ " + ((parseInt(localStorage.discount_value) + parseInt(localStorage.price)) * parseInt(localStorage.result_quantity)));
      // }
      // end for paneer offer hide ghee offer
    }
    if (localStorage.discount_value) {
      if(localStorage.promocode_for =='refferal'){ 
        $(".showcheckoutoffersDiscount").html("₹ 0");
        $(".showcheckoutRewardDiscount").html("-₹"+localStorage.discount_value );
      }else{
        $(".showcheckoutTotal").html(parseInt(localStorage.totalval)-parseInt(localStorage.offeredprice));
        $(".showcheckoutoffersDiscount").html("-₹" +localStorage.discount_value); // added discount_value instead of offeredprice
      }
    }
    if(localStorage.promocode_for =='refferal'){ 
      $(".showcheckoutoffersDiscount").html("₹ 0");
      $(".showcheckoutRewardDiscount").html("-₹"+localStorage.discount_value );
    }
    if (localStorage.dis && localStorage.pid == 3) {
      if (localStorage.result_quantity == 30 && localStorage.dis == 0) {
        $(".showcheckoutTotal").html(localStorage.totalval - localStorage.amnt);
      }
    }
    if(localStorage.promocode_name === PRODUCT_OFFER.OFFER_CODE) {
      $(".showcheckoutTotal").html(parseInt(localStorage.totalval) - parseInt(localStorage.discount_value));
      $(".showcheckoutDiscount").html("₹0");
      localStorage.setItem('totalval', parseInt(localStorage.totalval) - parseInt(localStorage.discount_value));
      // $(".showcheckoutSubtotal").html("₹ " + (parseInt(localStorage.totalval)));
      }
  } else {
    //"null");
  }
  if (localStorage.promocode_name) {
    if (localStorage.referrer_no != '') {
      var amnt = parseInt(localStorage.totalval);
      if (amnt < 2000 ) {
        // Paneer offer code
        if(localStorage.promocode_name == PRODUCT_OFFER.OFFER_CODE && localStorage.paneerPromocodeHandling == false){
          $(".checkout__cart__coupon__row").html(`
              <span class="error-message">Add ₹${2000-parseInt(localStorage.totalval)} or more now to unlock your referral coupon!</span>
              <div class="checkout__cart__coupon__left d-flex">
              <a class="checkout__cart__coupon__remove text-blue underline" id="promocodecouponremove" onclick="removepromocodeoffer()"> (Remove)</a>
                  <div class="checkout__cart__viewOffers text-blue pointer" onclick="viewofferspromocode();"><b>VIEW OFFERS</b></div>
