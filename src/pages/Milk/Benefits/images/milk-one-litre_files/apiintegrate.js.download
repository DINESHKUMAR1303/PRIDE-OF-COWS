      $.ajax(settings).done(function (response) {
        // console.log(response);

        // storing payment data for custom analytics
        try {
           updateUtmCookie("999payment", "999payment", { amount: 999 });
        } catch (error) {
          
        }
        if (response.status == 1) {
          setTimeout(() => {
            Swal.fire({
              position: "middle",
              icon: "success",
              title:
                "We are redirecting you to the payment gateway for processing the order",
              showConfirmButton: false,
              timer: 3000,
            });
          }, 1500);

          cartitem =
            response.product_id +
            ":" +
            response.rate +
            ":" + response.duration + ":" +
            response.duration * response.rate +
            "|";
          allcart = response.start_date + ":" + response.end_date + ":"+response.frequency+"|";
          // if(response.customcart!=='' && typeof response.customcart !== 'undefined'){
          //   alert("custom cart");
          //   cartitem=response.customcart;
          // }
          let frequency_pattern = '';
          if (response.frequency == "everyday") {
            frequency_pattern = '1,1,1,1,1,1,1|';
          } else if (response.frequency == "alternate") {
            frequency_pattern = 'alternate,1|';
          }
            if (response.customcart !== "") { 
              let frequency = response.customcart;
              let allDates = [];
              if (typeof frequency === "string" && frequency.length > 0) {
                let entries = frequency.split("|").filter(Boolean);
                entries.forEach(entry => {
                  let parts = entry.split(":");
                  if (parts.length >= 2) {
                    allDates.push(parts[0]);
                  }
                });
              }
              // Build pattern for one week (Monday to Sunday) starting from the first Monday on/after start_date
              let patternDates = [];
              let startDate = new Date(response.start_date);
              // Find the first Monday on/after startDate
              let dayOfWeek = startDate.getDay(); // 0=Sunday, 1=Monday, ..., 6=Saturday
              let offset = (dayOfWeek === 0) ? 1 : (8 - dayOfWeek) % 7;
              let mondayDate = new Date(startDate);
              mondayDate.setDate(startDate.getDate() + offset - (dayOfWeek === 1 ? 0 : 0));
              for (let i = 0; i < 7; i++) {
                let d = new Date(mondayDate);
                d.setDate(mondayDate.getDate() + i);
                let dateStr = d.toISOString().split("T")[0];
                patternDates.push(allDates.includes(dateStr) ? 1 : 0);
              }
              let weekPattern = patternDates.join(',') + '|';
              frequency_pattern = weekPattern;
              // console.log("One week pattern (Mon-Sun):", frequency_pattern);
            }
          if(response.offer_name == 'Offer@999'){     // added for 999 offer tracking
            // console.log("999 offer applied");
            localStorage.setItem("trippleNine", "999Offer");  // added for 999 offer tracking
            localStorage.setItem("selectedAddressId", userdata.default_address_id);
          }                                               // added for 999 offer tracking

          var params = {
            customofferdetail: 1,
            CartItems: cartitem,
            custId: userdata.UserID,
            allcart: allcart,
            minDate: response.start_date,
            maxDate: response.end_date,
            City: userdata.city_id,
            TotalAmount: response.min_payment,
            subscriptionType: response.frequency,
            package_frequency: frequency_pattern,
            TotalPay: response.min_payment,
            api: "SubscriptionPlaceorder",
            website_payment: 1,
            Source: "Desktop",
            offerStatus: "1",   // added for 999 offer tracking. initial 0
            offcart: 0,
            address: "",
            customC: 0,
            offeredprice: response.discount,      // added for 999 offer tracking initial 0
            packageId: 0,
            sourceOffer: source
          };
          var payData = {};
          payData["status_999"] = 1;
          payData["TotalAmount"] = response.min_payment;
          payData["customer_id"] = userdata.UserID;
          payData["dataAr"] = JSON.stringify(params);
          localStorage.payData = JSON.stringify(payData);
          // console.log(localStorage.payData);

          setTimeout(() => {
            nimmblepay();
          }, 2500);
        } else if (response.status == 2) {
          // window.location.href=url+"wallet";

          setTimeout(() => {
            Swal.fire({
              position: "middle",
              icon: "success",
              title:
                "Sorry this offer is applicable for new customers only.You can avail other offers.",
              showConfirmButton: false,
              timer: 4000,
            });

            setTimeout(() => {
              window.location.href = url + "wallet?walletoffer=1";
            }, 3500);
          }, 1500);
        } else if (response.status == 3) {
          setTimeout(() => {
            Swal.fire({
              position: "middle",
              icon: "success",
              title:
                "Sorry this offer is not applicable in your pincode.You can avail other offers",
              showConfirmButton: false,
              timer: 4000,
            });

            setTimeout(() => {
              window.location.href = url + "wallet?walletoffer=1";
            }, 3500);
          }, 1500);
        }
      });
    }
  }
}
const crypt = (salt, text) => {
  const textToChars = (text) => text.split("").map((c) => c.charCodeAt(0));
  const byteHex = (n) => ("0" + Number(n).toString(16)).substr(-2);
  const applySaltToChar = (code) =>
    textToChars(salt).reduce((a, b) => a ^ b, code);

  return text
    .split("")
    .map(textToChars)
    .map(applySaltToChar)
    .map(byteHex)
    .join("");
};

function forceloginuser(MobileNo, masterOtp) {
  $("#preloaderfull").show();
  const decrypted_string = decrypt("salt", MobileNo); // -> Hello

  var mob = parseInt(decrypted_string);
  localStorage.clear();
  var settings = {
    url: baseUrl + "login",
    method: "POST",
    timeout: 0,
    headers: {
      "Content-Type": "application/json",
    },
    data: JSON.stringify({
      MobileNo: mob + "+*",
      Source: "Desktop",
      Type: "login",
    }),
  };

  $.ajax(settings).done(function (resp) {
    $("#otpsub").hide();
    $("#otpreceive").show();

    if (resp.status == 1) {
      var settings = {
        url: baseUrl + "otpverifylogin",
        method: "POST",
        timeout: 0,
        headers: {
          "Content-Type": "application/json",
        },
        data: JSON.stringify({
          MobileNo: mob + "+*",
          OTP: masterOtp,
        }),
      };

      $.ajax(settings).done(function (response) {
        if (response.status == 1) {
          localStorage["userdata"] = JSON.stringify(response.data);

          setTimeout(() => {
            window.location.href = url + "offers";
          }, 1000);
        }
      });
    }
  });
}

