function Contactus() {
  var userdata = localStorage.getItem("userdata", userdata);
  var data = JSON.parse(userdata);
  var token = data.token;
  var UserID = data.UserID;
  var message = $("#message").val();
  var settings = {
    url: baseUrl + "contactus",
    method: "POST",
    timeout: 0,
    headers: {
      "Content-Type": "application/json",
      Authorization: "Bearer " + token,
    },
    data: JSON.stringify({
      Customer_id: UserID,
      message: message,
    }),
  };
  try {
    window.dataLayer = window.dataLayer || [];
    dataLayer.push({
      event: "connect_with_us",
      platform: "Website"
    })
  } catch (err) {

  }
  $.ajax(settings).done(function (response) {
    if (response.status == 1) {
      Swal.fire({
        title: "success",
        text: response.message,
        icon: "success",
        closeOnConfirm: true,
      }).then(function () {
        window.location.href = url + "contact";
      });
    } else {
      Swal.fire({
        title: "error",
        text: response.message,
        icon: "error",
        closeOnConfirm: true,
      }).then(function () {
        window.location.href = url + "contact";
      });
    }
  });
}
