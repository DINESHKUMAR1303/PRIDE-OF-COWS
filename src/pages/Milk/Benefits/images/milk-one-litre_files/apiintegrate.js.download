function placeOrderLoyalty() {
  var userdata = localStorage["userdata"]
    ? JSON.parse(localStorage["userdata"])
    : {};
  if (userdata) {
    var token = userdata.token;
    var end_date = localStorage.getItem("loyaltyResponse.end_date");
    var start_date = localStorage.getItem("loyaltyResponse.start_date");
    var product_id = localStorage.getItem("loyaltyResponse.product_id");
    var cartPrice = 0;
    var total_items = localStorage.getItem("loyaltyResponse.total_items");
    var delivery_plan = localStorage.getItem("loyaltyResponse.delivery_plan");
    var reward_id = localStorage.getItem("reward_id");
    var customerId = userdata.UserID;
    var city = userdata.city_id;
    var settings = {
      url: baseUrl + "packagemasters",
      method: "POST",
      headers: {
        Authorization: "Bearer " + token,
      },
      data: {
        custId: customerId,
        CartItems: product_id + ":" + cartPrice + ":" + total_items + ":0|",
        City: city,
        TotalAmount: 0,
        TotalPay: 0,
        subscriptionType: delivery_plan,
        allcart: start_date + ":" + end_date + ":" + delivery_plan + "|",
        minDate: start_date,
        maxDate: end_date,
        rewardId: reward_id,
        addressId: poc_addressID,
      },
    };
    $.ajax(settings).done(function (response) {
      if (response.status == 1) {
        window.location.href = "https://staging.prideofcows.in/";
      }
    });
  }
}

function addCartsummaryoffercart() {
  var Cart = localStorage.getItem("offercart", Cart);
  var total1 = localStorage.getItem("totalval", total1);

  var Quantity = localStorage.getItem("currVlaue", Quantity);
  var total1 = localStorage.getItem("totalval", total1);
  var data = JSON.parse(Cart, Quantity, total1);
  // console.log(data);
  if (data) {
    $(".checkout__cart__coupon").hide();
    $.each(data, function (i, it) {
      $("#cart_summary").append(`<div class="row checkout_product_items">
                        <div class="col-4">
                            <a href="#" >
                                <img class="checkout__cart__img" src="${it.main_img}" alt="">
                            </a>
                        </div>
                        <div class="col-8">
                            <div class="checkout__cart__text">
                                <a href="#">
                                    <h4 class="checkout__cart__title">${it.Name}</h4>
                                </a>
                                
                                <div class="checkout__cart__deliveryPlan">Delivery plan: <span>${it.DeliveryPlan}</span></div>
                                <div class="checkout__cart__deliveryPlan">No. Of Booking Days: <span>${it.diffDays}</span></div>
                                <div class="checkout__cart__quantityPriceRow d-flex justify-space-between">
                                    <div class="checkout__cart__quantity">Quantity: <span>${it.Quantity}</span></div>
                                    <div class="checkout__cart__totalQuantityPrice">₹ ${it.totalPriceItem}</div>
                                </div>
                            </div>
                        </div>
                       
                    </div>`);
    });
  } else {
    // console.log("null");
  }
  // totalprice();
}

