function emptyCartScreen(){
const userdata = JSON.parse(localStorage.getItem('userdata'));
  if (!userdata) {
  $(".checkout__wrapper").css("display", "block")
    const cartData = JSON.parse(localStorage.getItem("cart"));
    if(!cartData){
      $(".wrapper--large.checkout__wrapper").html(`
        <div class="text-center h-60vh content-center">
          <div class="d-flex mx-auto cart_empty_img">
            <img src="../frontend/web/images/empty_cart.svg" alt="empty cart">
          </div>
          <p class="cart_content mt-15">Your cart’s empty, and so is the ride.</p>
          <p class="mt-0">Let’s fill it with something farm-fresh and fabulous.</p>
          <button class="mt-25">
            <a href="${weburl + 'shop/all'}" class="shop_redirect_button mt-15">Browse Products</a>
          </button>
        </div>
      `);
    }
  }
}

function loadCartItems() {
  const userdata = JSON.parse(localStorage.getItem('userdata'));
  // const poc_addressID = localStorage.getItem("selectedAddressId");
  if (!userdata) {
    const cartData = JSON.parse(localStorage.getItem("cart")) || [];
    $('#taxes').html("₹0");
    $("#checkoutProducts").empty(); // clear old items
    localStorage.setItem("totalCartItems", cartData.length);

    if (cartData.length === 0) {
      $(".checkout .checkout__wrapper").addClass("cartOrdersSection");
      $(".checkout__footer").hide();
      $(".checkout__wrapper").html(`
        <div class="text-center">
          <div class="d-flex mx-auto cart_empty_img">
            <img src="../frontend/web/images/empty_cart.svg" alt="empty cart">
          </div>
          <p class="cart_content mt-15">Your cart’s empty, and so is the ride.</p>
          <p class="mt-0">Let’s fill it with something farm-fresh and fabulous.</p>
          <button class="mt-25">
            <a href="../shop/all" class="shop_redirect_button mt-15">Browse Products</a>
          </button>
        </div>
      `);
      return;
    } else {
      $(".checkout .checkout__wrapper").show();
      $(".checkout .checkout__wrapper").removeClass("d-none cartOrdersSection");
      $(".checkout__footer").show();
    }

    // ✅ Local cart behaves like server cart
    let recalculatedTotal = 0;

    cartData.forEach(function (item) {
      let discountPercent = (item.priceBeforeDiscount && item.priceBeforeDiscount !== item.Price)
        ? Math.round(((item.priceBeforeDiscount - item.Price) / item.priceBeforeDiscount) * 100) + "% off"
        : "";

      // delivery
      let deliveryHtml = `
        <div class="label-expected-delivery localCart_delivery">
          <div><img src="../frontend/web/images/motor-checkout-icon.svg" alt=""></div>
          <div class="relative">
            <p style="width: max-content;">Expected Delivery Date:</p>
            <p style="margin: 0; font-weight: bold">${moment(item.StartDate, "DD/MM/YYYY").format("DD MMM")}</p>
            <input type="text" id="inputdeliveryDate-${item.ProductId}" 
                  value="${item.StartDate}" readonly disabled>
            <input type="text" id="deliveryDate-${item.ProductId}" readonly disabled style="position:absolute;height:0;">
          </div>
        </div>
        <button class="delivery_button editDate btn-change-date" id="localopenDatePicker-${item.ProductId}">Change Date</button>
      `;

      // qty controls
      let productActionHtml = `
        <div class="inputNumber d-flex justify-end">
          <div class="quantity-button-minus inputNumber__btn inputNumber__btn--down pointer" 
              onclick="qtychangeLocal(this,'${item.ProductId}','minus')">-</div>
          <input type="number" id="itemQuantity" min="1" value="${item.Quantity}" readonly>
          <div class="quantity-button-plus inputNumber__btn inputNumber__btn--up pointer" 
              onclick="qtychangeLocal(this,'${item.ProductId}','plus')">+</div>
        </div>
      `;

      recalculatedTotal += item.Price * item.Quantity;

      // product card
      let productHtml = `
        <div class="products-checkout" data-productid="${item.ProductId}">
          <div class="products-checkout-box localCart_delivery">
            <div class="products-checkout-items p-products-checkout-items">
              <div class="div1">
                <img src="${item.main_img}" alt="${item.Name}">
              </div>
              <div class="div2">
                <div class="product-inner-wrapper-1">
                  <p class="product-checkout-description">${item.Name}</p>
                  <p class="product-checkout-quantity">${item.unit_prod || ""}</p>
                  <p class="product-checkout-price">
                    ₹${item.Price}
                    ${item.priceBeforeDiscount && item.priceBeforeDiscount !== item.Price ? `<span class="cross-mrp">MRP: ₹${item.priceBeforeDiscount}</span>` : ""}
                    ${item.priceBeforeDiscount > item.Price ? `<span class="discount-text">${discountPercent}</span>` : ``}
                  </p>
                </div>
                <div class="product-inner-wrapper-2">${productActionHtml}</div>
              </div>
            </div>
            <div class="label-section">${deliveryHtml}</div>
          </div>
        </div>
      `;

      $("#checkoutProducts").append(productHtml);
    });

    // ✅ Totals update
    $(".showcheckoutTotal").html("₹" + recalculatedTotal);
    $(".showcheckoutSubtotalAmount, .totalsumamount").html("₹" + recalculatedTotal);
    $(".total-amount-amt").html("₹" + recalculatedTotal);

    localStorage.setItem("totalPayableAmount", recalculatedTotal);
    localStorage.setItem("totalval", recalculatedTotal);
    $(".payment-container, .explore-coupon-container").css({
      "pointer-events": "none",
      "bottom": "-33px"
    });
    $(".pay-via-wallet, .pay-amount-div").css({"opacity": 0.4,"pointer-events": "none"});
    return;
  }
        $("#preloader").hide()

  // ================= SERVER CART =================
  $.ajax({
    url: baseCarturl + "cart/get-cart",
    method: "POST",
    headers: {
      "Authorization": "Bearer " + userdata.token,
      "Content-Type": "application/json"
    },
    data: JSON.stringify({
      "addressId": poc_addressID,
      "City": userdata.city_id
    }),
    success: function (response) {
      if (response.status === 1) {
        $("#checkoutProducts").empty();
        localStorage.setItem("totalCartItems", response.cartItems.length);
        let offerCount = parseInt(localStorage.getItem("offerItem") || 0);
        let totalItemsCount = response.cartItems.length + offerCount;

        if (totalItemsCount > 1) {
          $(".total__cart__items").html(`(${totalItemsCount} Items)`);
        } else {
          $(".total__cart__items").html(`(${totalItemsCount} Item)`);
        }

        $(".cartIcon__count").html(totalItemsCount);

        // Sync localStorage cart with server response
        let syncedCart = response.cartItems.map(item => {
          return {
            ProductId: item.UniqueId,
            Quantity: item.Quantity,
            Price: item.price,
            DeliveryPlan: "once",
            StartDate: moment(item.deliveryDate).format("DD/MM/YYYY"),
            EndDate: moment(item.deliveryDate).format("DD/MM/YYYY"),
            Name: item.name,
            diffDays: 1,
            totalPrice: String(item.price),
            totalPriceItem: String(item.price * item.Quantity),
            main_img: item.Thumb,
            currVlaue: item.Quantity,
            taxprice: item.tax || "0",
            category_prod: item.category || "",
            unit_prod: item.weight || "",
            slug: item.slug || "",
            qtyProduct: [],
            priceBeforeDiscount: item.originalPrice ? String(item.originalPrice) : null,
            totalpriceBeforeDiscount: item.originalPrice ? String(item.originalPrice * item.Quantity) : null,
            ratingInfo: item.ratingInfo || { ratingNumber: 0, totalReviews: 0 },
            isSubscribe: item.isSubscribe || "0",
            cart_id: item.cart_id,
            deliveryBuffer: item.deliveryBuffer
          };
        });
        localStorage.setItem("cart", JSON.stringify(syncedCart));

        if (response.cartItems.length == 0) {
          $('.checkout .checkout__wrapper').addClass('cartOrdersSection');
          $('.checkout__footer').hide();
          $(".checkout__wrapper").html(`
            <div class="text-center">
              <div class="d-flex mx-auto cart_empty_img">
                <img src="../frontend/web/images/empty_cart.svg" alt="empty cart">
              </div>
              <p class="cart_content mt-15">Your cart’s empty, and so is the ride.</p>
              <p class="mt-0">Let’s fill it with something farm-fresh and fabulous.</p>
              <button class="mt-25">
                <a href="../shop/all" class="shop_redirect_button mt-15">Browse Products</a>
              </button>
            </div>
          `);
            $(".cartIcon__count").removeClass("show_cartIconCount");
            $(".cartIcon__count").hide();
          return;
        } else {
          $('.checkout .checkout__wrapper').show();
          $('.checkout .checkout__wrapper').removeClass('d-none cartOrdersSection');
          $('.checkout__footer').show();
        }

        // Recalculate total manually
        let recalculatedTotal = 0;
        const offerProductId = localStorage.getItem("offer_product_id");
        if(response.orderDetails.actualItemTotal > response.orderDetails.itemTotal){
          // $(".showcheckoutSubtotalAmount_discount").html("₹" + response.orderDetails.actualItemTotal);
          if (window.location.pathname.split('/').pop() !== "special-offer") {
            $(".showcheckoutSubtotalAmount_discount").html("₹" + response.orderDetails.actualItemTotal);
          }
        }
        let offerAppended = false;

        response.cartItems.forEach(function (item) {
          let discountPercent = (item.originalPrice && item.originalPrice !== item.price)
            ? Math.round(((item.originalPrice - item.price) / item.originalPrice) * 100) + "% off"
            : "";

          let deliveryHtml = "";
          let productActionHtml = "";

          if (item.delivery_possible == 0 || !item.is_stock_available) {
            deliveryHtml = `
              <div class="label-expected-delivery-red">
                <p>Not serviceable at selected address</p>
              </div>
            `;
            $(".pay-amount-div").css({
              "opacity": 0.5,
              "pointer-events": "none",
              "cursor": "not-allowed"
            });
            productActionHtml = `<button class="btn-remove-checkout" onclick="removeFromCartNonServicable('${item.cart_id}')">Remove</button>`;
          } else {

            // $(".pay-amount-div").css({
            //   "opacity": 1,
            //   "pointer-events": "auto",
            //   "cursor": "default"
            // });

            recalculatedTotal += item.price * item.Quantity;

            deliveryHtml = `
              <div class="label-expected-delivery">
                <div><img src="../frontend/web/images/motor-checkout-icon.svg" alt=""></div>
                <div class="relative">
                  <p style="width: max-content;">Expected Delivery Date:</p>
                  <p style="margin: 0; font-weight: bold">${moment(item.deliveryDate).format("DD MMM")}</p>
                  <input type="text" id="inputdeliveryDate-${item.UniqueId}" value="${moment(item.deliveryDate).format("DD/MM/YYYY")}" readonly disabled>
                  <input type="text" id="deliveryDate-${item.UniqueId}" readonly disabled style="position:absolute;height:0;">
                </div>
              </div>
              <button class="delivery_button editDate btn-change-date" id="openDatePicker-${item.UniqueId}">Change Date</button>
            `;

            productActionHtml = `
              <div class="inputNumber d-flex justify-end">
                <div class="quantity-button-minus inputNumber__btn inputNumber__btn--down pointer" onclick="qtychange(this,'${item.UniqueId}','minus','${item.cart_id}')">-</div>
                <input type="number" id="itemQuantity" min="1" value="${item.Quantity}" readonly>
                <div class="quantity-button-plus inputNumber__btn inputNumber__btn--up pointer" onclick="qtychange(this,'${item.UniqueId}','plus','${item.cart_id}')">+</div>
              </div>
            `;
          }

          let productHtml = `
            <div class="products-checkout" data-productid="${item.UniqueId}" data-cartid="${item.cart_id}" data-servicable="${item.is_subscribe}" data-preLaunchDate="${item.pre_launch_date}" data-deliveryBufferCheckout="${item.deliveryBuffer}">
              <div class="products-checkout-box userHaveDelivery">
                <div class="products-checkout-items p-products-checkout-items">
                  <div class="div1">
                    <img src="${item.image}" alt="${item.name}">
                  </div>
                  <div class="div2">
                    <div class="product-inner-wrapper-1">
                      <p class="product-checkout-description">${item.name}</p>
                      <p class="product-checkout-quantity">${item.weight || ""}</p>
                      <p class="product-checkout-price">
                        ₹${item.price}
                        ${item.originalPrice && item.originalPrice !== item.price ? `<span class="cross-mrp">MRP: ₹${item.originalPrice}</span>` : ""}
                        ${item.originalPrice > item.price ? `<span class="discount-text">${item.discount}%</span>`: ``}
                      </p>
                    </div>
                    <div class="product-inner-wrapper-2">${productActionHtml}</div>
                  </div>
                </div>
                <div class="label-section">${deliveryHtml}</div>
              </div>
            </div>
          `;

          $("#checkoutProducts").append(productHtml);

          // 🔥 If this item matches offerProductId → add extra HTML
          const mainProductOfferID = localStorage.getItem("promoOfferPoruductId");
          if (offerProductId && item.UniqueId == mainProductOfferID && !offerAppended) {
            let offerAppended = true;
            var city = data.city;
            var isSubscribe = 0;
            var settings = {
              url: baseUrl + "productlist",
              method: "POST",
              headers: {
                "Authorization": "Bearer " + userdata.token,
                "Content-Type": "application/json",
              },
              data: JSON.stringify({
                City: city,
                IsSubscribe: isSubscribe,
                pre_launch: 2
              }),
            };

            $.ajax(settings).done(function (response) {
              let matchedProduct = response.data.find(p => p.id == offerProductId);
              if (matchedProduct && matchedProduct.id == offerProductId) {
                let offerHtml = `
              <div class="products-checkout-box offer-box-apply">
                  <div class="products-checkout-items p-products-checkout-items">
                  <div class="div1">
                    <img src="${matchedProduct.image}" alt="${matchedProduct.name}">
                  </div>
              <div class="div2">
               <div class="product-inner-wrapper-1">
                <p class="product-checkout-description">
                   ${matchedProduct.name} (Offer)
                </p>
                <p class="product-checkout-quantity">
                  ${matchedProduct.product_unit || ""}
                </p>
                <p class="product-checkout-price">
                  ₹0 <span class="mp-cut">MRP: ₹${matchedProduct.price}</span>
                </p>
              </div>
            <div class="product-inner-wrapper-2">
              <button class="remove__offer" onclick="removepromocodeoffer()">
              Remove
            </button>
          </div>
        </div>
      </div>
      <div class="label-section">
        <div class="label-expected-delivery-green">
          <img src="../frontend/web/images/gift_card_offer.svg" />
          Congrats! You've got 200ml Ghee for free.
        </div>
        <div class="tandc_icon pointer">
          <img src="../frontend/web/images/tandc_icon.svg" alt="tandc_icon"/>
        </div>
      </div>
    </div>
`;
                $(`[data-productid='${item.UniqueId}']`).closest(".products-checkout").append(offerHtml);
                offerAppended = true;
                $(".offerTextCheckout").removeClass("d-none");

                if (item.deliveryDate) {
                  localStorage.setItem("offerstart", item.deliveryDate);
                  localStorage.setItem("offerend", item.deliveryDate);
                }
              }
              $(".green-text").html(`Discount ( ${localStorage.promocode_name} )`);
              $(".appliedDeliveryCharge").html(`-₹${localStorage.discount_value}`);
              var totalVal = Number(localStorage.totalval);
              var discountVal = Number(localStorage.discount_value);
              var grandTotal = totalVal + discountVal;
              $(".showcheckoutSubtotalAmount").html(`₹${grandTotal}`);
            });
          }
        });

        // ✅ Update totals with recalculated value
        $(".showcheckoutTotal").html("₹" + recalculatedTotal);
        $(".showcheckoutSubtotalAmount, .totalsumamount").html("₹" + recalculatedTotal);
        $(".walletAmount").html("₹" + response.orderDetails.walletBalance);
        // if (response?.orderDetails?.tax) {
        //   $('#taxes').html("₹" + response.orderDetails.tax);
        // } else {
        //   $('#taxes').html("₹0");
        // }
        $('#taxes').html("₹" + response.orderDetails.tax);
        $('.handling_fee').html("₹" + response.orderDetails.handlingFee);
        $('.delivery_fee').html('<span style="text-decoration: line-through;">₹30</span> Free');
        $('.appliedDeliveryCharge').html(response.orderDetails.appliedDeliveryCharge);
        $('.total-amount-amt').html("₹" + recalculatedTotal);

        localStorage.setItem("totalPayableAmount", recalculatedTotal);
        localStorage.setItem("totalval", recalculatedTotal);

        if (response.orderDetails.walletBalance > 0) {
          $('.pay-via-wallet').show();
        } else {
          $('.pay-via-wallet').hide();
        }
      } else {
        $("#checkoutProducts").html(`<div class="text-center">Your cart is empty!</div>`);
      }
    },
    error: function (err) {
      console.error("Error fetching cart:", err);
    }
  });
}
function clearCartAfterPayment() {
  const userdata = JSON.parse(localStorage.getItem('userdata'));
  $.ajax({
    url: baseCarturl + "cart/clear-cart",
    method: "POST",
    headers: {
      "Authorization": "Bearer " + userdata.token,
      "Content-Type": "application/json"
    },
    success: function (response) {
      localStorage.removeItem("cart");
      localStorage.removeItem('discount_value');
      localStorage.removeItem('promocode_for');
      localStorage.removeItem('referrer_no');
      localStorage.removeItem('promocode_name');
      localStorage.removeItem('offeredprice');
      localStorage.removeItem('productOfferId');
      localStorage.removeItem('offer_product_id');
      localStorage.removeItem('offerItem');
    },
  })
}

function checkboxChanged() {
  const checkbox = document.getElementById("wallet-checkbox");
  const totalPayableAmount = parseFloat(localStorage.getItem("totalPayableAmount")) || 0;
  const payAmountDiv = document.querySelector(".pay-amount-div");
  const walletAmount = parseFloat(localStorage.getItem("balance")) || 0;

  var userDetails = JSON.parse(localStorage.getItem('userdata'))
  console.log("walletAmount:", walletAmount);
  console.log("totalPayableAmount:", totalPayableAmount);

  if (checkbox.checked) {
    let finalAmount = totalPayableAmount - walletAmount;

    if (walletAmount >= totalPayableAmount) {
      // Wallet covers the full amount
      $(".showcheckoutSubtotal").html("₹ 0");
      $(".proceed-container").html("<p>Place Order</p>");
      payAmountDiv.setAttribute("onclick", "ordersubmitone()");
      localStorage.setItem("totalval", 0);
      console.log("Wallet covers full order → Place Order");
       gaEvent({
        'event': 'wallet',
        'payableAmount': localStorage.getItem("totalval"),
        'addressID': localStorage.getItem("selectedAddressId"),
        'userID': userDetails.UserID,
        'walletBalance': walletAmount,
        'totalCartItem': localStorage.getItem("totalCartItems"),
        'paymentWallet': (checkbox.checked) ? 'true' : 'false'
      })
    } else {
      // Wallet partially covers, some amount still payable
      $(".showcheckoutSubtotal").html("₹ " + finalAmount);
      $(".proceed-container").html("<p>Proceed To Pay</p>");
      payAmountDiv.setAttribute("onclick", "ordersubmitone()");
      localStorage.setItem("totalval", finalAmount);
      console.log("Wallet partially covers → Pay remaining:", finalAmount);
       gaEvent({
        'event': 'wallet',
        'payableAmount': localStorage.getItem("totalval"),
        'userID': userDetails.UserID,
        'addressID': localStorage.getItem("selectedAddressId"),
        'walletBalance': walletAmount,
        'totalCartItem': localStorage.getItem("totalCartItems"),
        'paymentWallet': (checkbox.checked) ? 'true' : 'false'
      })
    }
  } else {
    // Wallet not applied, pay full
    $(".showcheckoutSubtotal").html("₹ " + totalPayableAmount);
    $(".proceed-container").html("<p>Proceed To Pay</p>");
    payAmountDiv.setAttribute("onclick", "ordersubmitone()");
    localStorage.setItem("totalval", totalPayableAmount);
    console.log("Wallet not used → Pay full:", totalPayableAmount);
     gaEvent({
        'event': 'wallet',
        'payableAmount': localStorage.getItem("totalval"),
        'userID': userDetails.UserID,
        'addressID': localStorage.getItem("selectedAddressId"),
        'walletBalance': walletAmount,
        'totalCartItem': localStorage.getItem("totalCartItems"),
        'paymentWallet': (checkbox.checked) ? 'true' : 'false'
      })
  }
}

    function checkoutChangeAdd(){
      var userdata = localStorage.getItem("userdata");
      if (userdata) {
        const newdata = JSON.parse(userdata);
        var token = newdata.token;
        var settings = {
          url: baseUrl + "get-user-addresses",
          method: "POST",
          timeout: 0,
          headers: {
            "Content-Type": "application/json",
            Authorization: "Bearer " + token,
          },
        };
        $.ajax(settings)
          .done(function (response) {
            if(response.addresses.length >= 1){
              $('.topmodal').addClass("show-topmodal");
            }
            else{
               AddressHelper.addNewAddress();
            }
          })
      }else{
        Swal.fire({
        title: "Login Required",
        text: "You need to log in to Add Address.",
        icon: "warning",
        confirmButtonText: "OK",
      }).then((result) => {
        if (result.isConfirmed) {
          showRegister(event);
        }
      });
      }
    }


function loadProducts(city, token, categoryId) {
  var isSubscribe = 0;
  const poc_addresid = localStorage.getItem("selectedAddressId");
  $("#preloader").show();
  var settings = {
    url: baseUrl + "categorywiseproductlist",
    headers: {
      "Content-Type": "application/json",
      Authorization: "Bearer " + token,
    },
    method: "POST",
    data: JSON.stringify({
      City: city,
      IsSubscribe: isSubscribe,
      categoryId: categoryId,
      pre_launch: 2,
      addressId: poc_addresid
    }),
  };
  $.ajax(settings).done(function (response) {
    $("#preloader").hide();
    const referrer = document.referrer;
    if (response.status == 1) {
      if (response.data) {
        var pname = "";
        var items = [];
        var cname = localStorage.getItem("cname") || 'all';
        // if (cname == "all") {
        if (categoryId == "all") {
          pname = 'all';

          $.each(response.data, function (i, it) {
            localStorage.setItem("filterCategory", it[0].category);
            $.each(it, function (i1, it1) {
              items.push({
                item_id: it1.id,
                item_name: it1.name,
                item_brand: "Pride Of Cows",
                item_category: it1.catagory,
                item_variant: it1.product_unit,
                price: it1.price,
                price_before_discount: it1.priceBeforeDiscount,
                price_discount_percentage: it1.priceDiscountPercentage,
              });

              priceDisplay = it1.priceBeforeDiscount
                ? `<span style="color:gray">MRP:</span><span class="amount-minus"> ₹${it1.priceBeforeDiscount}</span>`
                : '';

              discountDisplay = it1.priceDiscountPercentage
                ? `<p id="percent-off" style="display:none">${it1.priceDiscountPercentage}% off</p>`
                : '';
              $("#content_category").append(
                `<div class="col-3 col-xs-6 new-col-3" hover-container">
                      <a class="shopListing__box d-flex productlisting" onclick="getproductDetail(${it1.id}, '${it1.slug}', '${it1.category_slug}', '${it1.pre_launch_date}'); submitCampaignDetails('${CAMPAIGN_EVENTS.CATEGORY_Visited}', '${it1.id}');" href="#">
                        <div class="lazyContainer" style="">
                          <div class="productImageCat">
                            <img src="${it1.main_img}" alt="">
                          </div>
                          <div class="shopListing__box__text">
                            <div>
                              <h3 class="productname-text poc_ellipsis">${it1.display_name}</h3>
                              <div class="stars" id="shop-list-ratings-${i}${i1}" style="display: none;"></div>
                            </div>
                            
                            <div class="d-flex justify-space-between">
                                <h3 class="indRs">
                                  ${discountDisplay ? '' : 'MRP:'} ₹${it1.price}
                                </h3>
                                <p class="productunit">${it1.product_unit}</p>
                            </div>
                                ${it1.priceDiscountPercentage ? `<p>${priceDisplay ?? '' } ${it1.priceDiscountPercentage ? `<span class="percentageoff">${it1.priceDiscountPercentage}% off</span>` : ''}</p>` : ``}
                                <div class="tax-fs-12">(Price inclusive of all taxes)</div>
                          </div>
                        </div>
                          
                          <button class="new-button">Buy now</button>   
                      </a>
                      <a class="shopListing__box1 hover-data dn" onclick="getproductDetail(${it1.id}, '${it1.slug}', '${it1.category_slug}','${it1.pre_launch_date}')" href="#">
                        <p>${it1.description}</p>
                      </a>
                    </div>`
              );
              renderStars({ rating: parseFloat(it1.ratingInfo?.ratingNumber), containerId: `shop-list-ratings-${i}${i1}`, totalReviews: parseInt(it1.ratingInfo?.totalReviews) });
            });
          });
        } else {
          var cnameFound = 0;
          $.each(response.data, function (i, it) {
            if (categoryId == i) {
              cnameFound = 1;
              var buffer = "";
              if (it.length == 1) {
                buffer = '<div class="col-3 col-xs-12"></div>';
              }
              localStorage.setItem("filterCategory", it[0].category);
              $.each(it, function (i1, it1) {
                pname = it1.product_display_name
                items.push({
                  item_id: it1.id,
                  item_name: it1.name,
                  item_brand: "Pride Of Cows",
                  item_category: it1.catagory,
                  item_variant: it1.product_unit,
                  price: it1.price,
                  price_before_discount: it1.priceBeforeDiscount,
                  price_discount_percentage: it1.priceDiscountPercentage,
                });

                priceDisplay = it1.priceBeforeDiscount
                  ? `<span style="color:gray">MRP:</span><span class="amount-minus">₹${it1.priceBeforeDiscount}</span>`
                  : '';

                discountDisplay = it1.priceDiscountPercentage
                  ? `<p id="percent-off" style="display:none">${it1.priceDiscountPercentage}% off</p>`
                  : '';
                $('#taste-goodness').show();
                $("#content_category1").html('');
                $("#content_category").append(
                  buffer +
                `<div class="col-3 col-xs-6 new-col-3" hover-container">
                      <a class="shopListing__box d-flex productlisting" onclick="getproductDetail(${it1.id}, '${it1.slug}', '${it1.category_slug}', '${it1.pre_launch_date}'); submitCampaignDetails('${CAMPAIGN_EVENTS.CATEGORY_Visited}', '${it1.id}');" href="#">
                        <div class="lazyContainer" style="">
                          <div class="productImageCat">
                            <img src="${it1.main_img}" alt="">
                          </div>
                          <div class="shopListing__box__text">
                            <div>
                              <h3 class="productname-text poc_ellipsis">${it1.display_name}</h3>
                              <div class="stars" id="shop-list-ratings-${i}${i1}" style="display: none;"></div>
                            </div>
                            
                            <div class="d-flex justify-space-between">
                                <h3 class="indRs">
                                  ${discountDisplay ? '' : 'MRP:'} ₹${it1.price}
                                </h3>
                                <p class="productunit">${it1.product_unit}</p>
                            </div>
                                ${it1.priceDiscountPercentage ? `<p>${priceDisplay ?? '' } ${it1.priceDiscountPercentage ? `<span class="percentageoff">${it1.priceDiscountPercentage}% off</span>` : ''}</p>` : ``}
                                <div class="tax-fs-12">(Price inclusive of all taxes)</div>
                          </div>
                        </div>
                          
                          <button class="new-button">Buy now</button>   
                      </a>
                      <a class="shopListing__box1 hover-data dn" onclick="getproductDetail(${it1.id}, '${it1.slug}', '${it1.category_slug}','${it1.pre_launch_date}')" href="#">
                        <p>${it1.description}</p>
                      </a>
                    </div>` +
                  buffer
                );
                renderStars({ rating: parseFloat(it1.ratingInfo?.ratingNumber), containerId: `shop-list-ratings-${i}${i1}`, totalReviews: parseInt(it1.ratingInfo?.totalReviews) });
              });
            }
            // setTimeout(() => {
            //   if (cnameFound == 0) {
            //     alert("4")
            //   $("#content_category").append(`
            //     <h1 class="text-center">Sorry, There is no available products of this category in your location </h1>
            //   `); 
            //   }
            // }, 500);
            if (cnameFound == 0) {
              $('#taste-goodness').hide();
              $("#content_category").html('');
              // $("#content_category").append(`
              //     <h1 class="text-center">Sorry, There is no available products of this category in your location </h1>
              //   `);
            }
          });
          setTimeout(() => {
              if (cnameFound == 0) {
              $("#content_category").append(`
                <h1 class="text-center">Sorry, There is no available products of this category in your location </h1>
              `); 
              }
            }, 500);
        }
        document.querySelectorAll("#product-category-list li").forEach((ele) => {
          if (ele.getAttribute("id") === categoryId) {
            ele.scrollIntoView({
              behavior: 'smooth',
              block: 'center',
              inline: 'center',
            });
            ele.classList.add("filter-active");
          }
        });
      }

      var jsonEvent = {
        event: "view_item_list",
        ecommerce: {
          items: items,
          item_name: pname,
          item_brand: "Pride Of Cows"
        },
        previous_page: document.referrer
      };
      gaEvent(jsonEvent);
    } else {
      // showAlert(response.message, "Error", "OK");
    }
  });
}

