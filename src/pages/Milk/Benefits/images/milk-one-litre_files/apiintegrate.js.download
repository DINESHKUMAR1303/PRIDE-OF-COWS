            You've been <span class="fwb">${info.name}</span> </p>
            <p class="fs-16 swal-subtitle swal-text-container mb-10 mt-5 text-black">${window.inviteModalContent.subDescription} 
          </p>
          <p class="fs-16 swal-subtitle swal-text-container mb-10 text-black" style="font-weight:bold;">${info.login_id}</p>
          <p class="swal-subtitle swal-text-container mb-10 f-12" style="color:#AE8A49; text-align:left">${window.inviteModalContent.info}</p>
        </div>
      `,
      confirmButtonText: "Accept",
      customClass: {
        popup: "yourinvitedpopup",
        confirmButton: "custom-accept-btn",
      },
      preConfirm: () => {
        walletAmountSet(info.login_id, referNearnWalletAmount);
      },
    }).then((result) => {
      if (result.dismiss === Swal.DismissReason.backdrop) {
        showInviteStrip();
      }
    });
  }

