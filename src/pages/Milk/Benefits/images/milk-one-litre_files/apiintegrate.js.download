function getOproductDetail(pid, date, qty) {
  localStorage.setItem("pid", pid);
  localStorage.setItem("odate", date);
  localStorage.setItem("oQty", qty);
  localStorage.setItem("offer_product_quantity", qty);
}

//product category details script3
function getProductdetails(prod = "",viewdata='') {
var userdata = localStorage.getItem("userdata");
data = userdata ? JSON.parse(userdata) : {};

const featureFlags = JSON.parse(localStorage.getItem('featureFlags'));
const isStockEnable = featureFlags ? typeof featureFlags?.product_stock_availability === "boolean" && featureFlags?.product_stock_availability : false;

  var city = data.city_id||0;
  var token = data.token||'';
  var ProductID = localStorage.getItem("pid", ProductID);
  const poc_addresid = localStorage.getItem("selectedAddressId");
  if (prod !== "") {
    var ProductID = prod;
  }

  $("#productPageShimmer").show();
  $("#productImgContainer").hide();
  if(!userdata) {
    var settings = {
    url: baseUrl + "productdetail",
    method: "POST",
    timeout: 0,
    headers: {
      "Content-Type": "application/json",
    },
    data: JSON.stringify({
      ProductID: ProductID,
      City: localStorage.userPincode != "" ? 329 : 329,
    }),
  };
  $.ajax(settings).done(function (response) {
    if (response.status == 1) {
      if (response.data) {
        $("#productPageShimmer").hide();
        $("#productImgContainer").show();
        console.log(response.data)
         var reorderdetails = localStorage.getItem("reorderdetails", reorderdetails);
         let metaData = response.data.meta_data;
         let faqContainer = document.getElementById("faq-container");
         let faqSection=document.getElementById("faq_section");
         let healthyLifestyle2 = document.getElementById("healthyLifestyle2");
         updateQuantityByUniqueId(response.data.id)
     if (metaData === null) {
       faqSection.style.display="none";
       healthyLifestyle2.classList.add("no-padding-bottom");
     }else if (metaData.faq.length > 0 ){
         faqContainer.innerHTML = metaData.faq.map(faq => `
              <div class=' faqsList__item faq-item'>
                         <button class='faqsList__category faq-question no__center'>
                             <h4> ${faq.Question}</h4>
                             <svg class='arrow' width='24' height='24' viewBox='0 0 24 24' fill='none'
                                  xmlns='http://www.w3.org/2000/svg'>
                                 <path d='M6 9l6 6 6-6' stroke='black' stroke-width='2' stroke-linecap='round'
                                       stroke-linejoin='round' />
                             </svg>
                         </button>
                         <div class='faq-answer faqsList__detail faqsList__detail__api'>
                             <div class='faq-answer-content'>
                            ${faq.Answer}
                             </div>
                         </div>
                     </div>
         `).join(""); 
     } else{
       faqSection.style.display="none";
       healthyLifestyle2.classList.add("no-padding-bottom");
     }
 
        const value = JSON.parse(reorderdetails);

        priceDisplay = response.data.priceBeforeDiscount 
        ? `<span class="amount-minus">₹${response.data.priceBeforeDiscount}</span>` 
        : '';

        discountDisplay = response.data.priceDiscountPercentage 
        ? `${response.data.priceDiscountPercentage}% off`
        : '';

        priceDisplay = response.data.priceBeforeDiscount 
        ? ` <span style="color:gray; font-size:18px;">MRP:</span> <span class="amount-minus">₹${response.data.priceBeforeDiscount}</span>` 
        : '';

        discountDisplay = response.data.priceDiscountPercentage 
        ? `${response.data.priceDiscountPercentage}% off`
        : '';
        if(response.data?.isAutoOrderActive){
          $("#subscribe-now").hide()
          $("#manage-subscription").attr("onclick", `getAllSubscription(${response.data?.subscriptionOrderId})`)
          $("#manage-subscription").show()
        }
        localStorage.setItem("main_img", response.data.main_img);
        localStorage.setItem("category_prod", response.data.catagory);
        localStorage.setItem("unit_prod", response.data.product_unit);
        localStorage.setItem("name", response.data.name);
        localStorage.setItem("price", response.data.price);
        localStorage.setItem("totalPrice", response.data.price);
        localStorage.setItem("totalPriceItem", response.data.price);
        localStorage.setItem("priceBeforeDiscount", response.data.priceBeforeDiscount);
        localStorage.setItem("is_subscribe", response.data.is_subscribe);
        localStorage.taxprice = response.data.taxamount;
        localStorage.setItem("deliveryBuffer", response.data.deliveryBuffer);
        localStorage.launch_date = response.data.launch_date;
        $("#product_img").attr("src", response.data.main_img);
        $("#pimg").attr("src", response.data.banner_web);
        $("#pimg_mobile").attr("src", response.data.banner_web);
        $(".pimg_mobilew").attr("src", response.data.banner_web);
        $("#pgm > a").html(response.data.name);
        $("#pname").html(response.data.name);
        if (!response.data.priceBeforeDiscount) {
            $("#pamount, .product-amount-span").html("MRP : ₹" + response.data.price + priceDisplay);
        } else {
            $("#pamount, .product-amount-span").html("₹" + response.data.price + priceDisplay);
        }
        $("#percent-off").text(discountDisplay);
        $("#prodcuctDetails").html(response.data.description.replaceAll("\n", "<br />"));
        $(".discount-percentage-span").text(discountDisplay);
        $("#loyalty_points").text(response.data.loyalty_points);
        const contentProduct = $("#prodcuctDetails");
        const readMore = $("#readMore");
        const charLimit = 312;

        if (contentProduct.text().length > charLimit) {
          contentProduct.addClass("truncated");
          readMore.show().text("Read More");
        } else {
          contentProduct.removeClass("truncated");
          readMore.hide();
        }

        readMore.on("click", function () {
          const expanded = contentProduct.toggleClass("expanded").hasClass("expanded");
          contentProduct.toggleClass("truncated", !expanded);
          readMore.text(expanded ? "Read Less" : "Read More");
        });
        if(!response.data.loyalty_points){$(".earn-crown").remove()};
        if(response.data.priceBeforeDiscount){
          $(".discount-value-span").text(`-₹${+response.data.priceBeforeDiscount - +response.data.price}`);
        }else{
          $("#discount-details").hide();
        }
        $(".total-amount-span").text(`₹${response.data.price}/Day`);
        $(".total-amount-span-days").text(`₹${response.data.price*7}`);
        $(".prodQntSet").text(localStorage.getItem('currVlaue'));
        localStorage.setItem("currVlaue", 1)

        if(!response.data.is_subscribe){
          $("#total_product_amount").addClass("margin-bottom-4");
        }
        
        //ratings and reviews

        if(response.data?.ratingInfo?.ratingNumber){
          const rating = parseFloat(response.data.ratingInfo.ratingNumber);
          const totalRating = parseInt(response.data.ratingInfo.totalReviews);
          $("#num-rating").val(rating);
          $("#total-review").val(totalRating);
          renderStars({rating : rating, containerId: "customer-ratings", totalReviews : totalRating});
        }

        var productMainSliderContainer = document.querySelector('.productInner__mainSlider .draggable');
        var productMobSliderContainer = document.querySelector('.productInner__mainSlider--mobile');
        var productThumbnailContainer = document.querySelectorAll('.product-thumbnail');
        var getProductImageList  = response.data.productImages;

        var productImageList = "";
        getProductImageList.forEach((imageList, index) => {
        productImageList += `<div class="slide">
                        <div class="lazyContainer">
                            <img src=${imageList} alt="" data-index="${index}" class="open-modal"/>
                        </div>
                    </div>`;
          
        });

        productMainSliderContainer.innerHTML = productImageList;

        $(productMainSliderContainer).slick({
            infinite: true,
            slidesToShow: 1,
            slidesToScroll: 1,
            dots: false,
            autoplay: true,
            autoplaySpeed: 2000  
        });

        // mobile view SLider
        var mobileProductImageList = "";
        getProductImageList.forEach((imageList, index) => {
          mobileProductImageList += `<div class="slide">
                        <div class="lazyContainer">
                            <img src=${imageList} alt="" style="height:100%;width:100%" data-index="${index}" class="open-modal"/>
                        </div>
                    </div>`;
          
        });

        var thumbnailsImg = "";
        getProductImageList.forEach((imageList, index) => {
          thumbnailsImg += `<div data-index="${index}" class="thumbnail">
                              <img src=${imageList} alt="" style="height:100%;width:100%" data-index="${index}" />
                            </div>`;
        });

        productThumbnailContainer.forEach(ele => ele.innerHTML = thumbnailsImg )      
        productMobSliderContainer.innerHTML = mobileProductImageList;
        $(productMobSliderContainer).slick({
          infinite: true,
          slidesToShow: 1,
          slidesToScroll: 1,
          dots: false,
          autoplay: true,
          autoplaySpeed: 2000  
        });

      function updateActiveThumbnail(selector, index) {
        $(selector).removeClass('active');
        $(selector+'[data-index="' + index + '"]').addClass('active');
      }
      updateActiveThumbnail(".product-thumbnail .thumbnail", 0);
      function goToSlide(index) {
        $(productMainSliderContainer).slick('slickGoTo', index);
        $(productMobSliderContainer).slick('slickGoTo', index);
        updateActiveThumbnail(index);
      }
      $('.product-thumbnail .thumbnail').on('click', function() {
        var index = $(this).data('index'); // Get index from clicked thumbnail
        goToSlide(index);
      });      
      $(productMainSliderContainer).on('afterChange', function(event, slick, currentSlide) {
        updateActiveThumbnail(".pc-view .product-thumbnail .thumbnail",currentSlide);
      });
      $(productMobSliderContainer).on('afterChange', function(event, slick, currentSlide) {
        updateActiveThumbnail(".mobile-view .product-thumbnail .thumbnail", currentSlide);
      });

      const modal = $('#imageModal');
      const modalSliderContainer = $('.modal-slider');
      const closeModal = $('.close');

      $(document).on('click', '.open-modal', function () {
        const index = $(this).data('index');
        const imageSrc = $(this).attr('src');

        modalSliderContainer.html('');
        getProductImageList.forEach((image) => {
          modalSliderContainer.append(`<div><img src="${image}" alt="" /></div>`);
        });

        modalSliderContainer.slick({
          infinite: true,
          slidesToShow: 1,
          slidesToScroll: 1,
          initialSlide: index
        });

        modal.fadeIn();
      });

      closeModal.on('click', function () {
        modal.fadeOut();
        modalSliderContainer.slick('unslick');
      });

      $(window).on('click', function (e) {
        if ($(e.target).is(modal)) {
          modal.fadeOut();
          modalSliderContainer.slick('unslick');
        }
      });

        if (value && value.total_amount != '' && value.total_amount != null) {
          reorderproduct();
          setTimeout(() => {
            localStorage.removeItem("reorderdetails");
            }, 2000);
        } else {
          // $("#total_product_amount").html("₹" + response.data.price);
          $("#total_product_amount").html("₹" + response.data.price * 7);
