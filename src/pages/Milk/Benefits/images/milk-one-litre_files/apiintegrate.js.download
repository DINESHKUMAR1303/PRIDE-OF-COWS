    var offerStatus = 2;
    var couponid=localStorage.couponid;
  } else{
    var couponid='';
    var offerStatus = 0;
  }
  $.each(cartdata, function (i, it) {
    localStorage.removeItem("singlecart");
    localStorage.removeItem("multicart");
    if (it.DeliveryPlan == "once") {
