                    $('#promocodesuccess').html(`<div class="checkout__cart__coupon__row d-flex justify-space-between">
                                    <div class="checkout__cart__coupon__left d-flex noCoupon">
                                        <img src="../images/verify.png" alt="discount icon" loading="lazy" class="noCoupon" >${response.data.promocode_name} applied! 
                                        <a class="checkout__cart__coupon__remove text-blue underline noCoupon" id="promocodecouponremove" onclick="removepromocodeoffer()"> (Remove)</a>
                                    </div>
                                    <div class="checkout__cart__viewOffers_discount noCoupon">
                                        ${response.data.discount_value != 0 ?`  ₹ ${response.data.discount_value}` : ''}
                                    </div>
                                    <div class="checkout__cart__coupon__left d-flex">
                                        <div class="checkout__cart__viewOffers text-blue pointer" onclick="viewofferspromocode();"><b>VIEW OFFERS</b></div>
                                    </div></div>`);

                    $('.couponPopUp').attr('class', 'couponPopUp')
                   if (!isMatchProduct) { 
                       localStorage.discount_value = quantity!==0?  response.data.discount_value:0 ;
                       localStorage.promocode_name = response.data.promocode_name;
                       if(response.data.promocode_name === PRODUCT_OFFER.OFFER_CODE) {
                            localStorage.setItem("paneerPromocodeHandling", true);
                            localStorage.setItem("promocode_name", "");
                            if (promoIds != productIds) {
