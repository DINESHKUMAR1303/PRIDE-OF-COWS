                                                                 </div>
                                                                 </div>
                                                         </a></div>`;
            });
          });
        } else {
          $.each(response.data, function (i, it) {
            if (cname == i) {
              $.each(it, function (i1, it1) {
                productBox += `<div class="offers__row row">
                                                                 <div class="col-6 col-xs-12 hover-container">
                                                                 <a class="shopListing__box" onclick="getproductDetail(${it1.id}, '${it1.slug}', '${it1.category_slug}' ,'${it1.pre_launch_date}')" href="#">
                                                                 <div class="lazyContainer" >
                                                                         <img src="${it1.main_img}" alt="">
                                                                 </div>
                                                                 <div class="lazyContainer" style="--ratio:100%;">
                                                                         <img class="hover-trigger"onmouseover="showData()" onmouseout="hideData()" src="${it1.image}" alt="">
                                                                         <img class="gif" src="${it1.image}" alt="">
                                                                 <div class="shopListing__box__text">
                                                                         <p>${it1.banner_text}</p>
                                                                         <div>
                                                                                 <h3>${it1.product_display_name}</h3>
                                                                         
                                                                         </div>
                                                                 </div>
                                                                 </div>
                                                                 
                                                         </a>
