// getCartData();  
function getCartData() {
  var parseUserData = JSON.parse(localStorage.getItem("userdata"));
  $("#checkoutProducts").html(""); // always reset container

  // --- Case 1: Guest user → local cart ---
  if (!parseUserData) {
    var localCart = JSON.parse(localStorage.getItem("cart")) || [];

    if (localCart.length === 0) {
      $(".empty__cart").show();
      return;
    }

    $(".empty__cart").hide();
    $(".cartIcon__count").text(localCart.length);

    localCart.forEach(function (item, index) {
      let discountPercent = "";
      if (item.priceBeforeDiscount && item.priceBeforeDiscount > item.Price) {
        let discount = Math.round(((item.priceBeforeDiscount - item.Price) / item.priceBeforeDiscount) * 100);
        discountPercent = discount + "% OFF";
      }

      let deliveryHtml = `
        ${item.DeliveryPlan === "once" ? "Expected delivery" : "Delivery plan"}:
        <span>${moment(item.StartDate, ["DD/MM/YYYY", "YYYY-MM-DD"]).format("DD MMM YYYY")}</span>
      `;

      $("#checkoutProducts").append(`
        <div class="products-checkout">
          <div class="products-checkout-box">
            <div class="products-checkout-items">
              <div class="div1">
                <img src="${item.image}" alt="${item.Name}">
              </div>
              <div class="div2">
                <div class="product-inner-wrapper-1">
                  <p class="product-checkout-description">${item.Name}</p>
                  <p class="product-checkout-quantity">${item.unit_prod || ""}</p>
                  <p class="product-checkout-price">
                    ₹${item.Price}
                    ${item.priceBeforeDiscount ? `<span class="cross-mrp">MRP: ₹${item.priceBeforeDiscount}</span>` : ""}
                    ${discountPercent ? `<span class="discount-text">${discountPercent}</span>` : ""}
                  </p>
                </div>

                <div class="product-inner-wrapper-2">
                  ${item.is_stock_available
                    ? `<div class="inputNumber d-flex justify-end">
                          <div class="quantity-button-minus inputNumber__btn inputNumber__btn--down pointer" onclick="qtychange(this,'${item.ProductId}','minus','local_${index}')">-</div>
                          <input type="number" min="1" value="${item.Quantity}" readonly>
                          <div class="quantity-button-plus inputNumber__btn inputNumber__btn--up pointer" onclick="qtychange(this,'${item.ProductId}','plus','local_${index}')">+</div>
                       </div>`
                    : `<button class="btn-remove-checkout" onclick="removeLocalCart(${index})">Remove</button>`}
                </div>
              </div>
            </div>
            <div class="label-section">${deliveryHtml}</div>
          </div>
        </div>`);
    });

    $("span.showItemTotal").html(localCart.length + (localCart.length > 1 ? " items" : " item"));
    return;
  }

  // --- Case 2: Logged-in user → fetch from API ---
  // const poc_addresid = localStorage.getItem("selectedAddressId");
  $.ajax({
    url: baseCarturl + "cart/get-cart",
    method: "POST",
    headers: {
      Authorization: "Bearer " + parseUserData.token,
      "Content-Type": "application/json",
    },
    data: JSON.stringify({ 
      "addressId": poc_addressID,
      "City": parseUserData.city_id }),
  }).done(function (response) {
    if (response.status !== 1) return;

    $("#checkoutProducts").html("");
    // totalprice();

    if (!response.cartItems || response.cartItems.length < 1) {
      $(".empty__cart").show();
      return;
    }

    $(".cartIcon__count").text(response.cartItems.length);
    $(".empty__cart").hide();

    response.cartItems.forEach(function (it) {
      $("#checkoutProducts").append(`
        <div class="products-checkout">
          <div class="products-checkout-box">
            <div class="products-checkout-items">
              <div class="div1">
                <img src="${it.image}" alt="${it.name}">
              </div>
              <div class="div2">
                <div class="product-inner-wrapper-1">
                  <p class="product-checkout-description">${it.name}</p>
                  <p class="product-checkout-quantity">${it.weight || ""}</p>
                  <p class="product-checkout-price">
                    ₹${it.originalPrice}
                    ${it.priceBeforeDiscount ? `<span class="cross-mrp">MRP: ₹${it.priceBeforeDiscount}</span>` : ""}
                  </p>
                </div>
                <div class="product-inner-wrapper-2">
                  <div class="inputNumber d-flex justify-end">
                    <div class="quantity-button-minus inputNumber__btn inputNumber__btn--down pointer" onclick="qtyPlusMinus(this, '${it.ProductId}','minus')">-</div>
                    <input type="number" min="1" value="${it.Quantity}" readonly>
                    <div class="quantity-button-plus inputNumber__btn inputNumber__btn--up pointer" onclick="qtyPlusMinus(this, '${it.ProductId}','plus')">+</div>
                  </div>
                </div>
              </div>
            </div>
            <div class="label-section">
              ${it.DeliveryPlan === "once" ? "Expected delivery" : "Delivery plan"}:
              <span>${moment(it.deliveryDate, ["DD/MM/YYYY", "YYYY-MM-DD"]).format("DD MMM YYYY")}</span>
            </div>
          </div>
        </div>`);
    });

    $("span.showItemTotal").html(response.cartItems.length + (response.cartItems.length > 1 ? " items" : " item"));
  });
}

function addToCartProduct(pid, date, qty) {
  var userdata = JSON.parse(localStorage.getItem("userdata"));
  let cityId = userdata.city_id ? userdata.city_id : "329";
  if (!userdata) {
    return;
  }

  // Step 1: Get existing cart first
  $.ajax({
    url: baseCarturl + "cart/get-cart",
    method: "POST",
    headers: {
      "Authorization": "Bearer " + userdata.token,
      "Content-Type": "application/json"
    },
    data: JSON.stringify({ 
      "addressId": poc_addressID,
      "City": cityId }),
  }).done(function (response) {
    if (response.status === 1) {
      let cartItems = response.cartItems || [];
      let existingItem = cartItems.find(item => String(item.UniqueId) === String(pid));

      if (!existingItem) {
        // 🚀 Case 1: No product found → add new item
        let payload = {
          product_id: pid,
          qty: qty,
          order_date: date,
          City: cityId
        };
        if (poc_addressID) {
          payload.addressId = poc_addressID;
        }
        $.ajax({
          url: baseCarturl + "cart/add-to-shopping-cart",
          method: "POST",
          headers: {
            Authorization: "Bearer " + userdata.token,
            "Content-Type": "application/json",
          },
          data: JSON.stringify(payload),
        }).done(function (res) {
          if (res.status === 1) {
            getCartData();
            $("#showcartmodal").addClass("active");
            setTimeout(() => $("#showcartmodal").removeClass("active"), 3000);
            $(".cartIcon__count").addClass("show_cartIconCount");
            $(".bottom-bar .cartIcon__count, .header__right .cartIcon__count.show_cartIconCount").css("display", "flex");
            setCartCount();
          }
        });

      } else {
        if (existingItem.deliveryDate === date) {
          // 🚀 Case 2: Same product + same date → update quantity
          // let newQty = parseInt(existingItem.Quantity) + parseInt(qty);
          var newQty = $("#itemQuantity").val();
          updateCartQuantity(existingItem.UniqueId, newQty);

        } else {
          // 🚀 Case 3: Same product + different date → update date
          updateCartDate(existingItem.cart_id, date);
        }
      }
    }
  }).fail(function (xhr, status, error) {
    console.error("Get-cart API error:", error);
  });
}


function removeFromCart(cart_id, product_id) {
  var userdata = JSON.parse(localStorage.getItem('userdata'));
  var payload = {};

  // If both cart_id and product_id are provided, send both
  if (cart_id && product_id) {
    payload = { cart_id: cart_id, addressId: poc_addressID };
  } else if (cart_id) {
    payload = { cart_id: cart_id, addressId: poc_addressID };
  } else if (product_id) {
    payload = { cart_id: product_id, addressId: poc_addressID };
  }

  var settings = {
    "url": baseCarturl + "cart/remove-from-cart",
    "method": "POST",
    "headers": {
      "Authorization": "Bearer " + userdata.token,
      "Content-Type": "application/json"
    },
    "data": JSON.stringify(payload)
  };

  $.ajax(settings).done(function (response) {
    if (response.status === 1) {
      loadCartItems();
      totalSaveProductId();
      removeOfferFromLocalStorage();

      $(".new_buynew").text("Buy Now").removeClass("active");
      $('#itemQuantity').val(1);

      // Update localStorage cart if needed
      let cart = JSON.parse(localStorage.getItem("cart")) || [];
      let updatedCart = cart.filter(item =>
        String(item.ProductId) !== String(product_id) &&
        String(item.ProductId) !== String(cart_id)
      );
      localStorage.setItem("cart", JSON.stringify(updatedCart));
      if ($('.prod-container.mobilecalendar').length === 0) {
        $('.pro_to_checkout').hide();
      }
    } else {
      console.error("Remove failed:", response.message);
    }
  }).fail(function (err) {
    console.error("Error removing item:", err);
  });
}

function getCartIdByProductId(productId) {
  return new Promise((resolve, reject) => {
    const userdata = JSON.parse(localStorage.getItem('userdata'));
    if (!userdata?.token) {
      return reject("User not logged in or token missing");
    }

    $.ajax({
      url: baseCarturl + "cart/get-cart",
      method: "POST",
      headers: {
        "Authorization": "Bearer " + userdata.token,
        "Content-Type": "application/json"
      },
      data: JSON.stringify({ 
        "addressId": poc_addressID,
        "City": userdata.city_id
      }),
    })
    .done(cartResponse => {
      const matchedItem = cartResponse?.cartItems?.find(item => item.UniqueId == productId);
      matchedItem?.cart_id 
        ? resolve(matchedItem.cart_id) 
        : reject(`No matching cart item found for productId: ${productId}`);
    })
    .fail((xhr, status, error) => reject(`Get-cart API error: ${error}`));
  });
}

