function walletTransHistory(historyCount) {
  $('.transactions-preloader').hide();
  $('#more-transactions').hide();
  var userdata = localStorage.getItem("userdata", userdata);
  var data = JSON.parse(userdata);
  var token = data.token;
  var page = 1;
  var pageSize = 10;
  if ($('#transaction_history > .transaction__item').length >= historyCount) {
    return false;
  }
  if ($('#transaction_history > .transaction__item').length >= pageSize) {
    page = Math.ceil($('#transaction_history > .transaction__item').length / pageSize) + 1;
  }
  if (historyCount > pageSize) {
    $('#more-transactions').show();
  }
  var settings = {
    url: baseUrl + "wallet-history",
    method: "POST",
    headers: {
      "Content-Type": "application/json",
      Authorization: "Bearer " + token,
    },
    data: JSON.stringify({
      'page': page,
      'cust_id': data.UserID
    }),
    beforeSend: () => {
      $('.transactions-preloader').show();
      $('#more-transactions').hide();
    }
  };
  $.ajax(settings).done(function (response) {
    $('.transactions-preloader').hide();
    $('#more-transactions').show();
    if (response.status == 1) {
      if (response.data) {
        $.each(response.data, function (i, it) {
          var dt = new Date(it.created_dt);
          var createDate = dt.toLocaleString('en-UK', {
            day: '2-digit',
            month: 'short',
            year: 'numeric',
            hour: '2-digit',
            minute: '2-digit',
            second: '2-digit',
            hour12: true,
          });
          var sign = '+';
          var style = '';
          if (it.amount < 0) {
            sign = '-';
            style = 'style="color:orange;"';
          }
          if (it.trans_id == null) {
            it.trans_id = '';
          }
          if (it.detail == null) {
            it.detail = '';
          }
          var amount = Math.abs(it.amount);
          $(".histry_section").append( `
              <div class="transaction__item">
                <div class="transaction__box">
                  <div class="transaction__left">
                    <div class="icon-wrapper">
                      <img src="../images/wallet_trans_histroy.png" alt="wallettranshistroy" />
                    </div>
                    <div class="details">
                      <div class="title">${it.detail}</div>
                      <div class="date">${createDate}</div>
                      <div class="balance">Wallet Balance: <span>₹${amount}</span></div>
                    </div>
                  </div>
                  <div class="transaction__right ${sign === '+' ? 'credit' : 'debit'}">
                    ${sign}₹${amount}
                  </div>
                </div>
              </div>
            `);
          if ($('#transaction_history > .transaction__item').length >= historyCount) {
            $('#more-transactions').hide();
          }
        });
      }
    } else {
      //showAlert(response.message, "Error", "OK");
    }
  });
}

function formatDateTime(dateTimeStr) {
    const dateObj = new Date(dateTimeStr.replace(/-/g, "/"));
    const date = dateObj.toLocaleDateString('en-GB', {
        day: '2-digit', month: 'short', year: 'numeric'
    });
    const time = dateObj.toLocaleTimeString([], {
        hour: '2-digit',
        minute: '2-digit',
        hour12: true
    });
    return `${time}, ${date}`;
}

// special offer code start
function specialOffer() {
    var userdata = localStorage.getItem('userdata');
    const data = JSON.parse(userdata);
    var token = data.token;
    var cart = localStorage.getItem('cart');
    const cartdata = JSON.parse(cart);
    var pdata = '';
    var promocode_for = localStorage.getItem('promocode_for');
    if (cartdata) {
        var product = {};
        $.each(cartdata, function(i, it) {
            product[it.ProductId] = it.ProductId;
        });
        localStorage.setItem('productdata', JSON.stringify(product));
        var productdata = localStorage.getItem('productdata');
        var pdata = JSON.parse(productdata);
        var totalval = localStorage.getItem('totalPayableAmount');
    }

    var proddata = JSON.stringify(pdata);

  //   var settings = {
  //   "url": baseCarturl + "cart/get-cart",
  //   "method": "POST",
  //   "headers": {
  //     "Authorization": "Bearer " + parsedUserdata.token,
  //     "Content-Type": "application/json"
  //   },
  //   data: JSON.stringify({
  //     addressId: poc_addresid,
  //   }),
  // };
  //   $.ajax(settings).done(function (response) { 
  //     var uniqueIds = response.cartItems.map(function(item) {
  //   return item.UniqueId;
  //   });

  //   console.log(uniqueIds);
  // });

    var settings = {
        "url": baseurl + "productpromocode",
        "method": "POST",
        "timeout": 0,
        "headers": {
            "Content-Type": "application/json",
            "Authorization": "Bearer " + token,
        },
        "data": JSON.stringify({
            "product": proddata,
            "promocode_for": "product",
            "minimum_cart_value": totalval,
            'custid': data.UserID,
            'city': data.city_id,
            'custtype': data.customer_type,
        }),
    };

    $.ajax(settings).done(function(response) {
        $(".offer-box").empty().removeClass("slick-initialized slick-slider");
        if (response.status == 1 && response.data.length > 0) {
            if(promocode_for !== "product") {
            response.data.forEach(function(offer) {
                let metadata = {};
                try {
                    metadata = JSON.parse(offer.metadata || "{}");
                } catch (e) {
                    console.log("Invalid metadata JSON for:", offer.promo_code);
                }
                const offerHtml = `
                    <div class="ghee-offer-box d-flex">
                        <div class="blue_strip"></div>
                        <div class="d-flex justify-space-between flex-fill">
                            <div class="ghee-offer-left d-flex">
                                <img src="${metadata.image}" alt="${metadata.title}" loading="lazy">
                                <div class="ghee-offer-details d-flex flex-column align-start">
                                    <h6 class="fw-600 mt-0">${metadata.title}</h6>
                                    <p class="mt-0">${metadata.subtitle}</p>
                                </div>
                            </div>
                            <div class="d-flex flex-column">
                            <button class="ghee-apply-btn" onclick="applyPromocode('${offer.promo_code}')">Apply</button>
                            <div class="tncInfo" onclick="viewofferspromocode();">T&C</div>
                            </div>
                        </div>
                    </div>
                `;
                $(".offer-box").append(offerHtml);
            });
        }
            if (response.data.length >= 2) {
                $(".offer-box").slick({
                    dots: true,
                    infinite: false,
                    speed: 500,
                    slidesToShow: 1,
                    slidesToScroll: 1,
                    autoplay: true,
                    autoplaySpeed: 3000,
                    arrows: false,
                    swipe: true,
                    touchMove: true,
                });
            }
        }
    });
}
// special offer code end

    function applyPromocode(code = '',ref_no='') {

        // start campaign apply coupon
        var cartdata = localStorage.getItem("cart") || "[]";
        var cartdataNew = JSON.parse(cartdata);
        var productQtyString = cartdataNew
        .map(function (item) {
        return item.ProductId + ':' + item.Quantity;
        })
        .join(',');
        submitCampaignDetails(CAMPAIGN_EVENTS.CATEGORY_Apply_Coupon, productQtyString);
        // end campaign apply coupon
        var userdata = localStorage.getItem('userdata', userdata);
        const data = JSON.parse(userdata);
        var token = data.token;
        var promo_code = code;
        var city = data.city_id;
        var productIds = cartdataNew.map(item => item.ProductId);
        var min_amount = localStorage.getItem('totalval');
        if (promo_code == '') {
            promo_code = $('#promocodeD').val();
        }
        var cartitem = '';
        if (cartdataNew && cartdataNew.length > 0) {
          cartitem = cartdataNew.map(function(it) {
            return it.ProductId + ":" + it.Price + ":" + it.Quantity + ":" + it.totalPriceItem;
          }).join("|");
        }
        var settings = {
            "url": baseurl + "productpromocodemapping",
            "method": "POST",
            "timeout": 0,
            "headers": {
                "Content-Type": "application/json",
                "Authorization": "Bearer " + token,
            },
            "data": JSON.stringify({
                "promo_code": promo_code,
                "productId": productIds.join(","),
                "min_amount": min_amount,
                "promo_type":"product",
                "cartItem":cartitem,
            }),
        };

        $.ajax(settings).done(function(response)
        {
            if (response.status == 1) {
              $("#coupon-default").hide();
              $("#coupon-applied").show();
              $("#image-offer").attr("src", localStorage.getItem("appliedOfferImage")).show();
              
              localStorage.setItem("tandC_metadat",response.data.metadata.tnc);
                // Dynamic text 
               let code = response.data.promo_code;
              
                // Show subtitle instead of "1 unit"
               let offerText = response.data.metadata.title;
               let offerImage = response.data.metadata.image;
               $("#applied-offer-text").text(`${offerText}`);
               $("#applied-code").text(`(${code})`);
               $("#image-offer").attr("src", offerImage);
               // product offer code object
              var PRODUCT_OFFER = {
                OFFER_CODE: response.data.promo_code
              };
              
               // save for reload
               localStorage.setItem("couponApplied", "true");
               localStorage.setItem("appliedCode", `(${code})`);
               localStorage.setItem("appliedOfferText", `${offerText}`);
               localStorage.setItem("appliedOfferImage", offerImage);

                localStorage.setItem("offerItem", 1);
                var Productcart = localStorage.getItem('cart', Productcart);
                var offercart = localStorage.getItem('offercart', offercart);
                var promocodeProduct = response.data.product;
                var cartDataPromo = JSON.parse(Productcart);
                localStorage.setItem('productOfferId', response.data.product);
                localStorage.setItem('offer_product_id', response.data.offer_product_id);
                var promoIds = promocodeProduct
                .split('#')         
                .filter(id => id);   
                var isMatchProduct = promoIds.some(promoId =>
                cartDataPromo.some(item => item.ProductId == promoId)
                );
                localStorage.setItem("matchProduct", isMatchProduct);
                let promoOfferPoruductId = promoIds.map(Number).join(', ');
                localStorage.setItem("promoOfferPoruductId",promoOfferPoruductId);
                localStorage.removeItem('promocode_for');
                if (offercart) {
                            var myData1 = JSON.parse(offercart);
                            $.each(myData1, function(key, value) {
                                var myData = value;
                                var data = JSON.parse(Productcart);
                                var data = $.grep(data, function(e) {
                                    return e.ProductId != value.ProductId;
                                });
                                data.push(myData);
                                localStorage.setItem('cart', JSON.stringify(data));
                            });
                            localStorage.removeItem('offercart');
                            localStorage.removeItem('offeredprice');
                            $('#removeaftersuccess').html('');
                            $('#promocodesuccess').attr('onclick', '');
                            $('#promocodesuccess').html(`<div class="checkout__cart__coupon__row d-flex justify-space-between">
                                    <div class="checkout__cart__coupon__left d-flex">
                                        <img src="../images/verify.png" alt="discount icon" loading="lazy" >${response.data.promocode_name} applied! 
                                        <a class="checkout__cart__coupon__remove text-blue underline" id="promocodecouponremove" onclick="removepromocodeoffer()"> (Remove)</a>
                                    </div>
                                    <div class="checkout__cart__viewOffers_discount">
                                        ${response.data.discount_value != 0 ?`  ₹ ${response.data.discount_value}` : ''}
                                    </div>
                                    <div class="checkout__cart__coupon__left d-flex">
                                        <div class="checkout__cart__viewOffers text-blue pointer" onclick="viewofferspromocode();"><b>VIEW OFFERS</b></div>
                                    </div></div>`);

                            $('.couponPopUp').attr('class', 'couponPopUp')

                            localStorage.discount_value = response.data.discount_value;
                            localStorage.couponid = ref_no;
                            localStorage.promocode_name = response.data.promocode_name;
                            localStorage.offeredprice = response.data.discount_value;
                            const poc_addresid = localStorage.getItem("selectedAddressId");

                            if (response.data.offer_product_id != 0) {
                                var settings = {
                                    "url": baseurl + "productdetail",
                                    "method": "POST",
                                    "timeout": 0,
                                    "headers": {
                                        "Content-Type": "application/json",
                                        "Authorization": "Bearer " + token
                                    },
                                    "data": JSON.stringify({
                                        "ProductID": response.data.offer_product_id,
                                        "City": city,
                                        "addressId": poc_addresid,
                                    }),
                                };
                                $.ajax(settings).done(function(resp) {
                                    if (resp.status == 1) {
                                        if (resp.data) {
                                            prod_id = response.data.product;
                                            prod_id = prod_id.replace(/#/g, '');
                                            var cart = JSON.parse(localStorage.getItem('cart')) || [];

                                            var product_arr = cart.find(item => item.ProductId === prod_id);
                                            if (product_arr) {
                                                const newProduct = {
                                                    "ProductId": response.data.offer_product_id,
                                                    "Quantity": parseInt(localStorage.result_quantity),
                                                    "Price": resp.data.price,
                                                    "DeliveryPlan": product_arr.DeliveryPlan,
                                                    "StartDate": product_arr.StartDate,
                                                    "EndDate": product_arr.StartDate,
                                                    "Name": resp.data.name,
                                                    "diffDays": 1,
                                                    "totalPrice": localStorage.result_quantity*localStorage.offeredprice,
                                                    "totalPriceItem": localStorage.result_quantity*localStorage.offeredprice,
                                                    "main_img": resp.data.main_img,
                                                    "currVlaue": localStorage.result_quantity,
                                                    "taxprice": resp.data.taxamount,
                                                    "category_prod": resp.data.catagory,
                                                    "unit_prod": resp.data.product_unit,
                                                    "slug": "",
                                                    "parent_id": prod_id
                                                };
                                                const productIndex = cart.findIndex(item => item.ProductId === newProduct.ProductId);

                                                if (productIndex !== -1) {
                                                    cart.splice(productIndex, 1);
                                                }

                                                cart.push(newProduct);
                                                localStorage.setItem('cart', JSON.stringify(cart));
                                            }


                                        }
                                    }
                                })
                            }

                    setTimeout(() => {
                        window.location.href = url + 'checkout';
                    }, 3000);
                } else {
                    if(response.data.promocode_for=='refferal' || response.data.promocode_for=='refferee'){
                        localStorage.discount_value = response.data.discount_value ;
                        localStorage.promocode_name = response.data.promocode_name;
                        localStorage.promocode_for = response.data.promocode_for;
                        localStorage.couponid = ref_no || 0;
                        localStorage.referrer_no = $('#promocodeD').val();
                        var amnt = parseInt(localStorage.totalval);
                        if (response.data.promocode_for == 'refferee' && amnt < response.data.minimum_cart_value) {
                                $(".checkout__cart__coupon__row").html(`
                                    <span class="error-message">Add ₹${response.data.minimum_cart_value-localStorage.totalval} or more now to unlock your referral coupon!</span>
                                    <div class="checkout__cart__coupon__left d-flex">
                                        <a class="checkout__cart__coupon__remove text-blue underline" id="promocodecouponremove" onclick="removepromocodeoffer()"> (Remove)</a>
                                        <a class="checkout__cart__viewOffers text-blue pointer" onclick="viewofferspromocode();"><b>VIEW OFFERS</b></a>
                                    </div>
                                `);
                                localStorage.removeItem('discount_value');
                                localStorage.removeItem('offeredprice');
                                localStorage.removeItem('referrer_no');
                                localStorage.removeItem('couponid');
                        }

                        if (response.data.promocode_for == 'refferal' && (amnt < parseInt(response.data.discount_value))) {
                            $(".checkout__cart__coupon__row").html(`
                                <span class="error-message">Please Add cart item more then discount amount</span>
                                <div class="checkout__cart__coupon__left d-flex">
                                <a class="checkout__cart__coupon__remove text-blue underline" id="promocodecouponremove" onclick="removepromocodeoffer()"> (Remove)</a>
                                    <a class="checkout__cart__viewOffers text-blue pointer" onclick="viewofferspromocode();"><b>VIEW OFFERS</b></as>
                                </div>
                            `);
                        localStorage.removeItem('discount_value');
                        localStorage.removeItem('promocode_for');
                        localStorage.removeItem('offeredprice');
                        localStorage.removeItem('couponid');
                        }
                        
                        $('#fade').hide();
                        $('#removeaftersuccess').html('');
                        $('#promocodesuccess').attr('onclick', '');
                        $('#promocodesuccess').html(`<div class="checkout__cart__coupon__row d-flex justify-space-between">
                                    <div class="checkout__cart__coupon__left d-flex">
                                        <img src="../images/verify.png" alt="discount icon" loading="lazy">${response.data.description} 
                                        <a class="checkout__cart__coupon__remove text-blue"> ${response.data.promocode_name} applied!</a>
                                        <div class="checkout__cart__viewOffers_discount">
                                        ${response.data.discount_value != 0 ?`  ₹ ${response.data.discount_value}` : ''}
                                        </div>
                                        <a class="checkout__cart__coupon__remove text-blue underline" id="promocodecouponremove" onclick="removepromocodeoffer()"> (Remove)</a>
                                        <div class="checkout__cart__coupon__left d-flex text-blue pointer" onclick="viewofferspromocode();"><b>VIEW OFFERS</b></div>
                                    
                                        </div>
                                    </div>`);

                    $('.couponPopUp').attr('class', 'couponPopUp')
                    if(localStorage.promocode_for =='refferal'){ 
                        $(".showcheckoutRewardDiscount").html("₹ "+localStorage.discount_value );
                        // checksubsciption();
                    }
                    
                    }else{
                    var cartVAl = JSON.parse(localStorage.getItem('cart')) || [];
                    try{
                    var pid = response.data.product.replace(/#/g, '');
