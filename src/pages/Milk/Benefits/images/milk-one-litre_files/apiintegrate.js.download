/**
 * Send push event to Google Analytics with try catch handling
 * @param {Object} eventData Event object to be sent to GA dataLayer
 * @param {string} eventData.event Event name 
 */

const referNearnWalletAmount = '2000';
var lottieurl = window.location.origin + "/poc/";
var cartProductItemFetch = {};
var PRODUCT_OFFER = {};

function gaEvent(eventData) {
  try {
    // alert(JSON.stringify(eventData))
    window.dataLayer = window.dataLayer || [];
    window.dataLayer.push(eventData);
  } catch (err) {
  }
}

function actionCategory() {
  const poc_addresid = localStorage.getItem("selectedAddressId");
  var userdata = localStorage.getItem("userdata", userdata);
  var data = JSON.parse(userdata);
  if (data) {
    var city = data.city;
    var isSubscribe = 0;
    var token = data.token;
  } else {
    var city = "";
    var token = "";
  }
  var settings = {
    url: baseUrl + "categorywiseproductlist",
    headers: {
      "Content-Type": "application/json",
      Authorization: "Bearer " + token,
    },
    method: "POST",
    data: JSON.stringify({
      City: city,
      IsSubscribe: isSubscribe,
      pre_launch: 2,
      addressId: poc_addresid
    }),
  };
  $.ajax(settings).done(function (response) {
    if (response.status == 1) {
      $("#preloader").hide();
      if (response.data) {
        var productBox = "";
        $("#category_product1").append(`
                        <li data-cls="All" id="all"> <a onclick="productdetails('all')">All</a></li>
                        `);
        $.each(response.data, function (i, it) {
          $("#category_product1").append(
            `<li data-cls="milk"> <a onclick="productdetails(${i}, '${it.category_slug}')">${i}</a></li>`
          );
        });
      }
    } else {
      showAlert(response.message, "Error", "OK");
    }
  });
}
function productdetails(cname, category_slug, catName) {
  try{
  const currSlideIndex = $(event.target || event.srcElement).closest(".hero__box.slick-slide").data("slick-index");
  gaEvent({
      'event': 'banner_click',
      'current_page': "Home",
      'position': currSlideIndex,
      'banner_name': currSlideIndex,
      'component_type': "button",
      'component_name': "shop_now_banner"
    });
   } catch (err) {
   }
   if(catName){
     localStorage.setItem("filterCategory", catName)
   }
  localStorage.setItem("cname", cname);
  window.location.href = weburl + 'shop/' + category_slug;
}
function imageviews(cname) {
  $(".catimages").removeClass("active");
  $(".category" + cname).addClass("active");
}

