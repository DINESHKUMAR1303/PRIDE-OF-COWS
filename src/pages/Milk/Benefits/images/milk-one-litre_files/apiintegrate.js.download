        $("#contactCard").append(`
          <div class="contsctBox d-flex justify-spc-bet mb-10">
            <div class="left-sec d-flex">
              <div class="picbx">
                ${it.invited_name.split(" ").slice(0, 2).map(i => i.charAt(0).toUpperCase()).join("")}
              </div>
              <div>
                <p class="text-blue fs-14">${it.invited_name || "-" }</p>
                <p class="text-grey fs-12">${it.phone_number}</p>
                ${statusText}
              </div>
            </div>
            <div class="right-sec d-flex text-right">
              ${buttonsHTML}
            </div>
          </div>`);
      });
      //  reward_list
      rewardList.forEach(function (it) {
        let rewardHTML = "";
        if (it.invited_status == 1 && it.is_redeem == "0") {
          rewardHTML = `<a href="rewards" class="btn btn-primary reedemmoney" 
          data-event="Click_Redeem"
          data-category="Referral"
          data-label="${it.invited_name} - ${it.phone_number}"
          >Redeem ₹500</a>`;
        } else if (it.is_redeem == "1") {
          rewardHTML = `<button type="button" class="btn btn-primary reedemed"  data-event="Click_Redeemed_Already"
          data-category="Referral"
          data-label="${it.invited_name} - ${it.phone_number}">Redeemed</button>`;
        }
        $("#contactCard").append(`
          <div class="contsctBox d-flex justify-spc-bet mb-10">
            <div class="left-sec d-flex">
              <div class="picbx">${it.invited_name.split(" ").slice(0, 2).map(i => i.charAt(0).toUpperCase()).join("")}</div>
              <div>
                <p class="text-blue fs-14">${it.invited_name || "-"}</p>
                <p class="text-grey fs-12">${it.phone_number}</p>
                <p class="fs-12 text-green">Success</p>
              </div>
            </div>
            <div class="right-sec d-flex text-right">
              ${rewardHTML}
            </div>
          </div>`);
      });
    } else {
          $("#contactCard").append(`
            <div class="norfrlsytBox">
              <p class="text1"> No referrals yet. </p>
              <p class="text2">Invite friends and start earning rewards!</p>
            </div>`);
      }
    });
  }

function sendWhatsAppMessage(phone, name, invitedCode) {
const wmessage = `Hi! 
I’m enjoying farm fresh single origin milk from Pride of Cows & you can too! Get ₹500 bonus on your first ₹2000 recharge. 
Use my referral code: ${invitedCode} 
Start here: https://onelink.to/poc-wallet-offer
Trust me, your mornings will thank you!
- ${name}`;
  const encodedMessagew = encodeURIComponent(wmessage);
  const whatsappUrl = `https://wa.me/${phone}?text=${encodedMessagew}`;

  window.open(whatsappUrl, '_blank');
}

function shareInvite(elem) {
    const name = elem.getAttribute("data-name");
    const phone = elem.getAttribute("data-number");
    const invitedCodeShare = elem.getAttribute("data-invitedCoupon");
    const message = `Hi! \nI’m enjoying farm fresh single origin milk from Pride of Cows & you can too! Get ₹500 bonus on your first ₹2000 recharge. Use my referral code: ${invitedCodeShare} Start here: https://onelink.to/poc-wallet-offer 
Trust me, your mornings will thank you! \n
- ${name}`;
    if (navigator.share) {
      navigator
        .share({
          title: "Refer & Earn - Pride of Cows",
          text: message 
        })
        .then(() => gaEvent({
            event: 'click_share',
            custId: elem.dataset.custid,
            invited_name: elem.dataset.name,
            phone: elem.dataset.number
                    })
        )
        .catch((err) => console.error("Sharing failed", err));
    } else {
      copyTextToClipboard(message);
      Swal.fire({
        title: "Copied to clipboard!",
        text: "You can now paste and send the referral message.",
        icon: "success",
        confirmButtonText: "OK",
      });
    }
  }

function copyTextToClipboard(text) {
    const temp = document.createElement("textarea");
    temp.value = text;
    document.body.appendChild(temp);
    temp.select();
    document.execCommand("copy");
    document.body.removeChild(temp);
}

  function confirmReminderSwal(el) {
    const name = el.getAttribute("data-name");
    Swal.fire({
       html: `
        <dotlottie-player
          src="${lottieurl}images/refralsent.lottie"
          background="transparent"
          speed="1"
          class="messagesentlottie"
          autoplay>
        </dotlottie-player>
        <h2 class="class="swal-title custom-gold-title mt-10 " style="color:#AE8A49">Send Reminder?</h2>
        <p class="swal-text text-black mt-0">A referral invite has already been sent to ${name}.</p>
        <p class="swal-text text-black second-text">Would you like to send a reminder?</p>
    `,
        showCancelButton: true,
        cancelButtonText: 'Cancel',
        confirmButtonText: 'Remind Now',
        reverseButtons: true,
        customClass: {
        popup: 'custom-swal-popup',
        title: 'swal-title custom-gold-title',
        htmlContainer: 'swal-text-container mt-0',
        image: 'swal-image',
        confirmButton: 'swal-button w-50',
        cancelButton: 'btn btn-transparent cancel-btn',
        actions: 'swal-actions-row'
    }
    }).then((result) => {
      if (result.isConfirmed) {
         sendRemindAlert(el)
         gaEvent({
                  event: 'click_reminder',
                  custId: elem.dataset.custid,
                  invited_name: elem.dataset.name,
                  reminder_count: elem.dataset.count,
                  referid:elm.dataset.refer_id,
                });

      }
    });
  }


  function sendRemindAlert(el) {
    var userdata = localStorage.getItem("userdata");
    var data = JSON.parse(userdata);
    if (data) {
        const referId = el.getAttribute("data-referid");
        $.ajax({
        method: "post",
        url: baseurl + "get-reminder",
        headers: {
        Authorization: "Bearer " + data.token,
    },
        data: {
        referId:referId,
    },
    success: function (resp) {
      if(resp.status=== 1){
        const name = el.getAttribute("data-name");
        let count = parseInt(el.getAttribute("data-count"));
        const max = parseInt(el.getAttribute("data-max"));
        count++;
        const remindersLeft = max - count;
        el.setAttribute("data-count", count);
        if (count >= max) {
          el.style.opacity = 0.3; 
          el.style.pointerEvents = "none"; 
          el.title = "Reminder limit reached"; 
        }
        if (count >= max) {
                  Swal.fire({
                    title: 'Limit Reached',
                    text: `You have already sent the maximum number of reminders to ${name}.`,
                    icon: 'info',
                    confirmButtonText: 'OK'
                  });
                  return;
        }
        Swal.fire({
            html: `
            <dotlottie-player
              src="${lottieurl}images/refralsent.lottie"
              background="transparent"
              speed="1"
              class="messagesentlottie"
              autoplay>
            </dotlottie-player>
            <h2 class="class="swal-title mt-10" style="color:#AE8A49">Reminder Sent!</h2>
              <p class="swal-text text-black mt-0">You’ve successfully sent a reminder to ${name}.</p>
              <p class="swal-text text-black second-text">${remindersLeft} out of ${max} reminders left.</p>
            `,
            imageWidth: 140,
            imageHeight: 140,
            imageAlt: 'Success icon',
            confirmButtonText: 'Done',
            confirmButtonColor: '#ffffff',
            customClass: {
            popup: 'custom-swal-popup',
            title: 'swal-title',
            htmlContainer: 'swal-text-container mt-0',
            image: 'swal-image',
            confirmButton: 'swal-button'
            }
        }).then(() => {
            location.reload(); 
        });
      }else{
              Swal.fire({
                  icon: "error",
                  title: "Failed!",
                  text: "Unable to send the reminder. Please try again.",
              });
            }
          }})
        }else{
          Swal.fire({
            icon: "error",
            title: "Failed!",
            text: "Unable to send the reminder. Please try again.",
          }); 
        }
  }

function getcwalletbalance() {
  var userdata = localStorage["userdata"]
    ? JSON.parse(localStorage["userdata"])
    : {};
  if (userdata) {
    var token = userdata.token;
    var settings = {
      url: baseUrl + "getwallet",
      method: "POST",
      headers: {
        Authorization: "Bearer " + token,
        "Content-Type": "application/json",
      },
    };
    $.ajax(settings).done(function (response) {
      if (response.status == 1) {
        localStorage.balance = response.data.balance;
        $(".wallet-balance").html("₹" + response.data.balance);
      }else{
        localStorage.balance = 0;
      }
      if(typeof populateAmoutDetails === "function"){
        populateAmoutDetails();
      }
    });
  }
}

function cartviews() {
  const cartList = updateCartStore.getState();
  //cartList);
  var orderTotal = (totalItem = notsubscribeamount = 0);
  var is_subscribe = 1;
  var cartitem = (dedatee = "");
  var userdata = localStorage.getItem("userdata");
  userdata = JSON.parse(userdata);
  var cartItemBox = "";
  if (cartList.cart) {
    $.each(cartList.cartItems, function (i, it) {
      totalItem += parseInt(it.Quantity);
      orderTotal = orderTotal + it.Quantity * it.Price;
      if (it.is_payment == 1) {
        notsubscribeamount += parseInt(it.Price * it.Quantity);
        is_subscribe = 0;
      }
      cartitem +=
        it.ProductId +
        ":" +
        it.Price +
        ":" +
        it.Quantity +
        ":" +
        moment(it.Date).format("YYYY-MM-DD") +
        "|";

      var product = {};
      product["name"] = it.Name;
      product["id"] = it.ProductId;
      var UniqueId = it.UniqueId;

      dedatee = moment(it.Date).format("DD MMMM YYYY");
    });
  }

  if (cartList.subcart) {
    dedatee = moment(localStorage.mindate).format("DD MMMM YYYY");
    $.each(cartList.subcartItems, function (i, it) {
      totalItem += parseInt(it.Quantity);
      orderTotal = orderTotal + it.orderTotal;
      cartitem +=
        it.ProductId +
        ":" +
        it.Price +
        ":" +
        it.Quantity +
        ":" +
        it.orderTotal +
        "|";
    });
  }
  getcwalletbalance();
  var walletBalance = localStorage.balance ? localStorage.balance : 0;
  var totalPay = 0;
  if (userdata && userdata.customer_type == "prepaid") {
    totalPay = walletBalance > orderTotal ? 0 : orderTotal - walletBalance;
  } else if (
    userdata &&
    userdata.customer_type == "Postpaid" &&
    is_subscribe == 0
  ) {
    totalPay =
      walletBalance > notsubscribeamount
        ? orderTotal - notsubscribeamount
        : notsubscribeamount -
        walletBalance +
        (orderTotal - notsubscribeamount);
  } else if (
    userdata &&
    userdata.customer_type == "Postpaid" &&
    is_subscribe == 1
  ) {
    totalPay = orderTotal;
  } else {
    totalPay = orderTotal;
  }
}
function setDateZero(date) {
  date = parseInt(date) * 1;
  return parseInt(date) < 10 ? "0" + date : date;
}

function logPurchaseEvent(TotalPay) {
  // start make payment gaEvent tracking
  var city_data = JSON.parse(localStorage.getItem("citydata"));
  var cart_data_event = JSON.parse(localStorage.getItem("cart"));
  var items_data = [];
  if (cart_data_event) {
    try {
      for (var i in cart_data_event) {
        items_data.push({
          index: parseInt(i),
          item_id: cart_data_event[i]["ProductId"],
          item_name: cart_data_event[i]["Name"],
          item_brand: "Pride Of Cows",
          item_category: cart_data_event[i]["category_prod"],
          item_variant: cart_data_event[i]["unit_prod"],
          quantity: cart_data_event[i]["Quantity"],
          location_id: city_data.city,
          discount: cart_data_event[i]["priceDiscountPercentage"] !== undefined ? cart_data_event[i]["priceDiscountPercentage"] : "0",
          price: Number(cart_data_event[i]["Price"]),
        });
      }
      var jsonEvent = {
        event: "purchase",
        items: items_data,
        currency: "INR",
        value: TotalPay,
      };
      gaEvent(jsonEvent);
    } catch (err) {
      console.error("Error parsing cart data:", err);
    }
  }
  // end make payment gaEvent tracking
}

