        });

        // Reward History Content Show/Hide
        $(".reward___btn .btn").on("click", function (e) {
          e.preventDefault();
          let $history = $(this).attr("data-history");
          $(".reward___btn .btn").removeClass("active");
          $(this).addClass("active");

          $(".reward_history_block").removeClass("active");
          $("." + $history).addClass("active");
        });

        $(".cartUpdatedDialog__close").on("click", function () {
          $(".redeem-coupon").removeClass("open");
        });

        $(".cartUpdatedDialog__overlay").on("click", function () {
          $(".cartUpdatedDialog").removeClass("open");
        });

        if (window.location.hash == "#history_content") {
          $(".reward___btn .btn").removeClass("active");
          $(".reward_history_block").removeClass("active");
          $("#history_content").addClass("active");
          $(".history_content").addClass("active");
        }
      }
    } else {
      showAlert(response.message, "Error", "OK");
    }
  });
  // redeemCoupon();
  // addToCart();
}
function accordionfun() {
  var acc = document.getElementsByClassName("accordion");
  var i;
  for (i = 0; i < acc.length; i++) {
    acc[i].addEventListener("click", function () {
      this.classList.toggle("active");
      var panel = this.nextElementSibling;
      while (panel && !panel.classList.contains("accordion")) {
        if (panel.style.display === "block") {
          panel.style.display = "none";
        } else {
          panel.style.display = "block";
        }
        panel = panel.nextElementSibling;
      }
    });
  }
}

function addToCart1(
  ProductID,
  price,
  name,
  diffDays,
  totalPrice,
  totalPriceItem,
  main_img,
  currVlaue,
  delivery_date,
  minimum_quantity,
  taxpr
) {
  diffDays = Number(diffDays);
  currVlaue = Number(currVlaue);
  var result_quantity = diffDays * 0;
  var rewardprice = 0;
  localStorage.setItem("rewardprice", rewardprice);
  // localStorage.setItem('result_quantity',result_quantity);
  var quantity = $("#itemQuantity").val();
  diffDays = Number(diffDays);
  currVlaue = Number(currVlaue);
  var result_quantity = diffDays * currVlaue;
  localStorage.setItem("result_quantity", result_quantity);
  localStorage.setItem("reward", "[]");
  var quantity = minimum_quantity;
  var deliveryPlan = "once";
  var startDate = delivery_date;
  var endDate = delivery_date;

  if (ProductID && quantity && startDate) {
    var Productcart = localStorage.getItem("reward");
    if (Productcart === "null" || Productcart === 0) {
      var myArray = {};
      // console.log("cart========>", Productcart);
      const myData = {
        ProductId: ProductID,
        Quantity: quantity,
        Price: price,
        DeliveryPlan: deliveryPlan,
        StartDate: startDate,
        EndDate: endDate,
        RepeatMonthly: 1,
        Name: name,
        diffDays: diffDays,
        totalPrice: totalPrice,
        totalPriceItem: totalPriceItem,
        main_img: main_img,
        currVlaue: currVlaue,
        taxprice: taxpr,
      };
      myArray.push(myData);
      localStorage.setItem("reward", JSON.stringify(myArray));
    } else {
      const myData = {
        ProductId: ProductID,
        Quantity: quantity,
        Price: price,
        DeliveryPlan: deliveryPlan,
        StartDate: startDate,
        EndDate: endDate,
        RepeatMonthly: 1,
        Name: name,
        diffDays: diffDays,
        totalPrice: totalPrice,
        totalPriceItem: totalPriceItem,
        main_img: main_img,
        currVlaue: currVlaue,
        taxprice: taxpr,
      };
      var data = JSON.parse(Productcart);
      var data = $.grep(data, function (e) {
        return e.ProductId != ProductID;
      });
      data.push(myData);
      localStorage.setItem("reward", JSON.stringify(data));
    }
  } else {
    Swal.fire({
      position: "top-end",
      icon: "error",
      title: "Please Select the Data",
      showConfirmButton: false,
      timer: 2500,
    });
  }
}
function redeemRewardOffer(event, key) {
  event.preventDefault();
  var userdata = localStorage.getItem("userdata", userdata);
  if (!userdata) {
    return; 
  }
  var data = JSON.parse(userdata);
  var token = data.token;

  const dateInput = document.getElementById(`selectDate_${key}`);
  const selectedDate = dateInput.value;
  const formElement = event.target; 
  const rewardId = formElement.getAttribute('data-reward-id');

  if (!rewardId) {
    Swal.fire({
      title: "Error",
      text: "Reward ID is missing.",
      icon: "error"
    });
    return;
  }
  var settings = {
    url: baseUrl + "redeem-reward",
    method: "POST",
    timeout: 0,
    headers: {
      "Content-Type": "application/json",
      Authorization: "Bearer " + token,
    },
    data: JSON.stringify({
      reward_id:rewardId,
      date:selectedDate,

    }),
  };
  $.ajax(settings).done(function (response) {
    if (response.status == 1) {
      Swal.fire({
        title: "success",
        text: response.message,
        icon: "success",
        closeOnConfirm: true,
      }).then(function () {
        window.location.href = url + "calenderorder";
      });
    } else {
      Swal.fire({
        title: "error",
        text: response.message,
        icon: "error",
        closeOnConfirm: true,
      }).then(function () {
        window.location.href = url + "calenderorder";
      });
    }
  }).fail(function () {
    Swal.fire({
      title: "Error",
      text: "Something went wrong. Please try again later.",
      icon: "error",
    });
  });
}
