            </div>`;
        } else if (it.invited_status == 2) {
            statusText = `<p class="fs-12 text-red">Referral timed out</p>`;
            buttonsHTML = `<button type="button" class="btn btn-primary reedemed"    data-event="Click_Refer_Expired"
            data-category="Referral"
