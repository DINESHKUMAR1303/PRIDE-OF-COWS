  $("#sname").val(username);
  $("#semail").val(Email);
}
function isEmpty(ele) {
  if (ele.value != "") {
    ele.nextSibling.nextSibling.innerHTML = "";
  }
}

function Giftcardsave() {
  var userdata = localStorage.getItem("userdata", userdata);
  var data = JSON.parse(userdata);
  var token = data.token;
  var UserID = data.UserID;
  var GiftCardType = $("#giftcard_type").val();
  var GiftAmount = $("#gift_amount").val();
  var RecipientName = $("#rname").val();
  var emailRegex = /^\w+([\.-]?\w+)*@\w+([\.-]?\w+)*(\.\w{2,3})+$/;
  var error = false;

  $(".form-error").html("");
  if (RecipientName == "") {
    error = true;
    $("#rname").next().html("Please enter recepient's name.");
    $("#rname").focus();
  }
  var RecipientEmail = $("#remail").val();
  if (RecipientEmail == "") {
    error = true;
    $("#remail").focus();
    $("#remail").next().html("Please enter recepient's email address.");
  } else {
    if (!emailRegex.test(RecipientEmail)) {
      $("#remail").next().html("Please enter a valid email address");
      $("#remail").focus();
      error = true;
    }
  }

  var RecipientPhone = $("#pnumber").val();
  if (RecipientPhone == "") {
    error = true;
    $("#pnumber").next().html("Please enter recepient's phone number.");
    $("#pnumber").focus();
  } else {
    if (RecipientPhone.length != 10) {
      $("#pnumber").next().html("Please enter a valid mobile number.");
      error = true;
      $("#pnumber").focus();
    }
  }
  var SenderName = $("#sname").val();
  if (SenderName == "") {
    error = true;
    $("#sname").next().html("Please enter sender's name.");
    $("#sname").focus();
  }
  var SenderEmail = $("#semail").val();
  if (SenderEmail == "") {
    $("#semail").next().html("Please enter sender's email address.");
    $("#semail").focus();
    error = true;
  } else {
    if (!emailRegex.test(SenderEmail)) {
      $("#semail").next().html("Please enter a valid email address");
      $("#semail").focus();
      error = true;
    }
  }
  var Messege = $("#message").val();
  if (error) {
    return false;
  }
  //var amount = GiftAmount;
  var userdata = localStorage["userdata"]
    ? JSON.parse(localStorage["userdata"])
    : {};

  if (userdata) {
    var userdata = localStorage.getItem("userdata");
    userdata = JSON.parse(userdata);

    var data = {};
    data["TotalAmount"] = GiftAmount;
    data["customer_id"] = UserID;

    //var customerId = userdata.UserID;
    var payData = {};
    payData["TotalAmount"] = GiftAmount;
    payData["UserID"] = UserID;
    payData["GiftCardType"] = GiftCardType;
    payData["GiftAmount"] = GiftAmount;
    payData["RecipientName"] = RecipientName;
    payData["RecipientPhone"] = RecipientPhone;
    payData["RecipientEmail"] = RecipientEmail;
    payData["SenderEmail"] = SenderEmail;
    payData["SenderName"] = SenderName;
    payData["Messege"] = Messege;
    payData["web_payment"] = 1;

    data["dataAr"] = JSON.stringify(payData);

    localStorage.payData = JSON.stringify(data);
    setTimeout(() => {
      nimmblepay();
    }, 1500);
  }
}

function bonusWalletTopup() {
  var referral_coupon_apply = localStorage.getItem('referral_coupon_apply');
  var rangeFrom = localStorage.getItem('range_from_value');
  var amount = $("#walletAmount").val();
  if(referral_coupon_apply==="false" && amount > rangeFrom) {
      localStorage.setItem("benefits_popup",false);
  } else if (referral_coupon_apply==="false" && amount == rangeFrom) {
      localStorage.setItem("benefits_popup",true);
  }

  if (localStorage.getItem("benefits_popup") === 'true') {
      walletTopup();
      $("#applyPromocodeD").text("Apply").attr("onclick", "mywalletapplyPromocode($('#promocodeD').val());");
      localStorage.removeItem("amount");
      localStorage.removeItem("referral_coupon_apply");
      localStorage.removeItem("promocode_for");
    } else if (localStorage.getItem("benefits_popup") === 'false') {
        $(".uniq_modal.uniq_modal4").css({
            "display": "grid",
            "place-content": "center"
        });        
        return;
    }
}

function walletTopup() {
  var amount = parseFloat($("#walletAmount").val()) ||
               parseFloat($("#payOnlineBtnModal").data("amount")) || 0;
// storing payment data for custom analytics event
  try {
    updateUtmCookie("wallet", "wallet_recharge", { amount: amount });  
  } catch (error) {}

  var consent = $('#paymentCheckbox').is(':checked') ? 1 : 0; 
  var rechargeTab = localStorage.getItem("rechargeTab");
  const minimumAmount = 500;
  if(rechargeTab === 'true') {
    if (amount == 0 || amount < minimumAmount){
      $('.autopay__content').html(`
        <div class="d-flex align-center gap-20">
          <img src="../images/autopay_500_img.png" width="74"/>
          <div class="flex-fill">
            <p class="fw-600">Minimum Amount ${minimumAmount} Required when Auto Pay is enabled!</p>
            <p class="mt-0">Please increase your recharge amount to proceed or switch to Pay Once for a 
              one-time recharge.</p>
          </div>
        </div>
        `);
        // Swal.fire({
        //     title: `Minimum Amount ${minimumAmount} Required when Auto Pay is enabled!`,
        // });
        $(".autoRechargeBtn").hide();
        return false;
    } else {
      $('.choose_payment_type').removeClass('d-none');
      $('.autoRechargeBtn').addClass('d-none');
    }
    return false;
  }
  
  // if(consent===1){
  //   $('.choose_payment_type').removeClass('d-none');
  //   return false;
  //   // window.location.href = url + "subscriptiontransaction";
  // }

  var userdata = localStorage.getItem("userdata") ? JSON.parse(localStorage.getItem("userdata")) : {};

  if (!userdata || amount <= 0) return;
  if (!localStorage.walletofferedprice){
   
    handleNonPromoResponse(userdata, amount);
  }else{
    var token = userdata.token;
    var outstanding = $("#outstanding").val();
   var requestSettings = {
        url: baseUrl + "all-wallet-promo",
        method: "POST",
        timeout: 0,
        headers: {
            "Content-Type": "application/json",
            Authorization: "Bearer " + token,
        },
        
      data: JSON.stringify({
            custId: userdata.UserID,
            amount: amount,
            promocode_for: localStorage.promocode_for_wallet
        }),
      
  };

    $.ajax(requestSettings).done(function (response) {
        if (response.status === 1) {
            if (outstanding === "1") {
              if(!localStorage.getItem("walletofferedprice")) {
                $(".uniq_modal.uniq_modal4").show();
              }
              else
              {
                localStorage.setItem("walletAmount", amount);
                localStorage.setItem("promocode_name", response.data.promocode_name);
                Swal.fire({
                  html: `
                    <p class="swal-title custom-gold-title mt-10" style="font-size:16px; font-weight: 700; color:#AE8A49">Note:</p>
                    <p class="swal-text  mt-15" style="color:#333;font-size: 14px;">You have to clear your outstanding balance to avail this offer.</p>
                `,
                confirmButtonText: 'Clear Outstanding',

                // allow outside click to close popup
                allowOutsideClick: true,

                customClass: {
                  popup: 'custom-swal-popup-outstanding',
                  title: 'swal-title custom-gold-title',
                  htmlContainer: 'swal-text-container mt-0',
                  confirmButton: 'swal-button custom-swal-button-outstanding',
                }
              }).then(function (result) {

                // ONLY redirect when user clicks the button
                if (result.isConfirmed) {
                  window.location.href = url + "offerwallet";
                }

                // If dismissed (outside click), do nothing
              });
                return;
              }  
            } else {
                var offeredp = response.data.discount_value;
                var payData = {
                    TotalAmount: amount,
                    customer_id: userdata.UserID,
                    dataAr: JSON.stringify({
                        customer_id: userdata.UserID,
                        website_payment: 1,
                        walletpromoAmount: offeredp,
                        referrer_no:localStorage.referrer_no,
                        promocode_for:localStorage.promocode_for_wallet,
                        couponid:localStorage.promo_code 
                    }),
                };
                localStorage.setItem("payData", JSON.stringify(payData));
                setTimeout(nimmblepay, 1500);
            }
        } else {
            var payData = {
              TotalAmount: amount,
              customer_id: userdata.UserID,
              dataAr: JSON.stringify({
                  customer_id: userdata.UserID,
                  website_payment: 1,
                  walletpromoAmount: offeredp,
                  referrer_no:localStorage.referrer_no,
              }),
          };
          localStorage.setItem("payData", JSON.stringify(payData));
          setTimeout(nimmblepay, 1500);
        }
    });
  }
}

function handleNonPromoResponse(userdata, amount) {
  if (userdata.customer_type === 'Postpaid') {
    var settings = {
      "url": baseUrl + "subscribedetail",
      "method": "POST",
      "headers": {
        "Authorization": "Bearer " + userdata.token,
        "Content-Type": "application/json",
      },
      "data": JSON.stringify({
        "UserID": userdata.UserID
      }),
    };
    $.ajax(settings).done(function (response) {
      if (parseInt(response.subs.restrict_access) === 1) {
        localStorage.setItem("rechargeamount", amount);
        var minAmount = response.min_amount;
        if (amount <= 0) {
          amount = minAmount;
        }
        if (minAmount > amount && minAmount !== 0) {
          Swal.fire({
            text: 'Kindly recharge your wallet with any amount above Rs.' + minAmount,
            icon: 'warning',
            closeOnConfirm: true,
          });
          return;
        } else if(response.status === 0) {
            var payData = {
              TotalAmount: amount,
              customer_id: userdata.UserID,
              dataAr: JSON.stringify({
                customer_id: userdata.UserID,
                website_payment: 1,
                walletpromoAmount: 0,
              }),
            };
            localStorage.setItem("payData", JSON.stringify(payData));
            setTimeout(nimmblepay, 1500);
        } else {
          if(localStorage.getItem("benefits_popup") == 'false') {
            $(".uniq_modal.uniq_modal4").show();
            return;
          }
          window.location.href = url + "walletrecharge";
        }
      } else {
        var payData = {
          TotalAmount: amount,
          customer_id: userdata.UserID,
          dataAr: JSON.stringify({
            customer_id: userdata.UserID,
            website_payment: 1,
            walletpromoAmount: 0,
          }),
        };
        localStorage.setItem("payData", JSON.stringify(payData));
        setTimeout(nimmblepay, 1500);
      }
    })

  } else {
    var payData = {
      TotalAmount: amount,
      customer_id: userdata.UserID,
      dataAr: JSON.stringify({
        customer_id: userdata.UserID,
        website_payment: 1,
        walletpromoAmount: 0,
      }),
    };
    localStorage.setItem("payData", JSON.stringify(payData));
    setTimeout(nimmblepay, 1500);
  }
}


function RedeemGiftcard(datas = null) {
  var userdata = localStorage.getItem("userdata", userdata);
  var data = JSON.parse(userdata);
  var token = data.token;
  var userid = data.UserID;
  var giftcode = $("#giftCardCode").val();
  if (datas != null) {
    var giftcode = datas;
  }
  var settings = {
    url: baseUrl + "giftredeem",
    method: "POST",
    timeout: 0,
    headers: {
      "Content-Type": "application/json",
      Authorization: "Bearer " + token,
    },
    data: JSON.stringify({
      giftcode: giftcode,
      userid: userid,
    }),
  };
  $.ajax(settings).done(function (response) {
    // console.log(response);
    if (response.status == 1) {
      Swal.fire({
        title: "success",
        text: response.message,
        icon: "success",
        closeOnConfirm: true,
      }).then(function () {
        window.location.href = url + "wallet";
      });
    } else {
      Swal.fire({
        title: "error",
        text: response.message,
        icon: "error",
        closeOnConfirm: true,
      }).then(function () {
        window.location.href = url + "wallet";
      });
    }
  });
}

// assign Time Slot
function assignTimeSlot(titleValue) {
  let cardContainer = document.getElementById("mainTimeSlot");
  let rescheduleContainer = document.getElementById("rescheduleTime");
  // Show a loader in the cardContainer
  cardContainer.innerHTML = `
    <p style="text-align: center;text-align: -webkit-center; padding: 10px;width:100%;background: #8080802b;border-radius: 7px;">
      <img src="../images/circular-loader.gif" alt="Loading..." style="width:15%" />
    </p>`;
  rescheduleContainer.innerHTML = `
    <p style="text-align: center;text-align: -webkit-center; padding: 10px;width:100%;background: #8080802b;border-radius: 7px;">
      <img src="../images/circular-loader.gif" alt="Loading..." style="width:15%" />
    </p>`;
  if (titleValue) {
    fetchAPI('get-available-slots', {
      collectionDate: titleValue,
    }).then((res) => {
      let timeSlotData = '';
      res.data.forEach((items, indx) => {
        timeSlotData += `<button type="button" class="btn-time-slot ${
                              items.status === 1 ? 'avail' : 'notAvail'
                                  }" id="slot_${items.id}" slotid="${items.id}" key="${indx}" title="${
                                    items.lable
                                  }" date="${items.created_at}">
                                    <input type="radio" class="checkSlots" name="slots" value="${
                                      items.lable
                                    }" id="slotTime-${indx}">
                              <p>${items.lable}</p>
                              <p>${items.status === 1 ? 'Available' : 'Not Available'}</p>
                          </button>`;
      });
      $('.time-slot').html(timeSlotData);
    });
  
    // Attach the event listener
    $(document).off('click', '.btn-time-slot').on('click', '.btn-time-slot', function () {
      $('.btn-time-slot').removeClass('active');
      $(this).addClass('active');
      $('#scedulepickup').show();
    });
  }
}

// Fetch API Main Function 
async function fetchAPI(endpoint, payload) {
  try {
    // Retrieve userdata from localStorage
    const data = JSON.parse(localStorage.getItem("userdata"));
    if (!data || !data.token) {
      throw new Error("User data or token is missing in localStorage");
    }

    const token = data.token;
    const settings = {
      url: baseUrl + endpoint,
      method: "POST",
      timeout: 0,
      headers: {
        "Content-Type": "application/json",
        Authorization: "Bearer " + token,
      },
      data: payload !== null ? JSON.stringify(payload) : null,
    };

    const response = await new Promise((resolve, reject) => {
      $.ajax(settings)
        .done((res) => resolve(res))
        .fail((jqXHR, textStatus, errorThrown) => reject(errorThrown));
    });

    return response; 
  } catch (error) {
    console.error("Error in fetchAPI:", error.message);
    throw error; 
  }
}


// Schedule Time Slots - create cash on delivery
function scheduleSlot() {
  const scheduleSlotId = $('.btn-time-slot.active').attr('slotid'); 
  const amount = $('#creditedAmount').text(); 
  let newAmount = parseInt(amount.replace(/,/g, ''), 10);
  let selectDate = $('.selectDate.active').attr('title');
  var userdata = localStorage.getItem("userdata", userdata);
  var data = JSON.parse(userdata);
  let topModel = document.querySelector(".topmodal");
 
  fetchAPI('create-cashondelivery-request', ({
          "slotId": scheduleSlotId,
          "collectionDate": selectDate,
          "amount": newAmount
        })).then(res => {

              document.querySelectorAll('.newModal').forEach(modal => {
                modal.style.display = "none";
            });

            let confirmModal = document.getElementById("confirmation");
            confirmModal.querySelector(".newModal-content").innerHTML = '';
            let innerConfirmModal = confirmModal.querySelector(".newModal-content");
            confirmModal.style.display = "block";
            innerConfirmModal.innerHTML = `<div class="modal-body newModal-body">
                                              <h4>${res.message}</h4>
                                          </div>
                                          <div class="make-flex gap-10 justify-center modalFooter newModal-footer">
                                              <button class="modalDone btn">Ok</button> 
                                          </div>`;
            document.querySelector('.modalDone').addEventListener('click', () => {
                location.reload();
                window.location.href = url + "walletreachargecashpickup";
            });
          console.log(res.message)
        });
}

// Festival offer API Integration 
async function getFestivalOfferData() {

    try {
      let showOffer = document.querySelector(".heroImage"); 
      let showOfferSlider = document.querySelector(".heroDeskImg"); 
      let showSlider = document.querySelector(".sliderShow"); 
      let showSliderBtn = document.querySelector(".sliderShowBtn"); 
            if(userdata){
              Object.assign(showOffer.style, {height: "200px",display: "flex",justifyContent: "center",alignItems: "center"});
              showOffer.innerHTML = `
                  <div class="homeSliderloader">
                      <img src="https://prideofcows.com/poc/images/circular-loader.gif" alt="Loading...">
                  </div>
              `;
            }
            const res = await fetchAPI('festival-offer', null);
            // Remove loader once data is fetched
            showOffer.style.height = "auto";
            showOffer.innerHTML = "";
            
            // on basis of offer status show homescreen slider / offer banner
            let offerStatus = res.show_offer_status;
            showSlider.style.display = "block";
            if (offerStatus === 0) {
              showSlider.style.display = "block";
              showSliderBtn.style.display = "block";
              showOffer.style.display = "none";
              showOfferSlider.style.display = "none";
            } else {
              showOfferSlider.style.display = "block";
              showOffer.style.display = "block";
              showSlider.style.display = "none";
              showSliderBtn.style.display = "none";

                // Offer data
                let offerId = res.data.offer_id;
                let heading =  res.data.main_heading;
                let body = res.data.main_body;
                let btnStatus = res.data.main_btn_status;
                let btnContent = res.data.main_btn_content;
                let btnAction = res.data.main_btn_action.web;
                let bannerImg = res.data.main_banner_img;
                let iconStatus = res.data.main_icon_status;
                let icon = res.data.main_icon;
                let loader = res.data.loader;
                let style = res.data.styles;

                if(!bannerImg) {
                  let offerFirstLine = document.querySelector(".offerP");
                  let offerSecondLine = document.querySelector(".offerH1");
                  let videoLink = document.querySelector(".videoSrc");
                  let videoElementWeb = document.querySelector("#webVideo");
                  let buttonCreate = Object.assign(document.createElement('a'), { className: 'gettingOffer', href: `javascript:void(0)`, textContent: btnContent, id: offerId });
                
                  const customOffer = () => {
                    const userdata = localStorage["userdata"] ? JSON.parse(localStorage["userdata"]) : {};
                    localStorage.setItem("selectedOfferId", offerId);

                    gaEvent({
                      "event": "custom_offer", 
                      "offer_title": "offerFirstLine",
                      "category": btnContent, 
                      "current_page": window.location.href,
                      "cust_id": userdata?.UserID
                    });

                  // redirect to the festive offer
                      location.href = "customer/festival-offer";
                    }
                  buttonCreate.onclick = customOffer; 

                  let santaSRC = document.querySelector(".santaVideoSrc");
                  let santaVideoElement = document.querySelector("#santaVideo");
                  santaSRC.setAttribute("src", loader)
                  
                  // add offer Data on DOM
                  offerFirstLine.innerText = heading;
                  offerSecondLine.innerText = body;
                  videoLink.setAttribute("src", icon);
                  offerSecondLine.insertAdjacentElement('afterend', buttonCreate);
                  videoElementWeb.load();
                  santaVideoElement.load();
                  // Web Offer reveal
                    document.querySelector('.gettingOffer').addEventListener('click', () => {
                      const santaImage = document.querySelector('.santa-image');
                      santaImage.style.display = 'block';
                      setTimeout(() => {
                      santaImage.style.display = 'none';
                      }, 10000); // Hide after 10 seconds
                  });
                } else {
                  showOffer.style.backgroundColor = "transparent";
                  if(btnStatus === 0){
                    showOffer.innerHTML = `<a href="/poc/customer/${btnAction}" id="webAction"></a>`
                    document.getElementById('webAction').innerHTML = `<img src="${bannerImg}" alt="Banner">`;
                  } else {
                    showOffer.innerHTML = `<img src="${bannerImg}" alt="Banner">`;
                  }
              }
            }
        } 
    catch (error) {
    console.error("Error occurred while calling fetchAPI:", error);
  }
}

// get offers Data
async function getOfferData() {
  const offerId = localStorage.getItem("selectedOfferId");

  try {
    const res = await fetchAPI('get-offer-page-details', ({
      offer_id: offerId
    }));
    
    let offerData = res.data;

    if(res.status) {
      // How It Works Block
        let howItWorks = offerData.HowItWorks;

        if (howItWorks?.how_it_works_content) {
          HIWcontent = howItWorks.how_it_works_content.split('$|$');
          let stepsUl = document.querySelector(".howWorks .list-unstyled");
          
          let steps = "";
          HIWcontent.forEach((step, idx) => {
            steps += `<li key="${idx}"><p>${step}</p></li>`;
          });
          stepsUl.innerHTML = steps;
        } 
        else {

          // Hide the .howWorks div if it exists
          const howWorksDiv = document.querySelector('.howWorks');
          if (howWorksDiv) {
            howWorksDiv.style.display = 'none';
          }
        }

        let offerAction = document.getElementById("offerAction");
        let offerButtonStatus = offerData.offer_details_btn_status;
        let offerButtonAction = offerData.offer_detail_btn_action;

        // if status is true
        if(offerButtonStatus) {
          // if button action is reward
          if(offerButtonAction === "Rewards") {
            offerAction.setAttribute("href", 'rewards');
          } 
          else if (offerButtonAction === "Mywallet") {
            offerAction.setAttribute("href", 'wallet');
          }
           else {
            offerAction.setAttribute("href", weburl);
          }
        }
        // if status is false
        else {
          offerAction.classList.add("pointernone");
        }

        let bannerRightImage = document.querySelector(".secreteGift");
        bannerRightImage.setAttribute("src", offerData.offer_details_img.web) ;

        // wallet offer details 
        let offerList = offerData.offers;
        let offerListing = document.querySelector('.offerListing'); 
        let offerContainer = document.querySelector('.walletOffer'); 
        let offerContent = "";
    
        if (offerList.length > 0) {
          // Loop through each offer and generate HTML
          offerList.forEach((offer) => {
            offerContent += `
            <div class="mt-2 walletOfferInner">
              <h4 class="fw-bold text-warning text-left">${offer.sub_heading}</h4>
              <div class="make-flex align-center walletFlex">
                <img src="${offer.main_heading_icon == 'wallet' ? '../images/wallet.png' : '../images/reward.png'}" class="img-fluid me-md-3" alt="${offer.main_heading_icon}">
                <h1 class="text-left text-md-start" style="color: #0c3b60;">${offer.main_heading.toUpperCase()}</h1>
              </div>
              ${offer.btn_status == false ? `<p class="text-left text-md-start getReady" style="color: #0c3b60; font-size:10px;">${offer.sub_para}</p>` : `<a href="${!offer?.offer_btn_action?.web?.url == "Mywallet" ? "Mywallet" : "offers"}" class="mt-3 festivalBtn">${offer.btn_content}</a>`}
            </div>`;
          });
      
        // Add the generated content to the container
        offerListing.innerHTML = offerContent;
      
          // Ensure the container is visible
          document.querySelector('.walletTitle').innerText = offerList[0].offer_title;
          offerContainer.style.display = 'block';
        } else {
          // Hide the container if no offers are present
          offerContainer.style.display = 'none';
        }

        const userdata = localStorage["userdata"] ? JSON.parse(localStorage["userdata"]) : {};

        gaEvent({
          "event": "custom_offer_load", 
          "custId": userdata?.UserID,
          "current_page": window.location.href,
          "offer_id": offerId,
        });
    
    } else {
      window.location.href = weburl;
    }

}
  catch (error) {
 console.error("Error occurred while calling fetchAPI:", error);
}
}


// getScheduleList Items
async function getScheduleSlots() {

  let cardContainer = document.getElementById("cardagent");
  cardContainer.innerHTML = '<div style="transition: all 0.5s ease-in;display: flex;justify-content: center;align-items: center;height: 80vh;"><img class="" src="../images/circular-loader.gif" alt="Loading..." style="width:10%" /></div>';
  try {
    const res = await fetchAPI('get-cashondelivery-request', null);

    let codAmount = res.min_cod_amount;
    $("#payCashBtn").attr("amount", codAmount);

    if (!res.data || res.data.length === 0) {
      // If no data, show a message
      cardContainer.remove();
      return;
    }

    let scheduledList = '';
    res.data.forEach((items, indx) => {

      scheduledList += `<div class="card-body scheduleCard">
                          <div class="DateTime gap-10 justify-space-between">
                            <div class="amountDateTime make-grid gap-10 pb-5">
                              <div class="make-flex justify-space-between firstSlot">
                                <div>
                                  <p class="schedule-label">Amount to pick:</p> 
                                  <p><span class="amountString">₹<b>${items.payment_amount.toLocaleString('en-IN')}</b></span></p>
                                </div>
                                <button class="btn-primary fix-square-btn edit-amount" id="${items.id}" data-slotid="${items.slot_id}" data-date="${items.collection_date}">Edit Amount</button>
                              </div>
                              <div class="make-flex justify-space-between secSlot">
                                <div>
                                  <p class="schedule-label">Date:</p> 
                                  <p><span id="collectionDate">${items.collection_date}</span></p>
                                </div>
                                <div>
                                  <p class="schedule-label">Time Slot:</p>  
                                  <p><span>${items.timeSlot.lable}<span></p>
                                </div>
                              </div>
                              <div class="make-flex justify-space-between thirdSlot">
                                <div class="agentDetails">
                                  Agent details will be shared 2 hours before pickup!
                                </div>
                              </div>
                            </div>
                            <div class="rescheduleBtns pt-10">
                              <div class="make-flex justify-space-between">
                                <button class="btn btn-primary square-btn rescheduleRequest" data-id="${items.id}">
                                <img src="../images/reschedule.svg" alt="Reschedule"> &nbsp;&nbsp;Reschedule</button>
                                <button class="btn btn-primary square-btn cancelRequest" data-id="${items.id}" data-reason="Test" data-amount="${items.payment_amount}">
                                <img src="../images/cancel-pickup.png" alt="Cancel"> &nbsp;&nbsp;Cancel</button>
                              </div>
                                <div class="info make-flex gap-10 pt-10">
                                  <img src="../images/reschedule-info.png">
                                  <p>You can cancel or reschedule your pickup up to 7 hours in advance.</p>
                                </div>
                              </div>
                            </div>
                          </div>
                        </div>`;
    });
    cardContainer.innerHTML = scheduledList;

    // on click of buttons edit amount
    document.addEventListener("click", function (event) {
      // Check if the clicked element has the 'edit-amount' class
      if (event.target.classList.contains("edit-amount")) {
          let button = event.target;
  
          // Find the corresponding amountString span
          let amountStringSpan = button.parentElement.querySelector(".amountString");
  
          // Toggle behavior based on button text
          if (button.textContent === "Edit Amount") {
              // Change button text to "Done" and add 'green' class
              button.textContent = "Done";
              button.classList.add("green");
  
              // Get the current amount value (remove the ₹ symbol)
              let currentValue = amountStringSpan.textContent.replace("₹", "").trim();
              currentValue = parseInt(currentValue.replace(/,/g, ''), 10);
              // Create an input field
              let inputField = document.createElement("input");
              inputField.type = "number";
              inputField.value = currentValue;
              inputField.className = "edit-input";

              // Replace the span's content with the input field
              amountStringSpan.innerHTML = "";
              amountStringSpan.appendChild(inputField);
  
              // Focus on the input field
              inputField.focus();
  
          } else if (button.textContent === "Done") {
              // Change button text back to "Edit" and remove 'green' class
              button.textContent = "Edit Amount";
              button.classList.remove("green");

              // Get the new value from the input field
              let inputField = amountStringSpan.querySelector(".edit-input");
              let newValue = parseFloat(inputField.value);
              
              // Retrieve additional data attributes
              let editButtonId = button.id;
              let editButtonDate = button.dataset.date;
              let editButtonSlotId = button.dataset.slotid;
              
              if(newValue < codAmount){
                alert("Amount should not be less than 999");
                button.textContent = "Done";
                button.classList.add("green");
              } else {
              // Update the span content with the new value
              amountStringSpan.innerHTML = `₹ ${newValue}`;
  
              // Call the API to update the value
              updateAmountCOD(newValue, editButtonId, editButtonDate, editButtonSlotId, 2);
              }
          }
      }

      // Check if the clicked element has the 'edit-amount' class
      if (event.target.classList.contains("cancelRequest")) {
        let cancelBTN = event.target;

         // Retrieve additional data attributes
        let cancelRequestId = cancelBTN.dataset.id;
        let cancelButtonReason = cancelBTN.dataset.reason;
        let cancelButtonAmount = cancelBTN.dataset.amount;
        let confirmModal = document.getElementById("confirmation");
        confirmModal.style.display = "block";
        // document.getElementById("payOnlineBtnModal").setAttribute("data-amount", cancelButtonAmount);
        document.getElementById('deleteRequest').addEventListener('click', () => {
          // Execute cancelRequestCOD and reload
          cancelRequestCOD(cancelRequestId, cancelButtonReason, cancelButtonAmount);
          location.reload();
        });
        
        // document.getElementById("payOnlineBtnModal").addEventListener("click", async (e) => {
        //   try {
        //     await cancelRequestCOD(cancelRequestId, cancelButtonReason, cancelButtonAmount);
        //     await getScheduleSlots();
        //     let requestAmount = e.target.getAttribute("data-amount");
        //     let walletAmount = document.getElementById("walletAmount");
        //     walletAmount.value = requestAmount;
        //     walletAmount.dispatchEvent(new Event("keyup"));
        //     document.getElementById("payOnlineBtn").classList.remove("pointernone");
        //     document.getElementById("confirmation").style.display = "none";
        //     walletAmount.scrollIntoView({ behavior: "smooth", block: "center" });
        //   } catch (error) {
        //     console.error("Error during operation:", error);
        //   }
        // });
    
      }

      // Check if the clicked element has the 'Reschedule' class to open modal
      let rescheduleModal = document.getElementById("rescheduleModal");
      if (event.target.classList.contains("rescheduleRequest")) {
        rescheduleModal.style.display = "block";
        let rescheduleBTN = event.target;

        // Retrieve additional data attributes
        let rescheduleRequestId = rescheduleBTN.dataset.id;
        
        rescheduleModal.setAttribute("data-requestid", rescheduleRequestId);
 
        rescheduleModalData(rescheduleRequestId);
    }
  });

  } catch (error) {
    console.error("Error occurred while calling fetchAPI:", error);
  } 
}

// new Schedule Request 
function schedRequest(event) {
  event.preventDefault(); 
  const selectedDate = document.querySelector('input[name="date"]:checked');
  const selectedSlot = document.querySelector('input[name="slots"]:checked');

  // Check if both date and slot are selected
  if (selectedDate && selectedSlot) {
      // alert(`Pickup scheduled for ${selectedDate.value} at ${selectedSlot.value}`);
      scheduleSlot();
      } else {
      alert("Please select both a date and a time slot before submitting.");
      }
  }

// new Reschedule Function 
function reSchedRequest(event) {
  event.preventDefault(); 
  const selectedDate = document.querySelector('input[name="date"]:checked');
  const selectedSlot = document.querySelector('input[name="slots"]:checked');

  if (selectedDate && selectedSlot) {
      // alert(`Pickup scheduled for ${selectedDate.value} at ${selectedSlot.value}`);
          const modalScheduleSlotId = document.querySelector('#rescheduleModal .btn-time-slot.active').getAttribute('slotid'); 
          const modalAmount = document.querySelector('#amountToPay-modal').textContent; 
          const numModalAmount = parseInt(modalAmount.replace(/,/g, ''), 10); // Remove commas and convert to a number
          let ModalSelectDate = document.querySelector('#rescheduleModal .selectDate.active').getAttribute('title');
          let ModalRequestId = document.querySelector('#rescheduleModal').getAttribute('data-requestid');
        // Call the API to update the value
          updateAmountCOD(numModalAmount, ModalRequestId, ModalSelectDate, modalScheduleSlotId, 1);
      } else {
      alert("Please select both a date and a time slot before Scheduling.");
      }
  }


// Update Amount of Request
async function updateAmountCOD(newAmount, editButtonId, editButtonDate, editButtonSlotId, action) {
  try {
          const res = await fetchAPI('update-cashondelivery-request', ({
            "requestId": editButtonId,
            "action": action,
            "collectionDate": editButtonDate,
            "slotId": editButtonSlotId,
            "amount": newAmount
          }));

          let confirmModal = document.getElementById("confirmation");
          confirmModal.querySelector(".newModal-content").innerHTML = '';
          let innerConfirmModal = confirmModal.querySelector(".newModal-content");
          confirmModal.style.display = "block";
          innerConfirmModal.innerHTML = `<div class="modal-body newModal-body">
                                            <h4 style="text-align:center">${res.message}</h4>
                                        </div>
                                        <div class="make-flex gap-10 justify-center modalFooter newModal-footer">
                                            <button class="modalDone btn">Ok</button> 
                                        </div>`;
          document.querySelector('.modalDone').addEventListener('click', () => {
              location.reload();
            });
        }
    catch (error) {
      console.error("Error occurred while calling fetchAPI:", error);
    }
}

// cancel request COD - delete request cod
async function cancelRequestCOD(cancelRequestId, cancelButtonReason) {
    try {
      const res = await fetchAPI('cancel-cashondelivery-request', ({
        "requestId": cancelRequestId,
        "reason": cancelButtonReason
      }));
    }
  catch (error) {
    console.log("Error occurred while calling cancel API:", error)
  }
}

// Reschedule Modal
async function rescheduleModalData(rescheduleRequestId) {
  try {
    const res = await fetchAPI('get-cashondelivery-request', null);
    let selectedModalData = res.data;
    let checkDateSelected = document.querySelectorAll("#date-list-modal .checkDate");
    let paymentAmount = document.getElementById("amountToPay-modal");

    let timeSlotAssigned = false; // Flag to ensure assignTimeSlot runs only once
    $("#addressLoc").html(
      `<div class="address-username" >${userdata?.FirstName } ${userdata?.LastName}</div>
      <span class="flat_plot_no" >${userdata["flat_plot_no"]}</span>
      <span class="building_name" > ${userdata["building_name"]}</span>
      <span class="street_road" > ${userdata["street_road"]}</span>
      <span class="landmark" > ${userdata["landmark"]}</span>
      <span class="City" >${userdata["City"]}</span>
      <span class="pincode" >${userdata["pincode"]}</span>`
    );
    checkDateSelected.forEach((dates) => {
      let dateTitle = dates.getAttribute("value");
      
      selectedModalData.forEach((items) => {
        if (items.id == rescheduleRequestId) {
          if (dateTitle === items.collection_date) {
            paymentAmount.innerText = items.payment_amount.toLocaleString('en-IN');
            dates.checked = true;
            dates.parentElement.classList.add("active");

            if (!timeSlotAssigned) {
              assignTimeSlot(dateTitle); // Run assignTimeSlot only once
              timeSlotAssigned = true; // Set flag to true
            }
          }
        }
      });
    });
  } catch (error) {
    console.log("Error occurred while getting cancel Data:", error);
  }
}

function Offerpackage() {
  var userdata = localStorage.getItem("userdata", userdata);
  var product = localStorage.getItem("pid", product);
  var data = JSON.parse(userdata, product);
  if (data) {
    var token = data.token;
    var settings = {
      url: baseUrl + "packagelist",
      method: "POST",
      timeout: 0,
      headers: {
        "Content-Type": "application/json",
        Authorization: "Bearer " + token,
      },
      data: JSON.stringify({
        product: product,
        city: data.city_id,
        custid: data.UserID,
      }),
    };

    $.ajax(settings).done(function (response) {
      // console.log(response);
      if (response.status == 1) {
        if (response.data) {
          var productBox = "";
          $.each(response.data, function (i, it) {
            // console.log(it);
            if (it.offer_product_id !== null) {
              var offerprod = `<span class="crd">${it.offer_product_quantity}PK${it.offer_product_id} FREE </span>`;
            } else {
              offerprod = "";
            }

            if (it.offer_price !== null) {
              var offerprice = `<span class="rful"> ₹${it.offer_price}</span>`;
              var offers = it.offer_price;
            } else {
              var offers = 0;
              offerprice = "";
            }
            $(
              "#offer_voucher"
            ).append(`<a href="#" onclick=shopofferdetail(${it.product_quantity},${offers})><div class="coupon-card1">
                                        <div class="hund">
                                            <span class="lful"> ${it.product_quantity}LT </span>
                                            ${offerprice}
                                        </div>
                                       ${offerprod}
                                        <div class="circle1"></div>
                                        <div class="circle2"></div>
                                    </div></a>`);
          });
        }
      } else {
        // showAlert(response.message, "Error", "OK");
      }
    });
  }
}
function Offerproduct(start, end) {
  var date1 = start.split("/");
  var date2 = end.split("/");
  var newstrtdate =
    date1[2] + "-" + setDateZero(date1[1]) + "-" + setDateZero(date1[0]);
  var newenddate =
    date2[2] + "-" + setDateZero(date2[1]) + "-" + setDateZero(date2[0]);
  // alert(newstrtdate+"---"+newenddate);
  localStorage.offerstart = newstrtdate;
  localStorage.offerend = newenddate;

  var userdata = localStorage.getItem("userdata", userdata);
  var product = localStorage.getItem("pid", product);
  var result_quantity = localStorage.getItem(
    "result_quantity",
    result_quantity
  );
  var data = JSON.parse(userdata, product);
  if (data) {
    var offerprodqty = localStorage.pquantity;
    // alert(offerprodqty+"--"+result_quantity);
    if (localStorage.parent && localStorage.parent === product) {
      localStorage.removeItem("offercart");
    }
    if (offerprodqty === result_quantity) {
      var token = data.token;
      var settings = {
        url: baseUrl + "packageofferitem",
        method: "POST",
        timeout: 0,
        headers: {
          "Content-Type": "application/json",
          Authorization: "Bearer " + token,
        },
        data: JSON.stringify({
          product: product,
          product_quantity: result_quantity,
        }),
      };

      $.ajax(settings).done(function (response) {
        // console.log(response);
        if (response.status == 1) {
          localStorage.packageofferediD = response.data.id;
          localStorage.offerdatasting = response.data.data_string;

          localStorage.removeItem("offercart");
          localStorage.setItem("parent", product);
          const poc_addresid = localStorage.getItem("selectedAddressId");
          $.each(response.data.Allproducts, function (i, it) {
            var userdata = localStorage.getItem("userdata", userdata);
            var data = JSON.parse(userdata);
            var city = data.city_id;
            var token = data.token;
            var ProductID = it;

            var settings = {
              url: baseUrl + "productdetail",
              method: "POST",
              timeout: 0,
              headers: {
                "Content-Type": "application/json",
                Authorization: "Bearer " + token,
              },
              data: JSON.stringify({
                ProductID: ProductID,
                City: city,
                addresId: poc_addresid
              }),
            };
            $.ajax(settings).done(function (resp) {
              if (resp.status == 1) {
                if (resp.data) {
                  var ProductID = resp.data.id;
                  var quantity = response.data.offer_quantities[i];
                  var price = resp.data.price;
                  var deliveryPlan = "daily";
                  var startDate = start;
                  var endDate = start;
                  var repeatMonthly = "";
                  var Pname = resp.data.name;
                  var diffDays = 1;
                  var totalPrice = price * quantity;
                  var totalPriceItem = price * quantity;
                  var main_img = resp.data.main_img;
                  var currVlaue = 0;
                  var taxpr = 0;
                  var parent = product;

                  var Productcart = localStorage.getItem(
                    "offercart",
                    Productcart
                  );
                  if (Productcart === null) {
                    localStorage.removeItem("offercart");
                    var myArray = [];
                    // console.log(Productcart);
                    const myData = {
                      ProductId: ProductID,
                      Quantity: quantity,
                      Price: price,
                      DeliveryPlan: deliveryPlan,
                      StartDate: startDate,
                      EndDate: endDate,
                      RepeatMonthly: repeatMonthly,
                      Name: Pname,
                      diffDays: diffDays,
                      totalPrice: totalPrice,
                      totalPriceItem: totalPriceItem,
                      main_img: main_img,
                      currVlaue: currVlaue,
                      taxprice: taxpr,
                      parent: parent,
                    };
                    myArray.push(myData);
                    localStorage.setItem("offercart", JSON.stringify(myArray));
                  } else {
                    localStorage.removeItem("offercart");
                    const myData = {
                      ProductId: ProductID,
                      Quantity: quantity,
                      Price: price,
                      DeliveryPlan: deliveryPlan,
                      StartDate: startDate,
                      EndDate: endDate,
                      RepeatMonthly: repeatMonthly,
                      Name: Pname,
                      diffDays: diffDays,
                      totalPrice: totalPrice,
                      totalPriceItem: totalPriceItem,
                      main_img: main_img,
                      currVlaue: currVlaue,
                      taxprice: taxpr,
                      parent: parent,
                    };
                    var data = JSON.parse(Productcart);
                    var data = $.grep(data, function (e) {
                      return e.ProductId != ProductID;
                    });
                    data.push(myData);
                    // console.log(data);
                    localStorage.setItem("offercart", JSON.stringify(data));
                  }
                }
                hidecart();
                showCart();
              }
            });
          });
          setTimeout(function () {
            window.location.href = url + "offercalendar";
          }, 2000);
        }
      });
    } else {
      localStorage.removeItem("offeredprice");
    }
  }
}

function Offerproductsave() {
  var price = localStorage.getItem("price");
  var taxpr = localStorage.taxprice;

  var name = localStorage.getItem("name", name);
  var main_img = localStorage.getItem("main_img", main_img);
  var diffDays = localStorage.getItem("diffDays", diffDays);
  var totalPrice = localStorage.getItem("totalPrice", totalPrice);
  var currVlaue = localStorage.getItem("currVlaue", currVlaue);
  var totalPriceItem = localStorage.getItem("totalPriceItem", totalPriceItem);
  var ProductID = localStorage.getItem("pid", ProductID);
  var offer_product_quantity = localStorage.getItem(
    "offer_product_quantity",
    offer_product_quantity
  );
  diffDays = Number(diffDays);
  currVlaue = Number(currVlaue);
  var prod_quantity = diffDays * currVlaue;
  if (prod_quantity == offer_product_quantity) {
    // alert(offer_product_quantity);
    var quantity = $("#itemQuantity").val();
    var deliveryPlan = $(".deliveryPlan__btns .active").attr("data-plan");
    if (deliveryPlan == "daily") {
      var startDate = $("#startDate").val();
      var endDate = $("#endDate").val();
      var repeatMonthly = 1;
      var date1 = startDate.split("/");
      var date2 = endDate.split("/");
      var newstrtdate = date1[2] + "-" + date1[1] + "-" + date1[0];
      var newenddate = date2[2] + "-" + date2[1] + "-" + date2[0];
      if (Date.parse(newenddate) < Date.parse(newstrtdate)) {
        $("#myElem3").show();
        setTimeout(function () {
          $("#myElem3").hide();
        }, 5000);
        return false;
      }
    } else if (deliveryPlan == "alternate") {
      var startDate = $("#alternateStartDate").val();
      var endDate = $("#alternateEndDate").val();
      var repeatMonthly = 1;
      var date1 = startDate.split("/");
      var date2 = endDate.split("/");
      var newstrtdate = date1[2] + "-" + date1[1] + "-" + date1[0];
      var newenddate = date2[2] + "-" + date2[1] + "-" + date2[0];
      if (Date.parse(newenddate) < Date.parse(newstrtdate)) {
        $("#myElem3").show();
        setTimeout(function () {
          $("#myElem3").hide();
        }, 5000);
        return false;
      }
    } else if (deliveryPlan == "once") {
      var startDate = $("#deliverDate").val();
      var endDate = $("#deliverDate").val();
    } else if (deliveryPlan == "custom") {
      var startDate = $("#cdates").val();
      var endDate = $("#cendDate").val();
      var date1 = startDate.split("/");
      var date2 = endDate.split("/");
      var newstrtdate = date1[2] + "-" + date1[1] + "-" + date1[0];
      var newenddate = date2[2] + "-" + date2[1] + "-" + date2[0];
      if (Date.parse(newenddate) < Date.parse(newstrtdate)) {
        $("#myElem3").show();
        setTimeout(function () {
          $("#myElem3").hide();
        }, 5000);
        return false;
      }
      var repeatMonthly = 1;
    }
    if (ProductID && quantity && startDate) {
      var parent = localStorage.parent;

      var Productcart = localStorage.getItem("offercart", Productcart);
      if (Productcart === null) {
        localStorage.removeItem("offercart");
        var myArray = [];
        // console.log(Productcart);
        const myData = {
          ProductId: ProductID,
          Quantity: quantity,
          Price: price,
          DeliveryPlan: deliveryPlan,
          StartDate: startDate,
          EndDate: endDate,
          RepeatMonthly: repeatMonthly,
          Name: name,
          diffDays: diffDays,
          totalPrice: totalPrice,
          totalPriceItem: totalPriceItem,
          main_img: main_img,
          currVlaue: currVlaue,
          taxprice: taxpr,
          parent: parent,
        };

        myArray.push(myData);
        localStorage.setItem("offercart", JSON.stringify(myArray));
        setTimeout(() => {
          showCart();
        }, 500);
      } else {
        localStorage.removeItem("offercart");
        const myData = {
          ProductId: ProductID,
          Quantity: quantity,
          Price: price,
          DeliveryPlan: deliveryPlan,
          StartDate: startDate,
          EndDate: endDate,
          RepeatMonthly: repeatMonthly,
          Name: name,
          diffDays: diffDays,
          totalPrice: totalPrice,
          totalPriceItem: totalPriceItem,
          main_img: main_img,
          currVlaue: currVlaue,
          taxprice: taxpr,
          parent: parent,
        };
        var data = JSON.parse(Productcart);
        var data = $.grep(data, function (e) {
          return e.ProductId != ProductID;
        });
        data.push(myData);
        // console.log(data);
        localStorage.setItem("offercart", JSON.stringify(data));
        setTimeout(() => {
          showCart();
        }, 500);
      }
    } else {
      Swal.fire({
        position: "top-end",
        icon: "error",
        title: "Please fill all the fields",
        showConfirmButton: false,
        timer: 2500,
      });
    }
  } else {
    alert("The quantity should be " + offer_product_quantity);
  }
}

function showOffercart() {
  var diffDays = localStorage.getItem("diffDays", diffDays);
  var currVlaue = localStorage.getItem("currVlaue", currVlaue);
  var cquantity = diffDays * currVlaue;
  var datas = localStorage.offerselected;
  var Cart = localStorage.getItem("offercart", Cart);
  var Quantity = localStorage.getItem("currVlaue", Quantity);
  var data = JSON.parse(Cart, Quantity);
  // console.log(data);
  if (data) {
    $.each(data, function (i, it) {
      // console.log(it);
      $("#cart_items").append(
        `<div class="row" id="delete_cart${it.ProductId}">
                                 <div class="col-4">
                                     <a  onclick="getOproductDetail(${it.ProductId},${it.StartDate},${it.Quantity})" href="${url}offerproduct" >
                                         <img loading="lazy" class="cart__img" src="${it.main_img}" alt="">
                                     </a>
                                 </div>
                                 <div class="col-8">
                                     <div class="cart__text">
                                         <div class="d-flex justify-space-between">
                                             <a  onclick="getOproductDetail(${it.ProductId},${it.StartDate},${it.Quantity})" href="${url}offerproduct" >
                                                 <h4 class="cart__title">${it.Name}</h4>
                                                 <h4 class="cart__title">%Offers</h4>
                                                 
                                             </a>
                                            
                                         </div>
                                         
                                         <div class="cart__deliveryPlan">Delivery plan: <span>${it.DeliveryPlan} </span></div>
                                         <div class="cart__deliveryPlan">Quantity: <span>${it.Quantity}</span></div>
                                         <div class="cart__deliveryPlan">No. of Booking Days: <span>${it.diffDays}</span></div>
                                         <div class="cart__quantityPriceRow d-flex justify-space-between">
                                             <div class="quantitySelector d-flex">
                                                 <div class="quantitySelector__item quantitySelector-minus pointer" onclick="qtyPlusMinus(this,'minus')">
                                                     <svg width="20" height="21" viewBox="0 0 20 21" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                         
                                                     </svg>
                                                 </div>
                                                 
                                                 <div class="quantitySelector__item quantitySelector-plus pointer" onclick="qtyPlusMinus(this,'plus')">
                                                
                                                 </div>
                                             </div>
                                             <input type="hidden" class="totalprice" value="${it.totalPriceItem}">
                                              
                                         </div>
                                     </div>
                                 </div>
                                 <div class="checkout__cart__updatedText color-green d-flex">
                                     <img src="<?= Yii::getAlias('@frontendUrl') ?>/images/t
                                      ick.svg" alt="">
                                 </div>
                             </div> `
      );
    });
    $(".total_product_amount").html("₹" + data.totalPrice);
  } else {
    // console.log("Your Cart is Empty");
  }
  $("#cartdiv").show();
  $("#cartdiv").addClass("open");
  // totalprice();
}

function showRewardCart() {
