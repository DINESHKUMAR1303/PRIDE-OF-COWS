function walletJourney(historyCount) {
  $('.transactions-preloader').hide();
  $('#more-transactions').hide();
  var userdata = localStorage.getItem("userdata", userdata);
  var data = JSON.parse(userdata);
  var token = data.token;
  var page = 1;
  var pageSize = 10;
  if ($('#transaction_history > .transaction__item').length >= historyCount) {
    return false;
  }
  if ($('#transaction_history > .transaction__item').length >= pageSize) {
    page = Math.ceil($('#transaction_history > .transaction__item').length / pageSize) + 1;
  }
  if (historyCount > pageSize) {
    $('#more-transactions').show();
  }
  var settings = {
    url: baseUrl + "wallet-history",
    method: "POST",
    headers: {
      "Content-Type": "application/json",
      Authorization: "Bearer " + token,
    },
    data: JSON.stringify({
      'page': page,
      'cust_id': data.UserID
    }),
    beforeSend: () => {
      $('.transactions-preloader').show();
      $('#more-transactions').hide();
    }
  };
  $.ajax(settings).done(function (response) {
    $('.transactions-preloader').hide();
    $('#more-transactions').show();
    if (response.status == 1) {
      if (response.data) {
        const limitedData = response.data.slice(0, 5);
        $.each(limitedData, function (i, it) {
          var dt = new Date(it.created_dt);
          var createDate = dt.toLocaleString('en-UK', {
            day: '2-digit',
            month: 'short',
            year: 'numeric',
            hour: '2-digit',
            minute: '2-digit',
            second: '2-digit',
            hour12: true,
          });
          var sign = '+';
          var style = '';
          if (it.amount < 0) {
            sign = '-';
            style = 'style="color:orange;"';
          }
          if (it.trans_id == null) {
            it.trans_id = '';
          }
          if (it.detail == null) {
            it.detail = '';
          }
          var amount = Math.abs(it.amount);
          $("#transaction_history").append(`<div class="transaction__item">
                                          <img src="../images/wallet_trans_histroy.png"/>
                                              <div class="row justify-space-between">
                                                <div class="text-left transDecLeft"> 
                                                  <div class="transaction__date">${it.detail}</div>
                                                  <div class="transaction__desc">
                                                    <span class="fs-12">${createDate}</span>
                                                  </div>
                                                </div> 
                                                <div class="text-left transDecRight"> 
                                                  <h4 class="transaction__amount credit" ${style}>${sign}₹${amount}</h4>
                                                </div>
                                              </div>
                                            </div>`);
          if ($('#transaction_history > .transaction__item').length >= historyCount) {
            $('#more-transactions').hide();
          }
        });
      }
    } else {
      //showAlert(response.message, "Error", "OK");
    }
  });
}

