function updateCartDate(cart_id, order_date, uniqueId = null) {
  var userdata = JSON.parse(localStorage.getItem('userdata'));
  var settings = {
    url: baseCarturl + "cart/update-cart-date",
    method: "POST",
    headers: {
      "Authorization": "Bearer " + userdata.token,
      "Content-Type": "application/json"
    },
    data: JSON.stringify({ cart_id: cart_id, order_date: order_date, addressId: poc_addressID })
  };

  $.ajax(settings).done(function (response) {
    if (response.success) {
      console.log("Date updated successfully");

      // 🔥 Update localStorage by ProductId (uniqueId)
      let localCart = JSON.parse(localStorage.getItem("cart")) || [];
      localCart = localCart.map(item => {
        if (uniqueId && String(item.ProductId) === String(uniqueId)) {
          item.StartDate = order_date;
          item.EndDate = order_date;
        }
        return item;
      });
      localStorage.setItem("cart", JSON.stringify(localCart));

      showCart();
    } else {
      console.warn("Failed to update date:", response.message);
      showCart();
    }
  }).fail(function (xhr, status, error) {
    console.error("Update Date API error:", error);
  });
}

