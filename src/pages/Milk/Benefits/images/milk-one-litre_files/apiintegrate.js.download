// start product detail page getting quntity
async function updateQuantityByUniqueId(uniqueId) {
  const userdata = JSON.parse(localStorage.getItem("userdata"));
  if (!userdata?.token) {
    throw new Error("User not logged in or token missing");
  }

  const poc_addressId = localStorage.getItem("selectedAddressId");

  try {
    const response = await $.ajax({
      url: baseCarturl + "cart/get-cart",
      method: "POST",
      headers: {
        Authorization: "Bearer " + userdata.token,
        "Content-Type": "application/json",
      },
      data: JSON.stringify({ 
        "addressId": poc_addressId,
        "City": userdata.city_id
      }),
    });

    if (response?.status !== 1 || !Array.isArray(response.cartItems)) {
      throw new Error("Invalid cart response");
    }

    const product = response.cartItems.find(
      (item) => Number(item.UniqueId) === Number(uniqueId)
    );

    if (!product) {
      return null; // stop here, don't change UI
    }

    // ✅ if product exists, update fields
    $("#itemQuantity").val(product.Quantity);
    $("#deliveryDate").val(moment(product.deliveryDate).format("D/M/YYYY"));

    $(".delivery_button.editDate").on("click", function () {
      $("#deliveryDate").prop("disabled", false).focus();
      $(document).off('click', '.dp-day.delivery-specific').on('click', '.dp-day', function () {
          handleBuyNow(this, '');
          $(".cartIcon .added-to-bag, .showcartmodal .added-to-bag").css("display", "none");
          setTimeout(function () {
              $("#cartdiv").css("display", "none");
          }, 1000);
          Swal.fire({
              position: 'bottom-end',
              icon: 'check',
              showConfirmButton: false,
              title: "Date updated successfully!",
              timer: 2500
          });
          $(this).addClass('delivery-specific');
      });
    });

    return product; // return matched product details if needed
  } catch (error) {
    console.error("Error updating quantity and delivery date:", error);
    throw error;
  }
}

// end product detail page getting quntity

function syncCartFromServer() {
  var userdata = JSON.parse(localStorage.getItem("userdata"));
  if (!userdata) {
    console.log("Guest user → keeping localStorage cart");
    return;
  }

  $.ajax({
    url: baseCarturl + "cart/get-cart",
    method: "POST",
    headers: {
      "Authorization": "Bearer " + userdata.token,
      "Content-Type": "application/json"
    },
    data: JSON.stringify({ 
      "addressId": poc_addressID,
      "City": userdata.city_id })
  }).done(function (response) {
    if (response.status === 1 && response.cartItems) {
      let localCart = JSON.parse(localStorage.getItem("cart")) || [];

      response.cartItems.forEach(serverItem => {
        let productId = String(serverItem.UniqueId || serverItem.product_id);

        // format date to DD/MM/YYYY
        let formattedDate = serverItem.deliveryDate
          ? moment(serverItem.deliveryDate, ["YYYY-MM-DD", "DD/MM/YYYY"]).format("DD/MM/YYYY")
          : null;

        // find in localCart
        let localItem = localCart.find(l => String(l.ProductId) === productId);

        if (localItem) {
          // 🔥 Update only dynamic fields
          localItem.Quantity = String(serverItem.Quantity);
          localItem.Price = String(serverItem.price);
          if (formattedDate) {
            localItem.StartDate = formattedDate;
            localItem.EndDate = formattedDate;
          }

          // recalc totals
          localItem.totalPrice = String(serverItem.price);
          localItem.totalPriceItem = String(serverItem.price * serverItem.Quantity);
        } else {
          // If new item not in localCart, push minimal version
          localCart.push({
            ProductId: productId,
            Quantity: String(serverItem.Quantity),
            Price: String(serverItem.price),
            StartDate: formattedDate,
            EndDate: formattedDate,
            Name: serverItem.productName,
            main_img: serverItem.productImg,
            totalPrice: String(serverItem.price),
            totalPriceItem: String(serverItem.price * serverItem.Quantity),
            DeliveryPlan: "once"
          });
        }
      });

      // Save patched cart
      localStorage.setItem("cart", JSON.stringify(localCart));
      localStorage.setItem("totalCartItems", localCart.length);

      console.log("ocalStorage cart synced (dates in DD/MM/YYYY)");
      loadCartItems();

    } else {
      console.warn("No items in server cart → clearing localStorage");
      localStorage.setItem("cart", JSON.stringify([]));
      localStorage.setItem("totalCartItems", 0);
      loadCartItems();
    }
  }).fail(function (xhr, status, error) {
    console.error("Error syncing cart from server:", error);
  });
}

// delivery instruction code start
function deliveryInstruction() {
    var userdata = localStorage.getItem("userdata");
    var data = JSON.parse(userdata);
    var settings = {
        url: baseUrl + "get-staticdata",
        method: "POST",
        headers: {
            "Authorization": "Bearer " + data.token,
            "Content-Type": "application/json",
        },
        data: JSON.stringify({ screen_name: 'delivery_instructions' })
    };
    $.ajax(settings).done(function (response) {
        const optionData = JSON.parse(response.data.data);
        let secHeader = response.data.name;
        let label = secHeader.replace(/_/g, " ").replace(/\b\w/g, c => c.toUpperCase());
        $("#delTxt").html(label)
        const container = document.getElementById("instructionOptions");

        container.innerHTML = ''; 
        const iconClasses = [
            "fa-bell",
            "fa-hand",
            "fa-door-open"
        ];

        optionData.forEach((item, index) => {
            const savedType = data.delivery_instruction_type;
            const isChecked = savedType === item.key ? 'checked' : '';
            const label = item.label.replace(/\n/g, "");
            const iconClass = iconClasses[index];
            const html = `
                <label class="option">
                    <input type="radio" name="delivery_instruction" value="${item.key}" onchange="onDeliveryInstructionChange(this)">
                    <i class="fa-solid ${iconClass} fa_icons"></i>
                    <div class="delivery_type">${label}</div>
                </label>
            `;
            container.innerHTML += html;
        });
        highlightSelectedOption();
        var features = JSON.parse(localStorage.getItem("featureFlags"));
        if (!features || typeof features.show_delivery_instructions === "undefined") {
          $('#deliveryInstructSec').remove();
        } else if (features.show_delivery_instructions === true) {
          $('#deliveryInstructSec').show();
        } else {
          $('#deliveryInstructSec').remove();
        }
    });
}
function onDeliveryInstructionChange(input) {
    const selectedKey = input.value;

    let userdata = localStorage.getItem("userdata");
    if (userdata) {
        let parsedData = JSON.parse(userdata);
        parsedData.delivery_instruction_type = selectedKey;
        localStorage.setItem("userdata", JSON.stringify(parsedData));
    }
    highlightSelectedOption();
}

function highlightSelectedOption() {
    document.querySelectorAll('.instruction-options .option').forEach(option => {
        const isChecked = option.querySelector('input[type="radio"]')?.checked;
        option.classList.toggle('active', isChecked);
        option.querySelector('.fa_icons')?.classList.toggle('color_blue', isChecked);
        option.querySelector('.delivery_type')?.classList.toggle('color_blue', isChecked);
    });
}
// delivery instruction code end
function removeFromCartNonServicable(cart_id, product_id) {
  var userdata = JSON.parse(localStorage.getItem('userdata'));
  var payload = {};

  // If both cart_id and product_id are provided, send both
  if (cart_id && product_id) {
    payload = { cart_id: cart_id, cart_id: product_id, addressId: poc_addressID };
  } else if (cart_id) {
    payload = { cart_id: cart_id, addressId: poc_addressID };
  } else if (product_id) {
    payload = { cart_id: product_id, addressId: poc_addressID };
  }

  var settings = {
    "url": baseCarturl + "cart/remove-from-cart",
    "method": "POST",
    "headers": {
      "Authorization": "Bearer " + userdata.token,
      "Content-Type": "application/json"
    },
    "data": JSON.stringify(payload)
  };

  $.ajax(settings).done(function (response) {
    if (response.status === 1) {
      loadCartItems();
      window.location.reload();
      $(".new_buynew").text("Buy Now").removeClass("active");
      $('#itemQuantity').val(1);

      // Update localStorage cart if needed
      let cart = JSON.parse(localStorage.getItem("cart")) || [];
      let updatedCart = cart.filter(item =>
        String(item.ProductId) !== String(product_id) &&
        String(item.ProductId) !== String(cart_id)
      );
      localStorage.setItem("cart", JSON.stringify(updatedCart));
    } else {
      console.error("Remove failed:", response.message);
    }
  }).fail(function (err) {
    console.error("Error removing item:", err);
  });
}


function removeOfferFromLocalStorage(){
  localStorage.removeItem("ref_no");
  localStorage.removeItem("offerItem");
  localStorage.removeItem("offer_product_id");
  localStorage.removeItem("offerend");
  localStorage.removeItem("offerstart");
  localStorage.removeItem("productOfferId");
  localStorage.removeItem("promocode_name");
  localStorage.removeItem("promocode_for");
  localStorage.removeItem("appliedCode");
  localStorage.removeItem("appliedOfferText");
  localStorage.removeItem("couponApplied");
}

  // Main function
function updateDeliveryDate(selectedAddressId, productData) {
  const newdata = JSON.parse(localStorage.getItem("userdata"));
  if (!newdata.token) throw new Error("Authentication token not found");

  const settings = {
    url: baseUrl + "get-user-addresses",
    method: "POST",
    timeout: 30000,
    headers: {
      "Content-Type": "application/json",
      Authorization: "Bearer " + newdata.token,
    },
    data: JSON.stringify({}),
  };

  $.ajax(settings).done((response) => {
    
    // find the selected address
    const selectedAddress = response.addresses.find(
      (addr) => addr.id === selectedAddressId
    );
    
    // console.log(selectedAddress.is_serviceable, "Fetched Addresses");
    if (!selectedAddress) {
      console.error("Address not found");
      return;
    }

    localStorage.setItem("is_serviceable_address", selectedAddress.is_serviceable);
  });
}

  $(document).on("click", ".tandc_icon", function () {
    let tandc = localStorage.getItem("tandC_metadat");
    if (tandc) {
      tandc = tandc.replace(/\/n/g, "\n");
      const points = tandc.split("\n").map(item => `<li style="list-style: disc; font-size:14px;padding-bottom:4px;">${item.trim()}</li>`).join("");

      Swal.fire({
        title: 'Terms & Conditions',
        html: `<ul style="text-align:left; padding-left:20px;">${points}</ul>`,
        imageUrl: '../frontend/web/images/tandc_icon.svg',
        imageWidth: 50,
        imageHeight: 50,
        imageAlt: 'Terms & Conditions Icon',
        confirmButtonText: 'Close',
        width: 550,
        color: '#333',
        background: '#fff',
        customClass: {
          popup: 'tandc-popup',   // custom popup class
          icon: 'tandc-icon',     // custom icon class
          title: 'tandc-title',
          confirmButton: 'tandc-confirm-btn',
        }
      });
    } else {
      Swal.fire("No Terms & Conditions!");
    }
  });

  function getEditAddressText(){
    var settings = {
        url: baseUrl + "get-staticdata",
        method: "POST",
        headers: {
                "Content-Type": "application/json",
        },
        data: JSON.stringify({ screen_name: "multiple_address"})
    };
    $.ajax(settings).done(function(response) {
      var as= JSON.parse(response.data.data)
        if(as){
          $("#EditAddrestext").text(as.addressUpdateTimeText);
        }else{
          $("#EditAddrestext").text("");
        }
      })
  }

function mergeLocalCartToServer(userdata) {
  const localCart = JSON.parse(localStorage.getItem("cart")) || [];
  const poc_addressID = localStorage.getItem("selectedAddressId");

  if (localCart.length === 0) return; // nothing to merge

  // Step 1: Get server cart first
  $.ajax({
    url: baseCarturl + "cart/get-cart",
    method: "POST",
    headers: {
      Authorization: "Bearer " + userdata.token,
      "Content-Type": "application/json",
    },
    data: JSON.stringify({
      "addressId": poc_addressID,
      "City": userdata.city_id,
    }),
  })
    .done(function (response) {
      if (response.status === 1) {
        let serverCart = response.cartItems || [];

        if (serverCart.length > 0) {
          // Server already has items → don’t add anything
          return;
        }

        // Server cart is empty → push all local cart items
        let requests = localCart.map((item) => {
          let orderDate = moment(item.StartDate, "DD/MM/YYYY").format("YYYY-MM-DD");

          return $.ajax({
            url: baseCarturl + "cart/add-to-shopping-cart",
            method: "POST",
            headers: {
              Authorization: "Bearer " + userdata.token,
              "Content-Type": "application/json",
            },
            data: JSON.stringify({
              product_id: item.ProductId,
              qty: item.Quantity,
              order_date: orderDate,
              addressId: poc_addressID,
            }),
          });
        });

        // Step 2: After syncing all, reload server cart
        $.when.apply($, requests).done(function () {
          // clear local cart after successful sync
          // localStorage.removeItem("cart");
          // localStorage.removeItem("totalCartItems");

          loadCartItems();
        });
      }
    })
    .fail(function (xhr, status, error) {
      console.error("Get-cart API error:", error);
    });
}

function disableScroll() {
  $("body").addClass("no-scroll");
}
function enableScroll() {
  $("body").removeClass("no-scroll");
}
function showUpdateOrderBtn() {
  let $btn = $(".checkout_button");
  $btn.removeClass("d-none");
  setTimeout(() => {
    $btn.addClass("expanded");
  }, 400); 
  const productCounts = $('.prod_item_add_count').length;
   if (productCounts == 0) {
      $btn.removeClass('expanded');
      $btn.addClass('d-none');
  }
}
const productCounts = $('.prod_item_add_count').length;
if (productCounts >= 1) {
  showUpdateOrderBtn();
}

function getStaticOffer(){
  const userdata = JSON.parse(localStorage.getItem('userdata'));
  // Check explicit localStorage flag first, then fallback to featureFlags
  const featureFlags = JSON.parse(localStorage.getItem('featureFlags') || '{}');
  const enabled = featureFlags && featureFlags.show32LitAndGheeOffer === true;
  if (!enabled) {
    // Ensure strip hidden when feature not enabled
    $("#OfferInfo").html('');
    $(".addprd").css("margin-top", "0px");
    return;
  }
  $.ajax({
    url: baseUrl + "get-staticdata",
    method: "POST",
    headers: {
      "Authorization": "Bearer " + userdata.token,
      "Content-Type": "application/json",
    },
    data: JSON.stringify({ screen_name: "32L_offer_screen" }),
    success: function (response) {
      if (response?.status === 1) {
        let data = response.data;
        if(!data){  
          $("#OfferInfo").html(``);
          $(".addprd").css("margin-top", "0px");
        } else {
          $("#OfferInfo").html(`
            <div class="urinvitedbox d-flex justify-spc-bet align-center mb-20">
              <div class="left-sec d-flex align-center">
                <p class="text-blue fs-14 mt-0 fwb pl5">Get 32L Milk and Ghee + Noritake Gift Box at Just ₹5500 <span class="amount-minus">₹7210</span></p>
              </div>
              <div class="right-sec">
                <a href="${url}special-offer" class="btn btn-transparent vwbtn text-white mt-0">Avail Now</a>
              </div>
            </div>
          `);
        }
      }
    }
  });
}

function servicableOrNot(){
  const newdata = JSON.parse(localStorage.getItem("userdata"));
  if(newdata){
    let token = newdata.token;
    const settings = {
    url: baseUrl + "get-user-addresses",
    method: "POST",
    headers: {
      "Content-Type": "application/json",
      Authorization: "Bearer " + token,
    },
    data: JSON.stringify({}),
  };

  $.ajax(settings).done((response) => {
    if (response.status === 1 && response.addresses && response.addresses.length > 0) {
      let selectedAddressId = localStorage.getItem("selectedAddressId");
      if(selectedAddressId){
      const selectedAddress = response.addresses.find(
      (addr) => addr.id === selectedAddressId
    );
      if(selectedAddress && selectedAddress.is_serviceable == false){
          Swal.fire({
          icon: 'info',
          title: 'Oops!',
          text: 'Looks like this festive offer isn’t available at your location.',
          confirmButtonText: 'OK',
            allowOutsideClick: false,
        }).then((result) => {
          if (result.isConfirmed) {
            window.location.href = "../shop/all";
          }
        });
      }
      }
  }})
  }else{
    Swal.fire({
      icon: "error",
      title: "Please login first",
      showConfirmButton: true
    });
  }
}