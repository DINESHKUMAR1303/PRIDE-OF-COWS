function Raiseticketsave() {
  var userdata = localStorage.getItem("userdata");
  var data = JSON.parse(userdata);
  var token = data.token;
  var UserID = data.UserID;
  var message = $("#message").val().trim();
  var product = $("#product").val();
  var fileInput = $('#raisefileInput')[0];

  if (message === '') {
    Swal.fire({
      title: "Error",
      text: 'Please fill the message field',
      closeOnConfirm: true,
    });
    return false;
  }

  if (fileInput.files.length > 0) {
    var file = fileInput.files[0];
    var reader = new FileReader();

    reader.onload = function (e) {
      var img = new Image();
      img.src = e.target.result;

      img.onload = function () {
        var canvas = document.createElement('canvas');
        var ctx = canvas.getContext('2d');

        var maxWidth = 1920;
        var maxHeight = 1920;
        var width = img.width;
        var height = img.height;

        if (width > height) {
          if (width > maxWidth) {
            height *= maxWidth / width;
            width = maxWidth;
          }
        } else {
          if (height > maxHeight) {
            width *= maxHeight / height;
            height = maxHeight;
          }
        }

        canvas.width = width;
        canvas.height = height;
        ctx.drawImage(img, 0, 0, width, height);

        var base64File = canvas.toDataURL('image/jpeg', 0.8).split(',')[1];

        var settings = {
          url: baseUrl + "raiseticket",
          method: "POST",
          timeout: 0,
          headers: {
            "Content-Type": "application/json",
            Authorization: "Bearer " + token,
          },
          data: JSON.stringify({
            Customer_id: UserID,
            message: message,
            product: product,
            image: base64File
          }),
        };

        $.ajax(settings).done(function (response) {
          if (response.status == 1) {
            Swal.fire({
              title: "Success",
              text: response.message,
              icon: "success",
              closeOnConfirm: true,
            }).then(function () {
              window.location.href = url + "raiseticket";
            });
          } else {
            Swal.fire({
              title: "Error",
              text: response.message,
              icon: "error",
              closeOnConfirm: true,
            }).then(function () {
              window.location.href = url + "raiseticket";
            });
          }
        });
      };

      img.onerror = function (error) {
        console.error("Error loading image:", error);
      };
    };

    reader.onerror = function (error) {
      console.error("Error reading file:", error);
    };

    reader.readAsDataURL(file);
  } else {
    var settings = {
      url: baseUrl + "raiseticket",
      method: "POST",
      timeout: 0,
      headers: {
        "Content-Type": "application/json",
        Authorization: "Bearer " + token,
      },
      data: JSON.stringify({
        Customer_id: UserID,
        message: message,
        product: product,
        image: null
      }),
    };

    $.ajax(settings).done(function (response) {
      if (response.status == 1) {
        Swal.fire({
          title: "Success",
          text: response.message,
          icon: "success",
          closeOnConfirm: true,
        }).then(function () {
          window.location.href = url + "raiseticket";
        });
      } else {
        Swal.fire({
          title: "Error",
          text: response.message,
          icon: "error",
          closeOnConfirm: true,
        }).then(function () {
          window.location.href = url + "raiseticket";
        });
      }
    });
  }
}


function Giftcard() {
  var userdata = localStorage.getItem("userdata", userdata);
  var data = JSON.parse(userdata);
  FirstName = data.FirstName;
  LastName = data.LastName;
  var username = FirstName + " " + LastName;
