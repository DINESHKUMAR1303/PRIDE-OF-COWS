function updateCartQuantity(uniqueId, qty, addRemoveQuantity) {
  var userdata = JSON.parse(localStorage.getItem('userdata'));
  $.ajax({
    url: baseCarturl + "cart/get-cart",
    method: "POST",
    headers: {
      "Authorization": "Bearer " + userdata.token,
      "Content-Type": "application/json"
    },
    data: JSON.stringify({ 
      "addressId": poc_addressID,
      "City": userdata.city_id }),
  }).done(function (cartResponse) {
    if (cartResponse.status === 1 && cartResponse.cartItems) {
      var matchedItem = cartResponse.cartItems.find(item => item.UniqueId == uniqueId);
      if (matchedItem) {
        var cart_id = matchedItem.cart_id;

        $.ajax({
          url: baseCarturl + "cart/update-cart-quantity",
          method: "POST",
          headers: {
            "Authorization": "Bearer " + userdata.token,
            "Content-Type": "application/json"
          },
          data: JSON.stringify({ cart_id: cart_id, qty: qty, addressId: poc_addressID })
        }).done(function (response) {
          if (response.status === 1) {
            $(".power-increment.increase.incrementWeb").removeClass("pointernone");
            $(".decrementWeb.decrease").removeClass("pointernone");
            console.log("Quantity updated successfully");

            // 🔥 Update localStorage
            let localCart = JSON.parse(localStorage.getItem("cart")) || [];
            localCart = localCart.map(item => {
              if (String(item.ProductId) === String(uniqueId)) {
                if(addRemoveQuantity==="plus")
                {
                  gaEvent({
                    'event':addRemoveQuantity,
                    'userID': userdata.UserID,
                    'addressID': localStorage.getItem("selectedAddressId"),
                    'productID': item.ProductId,
                    'productPrice': item.price,
                    'updatedQuantity': qty 
                  })
                }
                else
                {
                  gaEvent({
                    'event':addRemoveQuantity,
                    'userID': userdata.UserID,
                    'addressID': localStorage.getItem("selectedAddressId"),
                    'productID': item.ProductId,
                    'productPrice': item.price,
                    'updatedQuantity': qty 
                  })
                }
                item.Quantity = qty;
                item.totalPriceItem = String(item.Price * qty);
              }
              return item;
            });
            showUpdateOrderBtn();
            localStorage.setItem("cart", JSON.stringify(localCart));
          }
        }).fail(function (xhr, status, error) {
          console.error("Update API error:", error);
        });
      }
    }
  }).fail(function (xhr, status, error) {
    console.error("Get-cart API error:", error);
  });
}

