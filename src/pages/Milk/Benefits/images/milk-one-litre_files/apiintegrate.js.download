                                                                 <p>${it1.description}</p>
                                                         </a>
                                                         </div>
                                                         </div>`;
              });
            }
          });
        }
      }
      $("#content_category").html(productBox);
    } else {
      showAlert(response.message, "Error", "OK");
    }
  });
}
//shop category script2
function shopCategory(categoryId) {
  $("#preloader").show();
  const poc_addresid = localStorage.getItem("selectedAddressId");
  var userdata = localStorage.getItem("userdata", userdata);
  var newpin = localStorage.getItem("userPincode");
  var data = JSON.parse(userdata);
  if (data) {
    var token = data.token;
    var pinnid = newpin;
     var settings = {
        "url": baseurl + "allstatecity",
        "method": "POST",
        "timeout": 0,
        "headers": {
            "Content-Type": "application/json",
        },
        "data": JSON.stringify({
            "pincode": pinnid,
        }),
    };
    $.ajax(settings).done(function(response) {
          if (response?.status == 1 || response?.status == 2) {
              token = token;
              city = response.cid;
              // start load product with productlist and passing parameter as city id
              loadProducts(city, token, categoryId);
              // end load product with productlist and passing parameter as city id
          }
        })
  } else if (!data && newpin){
    var token = "";
    var city = "";
    var settings = {
        "url": baseurl + "allstatecity",
        "method": "POST",
        "timeout": 0,
        "headers": {
            "Content-Type": "application/json",
        },
        "data": JSON.stringify({
            "pincode": localStorage.userPincode
        }),
    };
    $.ajax(settings).done(function(response) {
          if (response?.status == 1 || response?.status == 2) {
              token = "";
              city = response.cid;
              // start load product with productlist and passing parameter as city id
              loadProducts(city, token, categoryId);
              // end load product with productlist and passing parameter as city id
            }
        });  
    }
    if(!newpin){
          var settings = {
        "url": baseurl + "allstatecity",
        "method": "POST",
        "timeout": 0,
        "headers": {
            "Content-Type": "application/json",
        },
        "data": JSON.stringify({
            "pincode": 400086
        }),
    };
          $.ajax(settings).done(function(response) {
          if (response?.status == 1 || response?.status == 2) {
              token = "";
              city = response.cid;
              // start load product with productlist and passing parameter as city id
              loadProducts(city, token, categoryId);
              // end load product with productlist and passing parameter as city id
            }
        });
        }
  }
function getproductDetail(pid, slug, category_slug, pre_launch_date, catgryId) {
  localStorage.setItem("pid", pid);
  localStorage.setItem("pslug", slug);

  if(catgryId){
    localStorage.setItem("cname", catgryId);
  }
  localStorage.setItem("launch_date", pre_launch_date);
  // window.location.href = weburl + slug;
  // start campaign visited 
  // submitCampaignDetails(CAMPAIGN_EVENTS.CATEGORY_Visited, pid);
  // start campaign visited 
  window.location.href = weburl + 'shop/' + category_slug + '/' + slug;
}
function getoffersView(pid, pquantity, offerprice, data_string, id) {
  localStorage.setItem("packageid", id);
  localStorage.setItem("pid", pid);
  localStorage.setItem("pquantity", pquantity);
  localStorage.offerselected = pquantity;
  localStorage.setItem("offerprice", offerprice);
  localStorage.setItem("data_string", data_string);
  localStorage.offeredprice = offerprice;
  $("#cartofferr").val(pquantity);

  localStorage.removeItem("cart");
  localStorage.removeItem("offercart");
  var userdata = localStorage["userdata"]
    ? JSON.parse(localStorage["userdata"])
    : 0;
  if (userdata == 0) {
    checklogin();
  } else {
    if (userdata.customer_type == 'prepaid') {
      if (localStorage.balance && parseInt(localStorage.balance) >= parseInt(offerprice)) {
        window.location.href = url + "offersview";
      } else {
        payofferAmount(offerprice);
      }
    } else {
      if (localStorage.balance && parseInt(localStorage.balance) >= parseInt(offerprice)) {
        window.location.href = url + "offersview";
      } else {
        window.location.href = url + "offercheckout";
      }
    }
  }
}
