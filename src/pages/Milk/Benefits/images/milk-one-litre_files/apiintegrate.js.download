function getCrownDetails() {
  var userdata = localStorage.getItem("userdata", userdata);
  var data = JSON.parse(userdata);
  var token = data.token;
  if (userdata) {
    var UserID = data.UserID;
  } else {
    var UserID = "";
  }
  var settings = {
    url: url + "loyalty",
    method: "POST",
    headers: {
      "Content-Type": "application/json",
      Authorization: "Bearer " + token,
    },
    data: JSON.stringify({
      customer_id: UserID,
    }),
  };
  $.ajax(settings).done(function (response) {
    if (response.status == 1) {
      var crown = response.earn_crows * 2;

      var crownBal = 50 - crown;
      if (crownBal >= 50 && crown >= 50) {
        crown = 0;
        crownBal = 0;
      }
      $(".crownBalance .crownsProgressBar__inner").width(crown + "%");
      $("#crownValue").text(response.earn_crows);
    }
  });
}
function checkoutitems() {
  var userdata = localStorage.getItem('userdata');
  var data = JSON.parse(userdata);
  var token = data.token;
  var rewardItems = localStorage.getItem('rewardItems');
  if (rewardItems === undefined) {
    return;
  }
  if (userdata) {
    var UserID = data.UserID;
  } else {
    var UserID = '';
  }
  var settings = {
    "url": baseCarturl + "cart/checkoutitems",
    "method": "POST",
    headers: {
      "Authorization": "Bearer " + token
    },
    data: {
      'customer_id': UserID,
      'reward_id': localStorage.getItem('reward_id')
    }
  };
  $.ajax(settings).done(function (response) {

    var txt = '';
    for (var i = 0; i < response.cartItems.length; i++) {
      txt += `<div class="row checkout_product_items" >
                                            <div class="col-4">
                                                    <a href="#" >
<img class="checkout__cart__img" src="https://prideofcows.in/prideofcows/storage/${response.cartItems[i].thumb_img}" alt="${response.cartItems[i].product_name}">                                            </div>
                                            <div class="col-8">
                                                    <div class="checkout__cart__text">
                                                    <a href="#">
<h4 class="checkout__cart__title">${response.cartItems[i].product_name}</h4>                                                    </a>
                                                    
                                                    <div class="checkout__cart__deliveryPlan">Delivery plan: <span>${response.cartItems[i].delivery_plan}</span></div>
                                                    <div class="checkout__cart__deliveryPlan">No. Of Booking Days: <span>${response.cartItems[i].noOfDays}</span></div>
                                                    <div class="checkout__cart__quantityPriceRow d-flex justify-space-between">
                                                            <div class="checkout__cart__quantity">Quantity: <span>${response.cartItems[i].quantity}</span></div>
                                                            <div class="checkout__cart__totalQuantityPrice">₹ ${response.cartItems[i].total_price}</div>
                                                    </div>
                                                    </div>
                                            </div>
                                          
                                            </div>`;
    }
    $('#cart_summary').html(txt);
    if (response.message === 'No Items in Your Cart!') {
      $('.showcheckoutSubtotal').html('₹0');
    } else {
      $('.showcheckoutSubtotal').html('₹' + response.checkout.cartPrice);
    }
    $('.showcheckoutTax').html('₹' + response.checkout.taxPriceTotal);
    $('.showcheckoutRewardDiscount').html('₹0');
    if (response.checkout.offfer_discount == null) {
      var offDis = 0;
    }
    
    if (response.customerType == 'loyalty' || response.customerType == 'refer_n_earn' || response.customerType == 'referror_to_earn') {
      $('.showcheckoutRewardDiscount').html('₹' + response.checkout.cartPrice);
    }
    $('.showcheckoutoffersDiscount').html('₹' + offDis);
    // $('.showcheckoutRewardDiscount').html('₹'+response.checkout.offfer_discount);
    var total = response.checkout.cartPrice - offDis - response.checkout.rewardDiscount;
    if (response.message === 'No Items in Your Cart!' || response.customerType == 'loyalty' || response.customerType == 'refer_n_earn' || response.customerType == 'referror_to_earn') {
      total = 0;
    }
    $('.showcheckoutTotal').html('₹' + total);
    if (response.customerType == 'loyalty' || response.customerType == 'refer_n_earn' || response.customerType == 'referror_to_earn') {
      $('.checkout__paymentModeSelect, #makePayment').hide();
      $('#placeOrder').attr('style', '');
      localStorage.setItem('loyaltyResponse.start_date', response.cartItems[0].start_date);
      localStorage.setItem('loyaltyResponse.end_date', response.cartItems[0].end_date);
      localStorage.setItem('loyaltyResponse.product_id', response.cartItems[0].product_id);
      localStorage.setItem('loyaltyResponse.cartPrice', response.cartItems[0].cartPrice);
      localStorage.setItem('loyaltyResponse.total_items', response.total_items);
      localStorage.setItem('loyaltyResponse.delivery_plan', response.cartItems['0'].delivery_plan);
    }
    // var html = '<div class="showcheckoutSubtotal">₹ '${response.checkout['0'].cartPrice }'"</div>";
    // $('.showcheckoutSubtotal').html( html );
    // for(var j = 0 ; j < response.checkout.length ; j++){
