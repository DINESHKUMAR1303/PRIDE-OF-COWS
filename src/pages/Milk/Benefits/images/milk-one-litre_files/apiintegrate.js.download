function ReferearninfoForReward() {
  return new Promise(function (resolve, reject) {
    var userdata = localStorage.getItem("userdata", userdata);
    var data = JSON.parse(userdata);
    var token = data.token;
    if (userdata) {
      var UserID = data.UserID;
    } else {
      var UserID = "";
    }
    var settings = {
      url: baseUrl + "referearninfo",
      method: "POST",
      headers: {
        "Content-Type": "application/json",
        Authorization: "Bearer " + token,
      },
      data: JSON.stringify({
        customer_id: UserID,
      }),
    };
    $.ajax(settings).done(function (response) {
      // console.log(response);
      if (response.status == 1) {
        if (response.data) {
          // console.log("New user info callal===>", response.data);
          resolve(response.data); // Resolve the Promise with the API response data
        }
      } else {
        reject(response.message); // Reject the Promise with an error message
      }
    });
  });
}

async function rewards() {
  var rewardDataForCustomer = await ReferearninfoForReward();
  var customerfilteredData = rewardDataForCustomer.filter(function (item) {
    return item.purchase_status == 1;
  });

  // console.log("Data from reward==>", customerfilteredData);
  var userdata = localStorage.getItem("userdata", userdata);
  // console.log("userdata", userdata);
  var data = JSON.parse(userdata);
  // console.log("data", data);
  if (userdata) {
    FirstName = data.FirstName;
    LastName = data.LastName;
    var username = FirstName + " " + LastName;
  } else {
    var username = "";
  }
