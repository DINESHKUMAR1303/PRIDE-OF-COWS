                                        ${localStorage.discount_value != 0 ?`  ₹ ${localStorage.discount_value}` : ''}
                                    </div>
                                    <div class="checkout__cart__coupon__left d-flex">
                                        <div class="checkout__cart__viewOffers text-blue pointer" onclick="viewofferspromocode();"><b>VIEW OFFERS</b></div>
                                    </div></div>`);

    // paneer offer code
    if(localStorage.promocode_name !== PRODUCT_OFFER.OFFER_CODE) {
      $("#promocodesuccess").attr("onclick", "");
      $("#promocodesuccess")
        .html(`<div class="checkout__cart__coupon__row d-flex justify-space-between">
                                      <div class="checkout__cart__coupon__left d-flex">
                                          <img src="../images/verify.png" alt="discount icon"><span style="padding-right: 40px; font-size: 15px;">${localStorage.promocode_name} applied! 
                                          <a class="checkout__cart__coupon__remove text-blue underline" id="promocodecouponremove" onclick="removepromocodeoffer()"> (Remove)</a></span>
                                      </div>
                                      <div class="checkout__cart__viewOffers_discount">
                                          ${localStorage.discount_value != 0 ?`  ₹ ${localStorage.discount_value}` : ''}
                                      </div>
                                      <div class="checkout__cart__coupon__left d-flex">
                                          <div class="checkout__cart__viewOffers text-blue pointer" onclick="viewofferspromocode();"><b>VIEW OFFERS</b></div>
                                      </div></div>`);
                $(".offer-box").hide();
    }

    $(".couponPopUp").attr("class", "couponPopUp");
    if(localStorage.promocode_for =='refferal'){ 
      $(".showcheckoutoffersDiscount").html("₹ 0");
      $(".showcheckoutRewardDiscount").html("-₹"+localStorage.discount_value );
    }
  }
  // totalprice();
  addCartsummaryoffercart();
  getOffercarts();
}
function SubscriptionPlaceorder(params) {
  var userdata = localStorage["userdata"]
    ? JSON.parse(localStorage["userdata"])
    : {};
  if (userdata) {
    var token = userdata.token;

    var settings = {
      url: baseUrl + "subscription-placeorder",
      method: "POST",
      data: JSON.stringify(params),
      headers: {
        Authorization: "Bearer " + token,
        "Content-Type": "application/json",
      },
    };
    $.ajax(settings).done(function (response) {
      if (response.status == 1) {
        localStorage.removeItem("cartItems");
        localStorage.removeItem("dedate");
        localStorage.removeItem("subcartItems");
        localStorage.removeItem("cart");
        localStorage.removeItem("reward");
        localStorage.removeItem("subcart");
        localStorage.removeItem("customCart");
        setTimeout(function () {
          Swal.fire({
            title: "success",
            text: response.message,
            icon: "success",
            closeOnConfirm: true,
          }).then(function () {
            window.location.href = url + "calenderorder";
          });
        }, 1000);
      } else {
        Swal.fire({
          title: "error",
          text: response.message,
          icon: "error",
          closeOnConfirm: true,
        }).then(function () {
          window.location.href = url + "index";
        });
      }
    });
  }
}
function placeorder() {
  var cartitem = "";
  var Cart = localStorage.getItem("cart", Cart);
  var data = JSON.parse(Cart);
  var mindate = "";
  var maxdate = "";
  if (data) {
    $.each(data, function (i, it) {
      cartitem +=
        it.ProductId +
        ":" +
        it.Price +
        ":" +
        it.Quantity +
        ":" +
        it.totalPriceItem +
        "|";
      var mdate = it.StartDate;

      var mindate = mdate.split("/").reverse().join("-");
      var edate = it.EndDate;
      var maxdate = edate.split("/").reverse().join("-");
      localStorage.min = mindate;
      localStorage.max = maxdate;

      if (it.DeliveryPlan == "daily") {
        var planNane = "everyday";
      } else {
        var planNane = it.DeliveryPlan;
      }
      localStorage.plname = planNane;
    });
    setTimeout(function () {
      var params = {
        CartItems: cartitem,
        minDate: localStorage.min,
        maxDate: localStorage.max,
        TotalAmount: localStorage.totalval,
        subscriptionType: localStorage.plname,
        TotalPay: localStorage.totalval,
        Source: "Desktop",
      };
      SubscriptionPlaceorder(params);
    }, 2500);
    removeOfferFromLocalStorage();
  }
}

function wallet() {
  var userdata = localStorage.getItem("userdata", userdata);
  var data = JSON.parse(userdata);
  if (userdata) {
    FirstName = data.FirstName;
    LastName = data.LastName;
    var username = FirstName + " " + LastName;
  } else {
    var username = "";
  }
  var token = data.token;
  var settings = {
    url: baseUrl + "getwallet",
    method: "POST",
    headers: {
      "Content-Type": "application/json",
      Authorization: "Bearer " + token,
    },
  };
  $.ajax(settings).done(function (response) {
    if (response.status == 1) {
      if (response.data) {
        localStorage.balance=response.data.balance;
        $("#wallet_balance").html("₹" + response.data.balance);
        $("#user").html(username);
      }
    } else {
      localStorage.balance=response.data.balance;
      $("#wallet_balance").html("₹ 0");
      $("#user").html(username);
    }
  });
}

function Walletransactionhistory() {
  var userdata = localStorage.getItem("userdata", userdata);
  var data = JSON.parse(userdata);
  var token = data.token;
  if (userdata) {
    var UserID = data.UserID;
  } else {
    var UserID = "";
  }
  var settings = {
    url: baseUrl + "wallettransactions",
    method: "POST",
    headers: {
      "Content-Type": "application/json",
      Authorization: "Bearer " + token,
    },
    data: JSON.stringify({
      customer_id: UserID,
    }),
  };
  $.ajax(settings).done(function (response) {
    //response);
    if (response.status == 1) {
      if (response.data) {
        $.each(response.data, function (i, it) {
          if (it.adjustment === null) {
            var adjs = it.payment_amount;
          } else {
            var adjs = it.payment_amount + " + " + it.adjustment;
          }
          $("#transaction_history").append(`<div class="transaction__item abc">
                    <img src="../images/wallet_histiry_img.png"/>
                    <div>
                                        <div class="row">
                                          <div class="col-6"> 
                                            <div class="transaction__desc">${it.detail}</div>
                                          </div>
                                          <div class="col-6 text-right"> 
                                            <h4 class="transaction__amount credit">+ ₹${adjs}</h4>
                                          </div>
                                        </div>
                                        
                                        <div class="transaction__date">${it.created_date}</div>
                                    </div></div>`);
        });
        const totalTrans = $('.transaction__item').length;
        $(".totalTransactions").html(`Total ${totalTrans} transactions`)
      }
    } else {
      //showAlert(response.message, "Error", "OK");
    }
  });
}

function Paymentinfo() {
  var userdata = localStorage.getItem("userdata", userdata);
  var data = JSON.parse(userdata);
  var token = data.token;
  if (userdata) {
    var UserID = data.UserID;
  } else {
    var UserID = "";
  }
  var settings = {
    url: baseUrl + "paymentinfo",
    method: "POST",
    headers: {
      "Content-Type": "application/json",
      Authorization: "Bearer " + token,
    },
    data: JSON.stringify({
      customer_id: UserID,
    }),
  };
  $.ajax(settings).done(function (response) {
    if (response.status == 1) {
      if (response.data) {
        $.each(response.data, function (i, it) {

              let statusColor = "";
              if (it.payment_status === "success") {
                statusColor = "color: green;"; 
              } else if (it.payment_status === "pending") {
                statusColor = "color: orange;";
              } else if (it.payment_status === "failed") {
                statusColor = "color: red;";
              }
          
                $("#payment_info").append(`
                  <div class="faqsList__detail__item__answer recent List text-primary--imp">
                    <div class="transaction__item" data-order-id="${it.order_id}">
                      <div class="d-flex justify-space-between pb-5">
                        <div class="transaction__desc">Transaction ID: ${it.payment_order_id}</div>
                        <h4 class="transaction__amount pb-0">₹ ${it.amount}</h4>
                      </div>
                      <div class="d-flex justify-space-between">
                        <div class="transaction__date">${it.create_at}</div>
                        <div class="transaction__status" style="${statusColor}">${it.payment_status}
                           ${it.payment_status === 'pending' ? `
                          <i class="fa-solid fa-circle-info info-icon" style="cursor: pointer;"></i>
                        ` : ''}
                        </div>
                      </div>
                    </div>
                  </div>
                `);
              });
            }
          } else {
            showAlert(response.message, "Error", "OK");
          }
  });
}

$(document).on('click', '.info-icon', function () {
  const transactionElement = $(this).closest(".transaction__item");
  const transactionID = transactionElement.find(".transaction__desc").text().replace('Transaction ID: ', '');
  const orderID = transactionElement.data('order-id');
  const status = transactionElement.find(".transaction__status").text();
  const amount = transactionElement.find(".transaction__amount").text();
  const date = transactionElement.find(".transaction__date").first().text();

  $("#myModal .custom-modal-body").html(`
    <div class="transaction-modal">
      <h4 class="transaction-title">Transaction Details</h4>
      <p class="transaction-detail"><strong>Transaction ID:</strong> ${transactionID}</p>
      <p class="transaction-detail"><strong>Order ID:</strong> ${orderID}</p>
      <p class="transaction-detail"><strong>Amount:</strong> ${amount}</p>
      <p class="transaction-detail"><strong>Status:</strong> ${status}</p>
      <p class="transaction-detail"><strong>Date:</strong> ${date}</p>
    </div>
  `);

  $("#myModal").fadeIn();
});

$(document).on('click', '.custom-modal-close, .custom-modal-close-btn', function () {
  $("#myModal").fadeOut();
});

$(window).on('click', function (event) {
  if ($(event.target).is("#myModal")) {
    $("#myModal").fadeOut();
  }
});

