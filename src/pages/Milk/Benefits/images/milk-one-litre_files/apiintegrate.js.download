              var opr = parseInt(localStorage.discount_value)*parseInt(localStorage.result_quantity);
            } else {
              var opr = 0;
            }
            TotalPay = orderTotal - walletBalance;

            if (localStorage.packageofferediD) {
              var packageId = localStorage.packageofferediD;
            } else {
              var packageId = 0;
            }

            if (
              (ocart && jQuery.isEmptyObject(ocart) == false) ||
              localStorage.discount_value && localStorage.promocode_for !='refferal' && localStorage.promocode_for !='refferee'
            ) {
              var offerStatus = 1;
            } else if (localStorage.promocode_for =='refferee' && parseInt(localStorage.totalval)>=2000){
              var offerStatus = 0;
              var referrer_no = localStorage.referrer_no;
            } else if (localStorage.promocode_for =='refferal' && totalval>=500){
              var offerStatus = 2;
              var couponid=localStorage.couponid;
            } else{
              var offerStatus = 0;
              var couponid='';
            }

            // alert(TotalPay+"---"+userdata.customer_type);
            if ($.isEmptyObject(cartList.cartItems) == false) {
              if (localStorage.offCart) {
                var offCart1 = localStorage.offCart;
              } else {
                var offCart1 = 0;
              }

              if (localStorage.Alloffercartitems) {
                var customOcarts = localStorage.Alloffercartitems;
              } else {
                var customOcarts = 0;
              }

              var params = {
                couponid: localStorage.getItem("promocode_name"),
                CartItems: cartitem,
                custId: userdata.UserID,
                allcart: allcart,
                DeliveryDate: localStorage.mindate,
                City: citydata.city,
                TotalAmount: TotalPay - opr,
                TotalPay: TotalPay - opr,
                api: "Placeorder",
                website_payment: 1,
                Source: "Desktop",
                offerStatus: offerStatus,
                referrer_no:referrer_no,
                offcart: offCart1,
                address: address,
                customC: customOcarts,
                minDate: localStorage.mindate,
                maxDate: localStorage.mindate,
                offeredprice: opr,
                packageId: packageId,
                current_balance: localStorage.getItem("balance") ?? "0"
              };
            } else if (
              $.isEmptyObject(cartList.subcartItems) == false &&
              !localStorage.customCart
            ) {
              if (localStorage.offCart) {
                var offCart1 = localStorage.offCart;
              } else {
                var offCart1 = 0;
              }
              if (localStorage.Alloffercartitems) {
                var customOcarts = localStorage.Alloffercartitems;
              } else {
                var customOcarts = 0;
              }
              var params = {
                couponid: localStorage.getItem("promocode_name"),
                CartItems: cartitem,
                custId: userdata.UserID,
                allcart: allcart,
                minDate: localStorage.mindate,
                maxDate: localStorage.maxdate,
                City: citydata.city,
                TotalAmount: orderTotal - opr,
                subscriptionType: localStorage.subscriptiontype,
                TotalPay: TotalPay - opr,
                api: "SubscriptionPlaceorder",
                website_payment: 1,
                Source: "Desktop",
                offerStatus: offerStatus,
                referrer_no:referrer_no,
                offcart: offCart1,
                address: address,
                customC: customOcarts,
                offeredprice: opr,
                packageId: packageId,
                current_balance: localStorage.getItem("balance") ?? "0"
              };
            } else if (localStorage.customCart) {
              let customCartitem = "";
              localStorage.customCart.map((customCartItem, i) => {
                customCartitem +=
                  customCartItem.Date +
                  ":" +
                  customCartItem.ProductId +
                  ":" +
                  customCartItem.Price +
                  ":" +
                  customCartItem.Quantity +
                  "|";
              });
              var params = {
                couponid: localStorage.getItem("promocode_name"),
                CartItems: cartitem,
                custId: userdata.UserID,
                minDate: localStorage.mindate,
                maxDate: localStorage.maxdate,
                City: citydata.city,
                TotalAmount: orderTotal - opr,
                subscriptionType: localStorage.subscriptiontype,
                customCartitem: customCartitem,
                TotalPay: TotalPay - opr,
                api: "SubscriptionPlaceorder",
                website_payment: 1,
                Source: "Desktop",
                offerStatus: offerStatus,
                referrer_no: referrer_no,
                offeredprice: opr,
                packageId: packageId,
                current_balance: localStorage.getItem("balance") ?? "0"
              };
            }

            var payData = {};
            payData["TotalAmount"] = localStorage.totalval;
            payData["customer_id"] = userdata.UserID;
            payData["dataAr"] = JSON.stringify(params);
            localStorage.payData = JSON.stringify(payData);
            if(localStorage.promocode_for=='refferal' && localStorage.discount_value>localStorage.totalval){
              var offerStatus=2;
              var couponid=localStorage.couponid;
            }else{
              var offerStatus=0;
              var couponid='';
            }
          //  start new changes afternoon
            var params = {
            CartItems: cartitem,
            allcart: allcart,
            DeliveryDate: localStorage.mindate,
            City: citydata.city,
            // TotalAmount: orderTotal,
            TotalAmount: localStorage.totalPayableAmount,
            TotalPay: localStorage.totalval,
            custId: userdata.UserID,
            address: address,
            minDate: localStorage.mindate,
            maxDate: localStorage.mindate,
            offerStatus:offerStatus,
            couponid:couponidCheck,
            current_balance: localStorage.getItem("balance") ?? "0",
            deliveryAddressId: poc_addresid,
            billingAddressId: poc_addresid,
          };
          // console.log(params)
          if(localStorage.totalval == 0) {
            placeOrders(params)
          } else {
              var params = {
                CartItems: cartitem,
                custId: userdata.UserID,
                allcart: allcart,
                DeliveryDate: localStorage.mindate,
                City: citydata.city,
                // TotalPay: localStorage.getItem("totalPrice"),
                // TotalAmount: TotalPay - opr,
                // TotalAmount: localStorage.getItem("totalval"),
                // TotalPay: localStorage.getItem("totalval") - localStorage.getItem("balance"),
                TotalAmount: localStorage.totalPayableAmount,
                TotalPay: localStorage.getItem("totalval"),
                api: "Placeorder",
                website_payment: 1,
                Source: "Desktop",
                offerStatus: offerStatus,
                referrer_no: referrer_no,
                offcart: offCart1,
                address: address,
                customC: customOcarts,
                minDate: localStorage.mindate,
                maxDate: localStorage.mindate,
                // offeredprice: opr,
                offeredprice: localStorage.discount_value,
                packageId: packageId,
                current_balance: localStorage.getItem("balance") ?? "0",
                couponid: localStorage.getItem("promocode_name")
              };
              var payData = {};
              payData["TotalAmount"] = localStorage.totalPayableAmount;
              payData["customer_id"] = userdata.UserID;
              payData["dataAr"] = JSON.stringify(params);
              localStorage.payData = JSON.stringify(payData);
                setTimeout(() => {
                  nimmblepay();
                }, 1500);
              }
            // return;
            // setTimeout(() => {
            //   nimmblepay();
            // }, 1500);
            // end new changes afternoon
          } else {
            const poc_addresid = localStorage.getItem("selectedAddressId");
            var params = {
              CartItems: cartitem,
              allcart: allcart,
              DeliveryDate: localStorage.mindate,
              City: citydata.city,
              TotalAmount: orderTotal,
              TotalPay: TotalPay,
              // TotalAmount: localStorage.getItem("totalval"),
              // TotalPay: TotalPay - opr,
              minDate: localStorage.mindate,
              maxDate: localStorage.mindate,
              custId: userdata.UserID.toString(),
              offerStatus: offerStatus,
              couponid:couponid,
              current_balance: localStorage.getItem("balance") ?? "0",
              deliveryAddressId: poc_addresid,
              billingAddressId: poc_addresid,
            };
            placeOrders(params);
          }
        }
      } else if (
        $.isEmptyObject(cartList.subcartItems) == false &&
        !localStorage.customCart
      ) {
        var params = {
          couponid: localStorage.getItem("promocode_name"),
          CartItems: cartitem,
          custId: userdata.UserID,
          allcart: allcart,
          minDate: localStorage.mindate,
          maxDate: localStorage.maxdate,
          City: citydata.city,
          TotalAmount: orderTotal,
          subscriptionType: localStorage.subscriptiontype,
          TotalPay: TotalPay,
          Source: "Desktop",
          offerStatus: offerStatus,
          couponid:couponid,
          current_balance: localStorage.getItem("balance") ?? "0"
        };
        SubscriptionPlaceorders(params);
      } else if (localStorage.customCart) {
        var customCartItems = JSON.parse(localStorage.getItem("customCart"));
        let customCartitem = "";
        localStorage.customCart.map((customCartItem, i) => {
          customCartitem +=
            customCartItem.Date +
            ":" +
            customCartItem.ProductId +
            ":" +
            customCartItem.Price +
            ":" +
            customCartItem.Quantity +
            "|";
        });
        var params = {
          couponid: localStorage.getItem("promocode_name"),
          CartItems: cartitem,
          custId: userdata.UserID,
          minDate: localStorage.mindate,
          maxDate: localStorage.maxdate,
          City: citydata.city,
          TotalAmount: orderTotal,
          subscriptionType: localStorage.subscriptiontype,
          customCartitem: customCartitem,
          TotalPay: TotalPay,
          Source: "Desktop",
          address: address,
          offerStatus:offerStatus,
          couponid:couponid,
          current_balance: localStorage.getItem("balance") ?? "0"
        };
        SubscriptionPlaceorders(params);
      }
    }
  }
}
let isNewMethodEnabled = false;
try {
  isNewMethodEnabled = JSON.parse(localStorage.getItem("featureFlags")).use_new_payment_gatway;
  isNewMethodEnabled = isNewMethodEnabled === true || isNewMethodEnabled === "true" ? true : false;
} catch (error) {
  console.error("Error parsing featureFlags from localStorage:", error);
}

function nimmblepay() {
  var userdata = localStorage["userdata"]
  ? JSON.parse(localStorage["userdata"])
  : {};
  if (userdata) {
    $("#overlay").fadeIn();
    var token = userdata.token;
    var payData = localStorage.payData;
    var sourcename = localStorage.sourcename;
    var offerdetail = localStorage.offerdetail;
    let selectedPaymentMenthod = userdata.payment_gateway?userdata.payment_gateway:'RAZORPAY';
    if (!isNewMethodEnabled) {

      payData = JSON.parse(payData);
      if (localStorage.pid == 3) {
        if (localStorage.dis == 0 && localStorage.result_quantity == 30) {
          var amount = payData.TotalAmount - localStorage.amnt;
        } else {
          var amount = payData.TotalAmount;
        }
      }
      var amount = payData.TotalAmount;
      var customerId = payData.customer_id;
      var data1 = payData.dataAr;
      var status_999 = payData.status_999 ?? 0;
      // packagemasterone()
      localStorage.removeItem("payData");

    // start payment campaign
    const cartdata = localStorage.getItem("cart") || "[]";
    const cartdataNew = JSON.parse(cartdata);
    const productQtyString = cartdataNew
    .map(function (item) {
    return item.ProductId + ':' + item.Quantity;
    })
    .join(',');
    submitCampaignDetails(CAMPAIGN_EVENTS.CATEGORY_ProceedToPayment, productQtyString);

    let utm_source = sessionStorage.getItem("utm_source");
    let newlastParam = sessionStorage.getItem("lastparam_ghee");
    var promoCodeName = localStorage.getItem("promocode_name");
    data1 = JSON.parse(data1);
    if(localStorage.getItem("matchProduct") == false && localStorage.getItem("paneerPromocodeHandling") == true ) {
      data1["promocode_for"] = " ";
    }else if (localStorage.getItem("paneerPromocodeHandling") == false && localStorage.getItem("matchProduct") == true) {
      data1["promocode_for"] = promoCodeName;
    } else if(localStorage.getItem("trippleNine")) {    // new line add for 999 offer
      data1["promocode_for"] = "product";               // new line add for 999 offer
    }
     else{
      let promo_for = ""
        // Check if it is undefined, null, or literally the string "undefined"
        if (!localStorage.productOfferId) { // set empty string if undefined
          if (localStorage.promocode_for === "wallet") {
            promo_for = localStorage.promocode_for;
          } else if (localStorage.promocode_for_wallet === "wallet")  {
            promo_for = localStorage.promocode_for_wallet;
          }else {
            promo_for = "";
          }
        } else {
          promo_for = "product";
        }
        
      // data1["promocode_for"] = promoCodeName;
      data1["promocode_for"] = promo_for;
    }
    data1["deliveryAddressId"] = localStorage.trippleNine ? userdata.default_address_id : poc_addressID;
    data1["billingAddressId"] = localStorage.trippleNine ? userdata.default_address_id : poc_addressID;
    // data1["couponid"] = localStorage.getItem("promocode_name");    // comment line add for 999 offer
    data1["couponid"] = localStorage.trippleNine ? localStorage.trippleNine : localStorage.getItem("promocode_name") ? localStorage.getItem("promo_code") || localStorage.getItem("promocode_name") : localStorage.getItem("promocode_name"); // new line add for 999 offer
    
    if(localStorage.promocode_for === "wallet") {
      data1["couponid"] = localStorage.getItem("promo_code");
    }

    const promoCode = localStorage.trippleNine
                      ? localStorage.trippleNine
                      : localStorage.promocode_for === "wallet" || localStorage.promocode_for_wallet === "wallet"
                        ? localStorage.getItem("promo_code")
                        : localStorage.getItem("promocode_name");

     if (utm_source !== "other" && newlastParam !== 'other-cat') {
      data1["user_id"] = customerId;
      data1["product_id"] = productQtyString;
      data1["order_detail_id"] = CAMPAIGN_EVENTS.CATEGORY_ProceedToPayment;
      data1["source"] = utm_source;
      data1["offer_detail"] = utm_source !== 'utm_source' && newlastParam !== 'ghee' ? 'other-cat' : 'cat-ghee';
    }
    data1 = JSON.stringify(data1);
    // Always included payload
    var payload = {
      UserID: customerId,
      TotalAmount: amount,
      dataAr: data1,
      offer_source: sourcename,
      offer_desc: offerdetail,
      status: status_999,
      current_balance: localStorage.getItem("balance") ?? "0",
      couponid: promoCode,   // for 999 offer localStorage.getItem("promocode_name")
    };
    // end payment campaign

    var settings = {
      url: baseUrl + "razorordercreate",
      method: "POST",
      headers: {
        Authorization: "Bearer " + token,
        "Content-Type": "application/json",
      },
      data: JSON.stringify(payload),
    };
    $.ajax(settings).done(function (response) {
      if (response.status == 1) {
        localStorage.removeItem("sourcename");
        localStorage.removeItem("offerdetail");
        removeOfferFromLocalStorage();
        
        var order_id = response.order_id;
        var options = {
          "key": razorpayKey,
          // "key": "access_key_pKx7rdAWOEDoj3q2",
          "amount": amount,
          "currency": "INR",
          "name": "Pride of Cows",
          "image": originurl + "/poc/images/logo.png",
          "order_id": order_id,
          "callback_url": mainUrl + "/payment/razorprocess",
          "prefill": {
            "contact": userdata.MobileNo,
            "email": userdata?.Email || "",
          },
          "theme": { 
            "color": "#193b61"
          },
          "modal": {
            "ondismiss": function () {
              //location.reload();
              gaEvent({
                event: "razorpay_cancel_payment",
                amount: amount,
                order_id: options.order_id,
                contact: options.prefill?.contact
              });
              window.location.href = url + 'checkout';
            }
          },
          // "handler": function (response) {
          //   // clearCartAfterPayment();
          // }
        };

        var rzp = new Razorpay(options);
        // Handle failed payment
        rzp.on('payment.failed', function (response) {
          gaEvent({
              event: "razorpay_failed_payment",
              amount: amount,
              order_id: order_id,
              contact: options.prefill?.contact,
              error_code: response.error?.code,
              error_description: response.error?.description
          });
          window.location.href = url + 'checkout';
        });
        rzp.open();
        // localStorage.removeItem("discount_value");  // paneer offer code
        localStorage.setItem("promocode_for", JSON.parse(payData.dataAr).promocode_for);
        Checkcustomertype();
        const callbackData = JSON.parse(localStorage.getItem("callbackData"));
        if(callbackData?.url){
          localStorage.setItem("callbackData", JSON.stringify({...callbackData, redirect : true}))
        }
      }
    });

 
    } 
    // new payment
    else if (isNewMethodEnabled) {
      payData = JSON.parse(payData);
      if (localStorage.pid == 3) {
        if (localStorage.dis == 0 && localStorage.result_quantity == 30) {
          var amount = payData.TotalAmount - localStorage.amnt;
        } else {
          var amount = payData.TotalAmount;
        }
      }
      var amount = payData.TotalAmount;
      var customerId = payData.customer_id;
      var data1 = payData.dataAr;
      var status_999 = payData.status_999 ?? 0;
      // packagemasterone()
      localStorage.removeItem("payData");

      // start payment campaign
      const cartdata = localStorage.getItem("cart") || "[]";
      const cartdataNew = JSON.parse(cartdata);
      const productQtyString = cartdataNew
      .map(function (item) {
      return item.ProductId + ':' + item.Quantity;
      })
      .join(',');
      submitCampaignDetails(CAMPAIGN_EVENTS.CATEGORY_ProceedToPayment, productQtyString);

      let utm_source = sessionStorage.getItem("utm_source");
      let newlastParam = sessionStorage.getItem("lastparam_ghee");

      data1 = JSON.parse(data1);
      if (utm_source !== "other" && newlastParam !== 'other-cat') {
        data1["user_id"] = customerId;
        data1["product_id"] = productQtyString;
        data1["order_detail_id"] = CAMPAIGN_EVENTS.CATEGORY_ProceedToPayment;
        data1["source"] = utm_source;
        data1["offer_detail"] = utm_source !== 'utm_source' && newlastParam !== 'ghee' ? 'other-cat' : 'cat-ghee';
      }
      data1 = JSON.stringify(data1);
      // Always included payload
      var payload = {
        gateway: selectedPaymentMenthod.toString(),
        UserID: customerId.toString(),
        TotalAmount: amount,
        dataAr: data1,
        offer_source: sourcename,
        offer_desc: offerdetail,
        status: status_999,
        current_balance: localStorage.getItem("balance") ?? "0",
        rl: encodeURIComponent(window.location.href)
      };
      // end payment campaign
      let newPaymentMethodURL;
      let checkWalletRecharge = typeof data1 == 'string'?JSON.parse(data1):data1;
      if (!!checkWalletRecharge.CartItems) {
        newPaymentMethodURL = orderPlaceUrl;
      } else {
        newPaymentMethodURL = walletReachargeUrl;
      }
      var settings = {
        url: newPaymentMethodURL,
        method: "POST",
        headers: {
          Authorization: "Bearer " + token,
          "Content-Type": "application/json",
        },
        data: JSON.stringify(payload),
      };
      $.ajax(settings).done(function (response, textStatus) {
        if (textStatus === "success") {
          window.location.href = response.data.webviewUrl;
        }

        // if (response.status == 1) {
        //   localStorage.removeItem("sourcename");
        //   localStorage.removeItem("offerdetail");

        //   var order_id = response.order_id;
        //   var options = {
        //     "key": razorpayKey,
        //     // "key": "access_key_pKx7rdAWOEDoj3q2",
        //     "amount": amount,
        //     "currency": "INR",
        //     "name": "Pride of Cows",
        //     "image": originurl + "/poc/images/logo.png",
        //     "order_id": order_id,
        //     "callback_url": mainUrl + "/payment/razorprocess",
        //     "prefill": {
        //       "contact": userdata.MobileNo
        //     },
        //     "theme": { 
        //       "color": "#193b61"
        //     },
        //     "modal": {
        //       "ondismiss": function () {
        //         //location.reload();
        //         gaEvent({
        //           event: "razorpay_cancel_payment",
        //           amount: amount,
        //           order_id: options.order_id,
        //           contact: options.prefill?.contact
        //         });
        //         window.location.href = url;
        //       }
        //     }
        //   };

        //   var rzp = new Razorpay(options);
        //   // Handle failed payment
        //   rzp.on('payment.failed', function (response) {
        //     gaEvent({
        //         event: "razorpay_failed_payment",
        //         amount: amount,
        //         order_id: order_id,
        //         contact: options.prefill?.contact,
        //         error_code: response.error?.code,
        //         error_description: response.error?.description
        //     });
        //   });
        //   rzp.open();
        //   removedata();
        //   localStorage.setItem("promocode_for", JSON.parse(payData.dataAr).promocode_for);
        //   Checkcustomertype();
        //   const callbackData = JSON.parse(localStorage.getItem("callbackData"));
        //   if(callbackData?.url){
        //     localStorage.setItem("callbackData", JSON.stringify({...callbackData, redirect : true}))
        //   }
        // }
      });
    }
  }
}


function ccavenuepay() {
  return;
  var payData = localStorage.payData;
  payData = JSON.parse(payData);
  var amount = payData.TotalAmount;
  var customerId = payData.customer_id;
  var data = payData.dataAr;

  localStorage.removeItem("payData");
  window.location.href =
    mainUrl +
    "/payment/webindex?TotalAmount=" +
    amount +
    "&customer_id=" +
    customerId +
    "&dataAr=" +
    data;
}
