  var message = $('#message').val();
  var settings = {
    "url": baseUrl + "complaintscreate",
    "method": "POST",
    "timeout": 0,
    "headers": {
      "Content-Type": "application/json",
      "Authorization": "Bearer " + token,
    },
    "data": JSON.stringify({
      "Customer_id": UserID,
      "message": message
    }),
  };

  $.ajax(settings).done((response) => {
    let title, text;
    if (response.status == 1) {
      title = "Success";
      text = "Your enquiry has been sent.";
    } else {
      title = "Error";
      text = "Something went wrong!";
    }

    Swal.fire({
      title: title,
      text: text,
      icon: title.toLowerCase(),
      closeOnConfirm: true,
    }).then(() => {
      window.location.href = `${url}index`;
    });
  });
  // .fail((jqXHR, textStatus) => {
