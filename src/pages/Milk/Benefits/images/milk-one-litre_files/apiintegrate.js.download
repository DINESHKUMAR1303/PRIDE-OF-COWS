                </a>
              </div>
              <div class="right-icons mr-10">
                <img class="rticons" alt="share" src="../frontend/web/images/share-1.png"
                  data-name="${it.invited_name}"
                  data-number="${it.phone_number}"
                  data-custid="${UserID}"
                  data-invitedCoupon="${data.MobileNo}"
                  onclick="shareInvite(this)" />
              </div>
              <div class="right-icons">
                <img class="rticons ${it.reminder_count === it.reminder_count_max ? "disablebell" : ""}"
                 alt="reminder" src="../frontend/web/images/bell.png"
