function redeemCoupon() {
  var userdata = localStorage.getItem("userdata", userdata);
  var data = JSON.parse(userdata);
  var token = data.token;
  var userID = data.UserID;
  // console.log(token);
  var reward_id = $('input[name="reward_id"]').val();

  $(".redeem-coupon").removeClass("open");
  var rewardItems = localStorage.getItem("rewardItems");
  rewardItems = JSON.parse(rewardItems);
  var categoryQty = {}; // category-wise quantity map
  var productDelivery = [];
  if ($(".cart_items > p > div.snful").length == 0) {
    Swal.fire({
      icon: "error",
      title: "Please add products to cart.",
      showConfirmButton: false,
      timer: 2500,
    });
    return false;
  }
  $(".cart_items > p > div.snful").each(function () {
    var product_id = $(this).data("sub-id");         // Product ID
    var category_id = $(this).data("cat-id");   // Category ID
    var qty = parseFloat($(this).find('.qty-val').val());  // Qty
    var date = $(this).find('.date__delivery__coupon').val(); // Date
    productDelivery.push({
      id: product_id,
      qty: qty,
      date: date,
    });
    if (categoryQty[category_id]) {
      categoryQty[category_id] += qty;
    } else {
      categoryQty[category_id] = qty;
    }
  });
  var qtyError = false;
  var errorMsg = [];
  for (var i in rewardItems) {
    var product = rewardItems[i];
    var category_id = product["category_id"];
    var rewardQty = parseFloat(product["min_cart_value"]);
    var catQty = parseFloat(categoryQty[category_id] || 0); // total qty for this category
    if (catQty !== rewardQty) {
      errorMsg.push(
        "Quantity for " +
        product["category_name"] +
        " has to be " +
        rewardQty
      );
      qtyError = true;
    }
  }
  if (qtyError) {
    Swal.fire({
      icon: "error",
      title: errorMsg.join(","),
      showConfirmButton: false,
      timer: 2500,
    });
  } else {
    $(".cart_items > p").html("");
    $.ajax({
      url: baseCarturl + "cart/redeemcartvoucher",
      type: "POST",
      data: {
        redeem_coupon_id: reward_id,
        coupon_type: "cart",
        product_qty: JSON.stringify(productDelivery),
        userID: userID,
        addressId: poc_addressID,
      },
      headers: {
        Authorization: "Bearer " + token,
        "Content-Type": "application/x-www-form-urlencoded",
      },
      success: function (data) {
        if (data.status) {
          if(data.status == 400) {
            Swal.fire({
              icon: "error",
              title: data.message,
              showConfirmButton: false,
              timer: 2500,
            });
            return;
          }          
          localStorage.setItem("reward_id", reward_id);
          localStorage.setItem("cart", []);
          var products = data.products;
          products.forEach((product) => {
            var currValue =
              parseFloat(product.price) +
              parseFloat(product.tax) * parseFloat(product.price) * 0.01;
            addToCartLoyalty(
              product.product_id,
              data.cart.price,
              product.product_display_name,
              data.cart.totalPrice,
              data.cart.orderQuantity * data.cart.price,
              product.main_img,
              currValue,
              data.cart.startDate,
              data.cart.endDate,
              data.cart.noOfDays,
              product.minimum_quantity,
              product.tax,
              data.cart.orderQuantity
            );
          });
          // showRewardCart();
          // cartCount();
          // cartItems(false);
          Swal.fire({
            icon: "success",
            title: data.message,
            showConfirmButton: false,
            timer: 2500,
          });

          setTimeout(() => {
            packagemasterone();
          }, 500);
        } else {
          Swal.fire({
            //position: 'top-end',
            icon: "error",
            title: data.message,
            showConfirmButton: false,
            timer: 2500,
          });
        }
      },
      error: function (data) {
        // console.log(data);
        Swal.fire({
          //position: 'top-end',
          icon: "error",
          title: "Please Empty The Cart",
          //showConfirmButton: false,
          timer: 2500,
        });
      },
    });
  }
}

function addToCartLoyalty(
  ProductID,
  price,
  name,
  totalPrice,
  totalPriceItem,
  main_img,
  currVlaue,
  startDate,
  endDate,
  diffDays,
  minOrderQty,
  taxpr,
  quantity
) {
  startDate = new Date(startDate);
  var repeatMonthly = 0;
  endDate = new Date(endDate);
  var deliveryPlan = $('input[name="delivery_plan"]').attr("value");
  if (diffDays == 0 || isNaN(diffDays)) {
    diffDays = 1;
  }
  currVlaue = Number(currVlaue);
  var result_quantity = diffDays * currVlaue;
  localStorage.setItem("result_quantity", result_quantity);

  if (ProductID && quantity && startDate) {
    var Productcart = localStorage.getItem("cart");
    //"product cart :" + Productcart);
    if (Productcart.length == "") {
      var myArray = [];
      const myData = {
        ProductId: ProductID,
        Quantity: quantity,
        Price: price,
        DeliveryPlan: deliveryPlan,
        StartDate: startDate,
        EndDate: endDate,
        RepeatMonthly: repeatMonthly,
        Name: name,
        diffDays: diffDays,
        totalPrice: totalPrice,
        totalPriceItem: totalPriceItem,
        main_img: main_img,
        currVlaue: currVlaue,
        taxprice: taxpr,
      };
      myArray.push(myData);
      localStorage.setItem("cart", JSON.stringify(myArray));
    } else {
      const myData = {
        ProductId: ProductID,
        Quantity: quantity,
        Price: price,
        DeliveryPlan: deliveryPlan,
        StartDate: startDate,
        EndDate: endDate,
        RepeatMonthly: repeatMonthly,
        Name: name,
        diffDays: diffDays,
        totalPrice: totalPrice,
        totalPriceItem: totalPriceItem,
        main_img: main_img,
        currVlaue: currVlaue,
        taxprice: taxpr,
      };
      var data = JSON.parse(Productcart);
      var data = $.grep(data, function (e) {
        return e.ProductId != ProductID;
      });
      data.push(myData);
      //data);
      localStorage.setItem("cart", JSON.stringify(data));
    }
  } else {
    Swal.fire({
      position: "top-end",
      icon: "error",
      title: "Please fill all the fields",
      showConfirmButton: false,
      timer: 2500,
    });
  }
}

function addToCart(
  ProductID,
  price,
  name,
  diffDays,
  totalPrice,
  totalPriceItem,
  main_img,
  currVlaue
) {

  let clientDate = new Date();
  let formattedClientDate = clientDate.toISOString().split('T')[0];
  let formattedServerDate = serverDateCheck.toISOString().split('T')[0];

  if (formattedServerDate != formattedClientDate) {
    Swal.fire({
      text: 'Your system date is incorrect '  + formattedClientDate + '. Please correct the date.',
      closeOnConfirm: true,
    })
    return false;
  }

  // localStorage.removeItem("discount_value");
  // localStorage.removeItem("promocode_name");

  localStorage.setItem('currVlaue', parseInt($("#itemQuantity").val()));

  if (localStorage.getItem('currVlaue') === null) {
    localStorage.setItem('currVlaue', 1);
  }
  var price = localStorage.getItem("price");
  var name = localStorage.getItem("name", name);
  var taxpr = localStorage.taxprice;
  var main_img = localStorage.getItem("main_img", main_img);
  var unit_prod = localStorage.getItem("unit_prod", unit_prod);
  var category_prod = localStorage.getItem("category_prod", category_prod);
  var diffDays = localStorage.getItem("diffDays", diffDays);
  var totalPrice = localStorage.getItem("totalPrice", totalPrice) || price;
  var currVlaue = localStorage.getItem("currVlaue", currVlaue);
  var totalPriceItem = localStorage.getItem("totalPriceItem", totalPriceItem);
  var ProductID = localStorage.getItem("pid", ProductID);
  var launchDate = localStorage.getItem("launch_date", launchDate);
  var priceBeforeDiscount = localStorage.getItem("priceBeforeDiscount", priceBeforeDiscount);
  diffDays = Number(diffDays);
  currVlaue = Number(currVlaue);
  var result_quantity = diffDays * currVlaue;
  localStorage.setItem("result_quantity", result_quantity);
  var quantity = $("#itemQuantity").val();
  var deliveryPlan = $(".deliveryPlan__btns .active").attr("data-plan");
  if ($('input[name="reward_type"]').attr("value") == "loyalty") {
    deliveryPlan = $('input[name="delivery_plan"]').attr("value");
  }
  if (deliveryPlan == "daily") {
    var startDate = $("#startDate").val();
    var endDate = $("#endDate").val();
    var repeatMonthly = 1;
    var date1 = startDate.split("/");
    var date2 = endDate.split("/");
    var newstrtdate = date1[2] + "-" + date1[1] + "-" + date1[0];
    var newenddate = date2[2] + "-" + date2[1] + "-" + date2[0];

    if (Date.parse(newenddate) < Date.parse(newstrtdate)) {
      $("#myElem3").show();
      setTimeout(function () {
        $("#myElem3").hide();
      }, 5000);
      return false;
    }
    if (launchDate && launchDate.trim() !== '') {
      var launchDateParts = launchDate.split("-");
      var formattedLaunchDate = launchDateParts[0] + "-" + launchDateParts[1] + "-" + launchDateParts[2];
      var reverseFormatedLaunch = launchDateParts[2] + "-" + launchDateParts[1] + "-" + launchDateParts[0];
      var newstrtdate = date1[2] + "-" + setDateZero(date1[1]) + "-" + setDateZero(date1[0]);
      var newenddate = date2[2] + "-" + setDateZero(date2[1]) + "-" + setDateZero(date2[0]);

      var startDateParsed = Date.parse(newstrtdate);
      var endDateParsed = Date.parse(newenddate);
      var launchDateParsed = Date.parse(formattedLaunchDate);

      if (launchDateParsed > startDateParsed && endDateParsed >= launchDateParsed) {
        Swal.fire({
          text: 'Sorry this product will be available from ' + reverseFormatedLaunch,
          closeOnConfirm: true,
        })
        return false;
      } else if (startDateParsed < launchDateParsed && endDateParsed < launchDateParsed) {
        Swal.fire({
          text: 'Sorry this product will be available from ' + reverseFormatedLaunch,
          closeOnConfirm: true,
        })
        return false;
      }
