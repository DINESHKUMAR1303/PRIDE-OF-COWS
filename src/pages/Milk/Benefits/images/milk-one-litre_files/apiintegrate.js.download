function availoffer() {
  $(".customoffer").removeClass("open");

  var userdata = localStorage["userdata"]
    ? JSON.parse(localStorage["userdata"])
    : {};
  if (userdata) {
    var token = userdata.token;

    var settings = {
      url: baseUrl + "customofferdetail",
      method: "POST",
      headers: {
        "Content-Type": "application/json",
        Authorization: "Bearer " + token,
      },
      beforeSend: function () {
        $("#overlay").fadeIn();
      },
      data: JSON.stringify({
        custid: userdata.UserID,
        id: 1,
        // city: userdata.city_id,  999 for testing
        city: localStorage.city_id
      }),
    };
    $.ajax(settings).done(function (response) {
      $("#overlay").fadeOut();
      if (response.status == 1) {
        setTimeout(() => {
          Swal.fire({
            position: "middle",
            icon: "success",
            title:
              "We are redirecting you to the payment gateway for processing the order",
            showConfirmButton: false,
            timer: 3000,
          });
          $("#overlay").fadeIn();
        }, 1500);

        cartitem =
          response.product_id +
          ":" +
          response.rate +
          ":1:" +
          response.min_payment +
          "|";
        allcart = response.start_date + ":" + response.end_date + ":everyday|";

        var params = {
          customofferdetail: 1,
          CartItems: cartitem,
          custId: userdata.UserID,
          allcart: allcart,
          minDate: response.start_date,
          maxDate: response.end_date,
          City: userdata.city_id,
          TotalAmount: response.min_payment,
          subscriptionType: "everyday",
          TotalPay: response.min_payment,
          api: "SubscriptionPlaceorder",
          website_payment: 1,
          Source: "Desktop",
          offerStatus: 0,
          offcart: 0,
          address: "",
          customC: 0,
          offeredprice: 0,
          packageId: 0,
        };
        var payData = {};
        payData["TotalAmount"] = 999;
        payData["customer_id"] = userdata.UserID;
        payData["dataAr"] = JSON.stringify(params);
        localStorage.payData = JSON.stringify(payData);

        setTimeout(() => {
          nimmblepay();
        }, 2500);
      } else if (response.status == 2) {
        // window.location.href=url+"wallet";

        setTimeout(() => {
          Swal.fire({
            position: "middle",
            icon: "success",
            title:
              "Sorry this offer is applicable for new customers only.You can avail other offers.",
            showConfirmButton: false,
            timer: 4000,
          });
          $("#overlay").fadeIn();

          setTimeout(() => {
            window.location.href = url + "wallet?walletoffer=1";
          }, 3500);
        }, 1500);
      } else if (response.status == 3) {

        setTimeout(() => {
          Swal.fire({
            position: "middle",
            icon: "success",
            title:
              "Sorry this offer is not applicable in your pincode.You can avail other offers ",
            showConfirmButton: false,
            timer: 4000,
          });
          $("#overlay").fadeIn();

          setTimeout(() => {
            window.location.href = url + "wallet?walletoffer=1";
          }, 3500);
        }, 1500);
      }
    });
  }
}
