function qtyPlusMinus(here, productId, type) {
  var cartData = JSON.parse(localStorage.getItem('cart'));
  if (productId) {
    var quantitySelector__number = $(here)
      .closest(".quantitySelector")
      .find(".quantitySelector__number")
      .text();
    if (type == "plus") {
      cartData.forEach((item, index) => {
        if (item.ProductId == productId) {
          item.Quantity = Number(item.Quantity) + 1;
        }
      })
      $(here)
        .closest(".quantitySelector")
        .find(".quantitySelector__number")
        .text(+quantitySelector__number + 1);
    }
    if (type == "minus") {
      cartData.forEach((item) => {
        if (item.ProductId == productId) {
          item.Quantity =  Number(item.Quantity) - 1;
        }
      })
      $(here)
        .closest(".quantitySelector")
        .find(".quantitySelector__number")
        .text(quantitySelector__number - 1);
    }

    localStorage.setItem("cart", JSON.stringify(cartData));
  }
  totalprice();
}
function addCartsummary() {
  localStorage.paymethod = 1;
  var Cart = localStorage.getItem("cart", Cart);
  var total1 = localStorage.getItem("totalval", total1);
  // setTimeout(function() {
  // $(".showcheckoutSubtotal").html("₹ " + localStorage.totalval);
  //  }, 3000);
  // $('.showcheckoutTax').html('₹ 0');
  if (localStorage.reward) {
    $(".showcheckoutRewardDiscount").html("₹ " + total1);
  }
  if(localStorage.promocode_for=='refferal'){
    $(".showcheckoutRewardDiscount").html("₹ "+localStorage.discount_value );
  }
  if (localStorage.dis) {
    if (localStorage.dis == 0 && localStorage.result_quantity == 30) {
      $(".showcheckoutRewardDiscount").html("₹ " + localStorage.amnt);
    }
  }
  var diffDays = localStorage.getItem("diffDays", diffDays);
  var currVlaue = localStorage.getItem("currVlaue", currVlaue);
  var result_quantity = diffDays * currVlaue;
  var Quantity = localStorage.getItem("currVlaue", Quantity);
  var total1 = localStorage.getItem("totalval", total1);
  var data = JSON.parse(Cart, Quantity, total1, diffDays, currVlaue, result_quantity);
  //data);
  if (data) {
    $("#cart_summary").html("");
    $(".showcheckoutRewardDiscount").html("₹ 0" );
    var taxes = 0;
    var tot = 0;
    $.each(data, function (i, it) {
      var totalqty = parseInt(it.Quantity) * parseInt(it.diffDays);
      var result_quantity = parseInt(it.Quantity) * parseInt(it.diffDays);
      var prodtax = parseInt(it.Price) * (parseInt(it.taxprice) / 100);
      taxes = parseFloat(prodtax) * totalqty + parseFloat(taxes);
      tot = parseInt(it.totalPriceItem) + parseInt(tot);
      var result_quantity = parseInt(it.Quantity) * parseInt(it.diffDays);
      if (it.DeliveryPlan == 'custom') {
        var result_quantity = parseInt(0);
        let startDateDiff = moment(it.StartDate, 'DD/MM/YYYY');
        let endDateDiff = moment(it.EndDate, 'DD/MM/YYYY');
        let customDaysArr = localStorage.getItem("customDays");
        customDaysArr = JSON.parse(customDaysArr);
        while (startDateDiff <= endDateDiff) {
          if (customDaysArr[startDateDiff.day()] != '') {
            result_quantity += parseInt(customDaysArr[startDateDiff.day()]);
          }
          startDateDiff.add(1, "day");
        }
      }

      const today = serverDateCheck;
      const [day, month, year] = it.EndDate.split('/').map(Number);
      let endDate = new Date(year, month - 1, day, 15, 1, 40);
      const twoDaysAfterToday = new Date(today);
      twoDaysAfterToday.setDate(today.getDate() + 2);

      let newStart = "";
      let newEnd = "";
      
      if (it.DeliveryPlan === 'daily' || it.DeliveryPlan === 'alternate' || it.DeliveryPlan === 'custom') {
          let currentDate = moment().startOf("day");
          let startDateDiff = moment(it.StartDate, "DD/MM/YYYY").startOf("day");
          let endDateDiff = moment(it.EndDate, "DD/MM/YYYY").startOf("day");
      
          if (startDateDiff.isBefore(currentDate)) {
              startDateDiff = currentDate;
          }

          let originalDiffDays = endDateDiff.diff(moment(it.StartDate, "DD/MM/YYYY").startOf("day"), "days");
          endDateDiff = startDateDiff.clone().add(originalDiffDays, "days");
          let formattedStartDate = startDateDiff.format("DD/MM/YYYY");
          let formattedEndDate = endDateDiff.format("DD/MM/YYYY");
          newStart = formattedStartDate;
          newEnd = formattedEndDate;
      }    
      if (endDate.toDateString() === today.toDateString()) {
        endDate.setDate(endDate.getDate() + 2);
      } 
      else if (endDate < twoDaysAfterToday) {
        endDate = new Date(twoDaysAfterToday);
      }

      const onceEndDate = it.DeliveryPlan === 'once' 
      ? `${endDate.getDate().toString().padStart(2, '0')}/` + 
        `${(endDate.getMonth() + 1).toString().padStart(2, '0')}/` + 
        `${endDate.getFullYear()}`
      : it.DeliveryPlan;

      // $("#cart_summary").append(`<div class="row checkout_product_items">
      //                   <div class="col-4">
      //                       <a href="#" >
      //                           <img class="checkout__cart__img" src="${it.main_img}" alt="">
      //                       </a>
      //                   </div>
