              document.getElementById('fetchCity').textContent = "Enter a Pincode b";
              $("#loacationLoad").hide();
            }
          } else {
            document.getElementById('fetchCity').textContent = "Enter a Pincode";
              $("#loacationLoad").hide();
          }
        }
    
    $("#fetchPincode").text(pincodeInputData);
  }, 2000);
}

// browser location enable disaibled check
function checkLocationStatus() {
    if (!navigator.geolocation) {
        alert("Geolocation is not supported by this browser.");
        return;
    }

    if (navigator.permissions) {
        navigator.permissions.query({ name: 'geolocation' })
            .then(function (result) {
                if (result.state === "granted") {
                    // location enabled
                    locationFetchingPincode();
                    // location enabled
                    
                } else if (result.state === "denied") {
                    // Swal.fire({
                    //   text: 'Location access denied. Please enable the location 10423' ,
                    //   closeOnConfirm: true,
                    // });
                    document.getElementById('fetchCity').textContent = "Enter a Pincode";
                    $("#loacationLoad").hide();
                } else if (result.state === "prompt") {
                    Swal.fire({
                      text: 'Location access denied. Please enable the location' ,
                      closeOnConfirm: true,
                    });
                    document.getElementById('fetchCity').textContent = "Enter a Pincode";
                    $("#loacationLoad").hide();
                }
            })
            .catch(function () {
                // alert("Error checking location permission.");
                Swal.fire({
                  text: 'Location access denied. Please enable the location' ,
                  closeOnConfirm: true,
                });
            });
    } else {
        // Fallback for older browsers
        navigator.geolocation.getCurrentPosition(
            function () {           
                // location enabled
                locationFetchingPincode();
                // location enabled
             },
            function () {
              document.getElementById('fetchCity').textContent = "Enter a Pincode";
              $("#loacationLoad").hide();
              Swal.fire({
                text: 'Location access denied. Please enable the location 10454' ,
                closeOnConfirm: true,
              });
            }
        );
    }
}
// browser location enable disaibled check

// Remove cart items not in API product list
    function removeInvalidCartItems() {
      let cartData = localStorage.getItem("cart");
      if (!cartData) return;
      
      try {
            let cartItems = JSON.parse(cartData);
            const poc_addresid = localStorage.getItem("selectedAddressId");

            const settings = {
                url: baseUrl + "productlist",
                method: "POST",
                headers: {
                    "Content-Type": "application/json"
                },
                data: JSON.stringify({
                    IsSubscribe: 0,
                    pre_launch: 2,
                    addressId: poc_addresid
                })
            };

            $.ajax(settings).done(function (response) {
              console.log(response)
                if (response.status !== 1 || !Array.isArray(response.data)) {
                    console.warn("Invalid product list from API");
                    return;
                }

                let validProductIds = response.data.map(p => String(p.id));

                // Keep only valid products in the cart
                cartItems = cartItems.filter(item =>
                    validProductIds.includes(String(item.ProductId))
                );

                localStorage.setItem("cart", JSON.stringify(cartItems));
            });

        } catch (error) {
            console.error("Error removing invalid cart items:", error);
        }
    }

    function showAddresses(){
       $("#arrowimg").toggleClass("rotate-up");
       // If already visible -> hide and return
      if ($("#addAddressList1").is(":visible")) {
        $("#addAddressList1").slideUp(); 
        return;
      }
      $("#addAddressList1").empty().slideDown();

      var userdata = localStorage.getItem("userdata");
      if (userdata) {
        const newdata = JSON.parse(userdata);
        var token = newdata.token;
        var settings = {
          url: baseUrl + "get-user-addresses",
          method: "POST",
          timeout: 0,
          headers: {
            "Content-Type": "application/json",
            Authorization: "Bearer " + token,
          },
        };
        $.ajax(settings)
          .done(function (response) {
            const selectedId = localStorage.getItem("selectedAddressId");
            const otherAddresses = response.addresses.filter(addr => String(addr.id) !== String(selectedId));
            if (otherAddresses.length > 0) {
              otherAddresses.forEach(function(addr) {
                const addressHtml = `
                  <div class="address-card">
                    <div class="address-header mb-10">
                    <div class="d-flex align-center">
                      <span class="user-name">${addr.full_name}</span>
                      <span class="tag ml-10">${addr.address_type}</span>
                    </div>
                    </div>
                    <p class="address-text">
                      ${addr.flat_plot_no} ${addr.building_name} ${addr.street_road} ${addr.landmark} ${addr.city} ${addr.state} - ${addr.pincode}
                    </p>
                    ${addr.address_change_request_status == 0 ? `
                      <button class="checkout here-btn mt-10" disabled>Pending</button>
                      `: `
                      <button class="checkout here-btn mt-10" id="deliverhereid" onclick="selectAddOrder(${addr.id})">Select</button>
                      `}
                  </div>
                `;
                $("#addAddressList1").append(addressHtml);
              });
            } else {
              $("#addAddressList1").html("<p>No other addresses found.</p>");
            }
          });
      }
    }
    function showSelectedAddressOnly() {
      var userdata = localStorage.getItem("userdata");
      if (userdata) {
        const newdata = JSON.parse(userdata);
        var token = newdata.token;
        var settings = {
          url: baseUrl + "get-user-addresses",
          method: "POST",
          timeout: 0,
          headers: {
            "Content-Type": "application/json",
            Authorization: "Bearer " + token,
          },
        };
        $.ajax(settings)
          .done(function (response) {
          $("#addAddressList").empty();
          const selectedId = localStorage.getItem("selectedAddressId");
          const selectedAddress = response.addresses.find(addr => String(addr.id) === String(selectedId));
            if (selectedAddress) {
              const addressHtml = `
                <div class="address-card">
                  <div class="address-header mb-10">
                    <span class="user-name">${selectedAddress.full_name}</span>
                    <span class="tag">${selectedAddress.address_type}</span>
                  </div>
                  <p class="address-text">
                    ${selectedAddress.flat_plot_no} ${selectedAddress.building_name} ${selectedAddress.street_road} ${selectedAddress.landmark} ${selectedAddress.city} ${selectedAddress.state} - ${selectedAddress.pincode}
                  </p>
                  
              </div>
              `;
              $("#addAddressList").append(addressHtml);
            }
          });
      }
    }

function selectAddOrder(selectedId) {
  localStorage.setItem("selectedAddressId", selectedId);
  $("#userdataAddress").hide();
  $("#deliverhereid").text("Selected Address");

  var userdata = localStorage.getItem("userdata");
  if (userdata) {
    const newdata = JSON.parse(userdata);
    var token = newdata.token;
    var settings = {
      url: baseUrl + "get-user-addresses",
      method: "POST",
      timeout: 0,
      headers: {
        "Content-Type": "application/json",
        Authorization: "Bearer " + token,
      },
    };

    $.ajax(settings).done(function (response) {
      $("#addAddressList").empty();
      $("#addAddressList1").empty();

      const selectedAddress = response.addresses.find(
        (addr) => String(addr.id) === String(selectedId)
      );

      const otherAddresses = response.addresses.filter(
        (addr) => String(addr.id) !== String(selectedId)
      );

      // --- Selected address goes to #addAddressList ---
      if (selectedAddress) {
        const selectedHtml = `
          <div class="address-card">
            <div class="address-header mb-10">
              <span class="user-name">${selectedAddress.full_name}</span>
              <span class="tag">${selectedAddress.address_type}</span>
            </div>
            <p class="address-text">
              <span class="poc_flat_plot_no">${selectedAddress.flat_plot_no}</span> 
              <span class="poc_building_name">${selectedAddress.building_name}</span>
              <span class="poc_street_road"> ${selectedAddress.street_road} </span>
              <span class="poc_landmark">${selectedAddress.landmark}</span> 
              <span class="poc_city">${selectedAddress.city}</span> 
              <span class="poc_state">${selectedAddress.state}</span> - 
              <span class="poc_pincode">${selectedAddress.pincode}</span>
            </p>
          </div>
        `;
        $("#addAddressList").append(selectedHtml);

        // Update header pincode and city
        if (selectedAddress.pincode && selectedAddress.city) {
          if (document.getElementById('fetchCity')) {
            document.getElementById('fetchCity').textContent = selectedAddress.city;
          }
          if (document.getElementById('fetchPincode')) {
            document.getElementById('fetchPincode').textContent = selectedAddress.pincode;
          }
          // Also update .locationG if present
          if ($('.locationG').length) {
            $('.locationG').html(`${selectedAddress.city} (${selectedAddress.pincode})`);
          }
        }
        // Optionally update localStorage for city/pincode
        localStorage.setItem("userPincode", selectedAddress.pincode);
        localStorage.setItem("CityName", selectedAddress.city);
        $('#detect_Location_Popup').removeClass('show-topmodal')

        //productlist code start
        const poc_addresid = localStorage.getItem("selectedAddressId");

        localStorage.removeItem("offercart");

         const token = userdata.token;
        $.ajax({
          url: baseurl + "productlist",
          method: "POST",
          headers: {
            Authorization: "Bearer " + token,
            "Content-Type": "application/json",
          },
          data: JSON.stringify({
            IsSubscribe: 0,
            pre_launch: 2,
            addressId: poc_addresid
          }),
        }).done(function (response) {
          if (response.status == 1 && response.data) {
            const availableProducts = response.data;
            const cartprod = JSON.parse(localStorage.cart || "[]");

            if (cartprod) {
              updateCartWithProducts(cartprod, availableProducts).then(
                (updatedCart) => {
                  localStorage.setItem("cart", JSON.stringify(updatedCart));
                  if (Array.isArray(updatedCart) && updatedCart.length !== 0) {
                    setTimeout(() => {
                      const path = window.location.pathname;
                      const lastSegment = path.split("/").filter(Boolean).pop();
                      if (lastSegment === "checkout") {
                        location.reload();
                      }
                    }, 3000);
                  }
                }
              );
            }
          } else {
            localStorage.removeItem("cart");
          }
        });

        $("#overlay").fadeIn();
        setTimeout(() => {
          // productdetails();
          location.reload();
          $("#overlay").fadeOut();
        }, 6000);
        removeInvalidCartItems();
       }

       //productlist code end

      // --- Other addresses go to #addAddressList1 ---
      if (otherAddresses.length > 0) {
        otherAddresses.forEach(function (addr) {
          const addressHtml = `
            <div class="address-card">
              <div class="address-header mb-10">
                <span class="user-name">${addr.full_name}</span>
                <span class="tag">${addr.address_type}</span>
              </div>
              <p class="address-text">
                ${addr.flat_plot_no} ${addr.building_name} ${addr.street_road} 
                ${addr.landmark} ${addr.city} ${addr.state} - ${addr.pincode}
              </p>
              <button class="checkout here-btn mt-10" onclick="selectAddOrder(${addr.id})">Select</button>
            </div>
          `;
          $("#addAddressList1").append(addressHtml);
        });
      } else {
        $("#addAddressList1").html("<p>No other addresses found.</p>");
      }
    });
  }
}
async function updateUtmCookie(switchtype, paymentType, paymentData = []) {
    try {
        // Ensure paymentData is always an array
        if (!Array.isArray(paymentData)) {
            paymentData = paymentData ? [paymentData] : [];
        }

        // Helper function to read cookie value by name
        function getCookie(name) {
            const value = `; ${document.cookie}`;
            const parts = value.split(`; ${name}=`);
            if (parts.length === 2) return decodeURIComponent(parts.pop().split(';').shift());
            return null;
        }

        // Helper function to set a cookie value
        function setCookie(name, value, path = '/') {
            const expires = new Date(Date.now() + 6 * 3600 * 1000).toUTCString(); // 6 hours expiry
            document.cookie = `${name}=${encodeURIComponent(value)}; expires=${expires}; path=${path}`;
        }

        // Get existing utm_params cookie
        let cookieValue = getCookie("utm_params");
        if (!cookieValue) {
            return;
        }

        // Parse and validate cookie JSON
        let utmObj = {};
        try {
            utmObj = JSON.parse(cookieValue);
            if (typeof utmObj !== 'object' || Array.isArray(utmObj)) {
                return;
            }
        } catch (e) {
            return;
        }

        let refinedDataArray = [];

        // Decide how to populate payment data based on switchtype
        switch (switchtype) {
            case "wallet":
            case "999payment":
                refinedDataArray = paymentData;
                break;
            case "purchase":
                refinedDataArray = await fetchPaymentData(); // Fetch cart data from localStorage
                break;
            default:
                return;
        }

        // Update cookie with new payment type and data
        utmObj.payment_type = paymentType || "unknown";
        utmObj.payment_data = refinedDataArray;

        // Save updated data back into cookie
        setCookie("utm_params", JSON.stringify(utmObj));
    } catch (error) {
        // Silently fail
    }
}

async function fetchPaymentData() {
    try {
        // Get cart data from localStorage
        let cart_data_event = JSON.parse(localStorage.getItem("cart"));
        let items_data = [];

        // Convert each cart item to structured format
        if (cart_data_event) {
            for (let i in cart_data_event) {
                items_data.push({
                    index: parseInt(i),
                    item_id: cart_data_event[i]["ProductId"],
                    item_name: cart_data_event[i]["Name"],
                    item_category: cart_data_event[i]["category_prod"],
                    item_variant: cart_data_event[i]["unit_prod"],
                    quantity: cart_data_event[i]["Quantity"],
                    price: Number(cart_data_event[i]["Price"]),
                });
            }
        }

        return items_data;
    } catch (error) {
        return []; // fallback to empty array if any error
    }
}

function detectPageNavigation(event_name, data_params = null) {
    try {
        let isReload = false;

        // Detect page reload using performance API
        if (performance.getEntriesByType("navigation")[0]) {
            isReload = performance.getEntriesByType("navigation")[0].type === "reload";
        } else if (performance.navigation) {
            isReload = performance.navigation.type === 1;
        }

        // Track event only if it's not a reload
        if (!isReload) {
            const userdata = localStorage.getItem('userdata');
            const data = userdata ? JSON.parse(userdata) : {};
            const userId = data?.UserID ?? null;

            // Track custom event with user ID and optional data params
            window['analytics']?.trackEvent(event_name, {}, userId, data_params);
        }
    } catch (error) {
    }
}

