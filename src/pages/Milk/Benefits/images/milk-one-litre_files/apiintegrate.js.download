                                    icon: "error",
                                    closeOnConfirm: true
                                    });
                                    $(".black_overlay, .noCoupon").css("display", "none");
                            }
                        }
                   } else {
                            if(response.data.promocode_name === PRODUCT_OFFER.OFFER_CODE) {
                                localStorage.setItem("discount_value", response.data.discount_value);
                                localStorage.setItem("paneerPromocodeHandling", false);
                                localStorage.promocode_name = response.data.promocode_name;
                                setTimeout(() => {
                                window.location.reload()
                                }, 1000);
                            } else {
                                Swal.fire({
                                title: "error",
                                text: "Promo code not found",
                                icon: "error",
                                closeOnConfirm: true
                                })
                                return
                            }
                        }
                    localStorage.promocode_for = response.data.promocode_for;
                    localStorage.referrer_no = $('#promocodeD').val();
                    if(response.data.promocode_for !='refferal'){      
                    localStorage.offeredprice = quantity!==0 ? response.data.discount_value *quantity :0 ;
                    }else{
                    localStorage.offeredprice=500;
                    }
                    const poc_addresid = localStorage.getItem("selectedAddressId");
                    if (response.data.offer_product_id != 0) {
                        var settings = {
                            "url": baseurl + "productdetail",
                            "method": "POST",
                            "timeout": 0,
                            "headers": {
                                "Content-Type": "application/json",
                                "Authorization": "Bearer " + token
                            },
                            "data": JSON.stringify({
                                "ProductID": response.data.offer_product_id,
                                "City": city,
                                "addressId": poc_addresid,
                            }),
                        };
                        $.ajax(settings).done(function(resp) {
                            if (resp.status == 1) {
                                if (resp.data) {
                                    prod_id = response.data.product;
                                    prod_id = prod_id.replace(/#/g, '');
                                    var cart = JSON.parse(localStorage.getItem('cart')) || [];

                                    var product_arr = cart.find(item => item.ProductId === prod_id);
                                    if (product_arr) {
                                        const newProduct = {
                                            "ProductId": response.data.offer_product_id,
                                            "Quantity": response.data.offer_product_qty,
                                            "Price": resp.data.price,
                                            "DeliveryPlan": product_arr.DeliveryPlan,
                                            "StartDate": product_arr.StartDate,
                                            "EndDate": product_arr.StartDate,
                                            "Name": resp.data.name,
                                            "diffDays": 0,
                                            "totalPrice": resp.data.price,
                                            "totalPriceItem": resp.data.price,
                                            "main_img": resp.data.main_img,
                                            "currVlaue": 0,
                                            "taxprice": resp.data.taxamount,
                                            "category_prod": resp.data.catagory,
                                            "unit_prod": resp.data.product_unit,
                                            "slug": "",
                                            "parent_id": prod_id
                                        };
                                        const productIndex = cart.findIndex(item => item.ProductId === newProduct.ProductId);

                                        if (productIndex !== -1) {
                                            cart.splice(productIndex, 1);
                                        }

                                        cart.push(newProduct);

                                        // Update the cart in localStorage
                                        localStorage.setItem('cart', JSON.stringify(cart));
                                    }


                                }
                            }
                        })
                    }
                    setTimeout(() => {
                      window.location.href = url + 'checkout';
                    }, 3000);
                }
            }
            } else {
                Swal.fire({
                    title: "error",
                    text: response.message,
                    icon: "error",
                    closeOnConfirm: true
                })
            }
        });
    }

