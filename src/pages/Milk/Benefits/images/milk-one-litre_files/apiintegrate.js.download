// Always returns a usable poc_addressID or null
let poc_addressID = (() => {
  let id = localStorage.getItem("selectedAddressId");

  if (id) return id; // Positive scenario → already stored

  // fallback to default address from userdata
  let userdata = JSON.parse(localStorage.getItem("userdata"));
  if (userdata && userdata.defaultAddressId) {
    localStorage.setItem("selectedAddressId", userdata.defaultAddressId);
    return userdata.defaultAddressId;
  }

  // if nothing found → set default as 656
  // localStorage.setItem("selectedAddressId", "656");
  return ;
})();



