function reorderproduct() {
  var reorderdetails = localStorage.getItem("reorderdetails", reorderdetails);
  if (reorderdetails) {
    const value = JSON.parse(reorderdetails);
    let $plan = value.package_name;

    if (value.package_name == 'once') {
      $(".deliveryPlan__btns .btn").removeClass("active");
      $(".deliveryPlan__btns .btn[data-plan='" + $plan + "']").addClass("active");
      $(".deliveryPlan").removeClass("active");
      $(".deliveryPlan--" + $plan).addClass("active");

      $('#itemQuantity').val(value.quantity);
      var currValue = $("#itemQuantity").val();
      var product_price = value.product_price;
      var totalPrice = parseInt(currValue, 10) * parseInt(product_price, 10);
      $("#total_product_amount").html('₹' + totalPrice);

      let dateParts = value.to_date.split('-');
      let day = parseInt(dateParts[0], 10);
      let month = parseInt(dateParts[1], 10) - 1;
      let year = parseInt(dateParts[2], 10);
      let toDate = new Date(year, month, day);
      let nextDate = new Date(toDate);
      nextDate.setDate(toDate.getDate() + 1);
      
      let today = new Date();
      today.setHours(0, 0, 0, 0);

      if (nextDate <= today) {
          nextDate = new Date(today);
          nextDate.setDate(today.getDate() + 1); 
      }
      let nextDay = nextDate.getDate().toString().padStart(2, '0');
      let nextMonth = (nextDate.getMonth() + 1).toString().padStart(2, '0');
      let nextYear = nextDate.getFullYear();
      let formattedNextDate = `${nextDay}/${nextMonth}/${nextYear}`;
      $('#deliverDate').val(formattedNextDate);

      localStorage.setItem('totalPrice', totalPrice);
      localStorage.setItem('totalPriceItem', totalPrice);
      var totaldays = 1;
      var res1 = totaldays * (value.quantity);
      $('#offerdetailqnty').html("Total Quantity : " + res1);
      localStorage.setItem('diffDays', totaldays);

    } else if (value.package_name == 'Daily') {
      $(".deliveryPlan__btns .btn").removeClass("active");
      $(".deliveryPlan__btns .btn[data-plan='daily']").addClass("active");
      $(".deliveryPlan").removeClass("active");
      $(".deliveryPlan--daily").addClass("active");

      let fromDateParts = value.from_date.split('-');
      let fromDay = parseInt(fromDateParts[0], 10);
      let fromMonth = parseInt(fromDateParts[1], 10) - 1;
      let fromYear = parseInt(fromDateParts[2], 10);
      let fromDate = new Date(fromYear, fromMonth, fromDay);

      let toDateParts = value.to_date.split('-');
      let toDay = parseInt(toDateParts[0], 10);
      let toMonth = parseInt(toDateParts[1], 10) - 1;
      let toYear = parseInt(toDateParts[2], 10);
      let toDate = new Date(toYear, toMonth, toDay);

      let differenceInTime = toDate.getTime() - fromDate.getTime();
      let differenceInDays = differenceInTime / (1000 * 3600 * 24);

      let startDate = new Date(toDate);
      startDate.setDate(toDate.getDate() + 1);

      let today = new Date();
      today.setHours(0, 0, 0, 0);

      if (startDate <= today) {
        startDate = new Date(today);
        startDate.setDate(today.getDate() + 1); 
      }

      let endDate = new Date(startDate);
      endDate.setDate(startDate.getDate() + differenceInDays);

      let formatDate = (date) => {
        let day = date.getDate().toString().padStart(2, '0');
        let month = (date.getMonth() + 1).toString().padStart(2, '0');
        let year = date.getFullYear();
        return `${day}/${month}/${year}`;
      };

      let formattedStartDate = formatDate(startDate);
      let formattedEndDate = formatDate(endDate);
      $('#startDate').val(formattedStartDate);
      $('#endDate').val(formattedEndDate);

      $('#itemQuantity').val(value.quantity);
      var currVlaue = $("#itemQuantity").val();
      var product_price = value.product_price;
      var totaldays = differenceInDays + 1;
      var totalPrice = parseInt(currVlaue) * parseInt(product_price) * parseInt(totaldays);
      $("#total_product_amount").html('₹' + totalPrice);
      localStorage.setItem('totalPriceItem', totalPrice);
      localStorage.setItem('totalPrice', totalPrice);

      var res1 = totaldays * currVlaue;
      $('#offerdetailqnty').html("Total Quantity : " + res1);
      localStorage.setItem('diffDays', totaldays);

    } else if (value.package_name == 'alternate') {
      $(".deliveryPlan__btns .btn").removeClass("active");
      $(".deliveryPlan__btns .btn[data-plan='" + $plan + "']").addClass("active");
      $(".deliveryPlan").removeClass("active");
      $(".deliveryPlan--" + $plan).addClass("active");

      let fromDateParts = value.from_date.split('-');
      let fromDay = parseInt(fromDateParts[0], 10);
      let fromMonth = parseInt(fromDateParts[1], 10) - 1;
      let fromYear = parseInt(fromDateParts[2], 10);
      let fromDate = new Date(fromYear, fromMonth, fromDay);

      let toDateParts = value.to_date.split('-');
      let toDay = parseInt(toDateParts[0], 10);
      let toMonth = parseInt(toDateParts[1], 10) - 1;
      let toYear = parseInt(toDateParts[2], 10);
      let toDate = new Date(toYear, toMonth, toDay);

      let differenceInTime = toDate.getTime() - fromDate.getTime();
      let differenceInDays = differenceInTime / (1000 * 3600 * 24);
      let startDate = new Date(toDate);
      startDate.setDate(toDate.getDate() + 1);
            
      let today = new Date();
      today.setHours(0, 0, 0, 0);

      if (startDate <= today) {
        startDate = new Date(today);
        startDate.setDate(today.getDate() + 1); 
      }

      let endDate = new Date(startDate);
      endDate.setDate(startDate.getDate() + differenceInDays);

      let formatDate = (date) => {
        let day = date.getDate().toString().padStart(2, '0');
        let month = (date.getMonth() + 1).toString().padStart(2, '0');
        let year = date.getFullYear();
        return `${day}/${month}/${year}`;
      };

      let formattedStartDate = formatDate(startDate);
      let formattedEndDate = formatDate(endDate);
      $('#alternateStartDate').val(formattedStartDate);
      $('#alternateEndDate').val(formattedEndDate);

      $('#itemQuantity').val(value.quantity);
      var currVlaue = $("#itemQuantity").val();
      var product_price = value.product_price;

      var totaldays = differenceInDays + 1;
      var calculatedays = totaldays / 2;
      var roundcalculatedays = Math.round(calculatedays);
      var totalPrice = parseInt(currVlaue) * parseInt(product_price) * parseInt(roundcalculatedays);
      $("#total_product_amount").html('₹' + totalPrice);
      localStorage.setItem('totalPriceItem', totalPrice);
      localStorage.setItem('totalPrice', totalPrice);

      var res1 = roundcalculatedays * currVlaue;
      $('#offerdetailqnty').html("Total Quantity : " + res1);
      localStorage.setItem('diffDays', roundcalculatedays);
    } else if (value.package_name == 'custom') {
      $(".deliveryPlan__btns .btn").removeClass("active");
      $(".deliveryPlan__btns .btn[data-plan='" + $plan + "']").addClass("active");
      $(".deliveryPlan").removeClass("active");
      $(".deliveryPlan--" + $plan).addClass("active");

      document.getElementById('offerdetailqnty').innerHTML = 'Total Quantity : 0';
      localStorage.setItem('totalPrice', 0);
      localStorage.setItem('diffDays', 0);
      localStorage.setItem('totalPriceItem', 0);
      document.getElementById('total_product_amount').innerHTML = '₹0';
      $('#customPackage').hide();
      $(".qntyOfPlans").hide();

      var modal = document.getElementById("customPlanModal");
      modal.style.display = "block";

      let fromDateParts = value.from_date.split('-');
      let fromDay = parseInt(fromDateParts[0], 10);
      let fromMonth = parseInt(fromDateParts[1], 10) - 1;
      let fromYear = parseInt(fromDateParts[2], 10);
      let fromDate = new Date(fromYear, fromMonth, fromDay);

      let toDateParts = value.to_date.split('-');
      let toDay = parseInt(toDateParts[0], 10);
      let toMonth = parseInt(toDateParts[1], 10) - 1;
      let toYear = parseInt(toDateParts[2], 10);
      let toDate = new Date(toYear, toMonth, toDay);

      let differenceInTime = toDate.getTime() - fromDate.getTime();
      let differenceInDays = differenceInTime / (1000 * 3600 * 24);

      let startDate = new Date(toDate);
      startDate.setDate(toDate.getDate() + 1);
      
      let today = new Date();
      today.setHours(0, 0, 0, 0);

      if (startDate <= today) {
        startDate = new Date(today);
        startDate.setDate(today.getDate() + 1); 
      }

      let endDate = new Date(startDate);
      endDate.setDate(startDate.getDate() + differenceInDays);

      let formatDate = (date) => {
        let day = date.getDate().toString().padStart(2, '0');
        let month = (date.getMonth() + 1).toString().padStart(2, '0');
        let year = date.getFullYear();
        return `${day}/${month}/${year}`;
      };

      let formattedStartDate = formatDate(startDate);

      let formattedEndDate = formatDate(endDate);
      $('#cdates').val(formattedStartDate);
      $('#cendDate').val(formattedEndDate);

      var product_frequency = value.product_frequency;

      const dayMap = {
        0: { id: 'sun', label: 'Sun' },
        1: { id: 'mon', label: 'Mon' },
        2: { id: 'tue', label: 'Tue' },
        3: { id: 'wed', label: 'Wed' },
        4: { id: 'thu', label: 'Thu' },
        5: { id: 'fri', label: 'Fri' },
        6: { id: 'sat', label: 'Sat' }
      };
      $('.selectedDaysContainer').html('');
      let customPackageInfo = "Custom Package: ";

      for (let i = 0; i < product_frequency.length; i++) {
        let dayValue = parseInt(product_frequency[i], 10);
        let dayData = dayMap[i];
        let dayOfWeek = i;
        let withinRange = false;

        for (let d = new Date(startDate); d <= endDate; d.setDate(d.getDate() + 1)) {
          if (d.getDay() === dayOfWeek) {
            withinRange = true;
            break;
          }
        }
        if (dayValue > 0 && withinRange) {
          $('#' + dayData.id).addClass('checked');
          let dayHtml = `
                    <div class="selectedDayRow" id="selectedDayRow-${dayData.label.toLowerCase()}">
                        <div class="selectedDayLabel">${dayData.label}</div>
                        <div class="quantitySelector">
                            <div class="quantitySelector-controls">
                                <div class="quantitySelector-down">-</div>
                                <div class="quantitySelector__number">${dayValue}</div>
                                <div class="quantitySelector-up">+</div>
                            </div>
                        </div>
                    </div>
                  `;
          $('.selectedDaysContainer').append(dayHtml);
          $('#submitButton').show();
          if (customPackageInfo !== "Custom Package: ") {
            customPackageInfo += " - ";
          }
          customPackageInfo += `${dayData.label} (${dayValue})`;
        }
      }
      // $('#customPackage').show();
      $('#customPackage').show().text(customPackageInfo);
    }
  }
  setTimeout(function () {
    localStorage.removeItem("reorderdetails");
  }, 3500);
}

//productdetails all product show script4
getProductlist();
function getProductlist() {
  try {
    var userdata = localStorage.getItem("userdata", userdata);
    const poc_addresid = localStorage.getItem("selectedAddressId");
    var data = JSON.parse(userdata);
    var city = data.city;
    var isSubscribe = 0;
    var token = data.token;
    var settings = {
      url: baseUrl + "productlist",
      method: "POST",
      headers: {
        "Authorization": "Bearer " + token,
        "Content-Type": "application/json",
      },
      data: JSON.stringify({
        City: city,
        IsSubscribe: isSubscribe,
        pre_launch: 2,
        addressId: poc_addresid
      }),
    };
    $.ajax(settings).done(function (response) {
      if (response.status == 1) {
        if (response.data) {
          var productBox = "";
          $.each(response.data, function (i, it) {
            $(
              "#all_product"
            ).append(`<div class="forWellbeing__slide text-center">
                                  <a href="#">
                                      <div class="imgBox box-grey transition">
                                          <img loading="lazy" class="mx-auto" src="${it.main_img}" alt="">
                                      </div>
                                      <h4 class="text-blue">${it.tags}</h4>
                                      <h2>${it.name}</h2>
                                      <span href="#" onclick="product(${it.id});" class="btn btn--white">shop now</span>
                                  </a>
                              </div>`);
          });
        }
      } else {
        showAlert(response.message, "Error", "OK");
      }
    });
  } catch (err) {

  }
}


function getOfflineproducts() {
  // start code of finding redirect URL Params
  const redirectParam = new URLSearchParams(window.location.search).get('redirect');
  // end of finding redirect URL Params
  $("#overlay").fadeIn();
  const offlinecartData = localStorage.getItem('offlinecart');
  if (!offlinecartData) {
    if (redirectParam) {
      window.location.href = url + redirectParam; 
    } else {
      productdetails('all');
    }
    return; 
  }
  const offlinecartArray = JSON.parse(offlinecartData);
  const cartData = localStorage.getItem('cart');  
  const cartArray = cartData ? JSON.parse(cartData) : [];

  const productMap = {};
  cartArray.forEach(item => productMap[item.ProductId] = item);
  offlinecartArray.forEach(item => productMap[item.ProductId] = item);
  const mergedCartArray = Object.values(productMap);

  const userdata = localStorage["userdata"] ? JSON.parse(localStorage["userdata"]) : {};
  const poc_addresid = localStorage.getItem("selectedAddressId");
  const token = userdata.token;

  const settings = {
    url: baseUrl + "productlist",
    method: "POST",
    headers: {
      "Authorization": "Bearer " + token,
      "Content-Type": "application/json"
    },
    data: JSON.stringify({
      IsSubscribe: 0,
      pre_launch: 2,
      addressId: poc_addresid
    })
  };

  $.ajax(settings).done(function(response) {
    const availableProducts = response.data || [];
    if (availableProducts.length > 0) {
      updateoffCartWithProducts(mergedCartArray, availableProducts)
        .then(updatedCart => {
          if (updatedCart && updatedCart.length > 0) {
            localStorage.setItem('cart', JSON.stringify(updatedCart));
            location.reload();
          }else{
            productdetails('all');
            localStorage.removeItem('offlinecart');
          }
        });
    }
  });

  setTimeout(() => {
    $("#overlay").fadeOut();
  }, 3000);
}

function updateoffCartWithProducts(cartprod, availableProducts) {
  return new Promise(resolve => {
    setTimeout(() => {
      const availableProductIds = new Set(availableProducts.map(p => parseInt(p.id)));
      const updatedCart = cartprod
        .filter(product => availableProductIds.has(parseInt(product.ProductId)))
        .map(product => {
          const matchedProduct = availableProducts.find(p => parseInt(p.id) === parseInt(product.ProductId));
          return matchedProduct ? { ...product, ...matchedProduct } : product;
        });

      resolve(updatedCart);
    }, 1000); 
  });
}
function setCartCount() {
  var Cart = localStorage.getItem("cart", Cart);
  var Quantity = localStorage.getItem("currVlaue", Quantity);
  var data = JSON.parse(Cart, Quantity);
  if (!data) {
    return;
  }
  if(data.length == 0 || data.length < 1) {
    $(".cartIcon__count").removeClass("show_cartIconCount");
  } else if(data.length <= 1) {
    $('.showcheckoutTotalItems span.showItemTotal').html(data.length + ' item');
    $(".cartIcon__count").addClass("show_cartIconCount");
    $(".cartIcon__count").show();
  } else {
    $('.showcheckoutTotalItems span.showItemTotal').html(data.length + ' items');
    $(".cartIcon__count").addClass("show_cartIconCount");
    $(".cartIcon__count").show();
  }
  $('.cartIcon__count').html(data.length);
}
function updateCartUI(data) {
  if (data.length == 0) {
      $(".empty__cart").css("display", "grid");
      $("#cart_items").css("place-content", "center");
      $(".cart__bottom").css("display", "none");
  }
  else{
    $("#cart_items").css("place-content", "unset");
    $(".empty__cart").css("display", "none");
    $(".cart__bottom").css("display", "flex");
    $("#cart_items").html("");
  }
}
