  function rewardsHistory(){
    var userdata = localStorage.getItem('userdata');
    if (!userdata) {
        console.error('No userdata found in localStorage.');
        return;
    }

    var data = JSON.parse(userdata);
    if (!data || !data.UserID) {
        console.error('Invalid userdata or missing UserID.');
        return;
    }

    $.ajax({
        url: 'fetch-reward-status',
        type: 'POST',
        data: {
            cust_id: data.UserID
        },
        success: function(response) {
            if (response.success) {
                if (response.data.length > 0) {
                    response.data.forEach(function(reward) {
                        if (reward.is_redeemed == 1) {
                            $('#rewards-history').append(`<div class="rewards__box">
                                            <div class="row">
                                                <div class="col-2">
                                                    <div class="left d-flex justify-space-center" style=" min-height: 130px;">
