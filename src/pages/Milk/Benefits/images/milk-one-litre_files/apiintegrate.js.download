function isFormFilled() {

  var vistorName = document.getElementById('vistorName').value;
  var visitoMobile = document.getElementById('visitoMobile').value;
  var visitorEmail = document.getElementById('visitorEmail').value;
  var visitorLocation = document.getElementById('visitorLocation').value;
