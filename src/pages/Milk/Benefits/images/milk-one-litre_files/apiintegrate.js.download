        for (var j = 0; j < customerfilteredData.length; j++) {
          var coupon1 = customerfilteredData[j];
          // console.log("coupon1============",coupon1);

          var barcode =
            '<button class="accordion btn btn--outline" ><div style="text-transform:lowercase;">' +
            '<span style="text-transform:capitalize;">Rewards</span> <span style="text-transform:capitalize;">Code: &nbsp;</span>' +
            '<span style="margin-right:100px;" id ="coupon_ref_no_' +
            coupon1.invited_name +
            '"> </span>' +
            // '<div style="float:right; margin-right:100px;text-transform:lowercase;">'+
            '<span style="float:right;text-transform:capitalize;">Active</span> <span style="float:right;text-transform:capitalize;">Status: &nbsp;</span>' +
            "</div></button>";
          // console.log(j," entering into 1st loop ===>",barcode);
          couponContainer.append(barcode);
          // btnrefr.append(customerfilteredData[j]);
          $("#coupon_ref_no_" + coupon1.invited_name).text(
            coupon1.invited_name
          );

          for (var i = 0; i < response.data.length; i++) {
            var coupon = response.data[i];

            var currentDate = new Date();
            var isExpired = new Date(coupon.validity) < currentDate;
            var validityHTML = isExpired
              ? "<p>Expired</p>"
              : "<p>" + " " + "</p>";
            // console.log(i," entering into st loop ===>",response.data[i]);
            var productBox =
              '<div class="panel">' +
              '<div class="rewards__box">' +
              '<div class="row">' +
              '<div class="col-5">' +
              '<div class="left">' +
              "<h3>Reward Voucher</h3>" +
              '<div>Use: <h5 id="rewardscode" class="text-blue"> ' +
              coupon.reward_code +
              "</h5></div>" +
              "</div>" +
              "</div>" +
              '<div class="col-7">' +
              '<div class="right">' +
              "<div>" +
              '<h4 id="rewardstitle" class="text-blue"> ' +
              coupon.Title +
              " </h4>" +
              '<p id="rewardsdescription"> ' +
              coupon.description +
              " </p>" +
              '<div class="rewards__date">Valid till.</div>' +
              "<div>" +
              '<p id="validtill"> ' +
              coupon.validity +
              "</p>" +
              validityHTML +
              // '<p> ' + coupon.validity + '</p>' +
              '<input type="hidden" id="reward_id" name="reward_id" value=' +
              coupon.id +
              "></input>" +
              "</div>" +
              "</div>" +
              "<div>" +
              '<div class="d-flex justify-space-between">' +
              '<div class="cta d-flex">' +
              '<a class="reward__redeem" onclick="redeemCoupon()" data-id=' +
              coupon.id +
              ">redeem</a>" +
              '<svg width="12" height="8" viewBox="0 0 12 8" fill="none" xmlns="http://www.w3.org/2000/svg">' +
              '<path d="M7.71313 7.18086C7.53688 7.39344 7.56633 7.70865 7.7789 7.8849C7.99148 8.06116 8.30669 8.03171 8.48294 7.81914L7.71313 7.18086ZM11 4L11.3849 4.31914C11.5384 4.13405 11.5384 3.86595 11.3849 3.68086L11 4ZM8.48294 0.180863C8.30669 -0.0317143 7.99148 -0.0611594 7.7789 0.115095C7.56633 0.291349 7.53688 0.606559 7.71313 0.819136L8.48294 0.180863ZM1 3.5C0.723857 3.5 0.5 3.72386 0.5 4C0.5 4.27614 0.723857 4.5 1 4.5L1 3.5ZM8.48294 7.81914L11.3849 4.31914L10.6151 3.68086L7.71313 7.18086L8.48294 7.81914ZM11.3849 3.68086L8.48294 0.180863L7.71313 0.819136L10.6151 4.31914L11.3849 3.68086ZM11 3.5L1 3.5L1 4.5L11 4.5L11 3.5Z" fill="#193B61"/>' +
              "</svg>" +
              "</div>" +
              "</div>" +
              "</div>" +
              "</div>" +
              "</div>" +
              "</div>" +
              "</div>" +
              "</div>";
            if (isExpired) {
              // Coupon is expired, display it in the "expiredCouponContainer"
              $("#expiredCouponContainer").append(productBox);
              $("#expiredCouponContainer").append(barcode);
              // $('#couponContainer').append(barcode);
            } else {
              // Coupon is active, display it in the "couponContainer"
              $("#couponContainer").append(productBox);
            }
          }
        }
        accordionfun();

        $(".reward__redeem").on("click", function () {
          $('input[name="reward_id"]').val($(this).data("id"));
          // console.log("==4=============>", $('input[name="reward_id"]').val());
          // console.log("0000000000000000>", $(this).data("id"));
