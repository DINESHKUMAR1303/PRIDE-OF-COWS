function shopofferdetail(data, oprice) {
  $("#cartofferr").val(data);
  localStorage.offerselected = data;
  localStorage.offeredprice = oprice;
  localStorage.removeItem("cart");
  localStorage.removeItem("offercart");
  if (data) {
    Swal.fire({
      title: data + "  LITRE" + "  OFFER SELECTED",
      text: data.message,
      icon: "success",
      closeOnConfirm: true,
    });
  }
}

function calculateAmount1() {
  $("#itemQuantity").val(+$("#itemQuantity").val() + 0);

  var currVlaue = $("#itemQuantity").val();
  localStorage.setItem("currVlaue", currVlaue);
  $(".totalQtyItem").html(currVlaue);

  var totalPriceItem =
    parseInt(currVlaue) *
    parseFloat($("#itemPriceValue").val()) *
    parseFloat(diffDays);
  // console.log("currVlaue---- ", currVlaue);
  localStorage.setItem("totalPriceItem", totalPriceItem);
  // console.log(totalPriceItem);
  $("#total_product_amount").html("₹" + totalPriceItem);
  $(".totalPriceItem").text(totalPriceItem);
  $(".totalQtyItem").text(currVlaue);

  setTimeout(function () {
    var diffDays1 = localStorage.getItem("diffDays", diffDays1);
    var currVlaue1 = $("#itemQuantity").val();
    var res1 = diffDays1 * currVlaue1;
    $("#offerdetailqnty").html("Total Quantity : " + res1);
  }, 500);
}

function calculateAmount(here, cartId, type, deliveryPlan = "", diffDays) {
  if (cartId) {
    let $currVlaue = $("#itemQuantity").val();
    let $minValue = $("#itemQuantity").attr("min");
    if (!deliveryPlan) {
      deliveryPlan = $(".deliveryPlan__btns .active").attr("data-plan");
    }

    if (deliveryPlan == "daily") {
      let startDateDiff = moment($("#startDate").val(), "DD/MM/YYYY");
      let endDateDiff = moment($("#endDate").val(), "DD/MM/YYYY");

      diffDays =
        Math.ceil(Math.abs(endDateDiff - startDateDiff) / (1000 * 3600 * 24)) +
        1;
    } else if (deliveryPlan == "alternate") {
      let startDateDiff = moment($("#alternateStartDate").val(), "DD/MM/YYYY");
      let endDateDiff = moment($("#alternateEndDate").val(), "DD/MM/YYYY");

      diffDays = Math.round(
        (Math.ceil(Math.abs(endDateDiff - startDateDiff) / (1000 * 3600 * 24)) +
          1) /
        2
      );
    } else if (deliveryPlan == "once") {
      diffDays = 1;
    } else if (deliveryPlan == "custom") {
      // disable quantity selector if custom plan is selected
      $(".quantitySelector").addClass("disabled");

      diffDays = 1;
      let startDateDiff = moment($("#cdates").val(), "DD/MM/YYYY");
      // console.log('startDateDiff---- ',startDateDiff);
      let endDateDiff = moment($("#cendDate").val(), "DD/MM/YYYY");
      // console.log('endDateDiff---- ',endDateDiff);

      let weekDays = [];
      // get the weekDays array from the customDaysArr
      // console.log("$customDaysArr---- ", $customDaysArr);
      for (let i = 0; i < $customDaysArr.length; i++) {
        if ($customDaysArr[i] > 0) {
          weekDays.push(i);
        }
      }
      // console.log("weekDays---- ", weekDays);

      let noOfDays = 0;
      if (weekDays.length > 0) {
        while (startDateDiff < endDateDiff) {
          // check weekDays in array
          if ($.inArray(startDateDiff.day(), weekDays) > -1) {
            // console.log('day---- ',startDateDiff.day());
            noOfDays++;
          }

          startDateDiff.add(1, "day");
        }
      }
      // console.log("noOfDays---- ", noOfDays);
      diffDays = noOfDays;
    } else {
      diffDays = 1;
      $(".quantitySelector").removeClass("disabled");
    }

    if (diffDays == 0 || isNaN(diffDays)) {
      diffDays = 1;
    }
    localStorage.setItem("diffDays", diffDays);
    // console.log(diffDays);

    if (type == "plus") {
      $("#itemQuantity").val(+$("#itemQuantity").val() + 0);

      var currVlaue = $("#itemQuantity").val();
      localStorage.setItem("currVlaue", currVlaue);
      $(".totalQtyItem").html(currVlaue);

      var totalPriceItem =
        parseInt(currVlaue) *
        parseFloat($("#itemPriceValue").val()) *
        parseFloat(diffDays);
      // console.log("currVlaue---- ", currVlaue);
      localStorage.setItem("totalPriceItem", totalPriceItem);
      // console.log(totalPriceItem);
      $("#total_product_amount").html("₹" + totalPriceItem);
      $(".totalPriceItem").text(totalPriceItem);
      $(".totalQtyItem").text(currVlaue);
    }
  }
  setTimeout(function () {
    var diffDays1 = localStorage.getItem("diffDays", diffDays1);
    var currVlaue1 = $("#itemQuantity").val();
    var res1 = diffDays1 * currVlaue1;
    $("#offerdetailqnty").html("Total Quantity : " + res1);
  }, 500);

  // offerdetailquantity();
}

function calculateofferAmount(here, cartId, type, deliveryPlan = "", diffDays) {
  if (cartId) {
    let $currVlaue = $("#itemQuantity").val();
    let $minValue = $("#itemQuantity").attr("min");
    if (!deliveryPlan) {
      deliveryPlan = $(".deliveryPlan__btns .active").attr("data-plan");
    }

    if (deliveryPlan == "daily") {
      let startDateDiff = moment($("#startDate").val(), "DD/MM/YYYY");
      let endDateDiff = moment($("#endDate").val(), "DD/MM/YYYY");

      diffDays =
        Math.ceil(Math.abs(endDateDiff - startDateDiff) / (1000 * 3600 * 24)) +
        1;
    } else if (deliveryPlan == "alternate") {
      let startDateDiff = moment($("#alternateStartDate").val(), "DD/MM/YYYY");
      let endDateDiff = moment($("#alternateEndDate").val(), "DD/MM/YYYY");

      diffDays = Math.round(
        (Math.ceil(Math.abs(endDateDiff - startDateDiff) / (1000 * 3600 * 24)) +
          1) /
        2
      );
    } else if (deliveryPlan == "once") {
      diffDays = 1;
    } else if (deliveryPlan == "custom") {
      // disable quantity selector if custom plan is selected
      $(".quantitySelector").addClass("disabled");

      diffDays = 1;
      let startDateDiff = moment($("#cdates").val(), "DD/MM/YYYY");
      // console.log('startDateDiff---- ',startDateDiff);
      let endDateDiff = moment($("#cendDate").val(), "DD/MM/YYYY");
      // console.log('endDateDiff---- ',endDateDiff);

      let weekDays = [];
      // get the weekDays array from the customDaysArr
      // console.log("$customDaysArr---- ", $customDaysArr);
      for (let i = 0; i < $customDaysArr.length; i++) {
        if ($customDaysArr[i] > 0) {
          weekDays.push(i);
        }
      }
      // console.log("weekDays---- ", weekDays);

      let noOfDays = 0;
      if (weekDays.length > 0) {
        while (startDateDiff < endDateDiff) {
          // check weekDays in array
          if ($.inArray(startDateDiff.day(), weekDays) > -1) {
            // console.log('day---- ',startDateDiff.day());
            noOfDays++;
          }

          startDateDiff.add(1, "day");
        }
      }
      // console.log("noOfDays---- ", noOfDays);
      diffDays = noOfDays;
    } else {
      diffDays = 1;
      $(".quantitySelector").removeClass("disabled");
    }

    if (diffDays == 0 || isNaN(diffDays)) {
      diffDays = 1;
    }
    localStorage.setItem("diffDays", diffDays);
    // console.log(diffDays);

    if (type == "plus") {
      $("#itemQuantity").val(+$("#itemQuantity").val() + 0);

      var currVlaue = $("#itemQuantity").val();
      localStorage.setItem("currVlaue", currVlaue);
      $(".totalQtyItem").html(currVlaue);

      var totalPriceItem =
        parseInt(currVlaue) *
        parseFloat($("#itemPriceValue").val()) *
        parseFloat(diffDays);
      // console.log("currVlaue---- ", currVlaue);
      localStorage.setItem("totalPriceItem", totalPriceItem);
      // console.log(totalPriceItem);
      $("#total_product_amount").html("₹" + totalPriceItem);
      $(".totalPriceItem").text(totalPriceItem);
      $(".totalQtyItem").text(currVlaue);
    }
  }
  setTimeout(function () {
    var diffDays1 = localStorage.getItem("diffDays", diffDays1);
    var currVlaue1 = $("#itemQuantity").val();
    var res1 = diffDays1 * currVlaue1;
    $("#offerdetailqnty").html("Total Quantity : " + res1);
    if (parseInt(res1) === parseInt(localStorage.pquantity)) {
      $("#addcartbutton").show();
    } else {
      $("#addcartbutton").hide();
    }
  }, 500);

  // offerdetailquantity();
}

function ReferearninfoForinvited() {
  return new Promise(function (resolve, reject) {
    var userdata = localStorage.getItem("userdata", userdata);
    var data = JSON.parse(userdata);
    // console.log("data invited===================", data);
    var token = data.token;
    if (userdata) {
      var UserID = data.UserID;
    } else {
      var UserID = "";
    }
    var settings = {
      url: baseUrl + "referearninfoinvited",
      method: "POST",
      headers: {
        "Content-Type": "application/json",
        Authorization: "Bearer " + token,
      },
      data: JSON.stringify({
        invited_customer_id: UserID,
      }),
    };
    // console.log("settings invited====================", settings);
    $.ajax(settings).done(function (response) {
      // console.log(response);
      if (response.status == 1) {
        if (response.data) {
          // console.log("New user info callal===>", response.data);
          resolve(response.data); // Resolve the Promise with the API response data
        }
      } else {
        reject(response.message); // Reject the Promise with an error message
      }
    });
  });
}

