                      <div class="invotersec d-flex justify-spc-bet align-center mb-10">
                        <div class="text-left">
                          <p class="text-blue fs-14"> ${info.name}</p>
                          <p class="text-grey fs-14 mt-5 text-left">${info.login_id}</p>
                        </div>
                          ${info.login_id === localStorage.getItem("acceptedReferId") ? `<button class="btn btn-success mt-0 acceptedBtn text-gold textCam">Accepted</button>` : `<a type="button" class="btn btn-transparent text-blue mt-0 textCam" href="javascript:void(0)" onclick="handleInviteAccept(${info.login_id})">Accept</a>` }
                      </div>
                    `;
                  })
                  .join("")}
              </div>
              <p class="text-gold mt-10 fs-14" style="text-align:left; color:#AE8A49">
                ${window.inviteModalContent.info || "After accepting the invite, you need complete a transaction of ₹2,000 or more to get your reward."}
              </p>
            `,
            confirmButtonText: "Close",
            customClass: {
              popup: "yourinvitedpopup",
              confirmButton: "custom-accept-btn",
            },
          });
      }
    });
}


function handleInviteAccept(ind) {
  // start if user name not present in local storage
  let userData = JSON.parse(localStorage.getItem("userdata") || null);
  if(!userData?.FirstName){
      Swal.close(); 
      var register__step1 = document.querySelector(".register__step1");
      var register__step2 = document.querySelector(".register__step2");
      var register__step3 = document.querySelector(".register__step3");
      register.classList.add("open");
      register__step1.classList.add("hidden");
      register__step2.classList.add("hidden");
      register__step3.classList.remove("hidden");
      return;
    }
  // start if user name not present in local storage
  localStorage.setItem("acceptedReferId", ind)
  walletAmountSet(ind, referNearnWalletAmount);
}

function walletAmountSet(coupon, amount){
  // start if user name not present in local storage
  let userData = JSON.parse(localStorage.getItem("userdata") || null);
  if(!userData?.FirstName){
      var register__step1 = document.querySelector(".register__step1");
      var register__step2 = document.querySelector(".register__step2");
      var register__step3 = document.querySelector(".register__step3");
      register.classList.add("open");
      register__step1.classList.add("hidden");
      register__step2.classList.add("hidden");
      register__step3.classList.remove("hidden");
    return;
  }
  // start if user name not present in local storage
  localStorage.setItem("amount", amount);
  localStorage.setItem("coupon", coupon);
  window.location.href = url + 'wallet';
}
