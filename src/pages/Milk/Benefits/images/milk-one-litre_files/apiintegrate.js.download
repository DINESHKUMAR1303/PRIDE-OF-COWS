function priceBeforeDiscount() {
  var totalBeforeDiscount = 0;
  var pricesArray = [];

  $(".totalprice").each(function () {
    pricesArray.push(Number($(this).attr("priceBeforeDiscount")));
  });

  totalBeforeDiscount = pricesArray.reduce(function (a, b) {
    return a + b;
  }, 0);
}

// Retrieve the cart data from local storage
const cart = JSON.parse(localStorage.getItem("cart"));
var offer_promocode_name = localStorage.getItem("promocode_name");
var offer_discount_value = localStorage.getItem("discount_value");
const totalSaveProductId = localStorage.getItem("productOfferId");
if (cart && Array.isArray(cart)) {
  // Calculate the total savings, tax and total card price
  let totalCardPrice = 0;
  let totalTax = 0;
  let totalSave = 0;
  cart?.forEach(item => {
    const cartOfferProductId = item?.ProductId;
    let total = (Number(item?.Price) * Number(item?.Quantity))*Number(item?.diffDays);
    totalCardPrice += total;
    let tax = item?.taxprice == "0" ? 0 : (100 + Number(item?.taxprice)) /100;
    totalTax += tax == 0 ? 0 : Number(item?.totalPriceItem) - ((Number(item?.totalPriceItem)/(tax)));
    let totalbeforeDiscount = item?.totalpriceBeforeDiscount== null ? 0 : Number(item?.totalpriceBeforeDiscount);
    if(offer_promocode_name === PRODUCT_OFFER.OFFER_CODE) {
      if (cartOfferProductId === totalSaveProductId) {
        totalSave += totalbeforeDiscount === 0 ? 0 : (totalbeforeDiscount - total + Number(offer_discount_value));
      } else {
        totalSave += totalbeforeDiscount === 0 ? 0 : (totalbeforeDiscount - total);
      }
    } else {
      totalSave += totalbeforeDiscount == 0 ? 0 : (totalbeforeDiscount - total);
    }
  });

  $(".showcheckoutTax").html("₹ " + totalTax.toFixed(2));
  $(".showcheckoutTotal").html("₹ " + totalCardPrice);
  $(".showcheckoutSubtotal").html("₹ " + totalCardPrice);
  // Display the total savings in the .saved_amount div
  const savedAmountDiv = document.querySelector(".saved_amount");
  if (savedAmountDiv && totalSave) {
    savedAmountDiv.textContent = ` ₹${totalSave}`;
    // if(localStorage.offeredprice) {
    //   savedAmountDiv.textContent = ` ₹${Number(totalSave) + Number(localStorage.offeredprice)}`;
    // } else {
    //   savedAmountDiv.textContent = ` ₹${totalSave}`;
    // }
  } else {
    $(".savedAmount").hide();
  }
} else {
  // console.log("Cart data is not available or invalid!");
}

