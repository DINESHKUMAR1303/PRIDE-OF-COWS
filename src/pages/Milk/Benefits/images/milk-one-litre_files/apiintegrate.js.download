        //is_stock_available = false -> show "out of stock" message, is_stock_available = true -> show "in stock" message
        if(isStockEnable && typeof response.data?.is_stock_available === "boolean" && !response.data?.is_stock_available) {
          $(".btn-buy-sub-container").css("margin", "0px").html("<div class='out-of-stock' >Out of Stock</div>");
          $(".inputGroup.qntyOfPlans").remove();
        }
          let currentDate = new Date();
