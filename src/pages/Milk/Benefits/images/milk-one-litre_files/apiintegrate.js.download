function paymentSuccess() {
  var queryString = window.location.search;
  var urlParams = new URLSearchParams(queryString);
  if (!urlParams.has('payment')) {
    return;
  }
  var userdata = localStorage["userdata"] ? JSON.parse(localStorage["userdata"]) : {};
  if (!userdata) {
    return;
  }
  $.ajax({
    url: baseCarturl + 'cart/trackpaymentga',
    method: 'post',
    data: {
      'custId': userdata.UserID
    },
    headers: {
      'Content-Type': "application/x-www-form-urlencoded",
      'Authorization': 'Bearer ' + userdata.token
    },
    success: function (resp) {
      if (resp.status == 200) {
        gaEvent(resp.eventData);
      }
    }
  });
}
function getOffercarts() {
  var cartdata1 = localStorage.getItem("offercart");
  if (cartdata1) {
    var cartdata = JSON.parse(cartdata1);
    var userdata = localStorage.getItem("userdata");
    var data = JSON.parse(userdata);
    var token = data.token;
    var custId = data.UserID;
    var city = data.city;
    var cartitem = "";
    var allcart = "";

    if (cartdata) {
      $.each(cartdata, function (i, it) {
        city = userdata.city;
        totalamount = it.totalPrice;
        city = userdata.city;
        var sd = it.StartDate;
        var ed = it.EndDate;
        var date1 = sd.split("/");
        var date2 = ed.split("/");
        var newstrtdate =
          date1[2] + "-" + setDateZero(date1[1]) + "-" + setDateZero(date1[0]);
        var newenddate =
          date2[2] + "-" + setDateZero(date2[1]) + "-" + setDateZero(date2[0]);
        cartitem +=
          it.ProductId +
          ":" +
          it.Price +
          ":" +
          it.Quantity +
          ":" +
          newstrtdate +
          "|";
        if (it.DeliveryPlan == "daily") {
          var planNane = "everyday";
        } else {
          var planNane = it.DeliveryPlan;
        }

        allcart += newstrtdate + ":" + newenddate + ":" + planNane + "|";

        var Offdata = JSON.stringify({
          custId: custId,
          CartItems: cartitem,
          City: city,
          Source: "Desktop",
          TotalAmount: totalamount,
          TotalPay: "",
          maxDate: newenddate,
          minDate: newstrtdate,
          subscriptionType: planNane,
          allcart: allcart,
        });

        localStorage.offCart = Offdata;
      });
    }
  }
}

function placeOrders(params) {
  var userdata = localStorage["userdata"]
    ? JSON.parse(localStorage["userdata"])
    : {};
  if (userdata) {
    var token = userdata.token;
    var settings = {
      url: baseUrl + "allorderplace",
      method: "POST",
      headers: {
        Authorization: "Bearer " + token,
        "Content-Type": "application/json",
      },
      data: JSON.stringify(params),
    };
    $.ajax(settings).done(function (response) {
      if (response.status == 1) {

        // start campaign apply coupon
        const cartdata = localStorage.getItem("cart") || "[]";
        const cartdataNew = JSON.parse(cartdata);
        const productQtyString = cartdataNew
        .map(function (item) {
        return item.ProductId + ':' + item.Quantity;
        })
        .join(',');
        submitCampaignDetails(CAMPAIGN_EVENTS.CATEGORY_CheckOut, productQtyString);
        // end campaign apply coupon

        removedata();
        clearCartAfterPayment();
        setTimeout(function () {
          window.location.href = url + "calenderorder?status=success";
        }, 1000);
      } else {
        Swal.fire({
          title: "error",
          text: response.message,
          icon: "error",
          closeOnConfirm: true,
        }).then(function () {
          window.location.href = url + "calenderorder";
        });
      }
    });
  }
}

function SubscriptionPlaceorders(params) {
  //params);
