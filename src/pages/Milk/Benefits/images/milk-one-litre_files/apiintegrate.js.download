function postpaidoutstanding(st=0) {
  var data = (localStorage["userdata"]) ? JSON.parse(localStorage["userdata"]) : {};
  if (data && data.customer_type == 'Postpaid') {
      var token = data.token;
      var userId=data.UserID;
      var settings = {
          "url": baseUrl + "subscribedetail",
          "method": "POST",
          "headers": {
              "Authorization": "Bearer " + token,
              "Content-Type": "application/json",
          },
          "data": JSON.stringify({
                 "UserID": userId
            }),
      };
      $.ajax(settings).done(function(response) {
        if(st===1 && response.subs && response.subs.restrict_access && response.subs.restrict_access === 1 || response.subs.restrict_access === 0){
          showPostpaidModel();
        }
        if(st===1 && response.discription && response.header){
          if (response.invoice) {
            var sum = parseInt(response.invoice.total_outstanding) + parseInt(response.invoice.unbilled);
            if (parseInt(sum) > 0) {
            $('.post_payment_btn').css('display','');
            }
         }   
         $('.headcontentPost').html(response.header);
         $('.bodycontentPost').html(response.discription);
        }else{
          if (response.invoice) {
            var sum = parseInt(response.invoice.total_outstanding) + parseInt(response.invoice.unbilled);
            if (parseInt(sum) > 0) {
                $('.post_payment_btn').css('display','');
                $('#outstandingpostpaid').val(1);
            }
        }
      }
    });
  }
}

