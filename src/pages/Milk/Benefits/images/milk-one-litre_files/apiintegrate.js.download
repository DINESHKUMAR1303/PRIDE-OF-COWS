  $.ajax(settings).done(function (response) {
    if (response.status == 1) {
    localStorage.setItem("referearnRes", JSON.stringify(response.invited_list));
      const invitedList = response.invited_list || [];
      const rewardList = response.reward_list || [];
      invitedList.forEach(function (it) {
        let buttonsHTML = "";
