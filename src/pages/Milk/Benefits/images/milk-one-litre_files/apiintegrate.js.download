function fetchAllFeatureFlags() {
  var userdata = JSON.parse(localStorage.getItem("userdata"));
  var settings = {
    "url": baseUrl + "featureflags",
    "method": "POST",
    "headers": {
      "Authorization": "Bearer " + userdata?.token,
      "Content-Type": "application/json",
    },
  };
  $.ajax(settings).done(function (response) {
    if (response.status) {
      localStorage.setItem("featureFlags", JSON.stringify(response.features));
    }
  })
}
fetchAllFeatureFlags();
  
function handleBuyNow(
    ProductID,
    price,
    name,
    diffDays,
    totalPrice,
    totalPriceItem,
    main_img,
    currVlaue
  ) {
    // localStorage.removeItem("discount_value");
    // localStorage.removeItem("promocode_name");
  
    localStorage.setItem('currVlaue', parseInt($("#itemQuantity").val()));
  
    if (localStorage.getItem('currVlaue') === null) {
      localStorage.setItem('currVlaue', 1);
    }
    var user_data = JSON.parse(localStorage.getItem('userdata'));
    var price = localStorage.getItem("price");
    var name = localStorage.getItem("name", name);
    var taxpr = localStorage.taxprice;
    var main_img = localStorage.getItem("main_img", main_img);
    var unit_prod = localStorage.getItem("unit_prod", unit_prod);
    var category_prod = localStorage.getItem("category_prod", category_prod);
    var diffDays = localStorage.getItem("diffDays", diffDays);
    var totalPrice = localStorage.getItem("totalPrice", totalPrice);
    var currVlaue = localStorage.getItem("currVlaue", currVlaue);
    var totalPriceItem = localStorage.getItem("totalPriceItem", totalPriceItem);
    var ProductID = localStorage.getItem("pid", ProductID);
    var launchDate = localStorage.getItem("launch_date", launchDate);
    var deliveryBuffer = localStorage.getItem("deliveryBuffer");
    var priceBeforeDiscount = localStorage.getItem("priceBeforeDiscount", priceBeforeDiscount);
    var isSubscribeProd = localStorage.getItem("is_subscribe", isSubscribeProd);
    var isNewPayment = localStorage.getItem("use_new_payment_gatway", isNewPayment);
    var ratingInfo = {ratingNumber: parseFloat($("#num-rating").val()), totalReviews: parseInt($("#total-review").val())}
    diffDays = Number(diffDays) || 1;
    currVlaue = Number(currVlaue);
    var result_quantity = diffDays * currVlaue;
    localStorage.setItem("result_quantity", result_quantity);
    const poc_addresid = localStorage.getItem("selectedAddressId");
    var quantity = $("#itemQuantity").val();
    var deliveryPlan = "once";

    //  start if user login and if have cart items then run this 
    // if (user_data) {

    //   // ✅ Get local cart from localStorage
    //   var localCart = JSON.parse(localStorage.getItem("cart")) || [];

    //   // Loop through each product in cart and sync with backend
    //   localCart.forEach(function (item) {
    //     var settings = {
    //       url: baseUrl + "productdetail",
    //       method: "POST",
    //       timeout: 0,
    //       headers: {
    //         "Content-Type": "application/json",
    //         Authorization: "Bearer " + user_data.token,
    //       },
    //       data: JSON.stringify({
    //         "ProductID": ProductID,
    //         "addressId": poc_addresid
    //       }),
    //     };

    //     $.ajax(settings).done(function (response) {
    //       if (response.status == 1) {
    //         // Set order_prod_date based on subscription status
    //         var today = new Date();
    //         var orderDate = new Date(today);
    //         if (response.data.is_subscribe == 0) {
    //           orderDate.setDate(today.getDate() + 2);
    //         } else {
    //           orderDate.setDate(today.getDate() + 1);
    //         }
    //         var order_prod_date = orderDate.toISOString().split("T")[0];

    //         // ✅ Call backend API to add this product
    //         // addToCartProduct(item.ProductId, order_prod_date, item.Quantity);
    //         let updatedOrderDate = $("#deliveryDate").val();
    //         updatedOrderDate = formatDateToYMD(updatedOrderDate);
    //         addToCartProduct(item.ProductId, updatedOrderDate, item.Quantity);
    //       }
    //     });
    //   });
    // }

    if(user_data) {
      var settings = {
        url: baseUrl + "productdetail",
        method: "POST",
        timeout: 0,
        headers: {
          "Content-Type": "application/json",
          Authorization: "Bearer " + user_data.token,
        },
        "data": JSON.stringify({
          "ProductID": ProductID,
        }),
      };

      $.ajax(settings).done(function (response) {
        if (response.status == 1) {
          // Set the order_prod_date based on subscription status
          // var today = new Date();
            var poc_orderDate = $("#deliveryDate").val(); // e.g. "17 Oct 2025" or "17/10/2025"
            // Convert "17 Oct 2025" or "17/10/2025" to "2025-10-17"
            if (poc_orderDate) {
              if (poc_orderDate.includes("/")) {
              // Format: "17/10/2025"
              var parts = poc_orderDate.split("/");
              if (parts.length === 3) {
                var day = parts[0].padStart(2, "0");
                var month = parts[1].padStart(2, "0");
                var year = parts[2];
                poc_orderDate = `${year}-${month}-${day}`;
              }
              } else {
              // Format: "17 Oct 2025"
              var dateParts = poc_orderDate.split(" ");
              if (dateParts.length >= 3) {
                var day = dateParts[0].padStart(2, "0");
                var monthMap = {
                Jan: "01", Feb: "02", Mar: "03", Apr: "04", May: "05", Jun: "06",
                Jul: "07", Aug: "08", Sep: "09", Oct: "10", Nov: "11", Dec: "12"
                };
                var month = monthMap[dateParts[1]] || "01";
                var year = dateParts[2];
                poc_orderDate = `${year}-${month}-${day}`;
              }
              }
            }
            // console.log(poc_orderDate, "sds")
          // updatedOrderDate = formatDateToYMD(poc_orderDate);
          // console.log(poc_orderDate, "sds2")
          addToCartProduct(ProductID, poc_orderDate, quantity);
        }
      })
    }

    //  end if user login and if have cart items then run this 

    if ($('input[name="reward_type"]').attr("value") == "loyalty") {
      deliveryPlan = $('input[name="delivery_plan"]').attr("value");
    }
    var startDate = $("#deliveryDate").val() ? new Date(moment($("#deliveryDate").val(), "D/M/YYYY").format("YYYY-MM-DD")) : new Date();
    startDate = startDate.toLocaleDateString('en-GB');
    var endDate = startDate;
    if (launchDate && launchDate.trim() !== '') {
      var date1 = startDate.split("/");
      var newstrtdate = date1[2] + "-" + setDateZero(date1[1]) + "-" + setDateZero(date1[0]);
      var launchDateParts = launchDate.split("-");
      var formattedLaunchDate = launchDateParts[0] + "-" + launchDateParts[1] + "-" + launchDateParts[2];
      var reverseFormatedLaunch = launchDateParts[2] + "-" + launchDateParts[1] + "-" + launchDateParts[0];
      var startDateParsed = Date.parse(newstrtdate);
      var launchDateParsed = Date.parse(formattedLaunchDate);
      if (launchDateParsed > startDateParsed) {
        Swal.fire({
          text: 'Sorry this product will be available from ' + reverseFormatedLaunch,
          closeOnConfirm: true,
        })
        return false;
      }
    }
    if (!startDate || !endDate) {
      Swal.fire({
        position: "top-end",
        icon: "error",
        title: "Please Fill all the fields",
        showConfirmButton: false,
        timer: 2500,
      });
      return; // Exit function if dates are missing
    }
    if (totalPriceItem < 1) {
      Swal.fire({
        position: "top-end",
        icon: "error",
        title: "Please Select minimum one quantity",
        showConfirmButton: false,
        timer: 2500,
      });
      return;
    }
  
    if ($('input[name="reward_type"]').attr("value") == "loyalty") {
      var repeatMonthly = 0;
    }
    if (!startDate || !endDate) {
      Swal.fire({
        position: "top-end",
        icon: "error",
        title: "Please Fill all the fields",
        showConfirmButton: false,
        timer: 2500,
      });
      return;
    }
    if (ProductID && quantity && startDate && endDate) {
      var userdata = localStorage.getItem("userdata");
      data = userdata ? JSON.parse(userdata) : {};
      if (Object.keys(data).length === 0) {
        var mycArray = [];
        //Productcart);
        const mycartData = {
          ProductId: ProductID,
          Quantity: quantity,
          Price: price,
          DeliveryPlan: deliveryPlan,
          StartDate: startDate,
          EndDate: endDate,
          RepeatMonthly: repeatMonthly,
          Name: name,
          diffDays: diffDays,
          totalPrice: totalPrice,
          totalPriceItem: totalPriceItem,
          main_img: main_img,
          currVlaue: currVlaue,
          taxprice: taxpr,
          category_prod:category_prod,
          unit_prod:unit_prod,
          slug:slug,
          qtyProduct:qtyProduct,
          ratingInfo : ratingInfo,
          isSubscribe : isSubscribeProd,
          deliveryBuffer : deliveryBuffer
        };
        mycArray.push(mycartData);
        localStorage.setItem("offlinecart", JSON.stringify(mycArray));
        // register.classList.add("open");
        
        // start if userdata not found add product in cart
        var settings = {
          url: baseUrl + "productdetail",
          method: "POST",
          timeout: 0,
          headers: {
            "Content-Type": "application/json",
            // Authorization: "Bearer " + user_data.token,
          },
          "data": JSON.stringify({
            "ProductID": ProductID,
          }),
        };
        $.ajax(settings).done(function (response) {
          if (response.status == 1) {
            var product = response.data;

            var myArray = JSON.parse(localStorage.getItem("cart")) || [];

            // Check if product already exists in cart
            var existingIndex = myArray.findIndex(item => item.ProductId === product.id);

            if (existingIndex > -1) {
              // ✅ Product exists → increase quantity properly
              myArray[existingIndex].Quantity = parseInt(myArray[existingIndex].Quantity, 10) + parseInt(quantity, 10);

              // Recalculate totals
              myArray[existingIndex].totalPriceItem = myArray[existingIndex].Price * myArray[existingIndex].Quantity;
              myArray[existingIndex].totalPrice = myArray[existingIndex].totalPriceItem;
              myArray[existingIndex].totalpriceBeforeDiscount =
                (product.priceBeforeDiscount ?? product.price) * myArray[existingIndex].Quantity;
            } else {
              // ✅ Product not in cart → add fresh
              const myData = {
                ProductId: product.id,
                Quantity: parseInt(quantity, 10),
                Price: product.price,
                DeliveryPlan: deliveryPlan,
                StartDate: startDate,
                EndDate: endDate,
                RepeatMonthly: repeatMonthly,
                Name: product.name,
                diffDays: diffDays,
                totalPrice: totalPrice,
                totalPriceItem: totalPriceItem,
                main_img: product.main_img,
                currVlaue: currVlaue,
                taxprice: product.taxamount,
                category_prod: product.catagory,
                unit_prod: product.product_unit,
                slug: product.slug,
                qtyProduct: qtyProduct,
                priceBeforeDiscount: product.priceBeforeDiscount,
                totalpriceBeforeDiscount: (product.priceBeforeDiscount ?? product.price) * result_quantity,
                ratingInfo: product.ratingInfo,
                isSubscribe: product.is_subscribe,
                display_name: product.display_name,
                product_display_name: product.product_display_name,
                productImages: product.productImages,
                is_stock_available: product.is_stock_available,
                deliveryBuffer : deliveryBuffer
              };
              myArray.push(myData);
            }

            // Save updated cart
            localStorage.setItem("cart", JSON.stringify(myArray));
            $(".cartIcon__count").addClass("show_cartIconCount");
            setCartCount();
            $("#showcartmodal, .mobile-view-option.cartIcon, .bottom-bar .showcartmodal").addClass("active");
            setTimeout(() => $("#showcartmodal, .mobile-view-option.cartIcon, .bottom-bar .showcartmodal").removeClass("active"), 3000);
            // Handle order date logic
            var today = new Date();
            var orderDate = new Date(today);
            if (product.is_subscribe == 0) {
              orderDate.setDate(today.getDate() + 2);
            } else {
              orderDate.setDate(today.getDate() + 1);
            }
            var order_prod_date = orderDate.toISOString().split('T')[0];

            addToCartProduct(product.id, order_prod_date, quantity);
          }
        });

        // end if userdata not found add product in cart


        // start campaign login
        var cartdataLogin = localStorage.getItem("offlinecart") || "[]";
        var cartdataNewLogin = JSON.parse(cartdataLogin);
        var productQtyStringLogin = cartdataNewLogin
        .map(function (item) {
        return item.ProductId + ':' + item.Quantity;
        })
        .join(',');
        submitCampaignDetails(CAMPAIGN_EVENTS.CATEGORY_Login, productQtyStringLogin);
        // start campaign login

    return false;
   }
      var userdata = localStorage.getItem("userdata", userdata);
      var data = JSON.parse(userdata);
      var token = data.token;
      var Productcart = localStorage.getItem("cart", Productcart);
      var slug = '';
      var city = data.city_id;
      var qtyProduct = [];
      if (deliveryPlan == 'custom') {
        try {
          var customDays = localStorage.getItem("customDays");
          customDays = JSON.parse(customDays);
          for (var i in customDays) {
            if (!customDays[i]) {
              continue;
            }
            qtyProduct.push({
              'day': i,
              'qty': customDays[i]
            });
          }
        } catch (err) {
          console.log(err);
        }
      }
      $.ajax({
        'url': baseCarturl + 'cart/getproductforcity',
        'data': JSON.stringify({
          'product_id': ProductID,
          'city_id': city
        }),
        'method': 'post',
        'headers': {
          'Content-Type': 'application/json',
          'Authorization': 'Bearer ' + token
        },
        'success': (resp) => {
          slug = resp.product.slug
          // updateCartQuantity(ProductID,quantity);
          if (Productcart === null) {
            var myArray = [];
            //Productcart);
            const myData = {
              ProductId: ProductID,
              Quantity: quantity,
              Price: price,
              DeliveryPlan: deliveryPlan,
              StartDate: startDate,
              EndDate: endDate,
              RepeatMonthly: repeatMonthly,
              Name: name,
              diffDays: diffDays,
              totalPrice: totalPrice,
              totalPriceItem: totalPriceItem,
              main_img: main_img,
              currVlaue: currVlaue,
              taxprice: taxpr,
              category_prod: category_prod,
              unit_prod: unit_prod,
              slug: slug,
              qtyProduct: qtyProduct,
              priceBeforeDiscount: priceBeforeDiscount,
              totalpriceBeforeDiscount: priceBeforeDiscount * result_quantity,
              ratingInfo : ratingInfo,
              isSubscribe : isSubscribeProd,
              deliveryBuffer : deliveryBuffer
            };
            myArray.push(myData);
            localStorage.setItem("cart", JSON.stringify(myArray));
            $(".cartIcon__count").addClass("show_cartIconCount");
            setCartCount();
          } else {
            const myData = {
              ProductId: ProductID,
              Quantity: quantity,
              Price: price,
              DeliveryPlan: deliveryPlan,
              StartDate: startDate,
              EndDate: endDate,
              RepeatMonthly: repeatMonthly,
              Name: name,
              diffDays: diffDays,
              totalPrice: totalPrice,
              totalPriceItem: totalPriceItem,
              main_img: main_img,
              currVlaue: currVlaue,
              taxprice: taxpr,
              category_prod: category_prod.toLowerCase(),
              unit_prod: unit_prod,
              slug: slug,
              qtyProduct: qtyProduct,
              priceBeforeDiscount: priceBeforeDiscount,
              totalpriceBeforeDiscount: priceBeforeDiscount * result_quantity,
              ratingInfo : ratingInfo,
              isSubscribe : isSubscribeProd,
              deliveryBuffer : deliveryBuffer
            };
            var data = JSON.parse(Productcart);
            var data = $.grep(data, function (e) {
              return e.ProductId != ProductID;
            });
            data.push(myData);
            //data);
            localStorage.setItem("cart", JSON.stringify(data));
            $(".cartIcon__count").addClass("show_cartIconCount");
            setCartCount();
            $("#showcartmodal, .mobile-view-option.cartIcon, .bottom-bar .showcartmodal").addClass("active");
            setTimeout(() => $("#showcartmodal, .mobile-view-option.cartIcon, .bottom-bar .showcartmodal").removeClass("active"), 3000);
          }
        }
      });
    } else {
      Swal.fire({
        position: "top-end",
        icon: "error",
        title: "Please fill all the fields",
        showConfirmButton: false,
        timer: 2500,
      });
    }
    // var date1 = startDate.split('/');
    // var date2 = endDate.split('/');
    // var newstrtdate = date1[2] + "-" + date1[1] + "-" + date1[0];
    // var newenddate = date2[2] + "-" + date2[1] + "-" + date2[0];
    Offerproduct(startDate, endDate, deliveryPlan);
  
  
    var totalQty = parseInt(totalPriceItem) / parseInt(price);
    try {
      var jsonEvent = {
        event: "add_to_cart",
        // ecommerce: {
          items: [{
            index: 0,
            item_id: ProductID,
            item_name: name,
            item_brand: "Pride Of Cows",
            item_category: category_prod,
            item_variant: unit_prod,
            quantity: totalQty,
            price: Number(price),
          }],
          // quantity_per_day: quantity,
          // start_date: startDate,
          // end_date: endDate,
          currency: "INR",
          value: Number(totalPriceItem),
          // delivery_plan: deliveryPlan,
          // booking_days: diffDays
        // }
      };
      gaEvent(jsonEvent);
    } catch (er) {
  
    }
  
    setTimeout(function () {
      $("#cart_items").html("");
      // showCart();
      // checkCartStatusAndBindHandler();

      // start campaign add to cart
      var cartdataAddtocart = localStorage.getItem("cart") || "[]";
      var cartdataNewAddtocart = JSON.parse(cartdataAddtocart);
      var productQtyStringAddtocart = cartdataNewAddtocart
      .map(function (item) {
      return item.ProductId + ':' + item.Quantity;
      })
      .join(',');
      submitCampaignDetails(CAMPAIGN_EVENTS.CATEGORY_AddToCart, productQtyStringAddtocart);
      // end campaign add to cart

    }, 1000);
  }
  // ======================================whats new section slider api intergration==================================
$(document).ready(function () {
  function updateOfferImages() {
    $(".moslider img").each(function () {
      const newSrc = window.innerWidth <= 600 ? $(this).data("mobile-src") : $(this).data("desktop-src");
      if ($(this).attr("src") !== newSrc) {
        $(this).attr("src", newSrc);
      }
    });
  }
  updateOfferImages();
  let resizeTimer;
  $(window).on("resize", function () {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(updateOfferImages, 0); 
  });
});


let slider = $(".whats_new_slider");
let sliderNavigation = $(".whats_new_slider_navigation");
let totalSlides = slider.children().length;

if (totalSlides <= 2) {
  sliderNavigation.hide();
} else {
  sliderNavigation.show();
}

$(slider).slick({
  infinite: true,
  autoplay: true,
  autoplaySpeed: 2000,
  slidesToShow: 2,
  slidesToScroll: 1,
  prevArrow: $(".whats_new_prev_arrow"),
  nextArrow: $(".whats_new_next_arrow"),
  responsive: [
    {
      breakpoint: 769,
      settings: {
        arrows: false,
        dots: true,
        centerPadding: "20px",
        slidesToShow: 1,
      },
    },
  ],
});

function handleStaticDateHitw(){
  var settings = {
    "url": baseUrl + "get-staticdata",
    "method": "POST",
    "headers": {
        "Authorization": "Bearer " + userdata?.token,
        "Content-Type": "application/json",
    },
    "data": JSON.stringify({ screen_name: 'howitwork_subscription' })
};
$.ajax(settings).done(function(response) {
if(response.status){
  const data = JSON.parse(response.data.data);
$("#how-it-works .modal-content .modal-body").html(data.map(info => `
                
                    <div class="mb-3 steps">
                        <div>
                            <img src="${info.icon}" alt="${info.icon}">
                        </div>
                        <div>
                            <h5 class="hitw-heading">${info.title}</h5>
                            <p class="hitw-description" >
                            ${info.description.split("**").map((ex, i) => i % 2 ? `<br><strong>${ex}</strong>` : ex).join('')}
                            </p>
                        </div>
                    </div>
  `).join(""));
}
});
}

