    var newenddate = date2[2] + "-" + date2[1] + "-" + date2[0];
    if (Date.parse(newenddate) < Date.parse(newstrtdate)) {
      $("#myElem3").show();
      setTimeout(function () {
        $("#myElem3").hide();
      }, 5000);
      return false;
    }
    if (launchDate && launchDate.trim() !== '') {
      var launchDateParts = launchDate.split("-");
      var formattedLaunchDate = launchDateParts[0] + "-" + launchDateParts[1] + "-" + launchDateParts[2];
      var reverseFormatedLaunch = launchDateParts[2] + "-" + launchDateParts[1] + "-" + launchDateParts[0];
