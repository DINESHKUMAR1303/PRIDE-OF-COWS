                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-10">
                                                    <div class="right" style="padding:0 20px 0 0;">
                                                        <div class="d-flex justify-space-between">
                                                            <div class="reward_history_desc">
                                                                <h4 class="text-black">${reward.title}</h4>
                                                            <div class="rewards__date">Redeemed Date : ${reward.redeemed_date}
                                                            </div>
                                                            <div class="rewards__history_btn">
                                                                <div class="d-flex justify-space-between">
                                                                    <div class="cta mt-5">
                                                                    Reward
                                                                    </div>
                                                                </div>
                                                            </div>
                                                            </div>
                                                            <p class="mt-10"> <sup class="redeemed">Redeemed</sup></p>
                                                        </div>
                                                </div>
                                            </div>
                                        </div>`);
                        } else {
                            if (reward.expired == true){
                                $('#rewards-history').append(`<div class="rewards__box">
                                    <div class="row">
                                        <div class="col-3">
                                            <div class="left d-flex justify-space-center" style=" min-height: 130px;">
                                                <div class="crown d-flex justify-space-center">
                                                    <img src="../images/file.png">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-9">
                                            <div class="right" style="padding:0 20px 0 20px;">
                                                <div class="d-flex justify-space-between">
                                                    <div class="reward_history_desc">
                                                        <h4 class="text-blue">${reward.title}</h4>
                                                            <p> <sup class="expired">Expired</sup></p>
                                                    <div class="rewards__date">
                                                    This Coupon has expired on ${reward.valid_till}!
                                                    </div>
                                                    </div>
                                                    <div class="rewards__history_btn">
                                                        <div class="d-flex justify-space-between">
                                                            <div class="cta">
                                                            Reward
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                        </div>
                                    </div>
                                </div>`);
                            }
                        }
                    });
                }
            }
        },
        error: function(xhr, status, error) {
            console.error("An error occurred: " + error);
        }
    });
}

