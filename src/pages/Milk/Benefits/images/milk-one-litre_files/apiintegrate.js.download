  // });
}

function alloffercart() {
  localStorage.removeItem("customOcart");
  var Cart = localStorage.getItem("offercart", Cart);
  var data = JSON.parse(Cart);
  var array = [];
  // console.log(data);
  if (data) {
    localStorage.removeItem("offercartitems");

    $("#content_category2").html("");
    $.each(data, function (i, it) {
      var pr = it.ProductId;
      var qty = it.Quantity;
      array.push({ qty: qty, pid: pr });
      localStorage.setItem("offercartitems", JSON.stringify(array));
      for (var i = 1; i <= it.Quantity; i++) {
        if (i !== 1) {
          var reqField = "";
          var quant = 0;
          var visible = "display:none";
          var button =
            '<a onclick="removeDiv(' +
            it.ProductId +
            i +
            "," +
            it.ProductId +
            "," +
            qty +
            ')"><input type="button"  value="remove"></input></a>';
        } else {
          var reqField = "";
          var quant = qty;
          var visible = "";
          var button = "";
        }
        $("#content_category2").append(
          ` <div style="${visible}" class="col-12 col-xs-12 datefiels del${it.ProductId}${i} allprod${it.ProductId}${i}"> <input type="date" class="inputsdate datefields" name="${it.ProductId}${i}" id="dates${it.ProductId}${i}" value="" onchange="offerDates(this.value,${it.ProductId},'${it.Name}',${it.ProductId}${i},${i})"> <input type="number" ${reqField} class="inputsdate pname${it.ProductId}" id="prod${it.ProductId}${i}" name="dob" id="qty${it.ProductId}${i}" value="${quant}" onFocus=(this.name=this.value) onchange="offerqtychange('${it.ProductId}${i}',${qty},'${it.ProductId}',this.value,${i},this.name)"> <input type="text" readonly class="inputsdate" name="dob" id="dob" value="${it.Name}"> ${button}   
                                        </div> `
        );
      }
    });
  }
}
function uppernewlocation() {
  // Always use localStorage.CityName and localStorage.userPincode for header if present
  var cityName = localStorage.getItem("CityName");
  var userPincode = localStorage.getItem("userPincode");
  if (cityName && userPincode) {
    if ($('.locationG').length) {
      $('.locationG').html(`${cityName} (${userPincode})`);
    }
    if (document.getElementById('fetchCity')) {
      document.getElementById('fetchCity').textContent = `${cityName}, (${userPincode})`;
    }
    if (document.getElementById('fetchPincode')) {
      document.getElementById('fetchPincode').textContent = userPincode;
    }
    if (document.getElementById('loacationLoad')) {
      document.getElementById('loacationLoad').style.display = 'none';
    }
    $('.signinBtnn').show();
    return;
  }
  // Fallback to userdata if no selected address
  var userdetails = localStorage.getItem("userdata");
  var userdata = userdetails ? JSON.parse(userdetails) : {};
  if (Object.keys(userdata).length !== 0) {
    var City = userdata.City;
    var pin = userdata.pincode;
    if (City !== "" && City !== 'undefined') {
      $(".locationG").html(`${City}(${pin})`);
    }else{
      if(userdata.pincode === null){
        $(".locationG").text("Enter a pincode");
        $("#detect_Location_Popup").addClass("show-topmodal");
        Getlocationdetail();
        $('.close-buttonn').hide();
        $("#content_category").text("Please select a pincode");
      }
    }
  }
}
